  "audit_enqueue": {
    "rule_id": "SOURCE-AUDIT-ENQUEUE-01",
    "allocator": ".saipen/intake/audit_allocator.json",
    "lock": ".saipen/locks/audit-allocator.lock",
    "allocation": "MONOTONIC_NEVER_REUSED",
    "placement": "TEMP_THEN_ATOMIC_RENAME",
    "idempotency_key": "producer+producer_operation_id",
    "operation_states": [

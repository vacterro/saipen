  "load_profiles": {
    "schema_version": 1,
    "basis": "Each budget measures the non-cumulative routed surface named by one route. Conditional documents are reported separately and become mandatory only after routing into their owning profile.",
    "phase_preferences": {
      "enforced": false,
      "unit": "bytes",
      "bands": {
        "VERIFY": {
          "min": 6144,
          "max": 7168
        },
        "ADD": {
          "min": 5120,
          "max": 5632
        },
        "HUNT": {
          "min": 4608,
          "max": 5632
        },
        "PREPARE": {
          "min": 3584,
          "max": 4608
        },
        "SHIP": {
          "min": 8192,
          "max": 9216
        },
        "TRANSLATE": {
          "min": 7168,
          "max": 8192
        },
        "MARKHUNT": {
          "min": 8192,
          "max": 9216
        },
        "CLEAN": {
          "min": 7680,
          "max": 8704
        }
      }
    },
    "budgets": {
      "cold": 20480,
      "ordinary_continue": 35840,
      "command_resolution": 30720,
      "ordinary_phase": 40960,
      "ship_improve": 56320,
      "single_doc": 51200
    },
    "surfaces": {
      "active_phase_max": {
        "glob": "phases/*.md",
        "selection": "max_one"
      },
      "routine_doc_max": {
        "files": [
          "BOOT.md",
          "STYLE.md",
          "INDEX.md",
          "CORE.md",
          "MAINTENANCE.md",
          "OPS.md",
          "IMPROVE.md",
          "COMMANDS.md",
          "EXECUTION.md",
          "SOURCES.md",
          "RUNTIME.md"
        ],
        "selection": "max_one"
      }
    },
    "profiles": {
      "cold": {
        "routes": [
          {
            "name": "cold",
            "must": [
              "BOOT.md",
              "STYLE.md",
              "INDEX.md"
            ],
            "conditional": [],
            "exclude": [
              "CONFORMANCE.md",
              "CHANGELOG.md",
              "phases/*.md"
            ]
          }
        ]
      },
      "ordinary_continue": {
        "routes": [
          {
            "name": "done-to-next",
            "must": [
              "CORE.md",
              "phases/done.md"
            ],
            "conditional": [
              "SOURCES.md",
              "RUNTIME.md",
              "@active_phase_max"
            ],
            "exclude": [
              "CONFORMANCE.md",
              "CHANGELOG.md"
            ]
          }
        ]
      },
      "command_resolution": {
        "routes": [
          {
            "name": "command-router",
            "must": [
              "REGISTRY.json",
              "COMMANDS.md"
            ],
            "conditional": [
              "CONTROLS.md",
              "EXECUTION.md",
              "IMPROVE.md"
            ],
            "exclude": [
              "CORE.md",
              "CONFORMANCE.md",
              "phases/*.md"
            ]
          }
        ]
      },
      "ordinary_phase": {
        "routes": [
          {
            "name": "largest-active-phase",
            "must": [
              "CORE.md",
              "@active_phase_max"
            ],
            "conditional": [
              "SOURCES.md",
              "RUNTIME.md"
            ],
            "exclude": [
              "CONFORMANCE.md",
              "CHANGELOG.md",
              "inactive phases"
            ]
          }
        ]
      },
      "ship_improve": {
        "routes": [
          {
            "name": "ship-delta",
            "must": [
              "phases/ship.md",
              "OPS.md"
            ],
            "conditional": [
              "SOURCES.md",
              "RUNTIME.md"
            ],
            "exclude": [
              "CONFORMANCE.md",
              "inactive phases"
            ]
          },
          {
            "name": "improve-delta",
            "must": [
              "IMPROVE.md",
              "SAICRITIC.md"
            ],
            "conditional": [
              "RUNTIME.md"
            ],
            "exclude": [
              "CONFORMANCE.md",
              "phases/*.md"
            ]
          }
        ]
      },
      "single_doc": {
        "routes": [
          {
            "name": "largest-routine-document",
            "must": [
              "@routine_doc_max"
            ],
            "conditional": [],
            "exclude": [
              "CONFORMANCE.md",
              "CHANGELOG.md"
            ]
          }
        ]
      }
    }
  },

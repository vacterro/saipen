  "continue_fallback": {
    "invariant": "continue may fall through to improve ONLY after recovery, blocked/retryable, queued and required-follow-up routing are exhausted; it resumes an existing active Improve cycle and never creates an unbounded improve carousel",
    "marker": ".saipen/extensions/continue_fallback.json",
    "owner": "tools/saipen_engine/continue_fallback.py",
    "test": "tools/test_continue_improve_fallthrough.py"

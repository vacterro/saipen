      "beforeContent": "'use strict';\n\n/**\n * FREEBUFF SAI acceptance suite.\n *\n * Three groups, deliberately separated, because the mission forbids presenting\n * one as another:\n *\n *   UNIT        logic that runs entirely on local input.\n *   SIMULATED   the export and drift pipelines against an offline mock of the\n *               host API. A green result here proves the pipeline, NOT the live\n *               integration.\n *   LIVE        checks against the actually running Freebuff installation. A\n *               capability the host does not currently offer is recorded as\n *               BLOCKED with its reason, never as a pass.\n *\n * Filtering the suite or hiding a failure is not an option: the process exits\n * non-zero if anything FAILED, and BLOCKED results are counted and printed\n * separately so they cannot be mistaken for success.\n */\n\nconst fs = require('fs');\nconst path = require('path');\nconst os = require('os');\nconst crypto = require('crypto');\nconst http = require('http');\nconst https = require('https');\nconst { spawn, spawnSync } = require('child_process');\n\nconst PROJEC

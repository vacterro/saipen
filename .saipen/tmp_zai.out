      "afterContent": "#!/bin/sh\n# Refuse to publish the internal SAIPEN memory tree.\n#\n# The workspace repository tracks `.saipen/` (the protocol's own memory). That\n# tree is internal by design: it carries the operator's host paths, the\n# protocol's ticket history and machine-local handles. A public branch tip must\n# never carry it.\n#\n# The published workspace branch is written by\n#   python tools/publish-workspace-mirror.py --remote <remote> --branch <branch>\n# which strips `.saipen/` from every published tree. This hook is the guard for\n# every OTHER push, human or tool.\n#\n# Enable it once per clone:\n#   git config core.hooksPath tools/hooks\n\nstatus=0\nwhile read -r local_ref local_sha remote_ref remote_sha; do\n\t[ \"$local_sha\" = \"(delete)\" ] && continue\n\tgit cat-file -e \"$local_sha^{commit}\" 2>/dev/null || continue\n\tif git ls-tree -r --name-only \"$local_sha\" -- .saipen 2>/dev/null | grep -q .; then\n\t\techo \"pre-push: REFUSED: $local_ref still carries the internal .saipen/ memory tree.\" >&2\n\t\techo \"pre-push: publish it with:\" >&2\n\t\techo \"pre-push:   python tools/publish-wor

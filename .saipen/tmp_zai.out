      "beforeContent": "// T-415: the operator ingress acceptance suite.\n//\n// The operator's own `cc` and a model's `cc` are the same bytes. What tells\n// them apart is the origin: SAIPEN grants operator authority only for a host\n// ingress envelope the authority broker sealed for THIS session. These tests\n// drive the product's own code (the envelope builder, the launch carrier, the\n// refusal classification) and then let the REAL engine answer.\n//\n// The positive case runs against the installed SAIPEN engine through a\n// test-only fixture with a disposable native host identity. It is skipped\n// when no SAIPEN installation is present.\nimport assert from \"node:assert/strict\";\nimport test from \"node:test\";\nimport { spawnSync } from \"node:child_process\";\nimport { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\nimport { tmpdir } from \"node:os\";\nimport path from \"node:path\";\nimport { fileURLToPath } from \"node:url\";\nimport {\n  OPERATOR_INGRESS_HOST_ID,\n  buildOperatorIngressEnvelope,\n  buildOperatorIngressEvent,\n  isOperatorIngressSubmission,\n 

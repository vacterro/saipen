+        try:
+            info = path.lstat()
+        except OSError as exc:
+            raise FreshnessError(
+                f"cannot stat nested untracked input {path}: {exc}"
+            ) from exc
+        if stat.S_ISLNK(info.st_mode):
+            h.update(b"L\x00" + raw + b"\x00" + hashlib.sha256(_read_symlink(path)).digest())

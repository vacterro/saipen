+    @contextlib.contextmanager
+    def lstat_denied(self, target):
+        original = Path.lstat
+
+        def lstat(path, *args, **kwargs):
+            if path == target:
+                raise denied(target)
+            return original(path, *args, **kwargs)
+
+        with patch.object(Path, "lstat", lstat):
+            yield

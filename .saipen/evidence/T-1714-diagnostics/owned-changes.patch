+            self.assertEqual(completed.returncode, 0, value)
+            self.assertEqual(value["code"], "EXPLAIN_NEXT", value)
+            return 1 if not value["carrier"].get("ok", True) else 0, value["carrier"]
+        return completed.returncode, value

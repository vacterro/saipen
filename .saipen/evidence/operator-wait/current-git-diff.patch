+    "operator: manually provide release roots", "PHASE scout T-9",
+    "PHASE NO_SUCH_PHASE", "PHASE BUILD", "PHASE DONE T-9", "RUN:",
+    "RESUME:", "RESUME: missing ticket", "RESUME: T-9 NO_SUCH_PHASE",
+    "RESUME: T-9 build", "saipen ", "saipen no-such-command",
+    "RUN: first\nRUN: second", "WAIT: blocked", "WAIT: unknown -- question",
+)
+
+
+class NextActionGrammarTests(unittest.TestCase):
+    def test_owned_writer_and_repair_grammar_refuse_invalid_values(self) -> None:
+        for value in (*INVALID, None, 1, [], ""):
+            with self.subTest(value=value):
+                self.assertIsNotNone(state.next_action_error(value))
+                with self.assertRaises(state.NextActionError):
+                    state.patch_state(fixture.STATE, {"next_action": value})
+                if isinstance(value, str):
+                    self.assertTrue(_legacy_next_action(value))
+
+    def test_strict_reader_refuses_raw_legacy_bytes(self) -> None:
+        # Deliberately construct corrupt input as bytes, never through the
+        # writer whose invalid-value prevention this regression protects.
+        for value in INVALID:
+            if "\n" in value:
+                continue
+            with self.subTest(value=value):
+                text = fixture.STATE.format(next_action=value, home=fixture.HOME.as_posix())
+                fields, error = state.parse_state_or_error(text)
+                self.assertIsNone(fields)
+                self.assertIsNotNone(error)
+
+    def test_existing_valid_actions_round_trip_exactly(self) -> None:
+        text = fixture.STATE.format(next_action="saipen continue", home=fixture.HOME.as_posix())
+        for value in (
+            "PHASE SCOUT T-9", "PHASE DONE", "PHASE BUILD T-9 [50%]",
+            "RUN: python -B tools/check.py", "RUN: echo a; echo b",
+            "RESUME: T-9 BUILD", "RESUME: T-9 REVIEW [2/3]", "saipen continue",
+            "WAIT: blocked -- supply a release-root PATH; 0 of 751 sessions are agent-runnable",
+        ):
+            with self.subTest(value=value):
+                self.assertIsNone(state.next_action_error(value))
+                fields, error = state.parse_state_or_error(
+                    state.patch_state(text, {"next_action": value})
+                )
+                self.assertIsNone(error)
+                self.assertEqual(fields["next_action"], value)
+                self.assertFalse(_legacy_next_action(value))
+
+    def test_unowned_legacy_field_and_suffix_remain_exact(self) -> None:
+        text = fixture.STATE.format(next_action="operator: manual", home=fixture.HOME.as_posix())
+        text += "\n<!-- BOUNDARY: retained -->\n"

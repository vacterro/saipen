+            "next_action": wait,
+        })
+        path.write_text(text, encoding="utf-8")
+        files = [self.root / ".saipen" / name for name in ("STATE.md", "BOARD.md", "LOG.md")]
+        before = [file.read_bytes() for file in files]
+        for command in ("status", "continue", "recover"):
+            with self.subTest(command=command):
+                record = self.cli(command)
+                self.assertNotEqual(record.get("code"), "RECONCILE_REAUTH_REQUIRED", record)
+                self.assertEqual([file.read_bytes() for file in files], before)
+                if command == "continue":
+                    self.assertEqual(record.get("action"), wait, record)
+                    self.assertEqual(record.get("executable_behavior"), "RESTATE_AND_STOP", record)
+
+    def test_exact_rendered_recovery_preserves_original_and_requires_real_decision(self) -> None:
+        path = self.root / ".saipen" / "STATE.md"

+        command = diagnostic["canonical_next_command"]
+        self.assertEqual(path.read_bytes(), original)
+        self.assertFalse(diagnostic["safe_auto_repair_available"])
+        self.assertTrue(diagnostic["operator_decision_available"])
+        self.assertNotIn("<", command)
+        self.assertTrue(self.cli(*command.split()[1:])["ok"])
+        fields, error = state.parse_state_or_error(path.read_text(encoding="utf-8"))

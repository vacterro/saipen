+        self.assertEqual(patched, text.replace("agent: buffy", "agent: other"))
+
+
+class OperatorWaitBoundaryTests(unittest.TestCase):
+    def setUp(self) -> None:
+        temporary = tempfile.TemporaryDirectory(prefix="t1606-wait-")
+        self.addCleanup(temporary.cleanup)
+        self.root = fixture.project(Path(temporary.name))
+
+    def cli(self, *args: str) -> dict:
+        completed = subprocess.run(
+            [sys.executable, str(TOOLS / "saipen.py"), "--json", "--project-root",
+             str(self.root), *args],
+            capture_output=True, text=True, encoding="utf-8", errors="replace",
+            env=hermetic_env(), timeout=600,
+        )
+        self.assertNotIn("Traceback", completed.stderr)
+        return json.loads(completed.stdout)
+
+    def test_valid_operator_wait_is_readable_and_never_executed(self) -> None:
+        wait = "WAIT: blocked -- supply a release-root PATH; 0 of 751 sessions are agent-runnable"
+        path = self.root / ".saipen" / "STATE.md"
+        text = path.read_text(encoding="utf-8")

+        archives = self.root / ".saipen" / "recovery"
+        self.assertTrue(any(
+            p.is_file() and p.read_bytes() == original for p in archives.rglob("*")
+        ))
+        log = (self.root / ".saipen" / "LOG.md").read_text(encoding="utf-8")
+        self.assertIn("operator-authorized STATE.next_action", log)
+        before = path.read_bytes()
+        outcome = self.cli("continue")
+        self.assertEqual(outcome["action"], fixture.LEGACY_RECOVERY_WAIT)
+        self.assertEqual(outcome["executable_behavior"], "RESTATE_AND_STOP")
+        self.assertEqual(path.read_bytes(), before)

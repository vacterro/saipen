+def cli_value_positions(argv: Sequence[str]) -> frozenset[int]:
+    """Opaque operand positions, before the real `--` transport boundary.
+
+    Arity is declared data. A value spelling `--json`, `--`, or `+` is still
+    its option's value; only an unconsumed token can change CLI structure.
+    """
+    arities = _load_cli_option_arity()
+    positions = set()
+    remaining = 0
+    for index, token in enumerate(argv):
+        if remaining:
+            positions.add(index)
+            remaining -= 1
+        elif token == "--":
+            break
+        else:
+            remaining = arities.get(token, 0)
+    return frozenset(positions)
+
+
+def cli_has_option(argv: Sequence[str], options: Collection[str]) -> bool:
+    values = cli_value_positions(argv)
+    for index, token in enumerate(argv):
+        if index in values:
+            continue
+        if token == "--":
+            break
+        if token in options:
+            return True
+    return False
+

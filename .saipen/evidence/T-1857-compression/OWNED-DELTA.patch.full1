 )
 
 
+def _publication_staging_blocker(raw: str) -> bool:
+    """Recognize recorded release refusals, never permission to change an index."""
+    return bool(
+        re.match(r"^PUBLICATION_STAGING_BLOCKED(?:\s|:|$)", raw)
+        or (
+            raw.startswith("publication blocked:")
+            and re.search(r"\bforeign\b.*\bstag", raw, re.IGNORECASE)
+        )
+    )
+
+
+def _root_blockers(ticket_id: str, tickets: dict, seen: set | None = None) -> list[tuple]:
+    seen = set(seen or ())
+    if ticket_id in seen or ticket_id not in tickets:
+        return [(ticket_id, "UNKNOWN", "unresolved or cyclic dependency")]
+    seen.add(ticket_id)
+    ticket = tickets[ticket_id]
+    fields = ticket.get("fields") or {}
+    raw = str(fields.get("blocker") or "").strip()
+    match = re.match(r"^ACTIVE_DEPENDENCY\s*:\s*(T-\d+)", raw)
+    explicit = match.group(1) if match else str(fields.get("blocked_on") or "").strip()
+    dependencies = [explicit] if explicit else (
+        list(ticket.get("needs") or ()) if ticket.get("section") == "## TODO" else []
+    )
+    roots = []
+    for dependency in dependencies:
+        target = tickets.get(dependency)
+        if target is None or target.get("section") in ("## BLOCKED", "## TODO"):
+            roots.extend(_root_blockers(dependency, tickets, seen))
+    if roots:
+        return list(dict.fromkeys(roots))
+    klass = (
+        "WAIT_USER_DECISION" if _publication_staging_blocker(raw)
+        else re.split(r"[\s:\-]+", raw)[0] if raw else "UNKNOWN"
+    )
+    return [(ticket_id, klass, raw)]
+
+
 def resolve_root_blocker(
     ticket_id: str,
     tickets: dict,
     seen: set | None = None,
 ) -> tuple[str, str, str]:
-    """Resolve (root_ticket_id, blocker_class, blocker_raw_text) following dependency chains."""

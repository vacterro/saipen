-
-    m = re.match(r"^ACTIVE_DEPENDENCY\s*:\s*(T-\d+)", raw)
-    dep = m.group(1) if m else (blocked_on if blocked_on and blocked_on in tickets else None)
-    if dep and dep in tickets and tickets[dep].get("section") == "## BLOCKED":
-        return resolve_root_blocker(dep, tickets, seen)
-
-    tok = re.split(r"[\s:\-]+", raw)[0] if raw else ""
-    return (ticket_id, tok, raw)
+    """Compatibility view of the first root; project_blockers retains every root."""
+    return _root_blockers(ticket_id, tickets, seen)[0]
+
+
+def project_blockers(tickets: dict) -> dict:
+    """Read-only BOARD diagnostics. Recorded prose never grants recovery authority.
+
+    Groups are local to this BOARD/project. Publication aliases describe the
+    same shared index obstruction; other roots keep their independent identity.
+    No filesystem probe, mutation, automatic unblocking or new verdict vocabulary.
+    """
+    groups: dict[str, dict] = {}
+    items: dict[str, dict] = {}
+    for tid, ticket in tickets.items():
+        if ticket.get("section") not in ("## BLOCKED", "## TODO"):
+            continue
+        roots = _root_blockers(tid, tickets)
+        if ticket.get("section") == "## TODO" and all(root[0] == tid for root in roots):
+            continue
+        identities = []
+        for root, klass, raw in roots:
+            staging = _publication_staging_blocker(raw)
+            identity = "release:shared-index" if staging else f"work:{root}"
+            identities.append(identity)
+            if identity not in groups:
+                command = (
+                    f"saipen ticket resolve-external {root}"
+                    if klass == "BLOCKED_EXTERNAL" else None
+                )
+                groups[identity] = {
+                    "shared_blocker_id": identity,
+                    "blocker_class": klass,
+                    "cause": "publication-staging" if staging else klass.lower(),
+                    "root_cause": raw or "No verified root-cause evidence is recorded",
+                    "owner": "tools/saipen_engine/release.py" if staging else (
+                        "tools/saipen_engine/external.py" if klass == "BLOCKED_EXTERNAL"
+                        else "tools/saipen_engine/board.py"
+                    ),
+                    "root_tickets": [],
+                    "dependent_tickets": [],
+                    "recovery_internally_authorized": False,
+                    "external_input_required": True,
+                    "read_only_work_may_proceed": True,
+                    "recovery_operation": {
+                        "command": command,
+                        "operator_action": (
+                            "Resolve foreign staged-batch ownership, or authorize a verified "
+                            "canonical isolated release; preserve the live index."
+                            if staging else "Supply the root owner's missing evidence or decision."
+                        ),
+                    },
+                    "resumption_preconditions": (
+                        ["Foreign staging ownership is resolved or canonical isolation is verified",
+                         "Live index and foreign staged entries remain protected",
+                         "Exact reviewed scope and current verification pass release preflight"]
+                        if staging else ["The root owner supplies verified evidence or authority",
+                                         "Canonical dependency and resumption gates pass"]
+                    ),
+                    "basis": "recorded-blocker; not a live recovery authorization",
+                }
+            group = groups[identity]
+            if root not in group["root_tickets"]:
+                group["root_tickets"].append(root)
+            if tid not in group["dependent_tickets"]:
+                group["dependent_tickets"].append(tid)
+        primary = groups[identities[0]]
+        items[tid] = {
+            **primary,
+            "ticket": tid,
+            "root_tickets": list(dict.fromkeys(root[0] for root in roots)),
+            "shared_blocker_ids": list(dict.fromkeys(identities)),
+            "needs": list(ticket.get("needs") or ()),
+        }
+    for group in groups.values():
+        group["dependent_tickets"] = [
+            tid for tid in group["dependent_tickets"] if tid not in group["root_tickets"]
+        ]
+    for item in items.values():
+        item["dependent_tickets"] = list(groups[item["shared_blocker_id"]]["dependent_tickets"])
+    return {"schema_version": 1, "groups": list(groups.values()), "items": items}
 
 

@@ -24,6 +25,46 @@
 PROTOCOL = ROOT / "saipen"
 GOLDEN = ROOT / "tests" / "protocol_semantic_golden.json"
 OWNER_RE = re.compile(r"<!-- RULE-OWNER: ([A-Z][A-Z0-9-]+) -->")
+
+
+class CommandReferenceTests(unittest.TestCase):
+    def reference(self, root):
+        owner = getattr(registry_owner, "command_reference_path", None)
+        self.assertIsNotNone(owner, "the conditional inventory has no machine-owned locator")
+        return owner(root)
+
+    def fixture(self, *, name="COMMANDS_REFERENCE.md", legacy=False):
+        temporary = tempfile.TemporaryDirectory(prefix="saipen-command-reference-")
+        self.addCleanup(temporary.cleanup)
+        root = Path(temporary.name)
+        data = load_registry(PROTOCOL)
+        data["commands"] = dict(data["commands"])
+        if legacy:
+            data["commands"].pop("reference_document", None)
+        else:
+            data["commands"]["reference_document"] = name
+        (root / "REGISTRY.json").write_text(json.dumps(data), encoding="utf-8")
+        (root / "COMMANDS.md").write_text("legacy inventory", encoding="utf-8")
+        return root
+
+    def test_inventory_location_is_registry_owned(self):
+        self.assertEqual(self.reference(PROTOCOL), PROTOCOL / "COMMANDS_REFERENCE.md")
+
+    def test_legacy_registry_keeps_original_inventory(self):
+        root = self.fixture(legacy=True)
+        self.assertEqual(self.reference(root), root / "COMMANDS.md")
+
+    def test_missing_declared_inventory_never_uses_legacy_prose(self):
+        root = self.fixture()
+        with self.assertRaises(registry_owner.RegistryError):
+            self.reference(root)
+
+    def test_unbounded_or_non_filename_inventory_refuses(self):
+        for name in ("../outside.md", "x/y.md", "x\\y.md", "/absolute.md", "C:drive.md", "", None):
+            with self.subTest(name=name):
+                root = self.fixture(name=name)
+                with self.assertRaises(registry_owner.RegistryError):
+                    self.reference(root)
 
 

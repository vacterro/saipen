+        if token in shortcuts:
+            expanded.extend(
+                twin + separator + suffix for twin in derive_cyrillic_twins([token])
+            )
+    return {
+        "arguments": tuple(tuple(row) for row in arguments),
+        "operator_inputs": tuple(dict.fromkeys(expanded)),
     }
 
 

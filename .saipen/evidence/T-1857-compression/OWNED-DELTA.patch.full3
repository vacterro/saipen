-from saipen_engine.registry import load_registry, require_mapping, require_string_list
+from saipen_engine.registry import command_reference_path, load_registry, require_mapping, require_string_list
 from saipen_engine.corpus import (
     EXPECTED_IDS,
     check_generated as _check_conformance_generated,
@@ -5918,6 +5918,14 @@
 # project, and a hard-coded `_tools_parent / "saipen"` finds nothing in a
 # flattened install -- which is how these checks would have gone vacuously red
 # in every injected home (T-1332).
+try:
+    _commands_reference_path = command_reference_path(home_path("COMMANDS.md").parent)
+    _commands_reference_text = _commands_reference_path.read_text(encoding="utf-8-sig")
+except (OSError, ValueError) as _reference_error:
+    _commands_reference_path = None
+    _commands_reference_text = ""
+    fail(f"Command reference unavailable: {_reference_error}")
+
 _future_owner_path = home_doc("FUTURE.md")
 if _future_owner_path is not None:
     from saipen_engine import future_gate as _fg
@@ -5961,12 +5969,12 @@
             f"FUTURE-OWNER: `saipen future {_verb}` mutates but is absent from "
             "saipen/COMMAND_EFFECTS.json -- an undeclared mutation is a rule with no effect class"
         )
-    _commands_text = home_doc("COMMANDS.md").read_text(encoding="utf-8-sig")
+    _commands_text = _commands_reference_text
     for _verb in sorted(_mutating):
         if f"`saipen future {_verb}" not in _commands_text:
             fail(
                 f"FUTURE-OWNER: `saipen future {_verb}` is implemented and declared but "
-                "never published in saipen/COMMANDS.md"
+                "never published in the registered command reference"
             )
     # 3. The idle ladder is published in BOTH owners and agrees in order: a gate
     #    that outranks a rung it is not actually compared against is a doc lie.
@@ -9302,6 +9310,11 @@
         # teaching a WAIT-at-DONE rule that had been superseded.
         (".saipen/KNOWLEDGE/*.md", "citation + required-field-count checks"),
     ]
+    if _commands_reference_path is not None:
+        COVERED.append((
+            _commands_reference_path.relative_to(_tools_parent).as_posix(),
+            "registered command inventory: effect/verb publication and registry shortcut parity",
+        ))
     # EXEMPT means "no rule-CONTENT check applies", never "nothing looks at it".
     # Citations are verified across every shipped document below, exempt or
     # not: a pointer at a section or file that no longer exists is wrong
@@ -10786,12 +10799,7 @@

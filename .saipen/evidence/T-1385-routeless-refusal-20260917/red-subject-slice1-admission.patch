+def canonical_write_route(root: Path) -> str:
+    """The one command to run INSTEAD of writing canonical state by hand.
+
+    T-1385. `PROTECTED_CANONICAL_NAMESPACE` used to state the rule -- direct
+    mutation is forbidden, use canonical commands -- and name none of them.
+    Measured live: that refusal is the one the field repeats, three times in a
+    single session against the same target with nothing changed between
+    attempts, because "use canonical commands" is advice and a blocked session
+    needs a move.
+
+    The guard cannot know WHICH canonical write the session meant, so it names
+    the one the project's own state makes next: with an active ticket in a
+    ticket-bearing phase, the checkpoint that records what just happened; with
+    no such ticket, the status read that says where the project actually is.
+    `<what happened>` stays a placeholder on purpose -- it is the one part the
+    receiver already knows and the guard never can.
+    """
+    from .state import parse_state_or_error
+
+    state, error = parse_state_or_error(
+        _read_text_bounded(root / ".saipen" / "STATE.md", _STATE_READ_LIMIT)
+    )
+    if error or not isinstance(state, dict):
+        # An unreadable checkpoint is exactly when a session must not be sent
+        # to write one. Diagnose first.
+        return "saipen status --json"
+    task = str(state.get("task") or "").strip()
+    phase = str(state.get("phase") or "").strip()
+    if re.fullmatch(r"T-\d+", task) and phase in phases.TICKET_BEARING_PHASES:
+        return f"saipen checkpoint RUN {task} '<what happened>'"
+    return "saipen status --json"
+
+

    def maintenance_binding_fields(
        root: Path | str, pivot_objective: str, *, goal_id: str | None = None
    ) -> dict:
        """The exact maintenance identity a `continuous_maintenance` grant binds.
    
        SRC-393 P0-2. The continuation binding used to be derived from the latest
        committed goal pivot alone, so a capsule for the operator's self-maintenance
        objective described whatever a historic test pivot said ("T-1599 (SRC-164):
        test1") and the apply path wrote that old goal's authority into STATE. This
        binds the grant to the registered PersistentGoal instead:
    
        * exactly ONE ACTIVE MAINTENANCE goal (ambiguous -> fail closed);
        * its canonical objective must EQUAL the current pivot objective (a test
          pivot can never stand in for the maintenance objective);
        * the goal must belong to this project;
        * the identity digest is returned so proposal, apply and `prove` agree.
    
        Raises ValueError -- fail closed -- on any mismatch, so a wrong goal, a
        stale source, an altered objective, a mismatched provider or a mismatched
        project never produces a capsule at all.
        """
        goals = active_maintenance_goals(root)
        if not goals:
            raise ValueError("no ACTIVE maintenance goal is registered in this project")
        if goal_id is not None:
            goals = [goal for goal in goals if goal.goal_id == goal_id]
            if not goals:
                raise ValueError(f"maintenance goal {goal_id!r} is not registered as ACTIVE")
        if len(goals) != 1:
            raise ValueError(
                "ambiguous maintenance objective: "
                f"{len(goals)} ACTIVE MAINTENANCE goals ({', '.join(g.goal_id for g in goals)})"
            )
        goal = goals[0]
        if _normalize_objective(goal.objective) != _normalize_objective(pivot_objective):

+#: T-7: ONE definition of FINAL coverage, shared by every projection.
+#:
+#: A disposition in `DISPOSITION` is not automatically a FINAL decision:
+#: `NEEDS_EXTERNAL_EVIDENCE` is an explicit PENDING decision -- IMPROVE.md
+#: section 15 requires missing external evidence to be "an explicit blocker,
+#: not a repeated actionable submit/complete instruction". It used to read as
+#: swept/PASS to `derive_status`/`verify_cycle`/`complete_cycle` (any closed-set
+#: string counted) while reading as blocked to `improve_retrospective._view`
+#: and `reconcile`, so one ledger answered two opposite questions. Coverage is
+#: now decided here only, so an externally blocked finding keeps refusing the
+#: cycle bar instead of freezing the cycle as COMPLETE.
+NON_FINAL_DISPOSITIONS = frozenset({"NEEDS_EXTERNAL_EVIDENCE"})
+
+
+def is_final_coverage(disposition: str) -> bool:
+    """Does this disposition CLOSE its finding for the cycle bar?"""
+    return disposition in DISPOSITION and disposition not in NON_FINAL_DISPOSITIONS
 
 _MISSING = object()
 

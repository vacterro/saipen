                reason=reason,
                detail=detail,
                ticket=ticket,
                effective_route=routed,
                raw_route=raw_route,
            )
    
        if reason == "queued-source":
            return _make_assessment(
                SOURCE_AVAILABLE,
                action=action,
                reason=reason,
                detail=detail,
                effective_route=routed,
                raw_route=raw_route,
            )
    
        if reason == "crew-converge":
            return _make_assessment(
                ACTIVE_WORK,
                action=action,
                reason=reason,
                detail=detail,
                effective_route=routed,
                raw_route=raw_route,
            )
    
        if reason == "audit-inbox" or action == "saipen audit ingest":
            return _make_assessment(
                AUDIT_AVAILABLE,
                action=action,
                reason=reason,
                detail=detail,
                ticket=ticket,
                effective_route=routed,
                raw_route=raw_route,
            )
    
        if reason in ("start", "start-user-explicit", "dependency-continuation") or (
            action and action.startswith("PHASE SCOUT")
        ):
            return _make_assessment(
                QUEUED_WORK,
                action=action,
                reason=reason,

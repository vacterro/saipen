"""T-2022 / SRC-392: protocol-home exception vs standing maintenance grant.

The operator's original protocol-home objective (SRC-249) asked that SAIPEN's
own protocolist not need repeated human continuation merely to keep working.
The implementation that answered it conflated TWO different authorities:

* a protocol-home identity, which permits exactly ONE documented exception --
  its own goal budget checkpoint clears on `cc` without an operator; and
* a separate, operator-approved, scope-bound standing maintenance grant, which
  is what actually permits autonomous discovery and admission of NEW
  self-maintenance work.

`replenishment.maintenance_authority` therefore reported a protocol-home run as
a plain unproven claim, and nothing told the operator which of the two was
missing or how to obtain the second one without hand-computing hashes.

These tests pin the fix. Each is red-before-green:

1. `maintenance_authority` must NOT report `authorized` for a protocol home
   (lineage alone is never mutation permission), and must name the distinction
   in `authority_kind`.
2. It must report `authorized` only when the standing grant is actually proven.
3. `goal_authority.propose_capsule` must derive the exact current-goal capsule
   from the canonical owner (`current_binding`), never a stale or invented one,
   and must refuse an out-of-set scope.
4. The WAIT must carry a deterministic evidence fingerprint whose inputs move
   only when real evidence changes.
"""

from __future__ import annotations

import sys
import tempfile
import unittest
from pathlib import Path
from unittest.mock import patch

TOOLS = Path(__file__).resolve().parent
if str(TOOLS) not in sys.path:
    sys.path.insert(0, str(TOOLS))

from saipen_engine import goal_authority, replenishment  # noqa: E402

PROTOCOL_HOME_STATE = {
    "execution_intent": "goal",
    "continuation_authority": "operator_required",
    "authority_source": "E-18977",
    "authority_until": "budget",
    "safety_valve_mode": "hard_wait",
}

CM_STATE = {
    "execution_intent": "goal",
    "continuation_authority": "operator_persistent",
    "authority_source": "SRC-304",
    "authority_until": "continuous_maintenance",
    "safety_valve_mode": "checkpoint",
    "goal_ingress": "goal-0123456789abcdef",
}


class ProtocolHomeIsNotMaintenanceGrant(unittest.TestCase):
    def test_protocol_home_is_never_authorized_mutation(self):
        """R001: lineage alone must not authorize new maintenance work."""
        with (
            patch.object(goal_authority, "continuous_maintenance_proven", return_value=False),
            patch.object(goal_authority, "protocol_home", return_value=True),
            patch.object(replenishment, "maintenance_blocker_fingerprint",
                         return_value={"digest": "x"}),
        ):
            result = replenishment.maintenance_authority(Path("/tmp/proj"))
        self.assertFalse(result["authorized"])
        self.assertEqual(result["authority_kind"], "protocol_home_checkpoint_only")
        self.assertNotIn("standing", result["authority_kind"])

    def test_non_home_unproven_reports_none(self):
        with (
            patch.object(goal_authority, "continuous_maintenance_proven", return_value=False),
            patch.object(goal_authority, "protocol_home", return_value=False),
            patch.object(replenishment, "maintenance_blocker_fingerprint",
                         return_value={"digest": "x"}),
        ):
            result = replenishment.maintenance_authority(Path("/tmp/proj"))
        self.assertFalse(result["authorized"])
        self.assertEqual(result["authority_kind"], "none")

    def test_proven_grant_is_authorized(self):
        """The one authority that permits admission of new work."""
        with (
            patch.object(goal_authority, "continuous_maintenance_proven", return_value=True),
            patch.object(replenishment, "maintenance_blocker_fingerprint",
                         return_value={"digest": "x"}),
        ):
            result = replenishment.maintenance_authority(Path("/tmp/proj"))
        self.assertTrue(result["authorized"])
        self.assertEqual(result["authority_kind"], "standing_maintenance_grant")


class ProposeCapsule(unittest.TestCase):
    def test_out_of_set_scope_refused(self):
        result = goal_authority.propose_capsule(Path("/tmp/p"), {}, [], until="forever")
        self.assertFalse(result["ok"])
        self.assertEqual(result["code"], "SCOPE_INVALID")

    def test_derives_from_canonical_binding(self):
        """Never invent: the proposal IS what current_binding returns."""
        canonical = {
            "kind": "saipen-goal-continuation",
            "project_lineage": "lineage-abc",
            "goal_ingress": "goal-0123456789abcdef",
        }
        with patch.object(goal_authority, "current_binding", return_value=canonical) as m:
            result = goal_authority.propose_capsule(
                Path("/tmp/p"), CM_STATE, [], until="continuous_maintenance"
            )
        self.assertTrue(result["ok"])
        self.assertEqual(result["capsule"], canonical)
        self.assertTrue(m.called)

    def test_unavailable_binding_is_reported_not_faked(self):
        with patch.object(goal_authority, "current_binding",
                          side_effect=ValueError("no committed goal")):
            result = goal_authority.propose_capsule(Path("/tmp/p"), {}, [])
        self.assertFalse(result["ok"])
        self.assertEqual(result["code"], "PROPOSAL_UNAVAILABLE")

    def test_proposal_is_not_authority(self):
        """Proposing must never mutate: it returns bytes, it does not authorize."""
        src = Path(goal_authority.__file__).read_text(encoding="utf-8")
        body = src.split("def propose_capsule", 1)[1].split("\ndef ", 1)[0]
        for forbidden in ("write_bytes", "write_text", "authorize_goal_continuation"):
            self.assertNotIn(forbidden, body)


class BlockerFingerprint(unittest.TestCase):
    def test_fingerprint_is_deterministic_and_bundles_required_inputs(self):
        fp = replenishment.maintenance_blocker_fingerprint(
            Path(".").resolve(), authority_kind="protocol_home_checkpoint_only"
        )
        for key in (
            "code", "digest", "project", "project_lineage", "authority_source",
            "broker_instance", "source_fingerprint", "wake_condition",
        ):
            self.assertIn(key, fp, key)
        again = replenishment.maintenance_blocker_fingerprint(
            Path(".").resolve(), authority_kind="protocol_home_checkpoint_only"
        )
        self.assertEqual(fp["digest"], again["digest"])

    def test_fingerprint_moves_when_authority_kind_changes(self):
        a = replenishment.maintenance_blocker_fingerprint(
            Path(".").resolve(), authority_kind="none"
        )
        b = replenishment.maintenance_blocker_fingerprint(
            Path(".").resolve(), authority_kind="standing_maintenance_grant"
        )
        self.assertNotEqual(a["digest"], b["digest"])


class WaitCarriesFingerprint(unittest.TestCase):
    """R014: the WAIT must expose its evidence digest wherever it is emitted."""

    def test_router_gate_propagates_blocker_fingerprint(self):
        from saipen_engine import router  # noqa: E402

        with tempfile.TemporaryDirectory() as tmp:
            route = {
                "ok": True,
                "action": "saipen continue",
                "reason": "maintain",
                "stop_reason": "NO_ADMISSIBLE_WORK",
                "active_goals": [{"authorization_scope": "MAINTENANCE"}],
            }
            result = router.continuous_maintenance_gate(tmp, route)
        self.assertIsNotNone(result)
        self.assertEqual(result["reason"], "goal-waiting-authority")
        self.assertIn("blocker_fingerprint", result)
        self.assertIn("digest", result["blocker_fingerprint"])

    def test_automation_block_copies_fingerprint(self):
        """The second carrier of the same WAIT must not drop the digest."""
        from saipen_engine import automation

        src = Path(automation.__file__).read_text(encoding="utf-8")
        seg = src.split('reason_code == "goal-waiting-authority"', 1)[1].split(
            "return block", 1
        )[0]
        self.assertIn("blocker_fingerprint", seg)

    def test_route_payload_forwards_fingerprint(self):
        """The third carrier: `continue`'s public projection must forward it."""
        cli = Path(__file__).resolve().parent / "saipen.py"
        src = cli.read_text(encoding="utf-8")
        seg = src.split('routed.get("reason") == "goal-waiting-authority"', 1)[1].split(
            "if route.get", 1
        )[0]
        self.assertIn("blocker_fingerprint", seg)
        self.assertIn("canonical_next_command", seg)


class CoverageAdmitsEvidenceFitnessFields(unittest.TestCase):
    """A clause that DECLARES a live evidence class must still pass the gate.

    The coverage validator previously demanded an exact seven-key set, but
    `source disp --evidence-class` persists `actual_evidence_class` and the
    fitness reader consumes four optional fields. A live-acceptance clause
    could therefore be dispositioned but never pass a boundary gate: the
    writer's own field turned the ledger into CONTRACT_DRIFT (SRC-392:R001).
    """

    def _ledger(self, extra):
        entry = {
            "class": "requirement",
            "text": "live host acceptance",
            "actionable": True,
            "disposition": "VERIFIED",
            "work": "T-2022",
            "evidence": "E-1",
            "verification": "probe -> PASS",
        }
        entry.update(extra)
        contract = {"clauses": {"SRC-999:R001": {
            "class": "requirement", "text": "live host acceptance", "actionable": True}}}
        return contract, {"requirements": {"SRC-999:R001": entry}}

    def test_optional_evidence_fields_are_admitted(self):
        from saipen_engine import intake  # noqa: E402

        for extra in (
            {"actual_evidence_class": "INSTALLED_RUNTIME"},
            {"environment_evidence": {"kind": "probe"}},
            {"required_evidence_class": "LIVE_END_TO_END"},
            {"evidence_payload": {"rows": []}},
        ):
            contract, coverage = self._ledger(extra)
            intake._validate_contract_coverage("SRC-999", contract, coverage)

    def test_missing_mandatory_field_is_still_refused(self):
        from saipen_engine import intake  # noqa: E402

        contract = {"clauses": {"SRC-999:R001": {
            "class": "requirement", "text": "t", "actionable": True}}}
        coverage = {"requirements": {"SRC-999:R001": {
            "class": "requirement", "text": "t", "actionable": True,
            "disposition": "VERIFIED", "evidence": "E-1",
        }}}  # no work, no verification
        with self.assertRaises(ValueError):
            intake._validate_contract_coverage("SRC-999", contract, coverage)

    def test_unknown_field_is_still_refused(self):
        from saipen_engine import intake  # noqa: E402

        contract, coverage = self._ledger({"bogus_field": 1})
        with self.assertRaises(ValueError):
            intake._validate_contract_coverage("SRC-999", contract, coverage)


if __name__ == "__main__":
    unittest.main()

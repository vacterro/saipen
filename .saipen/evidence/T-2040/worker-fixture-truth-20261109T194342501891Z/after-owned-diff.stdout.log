+    def assert_incomplete_discovery(self, result: dict) -> None:
+        """Scripted DONE is not a checked twelve-source exhaustion proof."""
+        self.assertEqual(result["stop"], supervisor.INCOMPLETE_DISCOVERY, result)
+        self.assertFalse(result["ok"], result)
+        self.assertIsNone(result["operator_action"], result)
+        verdict = supervisor.decide(self.project)
+        self.assertEqual(verdict["verdict"], supervisor.INCOMPLETE_DISCOVERY, verdict)
+        self.assertFalse(verdict["requires_human"], verdict)
+        assessment = verdict["observation"]["continuation_assessment"]
+        self.assertFalse(assessment["quiescent"], assessment)
+        route = assessment["effective_route"]
+        self.assertEqual(route["terminal_classification"], supervisor.INCOMPLETE_DISCOVERY, route)
+        certificate = route["work_exhaustion"]
+        self.assertEqual(certificate["schema_version"], 2, certificate)
+        self.assertEqual(len(certificate["sources"]), 12, certificate)
+        self.assertTrue(any(row["checked"] is False for row in certificate["sources"]), certificate)
+        self.assertFalse(certificate["all_checked"], certificate)
+        self.assertFalse(certificate["exhausted"], certificate)
+
     def state_text(self) -> str:

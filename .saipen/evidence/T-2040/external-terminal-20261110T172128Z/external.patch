+def _archived_done_ticket(root: Path, work: str) -> dict | None:
+    """Recover one exact DONE row only from intact committed scrub authority."""
+    from .board import parse_board
+    from .board_scrub import SCRUB_EVIDENCE_ROOT
+    from .journal import hash_bytes, owned_target_path, semantic_receipt_snapshot
+    from .paths import prove_owned_dir_chain, prove_owned_regular, read_bound_regular_bytes
+
+    snapshot = semantic_receipt_snapshot(root)
+    if snapshot.errors:
+        raise ValueError("external terminal journal is corrupt: " + "; ".join(snapshot.errors[:3]))
+    found = None
+    for record in snapshot.records:
+        if record.get("operation") != "scrub_board":
+            continue
+        if record.get("status") == "ABORTED":
+            continue
+        if record.get("status") != "COMMITTED":
+            raise ValueError("external terminal scrub is not COMMITTED")
+        relative = f"{SCRUB_EVIDENCE_ROOT}/{record['op_id']}/BOARD.md"
+        targets = [item for item in record["targets"] if item.get("path") == relative]
+        if (
+            len(targets) != 1
+            or not targets[0].get("applied")
+            or targets[0].get("action") != "write"
+        ):
+            raise ValueError("external terminal scrub has no exact applied archive target")
+        owned_target_path(root, relative, kind="external terminal archive")
+        path = root / relative
+        prove_owned_dir_chain(path.parent, ownership_root=root, kind="external terminal archive")
+        info = prove_owned_regular(path, kind="external terminal archive")
+        raw = read_bound_regular_bytes(path, info, max_bytes=32 * 1024 * 1024)
+        if hash_bytes(raw) != targets[0].get("after_hash"):
+            raise ValueError("external terminal archive differs from its committed target")
+        text = raw.decode("utf-8")
+        if any(line.strip() and not line.startswith("- [x] ") for line in text.splitlines()):
+            raise ValueError("external terminal archive contains non-DONE physical records")
+        archived = parse_board("## DOING\n## TODO\n## DONE\n" + text + "\n## BLOCKED\n")
+        if archived["errors"]:
+            raise ValueError("external terminal archive is malformed: " + archived["errors"][0])
+        candidate = archived["tickets"].get(work)
+        if candidate is not None:
+            if found is not None and found["raw"] != candidate["raw"]:
+                raise ValueError("external terminal archives contain conflicting Work rows")
+            found = candidate
+    return found
+

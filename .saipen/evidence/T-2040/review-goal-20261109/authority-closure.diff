+#: The scope label a PersistentGoal must carry to be a maintenance objective.
+MAINTENANCE_GOAL_SCOPE = "MAINTENANCE"
+
+#: What a standing maintenance grant NEVER permits, signed by the operator so
+#: the capsule cannot be read as wider than it is (SRC-393 P0-2). Releasing,
+#: publishing, retiring Work and touching foreign repos each keep their own
+#: separate, scoped authorization.
+MAINTENANCE_EXCLUDED_ACTIONS = (
+    "release",
+    "publication",
+    "git_push",
+    "retirement",
+    "foreign_project_mutation",
+    "destructive_op",
+)
+
+#: The PersistentGoal fields that define its identity for a grant binding. Any
+#: change to one of them (altered objective, swapped provider, renamed goal)
+#: changes the digest and fails the granted capsule closed.
+_MAINTENANCE_IDENTITY_FIELDS = (
+    "goal_id",
+    "project_id",
+    "objective",
+    "authorization_scope",
+    "evidence_provider",
+)
+
+#: SRC-395 P0: the security-relevant POLICY fields a standing grant is also
+#: bound to. These are exactly the parameters that decide which Work may be
+#: admitted and when the goal counts as done -- the success criteria (coverage
+#: target, required capture sha, required patch identity, the independent-
+#: verification requirement), the admission policy (provider-relevant
+#: admission rules) and the evidence/backlog source. Mutable OBSERVATION state
+#: (`current_progress`, `last_evaluation`, `last_successful_work`,
+#: `last_discovery`, `blockers`, `resume_metadata`, `current_status`,
+#: `completion_evidence`, timestamps) is deliberately excluded: recording
+#: harmless progress must never invalidate a grant. `title` and
+#: `target_progress` are excluded too -- no provider or admission path reads
+#: them, so covering them could only invalidate authority, never protect it.
+_MAINTENANCE_POLICY_FIELDS = (
+    "success_criteria",
+    "admission_policy",
+    "research_or_work_backlog_source",
+)
+
+#: Version of the policy-identity digest. Bumped whenever the covered field set
+#: changes, so a digest minted under an older version can never equal a
+#: recomputed one and a legacy capsule or already-committed grant fails closed
+#: (prove reports no committed grant) instead of silently grandfathering the
+#: wider policy it was signed for.
+MAINTENANCE_POLICY_VERSION = 2
+
+
+class MaintenanceObjectiveMismatch(ValueError):
+    """The current goal pivot does not describe the registered maintenance goal.
+
+    Carries the exact canonical objective so the approval surface can hand the
+    operator the one command that resolves it, instead of asking them to guess
+    the goal's identity (SRC-395).
+    """
+
+    def __init__(self, goal_id: str, objective: str, feedback: str) -> None:
+        super().__init__(feedback)
+        self.goal_id = goal_id
+        self.objective = objective
+
+
+def _normalize_objective(text: object) -> str:
+    return " ".join(str(text or "").split())
+
+
+def maintenance_goal_digest(goal) -> str:
+    """The canonical, versioned digest of a PersistentGoal's granted policy.
+
+    Recomputed identically at proposal, at grant commit, at every `prove` and
+    before an admission write, so a capsule that names one identity AND policy
+    can never be applied to -- or keep authorizing -- another. Never a digest of
+    the FILE (indentation, key order and backup churn must not change the
+    authority): only the identity fields and the security-relevant policy
+    fields named above, under the current `MAINTENANCE_POLICY_VERSION`.
+    """
+    payload = {
+        "policy_version": MAINTENANCE_POLICY_VERSION,
+        **{
+            key: goal.to_dict().get(key)
+            for key in (*_MAINTENANCE_IDENTITY_FIELDS, *_MAINTENANCE_POLICY_FIELDS)
+        },
+    }
+    material = json.dumps(payload, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+    return "sha256:" + hashlib.sha256(material.encode("utf-8")).hexdigest()
+
+
+def active_maintenance_goals(root: Path | str) -> list:
+    """Every ACTIVE, unpaused MAINTENANCE PersistentGoal in this project."""
+    from .persistent_goal import STATUS_ACTIVE, list_goals
+
+    selected = []
+    for goal in list_goals(root):
+        if goal.paused or goal.current_status != STATUS_ACTIVE:
+            continue
+        if _normalize_objective(goal.authorization_scope).upper() != MAINTENANCE_GOAL_SCOPE:
+            continue
+        selected.append(goal)
+    return sorted(selected, key=lambda goal: goal.goal_id)
+
+
+def is_protected_goal_request(root: Path | str, text: str) -> dict | None:
+    """Classify whether a user request text targets or mimics a protected operator goal.
+
+    A model may propose engineering work, but may NOT create or renew operator-owned
+    maintenance goals by imitating their goal-entry text without operator carrier.
+    """
+    clean_text = _normalize_objective(text)
+    if not clean_text:
+        return None
+    for goal in active_maintenance_goals(root):
+        goal_obj = _normalize_objective(goal.objective)
+        if clean_text == goal_obj or clean_text.lower() == goal_obj.lower():
+            return {
+                "protected": True,
+                "goal_id": goal.goal_id,
+                "scope": goal.authorization_scope,
+                "objective": goal.objective,
+                "reason": "exact match for registered maintenance goal objective",
+            }
+        if "authorize the current self-maintenance" in clean_text.lower():
+            return {
+                "protected": True,
+                "goal_id": goal.goal_id,
+                "scope": goal.authorization_scope,
+                "objective": goal.objective,
+                "reason": "requests self-maintenance goal authorization",
+            }
+        if len(clean_text) > 30 and (
+            clean_text.lower() in goal_obj.lower() or goal_obj.lower() in clean_text.lower()
+        ):
+            return {
+                "protected": True,
+                "goal_id": goal.goal_id,
+                "scope": goal.authorization_scope,
+                "objective": goal.objective,
+                "reason": "paraphrases registered maintenance goal objective",
+            }
+    return None
+
+
+def protected_goal_blocker(root: Path | str, protected: dict, tickets: dict) -> str | None:
+    """Reuse exact blocked Source membership, or the same classifier hit.
+
+    Maintenance prose never links Work by itself. A BLOCKED ticket qualifies
+    when (a) it carries the exact blocked Source membership whose request
+    clause equals the protected objective, or (b) the ONE protected-goal
+    classifier already reads its description as a request to authorize the
+    SAME registered goal. Both are mechanical; neither compares free prose.
+    """
+    from . import intake
+
+    index = intake._read_index(Path(root)).get("active", {})
+    objective = _normalize_objective(protected["objective"])
+    matches = []
+    for ticket_id, ticket in tickets.items():
+        fields = ticket.get("fields") or {}
+        blocker = str(fields.get("blocker") or "").partition(" -- ")[0].strip()
+        if ticket.get("section") != "## BLOCKED" or blocker not in (
+            "CONTINUATION_AUTHORITY_UNPROVEN", "BLOCKED_AUTHORITY_GATE",
+        ):
+            continue
+        receipts = str(fields.get("source_receipts") or "").split(",")
+        for receipt in (value.strip() for value in receipts if value.strip()):
+            found = intake.read_body(root, receipt)
+            meta = found.get("meta") or {}
+            if (not found.get("ok") or found.get("location") != "active"
+                    or meta.get("source_kind") not in intake.REQUEST_KINDS
+                    or not intake.is_linked_to(meta, ticket_id)
+                    or not intake.is_linked_to(index.get(receipt), ticket_id)):
+                continue
+            body = found.get("body") or ""
+            request = intake.request_clause_text(body) or body
+            if _normalize_objective(request) == objective:
+                matches.append(ticket_id)
+                break
+    if matches:
+        return matches[0] if len(matches) == 1 else None
+    # (b) The same protected-goal classifier on an existing BLOCKED row: the
+    # authorization request already exists, so this request links to it and
+    # never creates duplicate Work.
+    for ticket_id, ticket in tickets.items():
+        if ticket.get("section") != "## BLOCKED":
+            continue
+        description = str(ticket.get("description") or "")
+        if not description:
+            continue
+        classified = is_protected_goal_request(root, description)
+        if classified is not None and classified.get("goal_id") == protected.get("goal_id"):
+            matches.append(ticket_id)
+    return matches[0] if len(matches) == 1 else None
+
+
+def maintenance_binding_fields(
+    root: Path | str, pivot_objective: str, *, goal_id: str | None = None
+) -> dict:
+    """The exact maintenance identity a `continuous_maintenance` grant binds.
+
+    SRC-393 P0-2. The continuation binding used to be derived from the latest
+    committed goal pivot alone, so a capsule for the operator's self-maintenance
+    objective described whatever a historic test pivot said ("T-1599 (SRC-164):
+    test1") and the apply path wrote that old goal's authority into STATE. This
+    binds the grant to the registered PersistentGoal instead:
+
+    * exactly ONE ACTIVE MAINTENANCE goal (ambiguous -> fail closed);
+    * its canonical objective must EQUAL the current pivot objective (a test
+      pivot can never stand in for the maintenance objective);
+    * the goal must belong to this project;
+    * the identity digest is returned so proposal, apply and `prove` agree.
+
+    Raises ValueError -- fail closed -- on any mismatch, so a wrong goal, a
+    stale source, an altered objective, a mismatched provider or a mismatched
+    project never produces a capsule at all.
+    """
+    goals = active_maintenance_goals(root)
+    if not goals:
+        raise ValueError("no ACTIVE maintenance goal is registered in this project")
+    if goal_id is not None:
+        goals = [goal for goal in goals if goal.goal_id == goal_id]
+        if not goals:
+            raise ValueError(f"maintenance goal {goal_id!r} is not registered as ACTIVE")
+    if len(goals) != 1:
+        raise ValueError(
+            "ambiguous maintenance objective: "
+            f"{len(goals)} ACTIVE MAINTENANCE goals ({', '.join(g.goal_id for g in goals)})"
+        )
+    goal = goals[0]
+    if _normalize_objective(goal.objective) != _normalize_objective(pivot_objective):
+        # SRC-395: the operator must not have to guess the goal identity. The
+        # refusal carries the exact canonical objective so the approval surface
+        # can print the one entry command that resolves it.
+        raise MaintenanceObjectiveMismatch(
+            goal.goal_id,
+            _normalize_objective(goal.objective),
+            "the current goal pivot does not describe the registered maintenance goal "
+            f"{goal.goal_id!r}; re-enter the goal with its exact objective before approving",
+        )
+    if (
+        _normalize_objective(goal.project_id)
+        and _normalize_objective(goal.project_id) != _normalize_objective(Path(root).name)
+    ):
+        raise ValueError(
+            f"maintenance goal {goal.goal_id!r} belongs to another project ({goal.project_id!r})"
+        )
+    return {
+        "maintenance_goal_id": goal.goal_id,
+        "maintenance_goal_digest": maintenance_goal_digest(goal),
+        "maintenance_scope": _normalize_objective(goal.authorization_scope).upper(),
+        "maintenance_provider": goal.evidence_provider,
+        "excluded_actions": list(MAINTENANCE_EXCLUDED_ACTIONS),
+    }
+
+
+def maintenance_policy_drift(
+    root: Path | str, goal_id: str, expected_digest: str | None
+) -> list[str]:
+    """SRC-395 P0 (TOCTOU): did the granted goal's policy move since admission?
+
+    The authority gate proves the grant against the LIVE goal file, but that
+    proof and the ticket write are separate steps. This re-reads the goal from
+    disk and compares its canonical digest against the one the admission
+    decision was made on, so a policy edit landing in that window refuses the
+    write instead of slipping under an already-green proof.
+
+    `expected_digest` is None only when the caller had no granted policy to bind
+    (no standing maintenance grant); that is drift-free by construction, and a
+    policy check is meaningless for an unauthorized admission anyway.
+    """
+    from .persistent_goal import get_goal
+
+    if not expected_digest:
+        return []
+    goal = get_goal(Path(root), goal_id)
+    if goal is None:
+        return [f"maintenance goal {goal_id!r} disappeared after the admission decision"]
+    live = maintenance_goal_digest(goal)
+    if live != expected_digest:
+        return [
+            f"maintenance goal {goal_id!r} policy changed between evaluation and "
+            f"admission ({expected_digest} -> {live}); the standing grant no longer "
+            "covers this policy and fresh operator approval is required"
+        ]
+    return []
+

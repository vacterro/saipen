+def propose_capsule(
+    root: Path | str, state: dict, history_events, *, until: str = "continuous_maintenance"
+) -> dict:
+    """The exact capsule for the CURRENT goal, so no operator computes hashes.
+
+    SRC-392 second finding: the operator was expected to hand-calculate the
+    pivot event hash, goal ingress, project lineage, grant fields and broker
+    binding before the approval surface could even be offered. Every one of
+    those values is already derivable by the canonical owner --
+    `current_binding` -- which is the SAME function the broker and `prove`
+    consume. This wraps it and nothing else: it invents no authority, mints no
+    capsule for a goal that has no committed pivot, and reads the scope the
+    caller names (never a convenient default).
+
+    Returns `{"ok": True, "capsule": {...}, "scope": ..., "summary": ...}` or
+    `{"ok": False, "code": ..., "detail": ...}`. The capsule is the exact JSON
+    the operator must sign and hand back through
+    `saipen goal authorize --file`; the summary is the human description the
+    approval surface shows.
+    """
+    root = Path(root).resolve()
+    if until not in GRANT_SCOPES:
+        return {
+            "ok": False, "code": "SCOPE_INVALID", "detail": f"{until!r} is outside {GRANT_SCOPES}"
+        }
+    try:
+        capsule = current_binding(root, state, history_events, {}, until=until)
+    except MaintenanceObjectiveMismatch as exc:
+        # SRC-395: a refusal alone is not a working approval path. The operator
+        # is handed the exact goal identity and the one command that re-enters
+        # the goal with it, so nothing has to be computed or guessed by hand.
+        return {
+            "ok": False,

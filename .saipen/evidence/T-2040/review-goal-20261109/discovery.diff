+def _projection_envelope_problem(
+    *, queued_source=None, pending_append=None, audit_inbox=None, future_gate=None,
+) -> str | None:
+    """A truthy but malformed projection is invalid input, never evidence.
+
+    The router consumes these read-only projections from outside owners; a
+    wrong type must fail the route instead of being iterated or indexed.
+    """
+    def _action_problem(name: str, projection) -> str | None:
+        if projection is None:
+            return None
+        if not isinstance(projection, dict):
+            return f"{name}: projection must be an object"
+        if "action" in projection and not (
+            isinstance(projection["action"], str) and projection["action"].strip()
+        ):
+            return f"{name}: action must be a nonempty string"
+        return None
+
+    for name, projection in (("queued_source", queued_source), ("pending_append", pending_append)):
+        problem = _action_problem(name, projection)
+        if problem:
+            return problem
+    if audit_inbox is not None:
+        if not isinstance(audit_inbox, dict):
+            return "audit_inbox: projection must be an object"
+        # `audit_inbox.projection` emits the layer collections as LISTS
+        # (`pending`/`closed_pending_delete` of layer keys, `invalid` of
+        # identifier summaries, `residue` of relative paths) and only the
+        # `*_only`/`binding_corrupt` verdicts as booleans. Typing the lists as
+        # booleans rejects the honest live projection ("invalid must be a
+        # boolean") and bricks `saipen continue`.
+        for name in ("pending", "closed_pending_delete", "invalid", "residue"):
+            value = audit_inbox.get(name)
+            if value is not None and not isinstance(value, (list, tuple)):
+                return f"audit_inbox: {name} must be a list"
+        for name in ("unresolved_audit_count", "residue_count"):
+            count = audit_inbox.get(name)
+            if count is not None and not (type(count) is int and count >= 0):
+                return f"audit_inbox: {name} must be a nonnegative integer"
+        for flag in ("unworkable_active_only", "binding_corrupt",
+                     "invalid_only", "residue_only"):
+            if flag in audit_inbox and type(audit_inbox[flag]) is not bool:
+                return f"audit_inbox: {flag} must be a boolean"
+    if future_gate is not None:
+        if not isinstance(future_gate, dict):
+            return "future_gate: projection must be an object"
+        for key in ("eligible", "refinable"):
+            value = future_gate.get(key)
+            if value is not None and (
+                not isinstance(value, (list, tuple))
+                or any(not isinstance(item, str) or not item for item in value)
+            ):
+                return f"future_gate: {key} must be a list of ticket ids"
+        if "refresh_required" in future_gate and type(future_gate["refresh_required"]) is not bool:
+            return "future_gate: refresh_required must be a boolean"
+    return None
 
 

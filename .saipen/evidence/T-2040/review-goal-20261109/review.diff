+def _package_review_bindings(package: OutboxPackage, collect_op: str) -> dict[str, str]:
+    return {"package_identity": package_identity(package), "package": package.package_id,
+            **{key: package.fields.get(key, "") for key in
+               ("producer", "source_head", "source_tree_fingerprint", "role_revision")},

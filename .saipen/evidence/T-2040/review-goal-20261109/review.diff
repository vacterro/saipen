+def _checkpoint_proves(event: dict, records: tuple[dict, ...]) -> bool:
+    """The committed owner must bind this exact ticket/text, not merely an op tag."""
+    from .journal import op_id_provenance
+    from .plan import semantic_payload_hash
+
+    op = event.get("op_id")
+    matches = [record for record in records if record.get("op_id") == op]
+    if op_id_provenance(op) != "canonical" or len(matches) != 1:
+        return False
+    record = matches[0]
+    return (record.get("operation") == "checkpoint" and record.get("status") == "COMMITTED"
+            and record.get("agent") == event.get("agent")
+            and {".saipen/LOG.md", ".saipen/STATE.md"}.issubset(
+                target.get("path") for target in record.get("targets", ())
+                if target.get("applied") is True)
+            and record.get("semantic_payload_hash") == semantic_payload_hash({
+                "operation": "checkpoint", "taxonomy": event.get("taxonomy"),
+                "ticket": event.get("ticket"), "description": event.get("text")}))
+
+
+def _verify_boundary_proves(event: dict, records: tuple[dict, ...]) -> bool:
+    from .journal import op_id_provenance
+    from .plan import semantic_payload_hash
+
+    if _checkpoint_proves(event, records):
+        return True
+    matches = [record for record in records if record.get("op_id") == event.get("op_id")]
+    if op_id_provenance(event.get("op_id")) != "canonical" or len(matches) != 1:
+        return False
+    record = matches[0]
+    return (record.get("operation") == "transition" and record.get("status") == "COMMITTED"
+            and record.get("agent") == event.get("agent")
+            and {".saipen/LOG.md", ".saipen/STATE.md"}.issubset(
+                target.get("path") for target in record.get("targets", ())
+                if target.get("applied") is True)
+            and any(record.get("semantic_payload_hash") == semantic_payload_hash({
+                "operation": "transition", "destination": "VERIFY", "from_phase": phase,
+                "ticket": event.get("ticket"), "agent": event.get("agent")})
+                    for phase in ("SCOUT", "BUILD", "VERIFY", "REVIEW", "SHIP")))
+

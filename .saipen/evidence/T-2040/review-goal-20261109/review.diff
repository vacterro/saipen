+def _independent_core_review(
+    root: Path, package: OutboxPackage, ticket: str, collect_op: str,
+    records: tuple[dict, ...], history=None,
+) -> tuple[dict | None, str]:
+    """Ticket-local review of an exact generation backed by native executed evidence.
+
+    ponytail: focused-unit evidence only; add another native validator when a
+    collected review requires a different executed family. No prose fallback.
+    """
+    from .focused_unit import MARKER, RECORD_DIR_REL, record_problem
+    from .log import (_claims_failure, _is_regression_evidence, _is_verify_boundary,
+                      read_history_snapshot, snapshot_contract_errors)
+    from .paths import prove_owned_dir_chain, prove_owned_regular, read_bound_regular_bytes
+
+    if history is None:
+        history = read_history_snapshot(root)
+    if problems := snapshot_contract_errors(history):
+        return None, "invalid review history: " + "; ".join(problems[:3])
+    # The collect authority is exactly ONE COMMITTED `sub_collect` receipt.
+    # A RESOLVED/accept_live record still deduplicates intake, but it is not
+    # committed review authority; a duplicated op id is ambiguous authority
+    # (T-2040).
+    collect_records = [record for record in records if record.get("op_id") == collect_op]
+    if len(collect_records) != 1:
+        return None, "missing or duplicate collect receipt"
+    collect_record = collect_records[0]
+    if (collect_record.get("operation") != "sub_collect"
+            or collect_record.get("status") != "COMMITTED"):
+        return None, "collect receipt is not a COMMITTED sub_collect operation"
+    # A collect receipt that names hypotheses must prove THIS generation in
+    # every one of them: a contradictory or duplicate block is not exact
+    # evidence, and the identity list alone may not launder it (T-2040).
+    problem = _collect_hypotheses_problem(
+        (collect_record.get("receipt_metadata") or {}), package
+    )
+    if problem:
+        return None, problem
+    _collected, links = _collect_links(root, records)
+    expected = _package_review_bindings(package, collect_op)
+    if links.get(expected["package_identity"]) != (ticket, collect_op):
+        return None, "missing or ambiguous exact collect linkage"
+    own = [event for event in history.events
+           if event.get("ticket") == ticket and event.get("taxonomy") == "RUN"]
+    intake = [event for event in own if event.get("op_id") == collect_op]
+    if len(intake) != 1:
+        return None, "missing unique ticket-local collect event"
+    intake_bindings = _REVIEW_BINDINGS.findall(intake[0].get("text", ""))
+    if (len(intake_bindings) != 6
+            or dict(intake_bindings) != {key: value for key, value in expected.items() if key != "collect_op"}):
+        return None, "collect event does not bind the full package generation"
+    later = [event for event in own if event["event"] > intake[0]["event"]]
+    boundaries = [event for event in later if _is_verify_boundary(event)]
+    if not boundaries or not _verify_boundary_proves(boundaries[-1], records):
+        return None, "no committed ticket-local VERIFY boundary"
+    cycle = [event for event in later if event["event"] > boundaries[-1]["event"]]
+    reviews = [event for event in cycle if event.get("text", "").startswith("review ->")]
+    if not reviews:
+        return None, "no ticket-local independent Core review"
+    review = reviews[-1]
+    if review.get("agent") == expected["producer"]:
+        return None, "package producer cannot author its own independent Core review"
+    text = review.get("text", "")
+    pairs = _REVIEW_BINDINGS.findall(text)
+    citations = _REVIEW_RECORD.findall(text)
+    if (not text.startswith("review -> PASS conf: high -- ")
+            or len(pairs) != len(expected) or dict(pairs) != expected
+            or len(citations) != 1 or not _checkpoint_proves(review, records)):
+        return None, "latest independent Core review lacks exact committed passing proof"
+    citation = citations[0]
+    if any(event["event"] > review["event"] and _checkpoint_proves(event, records)
+           and not _is_regression_evidence(event.get("text", ""))
+           and _claims_failure(event.get("text", "")) for event in cycle):
+        return None, "later ticket-local verification failed"
+    executed = [event for event in cycle if event.get("text", "").startswith(MARKER + " ")]
+    if (not executed or executed[-1]["event"] >= review["event"]
+            or not executed[-1].get("text", "").startswith(MARKER + " PASS conf: high ")
+            or _REVIEW_RECORD.findall(executed[-1]["text"]) != [citation]
+            or not _checkpoint_proves(executed[-1], records)):
+        return None, "no exact committed executed-evidence citation for this review"
+    if executed[-1].get("agent") == expected["producer"]:
+        return None, "package producer cannot supply its own executed evidence"
+    relative, digest = citation
+    if not relative.startswith(RECORD_DIR_REL + "/") or "\\" in relative or ":" in relative \
+            or any(part in ("", ".", "..") for part in relative.split("/")):
+        return None, "review record is outside owned focused evidence"
+    path = root / relative
+    try:
+        prove_owned_dir_chain(path.parent, kind="Core review evidence", ownership_root=root)
+        info = prove_owned_regular(path, kind="Core review evidence")
+        raw = read_bound_regular_bytes(path, info, max_bytes=8 * 1024 * 1024)
+        if hashlib.sha256(raw).hexdigest() != digest:
+            return None, "review record digest mismatch"
+        record = json.loads(raw)
+        problem = record_problem(root, record)
+        if problem:
+            return None, problem
+        from .verification_cache import replay_supported
+
+        if not replay_supported(record["verification_identity"]):
+            return None, "executed review has unresolved runtime dependencies"
+        configuration = record["verification_identity"]["configuration"]
+        if configuration.get("family") != "focused-unit" \
+                or configuration.get("patterns") != record["patterns"]:
+            return None, "executed review selection differs from its bound configuration"
+        if history.hash != read_history_snapshot(root).hash:
+            return None, "review history changed during evidence validation"
+    except (OSError, ValueError, KeyError, TypeError) as exc:
+        return None, f"independent Core review evidence unavailable: {exc}"
+    # The proof IS the receipt binding: every package field that the review
+    # text had to name, plus the exact executed record and its digest. Callers
+    # persist this whole object so a later verifier never reconstructs a
+    # weaker subset (T-2040).
+    return {**expected, "ticket_id": ticket, "review_event": f"E-{review['event']}",
+            "record": relative, "record_sha256": digest}, ""
 
 

+def _collect_links(root: Path, records: tuple[dict, ...] | None = None):
+    """Exact positional intake links; ambiguous generations retain no authority."""
+    collected: set[str] = set()
+    links: dict[str, tuple[str, str]] = {}
+    ticket_links: dict[str, tuple[str, str]] = {}
+    invalid: set[str] = set()
+    from .journal import op_id_provenance
+
+    for record in _iter_operation_records(root, records):
+        if not _durable_collect_receipt(record):
+            continue
+        meta = record.get("receipt_metadata") or {}
+        identities = meta.get("package_identities")
+        tickets = meta.get("tickets")
+        if not isinstance(identities, list):
+            continue
+        known = {value for value in identities if isinstance(value, str)
+                 and ROLE_REVISION_RE.fullmatch(value)}
+        collected.update(known)
+        op = record.get("op_id")
+        owned = {target.get("path") for target in record.get("targets", ())
+                 if target.get("applied") is True}
+        if (not {".saipen/LOG.md", ".saipen/BOARD.md", ".saipen/STATE.md"}.issubset(owned)
+                or not known or len(known) != len(identities)
+                or not isinstance(tickets, list) or len(tickets) != len(identities)
+                or any(not isinstance(tid, str) or not re.fullmatch(r"T-\d+", tid) for tid in tickets)
+                or len(set(tickets)) != len(tickets) or op_id_provenance(op) != "canonical"):
+            invalid.update(known)
+            continue
+        for identity, ticket in zip(identities, tickets):
+            binding = (ticket, op)
+            if identity in links and links[identity] != binding:
+                invalid.add(identity)
+            prior = ticket_links.get(ticket)
+            if prior is not None and prior != (identity, op):
+                invalid.update((identity, prior[0]))
+            ticket_links[ticket] = (identity, op)
+            links[identity] = binding
+    return collected, {identity: binding for identity, binding in links.items()
+                       if identity not in invalid}
+

+class BaselineBoundaryTests(unittest.TestCase):
+    """`assess` with a baseline written for the case."""
+
+    def setUp(self):
+        self.root = Path(tempfile.mkdtemp(prefix="t1673-unit-"))
+        self.addCleanup(lambda: shutil.rmtree(self.root, ignore_errors=True))
+        (self.root / ".saipen").mkdir()
+        self.claim, self.finish = "claim-" + "a" * 32, "finish-" + "b" * 32
+        for op_id in (self.claim, self.finish):
+            os.makedirs(self.root / OPS_DIR / op_id)
+        self.events = [
+            _event(1, "T-1", "DEC: claimed via SAIOPS -- owner x", self.claim),
+            _event(2, "T-1", "DEC: ticket finished via SAIOPS -- completion", self.finish),
+        ]
+
+    def write_board(self, done: list[str], todo: list[str]) -> dict:
+        lines = ["# Board", "## DOING", "## TODO"]
+        lines += [f"- [ ] {tid} work | verify: v" for tid in todo]
+        lines.append("## DONE")
+        lines += [f"- [x] {tid} work | verify: v" for tid in done]
+        lines.append("## BLOCKED")
+        text = "\n".join(lines) + "\n"
+        (self.root / ".saipen" / "BOARD.md").write_text(text, encoding="utf-8", newline="\n")
+        return parse_board(text)
+
+    def assess(self, board):
+        return lifecycle_authority.assess(self.root, {"last_event": 2}, board, self.events)
+
+    def test_no_baseline_is_no_finding(self):
+        board = self.write_board(done=["T-2"], todo=[])
+        self.assertEqual(self.assess(board)["findings"], [])
+
+    def test_a_row_a_closure_operation_closed_is_never_a_board_only_move(self):
+        self.write_board(done=[], todo=["T-1", "T-2"])
+        lifecycle_authority.record_terminal(self.root)
+        board = self.write_board(done=["T-1", "T-2"], todo=[])
+        found = self.assess(board)["findings"]
+        self.assertEqual([(f["ticket"], f.get("origin")) for f in found], [("T-2", "board-only")])
+
+    def test_an_unchanged_board_is_not_judged_whatever_the_baseline_says(self):
+        board = self.write_board(done=["T-2"], todo=[])
+        lifecycle_authority.record_terminal(self.root)
+        self.assertEqual(self.assess(board)["findings"], [])
+
+    def test_an_unreadable_baseline_is_no_finding(self):
+        self.write_board(done=[], todo=["T-2"])
+        lifecycle_authority.record_terminal(self.root)
+        (self.root / lifecycle_authority.TERMINAL_BASELINE).write_text("{", encoding="utf-8")
+        board = self.write_board(done=["T-2"], todo=[])
+        self.assertEqual(self.assess(board)["findings"], [])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1674_typed_closure_mode.py b/tools/test_t1674_typed_closure_mode.py
new file mode 100644
index 00000000..7a11a632
--- /dev/null
+++ b/tools/test_t1674_typed_closure_mode.py
@@ -0,0 +1,149 @@
+"""T-1674: a `## DONE` row with a typed closure_mode has a recovery owner.
+
+Measured on a copy of AUDAPACK (08.10.26): `T-282 ... | closure_mode:
+duplicate_reconciled`, typed by an executor two days earlier. `board.py`
+refuses the value, so every reader answered `checkpoint-invalid`; the
+phantom-DONE and legacy-review classes skip any row that carries a
+closure_mode at all, so `saipen recover` answered `RESIDUAL_DEFECTS` with no
+command. The project could not move and the only exit was a hand edit of
+BOARD.md -- the edit the protocol forbids.
+
+The CLI half drives the operator's entry point on a project with real
+allocations; the unit half pins which rows the class may and may not take.
+"""
+
+import re
+import shutil
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+sys.path.insert(0, str(TOOLS))
+
+import continuity_probes as probes  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+
+from saipen_engine.board import CLOSURE_MODES, parse_board  # noqa: E402
+from saipen_engine.reconcile import _board_lifecycle_repairs  # noqa: E402
+
+AGENT = "buffy"
+TYPED = "duplicate_reconciled"
+CLASS = "typed-closure-mode"
+CANON = ("STATE.md", "BOARD.md", "LOG.md")
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def _project() -> tuple[Path, str]:
+    """A git worktree whose second ticket was allocated by a real operation."""
+    root = probes.fresh_project("t1674")
+    subprocess.run(["git", "init", "-q", "."], cwd=root, check=True)
+    assert probes.cli(root, AGENT, "continue").get("ok")
+    added = probes.cli(root, AGENT, "ticket", "add", "P3", "the same widget again",
+                       "--verify", "duplicate of T-001")
+    assert added.get("ok"), added
+    return root, added["ticket"]
+
+
+def _type_the_closure(root: Path, ticket: str) -> None:
+    """Move the row under DONE by hand with a closure_mode nobody writes."""
+    board = root / ".saipen" / "BOARD.md"
+    text = board.read_text(encoding="utf-8")
+    line = next(row for row in text.splitlines() if f" {ticket} " in row)
+    text = text.replace(line + "\n", "")
+    done = re.sub(r"^- \[.\]", "- [x]", line) + f" | closure_mode: {TYPED}"
+    board.write_text(text.replace("## DONE\n", "## DONE\n" + done + "\n"),
+                     encoding="utf-8", newline="\n")
+
+
+def _bytes(root: Path) -> dict:
+    return {name: (root / ".saipen" / name).read_bytes() for name in CANON}
+
+
+class TypedClosureModeRecoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.root, self.ticket = _project()
+        self.addCleanup(lambda: shutil.rmtree(self.root, ignore_errors=True))
+
+    def cli(self, *args):
+        return probes.cli(self.root, AGENT, *args)
+
+    def test_recovery_names_one_approved_command_and_the_project_is_valid_after_it(self):
+        _type_the_closure(self.root, self.ticket)
+        before = _bytes(self.root)
+        status = self.cli("status")
+        self.assertFalse(status.get("ok"), status)
+        self.assertIn(f"closure_mode '{TYPED}'", str(status.get("detail")), status)
+        self.assertEqual(status.get("action"), "saipen recover", status)
+
+        plan = self.cli("recover")
+        self.assertEqual(plan.get("code"), "RECONCILE_REAUTH_REQUIRED", plan)
+        self.assertIn(CLASS, str(plan.get("changed")), plan)
+        route = str(plan.get("canonical_next_command") or "").split()
+        self.assertEqual(route[:3], ["saipen", "recover", "--apply-approved-repair"], plan)
+        # Bare recovery never reopens a row silently.
+        self.assertEqual(_bytes(self.root), before)
+
+        applied = self.cli(*route[1:])
+        self.assertEqual(applied.get("code"), "REPAIRED", applied)
+        row = parse_board(_bytes(self.root)["BOARD.md"].decode())["tickets"][self.ticket]
+        self.assertEqual(row["section"], "## TODO", row)
+        self.assertNotIn("closure_mode", row["fields"], row)
+        after = self.cli("status")
+        self.assertTrue(after.get("ok"), after)
+        self.assertEqual(self.cli("recover").get("code"), "CLEAN")
+        # The row is ordinary Work again: an operation may close it properly.
+        self.assertTrue(self.cli("claim", self.ticket, "--explicit").get("ok"))
+
+
+class WhichRowsTheClassTakesTests(unittest.TestCase):
+    """`_board_lifecycle_repairs` over boards built for the case."""
+
+    @staticmethod
+    def atoms(board_text: str, state: dict | None = None) -> list[dict]:
+        board = parse_board(board_text)
+        return [
+            atom for atom in _board_lifecycle_repairs(board, None, state)
+            if atom.get("_class") == CLASS
+        ]
+
+    @staticmethod
+    def board(*done_rows: str) -> str:
+        return "# Board\n## DOING\n## TODO\n## DONE\n" + "".join(
+            row + "\n" for row in done_rows
+        ) + "## BLOCKED\n"
+
+    def test_only_a_value_outside_the_closed_set_is_taken(self):
+        rows = [
+            f"- [x] T-{index} [P2] closed properly | verify: proof | closure_mode: {mode}"
+            for index, mode in enumerate(CLOSURE_MODES, start=10)
+        ]
+        typed = f"- [x] T-5 [P3] typed | verify: duplicate of T-6 | closure_mode: {TYPED}"
+        plain = "- [x] T-7 [P2] closed before the field existed | verify: proof"
+        atoms = self.atoms(self.board(typed, plain, *rows))
+        self.assertEqual([atom["ticket"] for atom in atoms], ["T-5"])
+        atom = atoms[0]
+        self.assertEqual((atom["kind"], atom["from_section"], atom["to_section"]),
+                         ("section-move", "## DONE", "## TODO"))
+        self.assertTrue(atom["requires_approval"])
+        self.assertIn("closure_mode", atom["fields"])
+        self.assertIn(TYPED, atom["reason"])
+
+    def test_the_claim_is_dropped_with_the_closure(self):
+        typed = (f"- [x] T-5 [P3] typed | verify: x | owner: buffy "
+                 f"| claim_time: 2026-10-06T02:39:00Z | closure_mode: {TYPED}")
+        atom = self.atoms(self.board(typed))[0]
+        self.assertTrue({"closure_mode", "owner", "claim_time"} <= set(atom["fields"]), atom)
+
+    def test_the_row_state_is_bound_to_is_left_to_the_current_done_classes(self):
+        typed = f"- [x] T-5 [P3] typed | verify: x | closure_mode: {TYPED}"
+        self.assertEqual(self.atoms(self.board(typed), {"task": "T-5", "phase": "DONE"}), [])
+        self.assertEqual(len(self.atoms(self.board(typed), {"task": "none"})), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1676_lifecycle_code.py b/tools/test_t1676_lifecycle_code.py
new file mode 100644
index 00000000..4c15ec84
--- /dev/null
+++ b/tools/test_t1676_lifecycle_code.py
@@ -0,0 +1,79 @@
+"""T-1676: the lifecycle refusal is a registered code of its own.
+
+T-1672 named the class UNAUTHORIZED_LIFECYCLE_WRITE only in the reason and the
+detail and refused with PROTOCOL_STATE_INVALID, because `command_resolution`
+stood 10 bytes under its budget and a registry code costs 34. With the route
+budgets in place (T-1670) the class is the code: status and every refused verb
+return it, it is registered (no `unregistered_code` marker), fleet maps it to
+the state surface as an operator decision, and every route budget still PASSes.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+import continuity_probes as probes  # noqa: E402
+import protocol_budget  # noqa: E402
+from saipen_engine import fleet  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+from test_t1671_lifecycle_authority import AGENT, _bytes, _project, _type_the_lifecycle  # noqa: E402
+
+CODE = "UNAUTHORIZED_LIFECYCLE_WRITE"
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+class RegisteredCodeTests(unittest.TestCase):
+    def test_the_code_is_registered(self):
+        registry = json.loads((ROOT / "saipen" / "REGISTRY.json").read_text(encoding="utf-8"))
+        self.assertIn(CODE, registry["error_codes"])
+
+    def test_fleet_maps_it_to_the_state_surface_as_an_operator_decision(self):
+        self.assertEqual(fleet._BLOCKING_SURFACE.get(CODE), "state")
+        self.assertIn(CODE, fleet._OPERATOR_DECISION_CODES)
+
+    def test_every_route_budget_still_passes(self):
+        self.assertEqual(protocol_budget.check(ROOT / "saipen"), [])
+
+
+class RefusalTests(unittest.TestCase):
+    def setUp(self):
+        self.root = _project()
+        self.addCleanup(lambda: shutil.rmtree(self.root, ignore_errors=True))
+        _type_the_lifecycle(self.root)
+
+    def cli(self, *args):
+        return probes.cli(self.root, AGENT, *args)
+
+    def test_status_and_every_refused_verb_return_the_class_as_the_code(self):
+        before = _bytes(self.root)
+        status = self.cli("status")
+        self.assertEqual((status.get("ok"), status.get("code")), (False, CODE), status)
+        self.assertEqual(status.get("action"), "saipen recover", status)
+        for args in (
+            ("transition", "SCOUT", "next"),
+            ("checkpoint", "RUN", "T-001", "a note after the fact"),
+            ("ticket", "add", "P2", "more work", "--verify", "it works"),
+            ("ticket", "done", "T-001", "--closure-mode", "own_patch"),
+            ("claim", "T-001"),
+        ):
+            with self.subTest(args=args):
+                answer = self.cli(*args)
+                self.assertEqual((answer.get("ok"), answer.get("code")), (False, CODE), answer)
+                self.assertNotIn("unregistered_code", answer, answer)
+        self.assertEqual(_bytes(self.root), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1678_path_launcher.py b/tools/test_t1678_path_launcher.py
new file mode 100644
index 00000000..174d0c6c
--- /dev/null
+++ b/tools/test_t1678_path_launcher.py
@@ -0,0 +1,396 @@
+"""T-1678 (SRC-192): the PATH launcher has an owner.
+
+PATH_LAUNCHER is the first transport of `SAIPEN_ENTRY.json`, and no installer
+created one: on the operator's machine every host answered degraded
+`no_canonical_path_launcher` and an executor typing `saipen` got "command not
+found" until two hand copies were put on PATH (E-13246).
+
+Evidence classes, kept apart:
+
+* OWNER     -- `path_launcher` against disposable homes: the declared
+               directories, the rendered bytes, adoption of a hand copy,
+               refusal of a foreign launcher, removal of what is ours only.
+* DOCTOR    -- `host doctor` reports a missing or stale launcher and
+               `host repair` writes it, on a disposable profile.
+* INSTALL   -- the real installer and uninstaller on a sandbox profile, then
+               `host entry` through PATH from a fresh project.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+for _entry in (str(TOOLS), str(ROOT / "bootstrap")):
+    if _entry not in sys.path:
+        sys.path.insert(0, _entry)
+
+import cli_launcher  # noqa: E402
+import install_ownership  # noqa: E402
+from saipen_engine import entry_resolver  # noqa: E402
+from saipen_engine import host_integration as HG  # noqa: E402
+from saipen_engine import path_launcher as PL  # noqa: E402
+from saipen_engine import runtime_bootstrap  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+
+ENGINE = ROOT / "tools" / "saipen.py"
+WINDOWS = os.name == "nt"
+POWERSHELL = shutil.which("powershell") if WINDOWS else shutil.which("pwsh")
+BASH = (
+    str(Path("C:/Program Files/Git/bin/bash.exe"))
+    if WINDOWS and Path("C:/Program Files/Git/bin/bash.exe").is_file()
+    else shutil.which("bash")
+)
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def clean_path(*first: Path) -> str:
+    """PATH with `first` in front and every directory that already holds a
+    `saipen` taken out: the operator's own launcher must not answer for the
+    sandbox, in either direction."""
+    kept = []
+    for entry in os.environ.get("PATH", "").split(os.pathsep):
+        if not entry.strip():
+            continue
+        if any((Path(entry) / name).exists() for name in ("saipen", "saipen.cmd")):
+            continue
+        kept.append(entry)
+    return os.pathsep.join([*(str(item) for item in first), *kept])
+
+
+class Scratch(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory(prefix="saipen-t1678-")
+        self.addCleanup(self._tmp.cleanup)
+        self.tmp = Path(self._tmp.name)
+        self.home = self.tmp / "home"
+        self.home.mkdir()
+        self.bin = PL.declared_dirs(self.home)[0]
+        self.bare = clean_path()
+        self.env = {"PATH": clean_path(self.bin)}
+
+    def launchers(self) -> dict[str, Path]:
+        return {name: self.bin / name for name in PL.names()}
+
+
+# ----------------------------------------------------------------------- OWNER
+
+
+class OwnerTests(Scratch):
+    def test_the_bytes_are_the_installer_renderer_and_the_resolver_proves_them(self):
+        rendered = PL.render(sys.executable, str(ENGINE))
+        reference = cli_launcher.render_launchers(sys.executable, str(ENGINE))
+        self.assertEqual(rendered, {name: reference[name] for name in PL.names()})
+        PL.install(ENGINE, self.home, self.env)
+        for path in self.launchers().values():
+            self.assertTrue(entry_resolver.prove_launcher(path, ENGINE)["ok"], path)
+
+    def test_every_declared_directory_is_inside_the_home_and_the_uninstaller_agrees(self):
+        for directory in PL.declared_dirs(self.home):
+            self.assertTrue(directory.is_relative_to(self.home), directory)
+        self.assertEqual(
+            {self.home.joinpath(*parts) for parts in install_ownership.LAUNCHER_DIRS},
+            set(PL.declared_dirs(self.home)),
+        )
+        self.assertEqual(
+            self.home.joinpath(*install_ownership.LAUNCHER_RECORD), PL.record_path(self.home)
+        )
+        self.assertEqual(set(install_ownership.LAUNCHER_NAMES), {PL.POSIX_NAME, PL.WINDOWS_NAME})
+
+    def test_no_declared_directory_on_path_writes_nothing_and_names_the_one_to_add(self):
+        env = {"PATH": self.bare}
+        report = PL.status(ENGINE, self.home, env)
+        self.assertEqual(report["code"], PL.CODE_NO_DIRECTORY)
+        self.assertIn(str(self.bin), report["action"])
+        answer = PL.install(ENGINE, self.home, env)
+        self.assertFalse(answer["ok"])
+        self.assertEqual(answer["code"], PL.CODE_NO_DIRECTORY)
+        self.assertEqual(list(self.home.iterdir()), [])
+        self.assertEqual(env, {"PATH": self.bare})
+
+    def test_install_owns_both_launchers_and_a_second_install_changes_nothing(self):
+        self.assertEqual(PL.status(ENGINE, self.home, self.env)["code"], PL.CODE_ABSENT)
+        answer = PL.install(ENGINE, self.home, self.env)
+        self.assertTrue(answer["ok"], answer)
+        self.assertEqual((answer["code"], answer["status"]), (PL.CODE_INSTALLED, PL.CODE_READY))
+        record = PL.read_record(self.home)
+        for path in self.launchers().values():
+            self.assertEqual(record[str(path)], hashlib.sha256(path.read_bytes()).hexdigest())
+        which = shutil.which("saipen", path=self.env["PATH"])
+        self.assertEqual(Path(which).parent, self.bin)
+        before = {name: path.read_bytes() for name, path in self.launchers().items()}
+        again = PL.install(ENGINE, self.home, self.env)
+        self.assertEqual(again["code"], PL.CODE_CURRENT)
+        self.assertEqual({n: p.read_bytes() for n, p in self.launchers().items()}, before)
+
+    def test_a_hand_copy_that_proves_the_engine_is_adopted(self):
+        self.bin.mkdir(parents=True)
+        for name, payload in PL.render(sys.executable, str(ENGINE)).items():
+            (self.bin / name).write_bytes(payload)
+        report = PL.status(ENGINE, self.home, self.env)
+        self.assertEqual(report["code"], PL.CODE_STALE)
+        self.assertEqual(set(report["files"].values()), {"unowned-proving"})
+        self.assertEqual(report["action"], PL.INSTALL_ACTION)
+        self.assertTrue(PL.install(ENGINE, self.home, self.env)["ok"])
+        self.assertEqual(PL.status(ENGINE, self.home, self.env)["code"], PL.CODE_READY)
+
+    def test_a_foreign_launcher_is_never_touched(self):
+        self.bin.mkdir(parents=True)
+        other = self.tmp / "other-install" / "tools" / "saipen.py"
+        foreign = PL.render(sys.executable, str(other))
+        for name, payload in foreign.items():
+            (self.bin / name).write_bytes(payload)
+        report = PL.status(ENGINE, self.home, self.env)
+        self.assertEqual(report["code"], PL.CODE_FOREIGN)
+        answer = PL.install(ENGINE, self.home, self.env)
+        self.assertFalse(answer["ok"])
+        self.assertEqual(answer["code"], PL.CODE_FOREIGN)
+        for name, payload in foreign.items():
+            self.assertEqual((self.bin / name).read_bytes(), payload)
+        self.assertFalse(PL.record_path(self.home).exists())
+
+    def test_an_owned_launcher_for_a_moved_engine_is_stale_and_rewritten(self):
+        moved = self.tmp / "moved" / "tools" / "saipen.py"
+        moved.parent.mkdir(parents=True)
+        moved.write_text("# engine\n", encoding="utf-8")
+        PL.install(moved, self.home, self.env)
+        report = PL.status(ENGINE, self.home, self.env)
+        self.assertEqual(report["code"], PL.CODE_STALE)
+        self.assertEqual(set(report["files"].values()), {"owned-stale"})
+        self.assertTrue(PL.install(ENGINE, self.home, self.env)["ok"])
+        for path in self.launchers().values():
+            self.assertTrue(entry_resolver.prove_launcher(path, ENGINE)["ok"])
+
+    def test_a_saipen_earlier_on_path_is_reported_as_shadowing(self):
+        earlier = self.tmp / "earlier"
+        earlier.mkdir()
+        for name, payload in PL.render(sys.executable, str(self.tmp / "x.py")).items():
+            (earlier / name).write_bytes(payload)
+        env = {"PATH": clean_path(earlier, self.bin)}
+        PL.install(ENGINE, self.home, env)
+        report = PL.status(ENGINE, self.home, env)
+        self.assertEqual(report["code"], PL.CODE_SHADOWED)
+        self.assertEqual(Path(report["shadowed_by"]).parent, earlier)
+
+    def test_removal_takes_only_what_is_still_as_written(self):
+        for remover in ("engine", "uninstaller"):
+            with self.subTest(remover=remover):
+                PL.install(ENGINE, self.home, self.env)
+                edited = self.launchers()[PL.POSIX_NAME]
+                edited.write_bytes(edited.read_bytes() + b"# mine now\n")
+                stranger = self.bin / "other-tool.cmd"
+                stranger.write_bytes(b"@echo off\r\n")
+                if remover == "engine":
+                    PL.remove(self.home)
+                else:
+                    install_ownership.remove_launcher(self.home)
+                self.assertTrue(edited.is_file())
+                self.assertTrue(stranger.is_file())
+                for name, path in self.launchers().items():
+                    if name != PL.POSIX_NAME:
+                        self.assertFalse(path.exists(), path)
+                self.assertFalse(PL.record_path(self.home).exists())
+                edited.unlink()
+
+    def test_the_uninstaller_refuses_a_record_that_names_a_file_elsewhere(self):
+        victim = self.tmp / "elsewhere" / "saipen"
+        victim.parent.mkdir()
+        victim.write_bytes(b"keep\n")
+        PL.record_path(self.home).parent.mkdir(parents=True)
+        PL.record_path(self.home).write_text(
+            json.dumps({"files": {str(victim): hashlib.sha256(b"keep\n").hexdigest()}}),
+            encoding="utf-8",
+        )
+        self.assertEqual(install_ownership.remove_launcher(self.home)["removed"], 0)
+        self.assertEqual(PL.remove(self.home)["removed"], [])
+        self.assertTrue(victim.is_file())
+
+
+# ---------------------------------------------------------------------- DOCTOR
+
+
+class DoctorTests(Scratch):
+    """Doctor and repair against a disposable profile: never the operator's."""
+
+    def setUp(self) -> None:
+        super().setUp()
+        patcher = mock.patch.dict(
+            os.environ,
+            {
+                "USERPROFILE": str(self.home),
+                "HOME": str(self.home),
+                "HOMEDRIVE": "",
+                "HOMEPATH": "",
+                "PATH": self.env["PATH"],
+            },
+        )
+        patcher.start()
+        self.addCleanup(patcher.stop)
+
+    def test_doctor_reports_a_missing_launcher_and_repair_writes_it(self):
+        report = HG.doctor(home=self.home)
+        self.assertEqual(report["path_launcher"]["code"], PL.CODE_ABSENT)
+        self.assertIn("path launcher  ABSENT  saipen host launcher install", HG.render(report))
+        with mock.patch.object(runtime_bootstrap, "_invoke_installer") as installer:
+            repaired = HG.repair(home=self.home)
+        installer.assert_not_called()
+        self.assertEqual([step["step"] for step in repaired["steps"]], ["launcher:install"])
+        self.assertTrue(repaired["ok"], repaired["steps"])
+        self.assertEqual(repaired["path_launcher"]["code"], PL.CODE_READY)
+        self.assertEqual(repaired["code"], "HOST_REPAIRED")
+
+    def test_doctor_reports_a_stale_hand_copy_and_repair_replaces_it_with_an_owned_one(self):
+        self.bin.mkdir(parents=True)
+        for name, payload in PL.render(sys.executable, str(ENGINE)).items():
+            (self.bin / name).write_bytes(payload)
+        self.assertEqual(HG.doctor(home=self.home)["path_launcher"]["code"], PL.CODE_STALE)
+        with mock.patch.object(runtime_bootstrap, "_invoke_installer"):

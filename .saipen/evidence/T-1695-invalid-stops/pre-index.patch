+class ClaudeGuiPathTests(unittest.TestCase):
+    """The real hook artifact, a real broker, and a process named like the host.
+
+    The hook is installed BY the host's own interpreter, exactly as the real
+    installer does, and the broker is started the way the shipped lifecycle
+    starts it -- as its own process. That matters: the installed hook command
+    names the interpreter that wrote it and the broker verifies that entry, so a
+    case that installed under one interpreter and served under another would be
+    measuring a configuration error instead of the admission path.
+    """
+
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self._tmp.cleanup)
+        self.tmp = Path(self._tmp.name)
+        self.world = World(self.tmp)
+        self.profile = self.tmp / "userprofile"
+        self.profile.mkdir()
+        self.runtime = isolate_profile(self, self.tmp)
+        self.host = host_stand_in(self.tmp)
+        self.services: list[subprocess.Popen] = []
+        self.addCleanup(self.stop_services)
+        self.env = {
+            **os.environ,
+            "USERPROFILE": str(self.profile),
+            "HOME": str(self.profile),
+            "HOMEDRIVE": "",
+            "HOMEPATH": "",
+            "PYTHONHOME": PYTHON_HOME,
+        }
+    def stop_services(self) -> None:
+        stored = HB.read_status(self.runtime) or {}
+        pid = stored.get("pid")
+        HC.shutdown(self.runtime)
+        for proc in self.services:
+            if proc.poll() is None:
+                with contextlib.suppress(OSError):
+                    proc.terminate()
+        deadline = time.time() + 12.0
+        while time.time() < deadline and HB.health(self.runtime, timeout=0.3):
+            time.sleep(0.2)
+        if pid:
+            with contextlib.suppress(OSError, TypeError, ValueError):
+                os.kill(int(pid), 9)
+            deadline = time.time() + 12.0
+            while time.time() < deadline and HB._pid_alive(int(pid)):
+                time.sleep(0.2)
+        for proc in self.services:
+            if proc.poll() is None:
+                with contextlib.suppress(OSError):
+                    proc.kill()
+            with contextlib.suppress(subprocess.SubprocessError, OSError):
+                proc.wait(timeout=10)
+
+    def start_service(self) -> subprocess.Popen:
+        """A broker process that already exists, under the host interpreter."""
+        host = self.require_host()
+        proc = subprocess.Popen(
+            [
+                str(host),
+                str(TOOLS / "authority_service.py"),
+                "serve",
+                "--saipen-root",
+                str(self.world.authority),
+                "--runtime",
+                str(self.runtime),
+                "--idle-seconds",
+                "0",
+            ],
+            stdout=subprocess.DEVNULL,
+            stderr=subprocess.DEVNULL,
+            env=self.env,
+        )
+        self.services.append(proc)
+        deadline = time.time() + 30.0
+        while time.time() < deadline:
+            if HB.health(self.runtime, timeout=0.5):
+                return proc
+            if proc.poll() is not None:
+                break
+            time.sleep(0.1)
+        raise AssertionError("the pre-existing broker never became reachable")
+
+    def run_guard(
+        self, interpreter: Path, event: dict, *, session: str = "session-1"
+    ) -> dict | None:
+        payload = {"session_id": session, "cwd": str(self.world.project), **event}
+        argv = [
+            str(interpreter),
+            str(HOOK),
+            "--host",
+            "claude",
+            "--saipen-root",
+            str(ROOT),
+            "--home",
+            str(self.world.home),
+            "--authority-root",
+            str(self.world.authority),
+        ]
+        proc = subprocess.run(
+            argv,
+            input=json.dumps(payload).encode("utf-8"),
+            capture_output=True,
+            cwd=str(ROOT),
+            check=False,
+            env=self.env,
+            timeout=180,
+        )
+        out = proc.stdout.decode("utf-8", errors="replace").strip()
+        return json.loads(out) if out else None
+
+    def require_host(self) -> Path:
+        """The host image, with the hook installed BY that interpreter.
+
+        The installed hook command names the interpreter that wrote it, and the
+        broker verifies that entry against its own runtime, so a host case must
+        install the hook the way the real installer does -- from inside the host.
+        """
+        if self.host is None:
+            self.skipTest("no stand-in host interpreter on this platform")
+        with mock.patch.object(sys, "executable", str(self.host)):
+            install_host_guard.install("claude", self.world.home, ROOT)
+        return self.host
+
+    def test_the_normal_gui_path_is_admitted_without_a_magic_phrase(self):
+        host = self.require_host()
+        self.start_service()
+        prompt = self.run_guard(
+            host, {"hook_event_name": "UserPromptSubmit", "user_prompt": "ordinary request"}
+        )
+        self.assertIn("hookSpecificOutput", prompt, prompt)
+        context = prompt["hookSpecificOutput"]["additionalContext"]
+        for name in PA.AUTHORITY_DOCUMENTS:
+            self.assertIn(f"=== {name} sha256:", context)
+        self.assertNotIn("decision", prompt)
+        self.assertNotIn("HOST_AUTHORITY_UNAVAILABLE", json.dumps(prompt))
+        self.assertGreaterEqual(HC.status(self.runtime)["authenticated_requests"], 1)
+        # The session is admitted, so the next prompt is not charged the full
+        # delivery again -- proved through the hook, because the test process
+        # itself is not allowed to ask the broker about a record.
+        second = self.run_guard(
+            host, {"hook_event_name": "UserPromptSubmit", "user_prompt": "second request"}
+        )
+        self.assertNotIn("decision", second)
+        self.assertNotIn("=== BOOT.md", second["hookSpecificOutput"]["additionalContext"])
+
+    def test_a_gui_restart_admits_the_new_session_automatically(self):
+        host = self.require_host()
+        self.start_service()
+        self.run_guard(host, {"hook_event_name": "UserPromptSubmit", "user_prompt": "one"})
+        restarted = self.run_guard(
+            host,
+            {"hook_event_name": "UserPromptSubmit", "user_prompt": "two"},
+            session="session-restarted",
+        )
+        self.assertIn("=== BOOT.md", restarted["hookSpecificOutput"]["additionalContext"])
+        self.assertNotIn("decision", restarted)
+
+    def test_an_absent_broker_is_started_by_the_adapter_and_the_prompt_proceeds(self):
+        host = self.require_host()
+        self.assertFalse(HB.health(self.runtime))
+        prompt = self.run_guard(
+            host, {"hook_event_name": "UserPromptSubmit", "user_prompt": "first prompt"}
+        )
+        self.assertIn("hookSpecificOutput", prompt, prompt)
+        self.assertNotIn("decision", prompt)
+        self.assertTrue(HB.health(self.runtime), "the adapter did not recover the authority")
+        started = HB.read_status(self.runtime)
+        self.assertTrue(started and started.get("pid"))
+
+    def test_a_crashed_broker_is_recovered_on_the_next_prompt(self):
+        host = self.require_host()
+        proc = self.start_service()
+        self.run_guard(host, {"hook_event_name": "UserPromptSubmit", "user_prompt": "one"})
+        proc.kill()
+        proc.wait(timeout=20)
+        # The key that signed the record died with the process, so nothing can
+        # verify that record any more: the next prompt must re-admit rather than
+        # trust evidence it can no longer check.
+        recovered = self.run_guard(
+            host, {"hook_event_name": "UserPromptSubmit", "user_prompt": "two"}
+        )
+        self.assertNotIn("decision", recovered)
+        self.assertIn("hookSpecificOutput", recovered)
+        self.assertFalse(proc.poll() is None)
+
+    def test_an_ordinary_python_client_is_still_blocked_with_recovery_detail(self):
+        self.start_service()
+        prompt = self.run_guard(
+            Path(sys.executable),
+            {"hook_event_name": "UserPromptSubmit", "user_prompt": "ordinary request"},
+        )
+        self.assertEqual(prompt["decision"], "block", prompt)
+        reason = prompt["reason"]
+        self.assertIn("HOST_AUTHORITY_UNAVAILABLE", reason)
+        self.assertIn("BROKER_CLIENT_NOT_AUTHENTICATED", reason)
+        self.assertIn("SAIPEN host-authority broker", reason)
+        self.assertIn("automatic recovery attempted", reason)
+        self.assertFalse((self.world.project / PA.LEDGER_DIR).exists())
+        self.assertGreaterEqual(HC.status(self.runtime)["refused_requests"], 1)
+
+    def test_no_broker_and_no_host_binding_is_a_concrete_recovery_not_a_dead_end(self):
+        prompt = self.run_guard(
+            Path(sys.executable),
+            {"hook_event_name": "UserPromptSubmit", "user_prompt": "ordinary request"},
+        )
+        self.assertEqual(prompt["decision"], "block", prompt)
+        self.assertIn("HOST_AUTHORITY_UNAVAILABLE", prompt["reason"])
+        self.assertIn("saipen authority start", prompt["reason"])
+        self.assertFalse(HB.health(self.runtime))
+
+    def test_degraded_mode_is_visible_on_the_prompt_path_and_never_automatic(self):
+        blocked = self.run_guard(
+            Path(sys.executable),
+            {"hook_event_name": "UserPromptSubmit", "user_prompt": "ordinary request"},
+        )
+        self.assertEqual(blocked["decision"], "block", blocked)
+        (self.world.home / ".saipen").mkdir(parents=True, exist_ok=True)
+        (self.world.home / ".saipen" / "authority.json").write_text(
+            '{"mode": "degraded"}', encoding="utf-8"
+        )
+        degraded = self.run_guard(
+            Path(sys.executable),
+            {"hook_event_name": "UserPromptSubmit", "user_prompt": "ordinary request"},
+        )
+        self.assertNotIn("decision", degraded, degraded)
+        self.assertIn("UNVERIFIED/DEGRADED", degraded["systemMessage"])
+        self.assertIn(
+            "UNVERIFIED/DEGRADED", degraded["hookSpecificOutput"]["additionalContext"]
+        )
+        self.assertFalse((self.world.project / PA.LEDGER_DIR).exists())
+
+
+if __name__ == "__main__":
+    unittest.main()

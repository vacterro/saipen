@@ -0,0 +1,266 @@
+"""SRC-112: a cold continuation consumes authority; it cannot grant itself one.
+
+The operator carrier below is an explicit external test double, never a claim
+about a production host. Disposable fixtures earn their counter history.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import sys
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+TOOLS = Path(__file__).resolve().parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+from saipen_engine import codec, intake, operations, state  # noqa: E402
+from saipen_engine.iteration_verdict import project_iteration_verdict  # noqa: E402
+from saipen_engine.reconcile import _derived_goal_counters  # noqa: E402
+from saipen_engine.log import read_history_snapshot  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+from test_t1363_zero_manual_entry import cli, project  # noqa: E402
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+OBJECTIVE = "Complete every runnable repository ticket until the goal is complete"
+
+
+class ContinuationAuthorityTests(unittest.TestCase):
+    def bounded(self, tickets=20):
+        lines = [
+            "# Log",
+            "- 09.10.26 00:00 [E-1] [agent: test-agent] DEC: goal pivot -- bounded work",
+        ]
+        for index in range(tickets):
+            lines.append(
+                f"- 09.10.26 00:00 [E-{index + 2}] [parent: E-{index + 1}] "
+                f"[agent: test-agent] DEC: goal_tickets {index}->{index + 1}"
+            )
+        action = (
+            f"WAIT: safety valve reached (0 waves / {tickets} tickets) -- run 'cc' to continue"
+            if tickets >= 20 else "saipen continue"
+        )
+        root = project(
+            self, log="\n".join(lines) + "\n", execution_intent="goal",
+            goal_waves=0, goal_tickets=tickets, next_action=action,
+        )
+        self.patch_state(root, {"saipen_home": str(TOOLS.parent)})
+        return root
+
+    def persistent(self):
+        root = project(self)
+        self.patch_state(root, {"saipen_home": str(TOOLS.parent)})
+        with patch.dict(os.environ, {
+            "SAIPEN_TASK_SHA256": hashlib.sha256(OBJECTIVE.encode("utf-8")).hexdigest(),
+        }):
+            result = operations.goal_entry(root, "test-agent", OBJECTIVE)
+        self.assertTrue(result.ok, result.to_dict())
+        return root
+
+    def read_state(self, root):
+        return state.parse_state(codec.read_doc(root / ".saipen" / "STATE.md"))
+
+    def snapshot(self, root):
+        return tuple((root / ".saipen" / name).read_bytes()
+                     for name in ("STATE.md", "BOARD.md", "LOG.md"))
+
+    def spend(self, root, *, tickets=20, waves=None):
+        """A coherent disposable counter boundary, not an edit to a live run."""
+        current = self.read_state(root)
+        target = {"goal_tickets": tickets}
+        if waves is not None:
+            target["goal_waves"] = waves
+        for key, desired in target.items():
+            for value in range(current.get(key) or 0, desired):
+                recorded = operations.checkpoint(
+                    root, "test-agent", "DEC", None, f"{key} {value}->{value + 1}",
+                )
+                self.assertTrue(recorded.ok, recorded.to_dict())
+        wave_count = target.get("goal_waves", current.get("goal_waves") or 0)
+        next_action = (
+            f"WAIT: safety valve reached ({wave_count} waves / {tickets} tickets) "
+            "-- run 'cc' to continue"
+        )
+        self.patch_state(root, {**target, "next_action": next_action})
+
+    def patch_state(self, root, fields):
+        path = root / ".saipen" / "STATE.md"
+        path.write_text(state.patch_state(codec.read_doc(path), fields), encoding="utf-8")
+
+    def test_explicit_operator_goal_records_persistent_authority_and_source(self):
+        current = self.read_state(self.persistent())
+        self.assertEqual(current.get("continuation_authority"), "operator_persistent")
+        self.assertRegex(current.get("authority_source") or "", r"^E-[1-9][0-9]*$")
+        self.assertEqual(current.get("authority_until"), "goal_complete")
+        self.assertEqual(current.get("safety_valve_mode"), "checkpoint")
+
+    def test_model_supplied_goal_does_not_create_persistent_authority(self):
+        root = project(self)
+        result = operations.goal_entry(root, "test-agent", OBJECTIVE)
+        self.assertTrue(result.ok, result.to_dict())
+        self.assertNotEqual(
+            self.read_state(root).get("continuation_authority"), "operator_persistent",
+        )
+
+    def test_agent_boot_continue_cannot_reset_an_ordinary_bounded_run(self):
+        root = self.bounded()
+        before = self.snapshot(root)
+        _code, payload, text = cli(root, "continue", "--json")
+        self.assertEqual(self.snapshot(root), before, text)
+        self.assertEqual(self.read_state(root)["goal_tickets"], 20)
+        self.assertIn(
+            "safety valve", str(payload.get("next_action") or payload.get("detail")), text,
+        )
+
+    def test_bounded_status_requires_the_operator_and_synthetic_cc_is_absent(self):
+        root = self.bounded()
+        code, payload, text = cli(root, "status", "--json")
+        self.assertEqual(code, 0, text)
+        self.assertEqual(payload["automation"]["disposition"], "WAIT_USER", text)
+        self.assertTrue(payload["automation"]["operator_action_due"], text)
+        self.assertIsNone(payload["automation"]["next_command"], text)
+
+    def test_persistent_cap_status_is_a_checkpoint_without_operator_action(self):
+        root = self.persistent()
+        self.spend(root)
+        code, payload, text = cli(root, "status", "--json")
+        self.assertEqual(code, 0, text)
+        self.assertEqual(payload["automation"]["disposition"], "CONTINUE", text)
+        self.assertFalse(payload["automation"]["operator_action_due"], text)
+        self.assertEqual(payload["automation"]["next_command"], "cc", text)
+        self.assertEqual(payload["computed_next_action"], "saipen continue", text)
+
+    def test_persistent_cold_continue_checkpoints_then_resumes_same_work(self):
+        root = self.persistent()
+        original = self.read_state(root)
+        self.spend(root)
+        code, payload, text = cli(root, "continue", "--json")
+        self.assertEqual(code, 0, text)
+        current = self.read_state(root)
+        self.assertEqual((current["goal_waves"], current["goal_tickets"]), (0, 0), text)
+        for key in ("task", "phase", "goal_ingress", "authority_source", "continuation_authority"):
+            self.assertEqual(current[key], original[key], (key, text))
+        log = (root / ".saipen" / "LOG.md").read_text(encoding="utf-8")
+        self.assertIn("DEC: goal checkpoint --", log)
+        self.assertIn("safety review", log)
+        self.assertEqual(_derived_goal_counters(read_history_snapshot(root).events),
+                         {"goal_waves": 0, "goal_tickets": 0})
+        self.assertNotEqual(payload.get("code"), "WAIT_USER", text)
+
+    def test_explicit_fresh_operator_cc_can_reset_the_bounded_cap(self):
+        root = self.bounded()
+        code, _payload, text = cli(root, "continue", "--json", operator_text="cc")
+        self.assertEqual(code, 0, text)
+        current = self.read_state(root)
+        self.assertEqual((current["goal_waves"], current["goal_tickets"]), (0, 0), text)
+        self.assertEqual(current.get("continuation_authority"), "operator_required")
+        self.assertEqual(current.get("authority_until"), "budget")
+        self.assertEqual(current.get("safety_valve_mode"), "hard_wait")
+        self.assertRegex(current.get("authority_source", ""), r"^E-[1-9][0-9]*$")
+        self.assertIn("DEC: goal reauthorized --", (root / ".saipen" / "LOG.md").read_text())
+
+    def test_a_different_operator_carrier_is_not_a_fresh_cc(self):
+        root = self.bounded()
+        before = self.snapshot(root)
+        cli(root, "continue", "--json", operator_text="inspect the README")
+        self.assertEqual(self.snapshot(root), before)
+
+    def test_a_model_source_cannot_be_upgraded_by_a_later_cc_carrier(self):
+        root = self.bounded()
+        captured = intake.capture(root, "cc", source_kind="user_instruction")
+        before = self.snapshot(root)
+        with patch.dict(os.environ, {
+            "SAIPEN_TASK_SHA256": hashlib.sha256(b"cc").hexdigest(),
+        }):
+            result = operations.reauthorize_valve(
+                root, "test-agent", operator_authority_source=captured["receipt"],
+            )
+        self.assertFalse(result.ok, result.to_dict())
+        self.assertEqual(self.snapshot(root), before)
+
+    def test_under_cap_continue_never_grants_a_fresh_budget(self):
+        root = self.persistent()
+        code, _payload, text = cli(root, "continue", "--json")
+        self.assertEqual(code, 0, text)
+        current = self.read_state(root)
+        self.assertEqual((current["goal_waves"], current["goal_tickets"]), (1, 0))
+        self.assertNotIn("goal checkpoint --", (root / ".saipen" / "LOG.md").read_text())
+
+    def test_wave_cap_uses_the_same_persistent_checkpoint_policy(self):
+        root = self.persistent()
+        self.spend(root, tickets=0, waves=3)
+        code, _payload, text = cli(root, "continue", "--json")
+        self.assertEqual(code, 0, text)
+        self.assertEqual(self.read_state(root)["goal_waves"], 0)
+
+    def test_legitimate_user_safety_brakes_survive_persistent_authority(self):
+        for action in (
+            "WAIT: user brake -- stop here", "WAIT: destructive-op -- remove the database",
+            "WAIT: first-publish -- choose repository visibility",
+        ):
+            root = self.persistent()
+            self.spend(root)
+            self.patch_state(root, {"next_action": action})
+            before = self.snapshot(root)
+            cli(root, "continue", "--json")
+            self.assertEqual(self.snapshot(root), before, action)
+
+    def test_missing_or_invented_source_cannot_reuse_persistent_authority(self):
+        root = self.persistent()
+        self.spend(root)
+        self.patch_state(root, {"authority_source": "E-999999"})
+        before = self.snapshot(root)
+        cli(root, "continue", "--json")
+        self.assertEqual(self.snapshot(root), before)
+        _code, payload, _text = cli(root, "status", "--json")
+        self.assertNotEqual(payload.get("automation", {}).get("disposition"), "CONTINUE")
+
+    def test_iteration_does_not_call_a_persistent_checkpoint_a_human_wait(self):
+        root = self.persistent()
+        self.spend(root)
+        verdict = project_iteration_verdict(root)
+        self.assertFalse(verdict["requires_human"], verdict)
+        self.assertEqual(verdict["decision"], "AUTO_KICK", verdict)
+
+    def test_authority_from_a_different_goal_cannot_reset_the_budget(self):
+        root = self.persistent()
+        self.spend(root)
+        self.patch_state(root, {"goal_ingress": "goal-" + "f" * 16})
+        before = self.snapshot(root)
+        cli(root, "continue", "--json")
+        self.assertEqual(self.snapshot(root), before)
+
+    def test_inconsistent_authority_tuple_is_invalid(self):
+        root = self.persistent()
+        self.patch_state(root, {"safety_valve_mode": "hard_wait"})
+        _code, payload, _text = cli(root, "status", "--json")
+        self.assertNotEqual(payload.get("automation", {}).get("disposition"), "CONTINUE")
+
+    def test_intent_exit_removes_the_authority_family(self):
+        root = self.persistent()
+        text = codec.read_doc(root / ".saipen" / "STATE.md")
+        current = state.parse_state(state.transition_execution_intent(text, "normal"))
+        for key in (
+            "continuation_authority", "authority_source", "authority_until", "safety_valve_mode",
+        ):
+            self.assertNotIn(key, current)
+
+    def test_persistent_checkpoint_then_core_validator_is_green(self):
+        root = self.persistent()
+        self.spend(root)
+        code, _payload, text = cli(root, "continue", "--json")
+        self.assertEqual(code, 0, text)
+        code, payload, text = cli(root, "validate", "--json")
+        self.assertEqual(code, 0, text)
+        self.assertTrue(payload["ok"], text)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1618_future_maturation.py b/tools/test_t1618_future_maturation.py
new file mode 100644
index 00000000..9147066a
--- /dev/null
+++ b/tools/test_t1618_future_maturation.py
@@ -0,0 +1,370 @@
+"""T-1618 FUTURE GATE maturation: activation policy, no-spin witness, AUTO-14 perf.
+
+T-1614 proved ELIGIBLE-before-HUNT (matrix A-X, AUTO-01..16). What stayed
+unproven is the DEFERRED half of the lifecycle:
+
+- a reviewed DEFERRED gate whose activation conditions become true must mature
+  deterministically and route before HUNT (activation policy);
+- repeated maturation passes must converge instead of reconsidering forever
+  (no-spin witness);
+- the AUTO-14 corpus migration must be measured fast, not merely asserted.
+
+The normative owner is `saipen/FUTURE.md` (Rule FUTURE-GATE-01); the enforced
+activation policy lives on `future_gate.evaluate` (persisted maturation) plus
+`future_gate.select` (live readiness on the routing path). Every assertion here
+is a mechanical consequence of those two.
+"""
+
+from __future__ import annotations
+
+import shutil
+import sys
+import tempfile
+import time
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+import test_t1614_future_gate as H  # noqa: E402
+from saipen_engine import future_gate as gates  # noqa: E402
+from saipen_engine.board import parse_board  # noqa: E402
+from saipen_engine.router import future_gate_projection  # noqa: E402
+
+#: Generous wall-clock bounds for the measured AUTO-14 path. The live corpus
+#: migrates in ~0.03s on the reference host; the bound documents the order of
+#: magnitude (seconds, never minutes) while staying robust on slow CI.
+REFRESH_BUDGET_S = 10.0
+STATUS_BUDGET_S = 10.0
+
+
+def _tickets(project: Path) -> dict:
+    text = (project / ".saipen" / "BOARD.md").read_text(encoding="utf-8")
+    return parse_board(text)["tickets"]
+
+
+def _board(project: Path) -> str:
+    return (project / ".saipen" / "BOARD.md").read_text(encoding="utf-8")
+
+
+def _reviewed_deferred(project: Path, *, needs: str) -> tuple[str, str]:
+    """One legacy (unmarked) document refined to reviewed DEFERRED.
+
+    Returns (gate_id, needs_ticket_or_token). The reviewed record binds slice,
+    evidence and needs to the exact bytes; the document itself stays untouched.
+    """
+    doc = "# Old design note\n\nWe deferred this follow-up. Status: deferred.\n"
+    directory = project / "future_gate"
+    directory.mkdir(parents=True, exist_ok=True)
+    (directory / "old.md").write_text(doc, encoding="utf-8")
+    gates.refresh(project)
+    gid = gates.status(project)["gates"][0]["id"]
+    result = gates.refine(
+        project,
+        gid,
+        slice_text="implement the ONE bounded unit",
+        evidence=("evidence.md",),
+    )
+    assert result["code"] == "FUTURE_GATE_REFINED", result
+    record = gates.load_record(project, gid)
+    record["facts"]["needs"] = [needs] if needs != "none" else []
+    gates.write_record(project, gid, record)
+    gates.refresh(project)
+    gate = gates.get_gate(project, gid)
+    assert gate.state == gates.DEFERRED, gate.state
+    assert gate.reviewed is True
+    return gid, needs
+
+
+class DeferredActivationMatrixTests(unittest.TestCase):
+    def setUp(self):
+        self._tmp = []
+
+    def tearDown(self):
+        for base in self._tmp:
+            shutil.rmtree(base, ignore_errors=True)
+
+    def _proj(self, **kwargs):
+        base, project = H._project(**kwargs)
+        self._tmp.append(base)
+        return project
+
+    def test_M1_reviewed_deferred_matures_when_its_needs_close(self):
+        """M1: needs TODO hides the gate; needs DONE routes it before HUNT."""
+        project = self._proj()
+        tid = H._add(project, "prerequisite work")
+        gid, _ = _reviewed_deferred(project, needs=tid)
+
+        hidden = future_gate_projection(project, _board(project))
+        self.assertEqual(hidden.get("eligible"), [], hidden)
+
+        H._done(project, tid)
+        # No explicit evaluate on this path: routing readiness is live.
+        offered = future_gate_projection(project, _board(project))
+        self.assertEqual(offered.get("eligible"), [gid], offered)
+        routed = H._route(project)
+        self.assertEqual(routed["reason"], "future-gate-promotion", routed)
+        self.assertEqual(routed["action"], f"saipen future promote {gid}", routed)
+
+        # evaluate persists the activation; status agrees with routing.
+        evaluated = gates.evaluate(project, _tickets(project))
+        self.assertEqual(evaluated.get("next"), gid, evaluated)
+        self.assertEqual(gates.get_gate(project, gid).state, gates.ELIGIBLE)
+        self.assertEqual(gates.status(project, _tickets(project))["next"], gid)
+
+    def test_M2_a_needs_ticket_missing_from_board_is_not_eligible(self):
+        """M2: an activation condition nobody owns names its reason."""
+        project = self._proj()
+        gid, _ = _reviewed_deferred(project, needs="T-999")
+        proj = future_gate_projection(project, _board(project))
+        self.assertEqual(proj.get("eligible"), [], proj)
+        gate = gates.get_gate(project, gid)
+        verdict, reasons = gates.readiness(gate, project, _tickets(project))
+        self.assertEqual(verdict, gates.INELIGIBLE)
+        self.assertTrue(any("T-999" in reason for reason in reasons), reasons)
+
+    def test_M3_missing_evidence_is_not_eligible(self):
+        """M3: activation needs a repository path that exists."""
+        project = self._proj()
+        tid = H._add(project, "prerequisite work")
+        gid, _ = _reviewed_deferred(project, needs=tid)
+        H._done(project, tid)
+        (project / "evidence.md").unlink()
+        proj = future_gate_projection(project, _board(project))
+        self.assertEqual(proj.get("eligible"), [], proj)
+        gate = gates.get_gate(project, gid)
+        verdict, reasons = gates.readiness(gate, project, _tickets(project))
+        self.assertEqual(verdict, gates.INELIGIBLE)
+        self.assertTrue(any("evidence" in reason for reason in reasons), reasons)
+
+    def test_M4_a_gate_without_a_bounded_slice_is_not_eligible(self):
+        """M4: activation binds ONE slice; without it the gate waits."""
+        project = self._proj()
+        doc = "# Old design note\n\nWe deferred this follow-up. Status: deferred.\n"
+        H._write_gate(project, "old.md", doc)
+        gates.refresh(project)
+        gid = gates.status(project)["gates"][0]["id"]
+        # Refined with no bound facts: reviewed DEFERRED with no slice.
+        result = gates.refine(project, gid)
+        self.assertEqual(result["code"], "FUTURE_GATE_REFINED", result)
+        gates.refresh(project)
+        gate = gates.get_gate(project, gid)
+        self.assertEqual(gate.state, gates.DEFERRED)
+        self.assertIsNone(gate.slice)
+        proj = future_gate_projection(project, _board(project))
+        self.assertEqual(proj.get("eligible"), [], proj)
+        verdict, reasons = gates.readiness(gate, project, _tickets(project))
+        self.assertEqual(verdict, gates.INELIGIBLE)
+        self.assertIn("no bounded slice declared", reasons)
+
+    def test_M5_an_unreviewed_legacy_record_is_never_activated_by_guess(self):
+        """M5: ambiguity stays NEEDS_REVIEW and is offered for refinement."""
+        project = self._proj()
+        doc = "# Old design note\n\nWe deferred this follow-up. Status: deferred.\n"
+        H._write_gate(project, "old.md", doc)
+        gates.refresh(project)
+        proj = future_gate_projection(project, _board(project))
+        self.assertEqual(proj.get("eligible"), [], proj)
+        self.assertEqual(proj.get("refinable"), ["FG-0001"], proj)
+        gate = gates.get_gate(project, "FG-0001")
+        self.assertEqual(gate.state, gates.NEEDS_REVIEW)
+
+    def test_M6_an_edited_document_invalidates_its_review(self):
+        """M6: a review binds exact bytes; an edit returns the gate to review."""
+        project = self._proj()
+        tid = H._add(project, "prerequisite work")
+        gid, _ = _reviewed_deferred(project, needs=tid)
+        H._done(project, tid)
+        self.assertEqual(
+            future_gate_projection(project, _board(project)).get("eligible"), [gid]
+        )
+        path = project / "future_gate" / "old.md"
+        path.write_text(path.read_text(encoding="utf-8") + "\nMore context.\n", encoding="utf-8")
+        gates.refresh(project)
+        gate = gates.get_gate(project, gid)
+        self.assertEqual(gate.state, gates.NEEDS_REVIEW)
+        self.assertTrue(any("refine again" in r for r in gate.reasons), gate.reasons)
+        self.assertEqual(
+            future_gate_projection(project, _board(project)).get("eligible"), []
+        )
+        # Re-refinement rebinds the new bytes; the old verdict is not inherited.
+        result = gates.refine(
+            project,
+            gid,
+            slice_text="implement the ONE bounded unit",
+            evidence=("evidence.md",),
+        )
+        self.assertEqual(result["code"], "FUTURE_GATE_REFINED", result)
+        record = gates.load_record(project, gid)
+        record["facts"]["needs"] = [tid]
+        gates.write_record(project, gid, record)
+        gates.refresh(project)
+        gate = gates.get_gate(project, gid)
+        self.assertEqual(gate.state, gates.DEFERRED)
+        self.assertTrue(gate.reviewed)
+        self.assertEqual(
+            future_gate_projection(project, _board(project)).get("eligible"), [gid]
+        )
+
+    def test_M7_activation_persists_and_survives_refresh(self):
+        """M7: ELIGIBLE is sticky; refresh never demotes a matured gate."""
+        project = self._proj()
+        tid = H._add(project, "prerequisite work")
+        gid, _ = _reviewed_deferred(project, needs=tid)
+        H._done(project, tid)
+        gates.evaluate(project, _tickets(project))
+        self.assertEqual(gates.get_gate(project, gid).state, gates.ELIGIBLE)
+        gates.refresh(project)
+        gate = gates.get_gate(project, gid)
+        self.assertEqual(gate.state, gates.ELIGIBLE)
+        self.assertEqual(gate.reasons, ())
+        self.assertEqual(
+            future_gate_projection(project, _board(project)).get("eligible"), [gid]
+        )
+
+    def test_M8_a_machine_readable_gate_matures_the_same_way(self):
+        """M8: control parity -- header-carrying gates share the policy."""
+        project = self._proj()
+        tid = H._add(project, "prerequisite work", needs=None)
+        H._write_gate(project, "gate.md", H._gate_doc("FG-0001", needs=tid))
+        gates.refresh(project)
+        self.assertEqual(future_gate_projection(project, _board(project)).get("eligible"), [])
+        H._done(project, tid)
+        self.assertEqual(
+            future_gate_projection(project, _board(project)).get("eligible"), ["FG-0001"]
+        )
+
+
+class NoSpinWitnessTests(unittest.TestCase):
+    def setUp(self):
+        self._tmp = []
+
+    def tearDown(self):
+        for base in self._tmp:
+            shutil.rmtree(base, ignore_errors=True)
+
+    def _proj(self, **kwargs):
+        base, project = H._project(**kwargs)
+        self._tmp.append(base)
+        return project
+
+    def _pass(self, project: Path, gid: str) -> tuple[str, str, tuple]:
+        gates.refresh(project)
+        gates.evaluate(project, _tickets(project))
+        proj = future_gate_projection(project, _board(project))
+        gate = gates.get_gate(project, gid)
+        verdict, _ = gates.readiness(gate, project, _tickets(project))
+        return (gate.state, verdict, tuple(proj.get("eligible") or ()))
+
+    def test_W1_repeated_maturation_converges_and_writes_nothing_more(self):
+        """W1: the witness -- pass 1 activates, later passes are byte-stable."""
+        project = self._proj()
+        tid = H._add(project, "prerequisite work")
+        gid, _ = _reviewed_deferred(project, needs=tid)
+        H._done(project, tid)
+        trace = [self._pass(project, gid) for _ in range(4)]
+        for row in trace:
+            self.assertEqual(row, (gates.ELIGIBLE, gates.ELIGIBLE, (gid,)), trace)
+        index_path = project / ".saipen" / "future" / "index.json"
+        before = index_path.read_bytes()
+        gates.evaluate(project, _tickets(project))
+        self.assertEqual(index_path.read_bytes(), before)
+        # A reviewed record is offered exactly once: no second refinement.
+        again = gates.refine(project, gid)
+        self.assertEqual(again["code"], "FUTURE_GATE_NOT_AMBIGUOUS", again)
+
+    def test_W2_eligibility_tracks_the_verdict_never_a_stored_state(self):
+        """W2: BOARD flip-flops move routing with no state oscillation."""
+        project = self._proj()
+        tid = H._add(project, "prerequisite work")
+        gid, _ = _reviewed_deferred(project, needs=tid)
+        seen_states = []
+        H._done(project, tid)
+        seen_states.append(self._pass(project, gid))
+        # Reopen the prerequisite: routing hides the gate, stored state stays.
+        board_path = project / ".saipen" / "BOARD.md"
+        board_path.write_text(
+            f"## DOING\n## TODO\n- [ ] {tid} [P1] prerequisite work | verify: verify it\n"
+            "## DONE\n## BLOCKED\n",
+            encoding="utf-8",
+        )
+        seen_states.append(self._pass(project, gid))
+        H._done(project, tid)
+        seen_states.append(self._pass(project, gid))
+        self.assertEqual(
+            [row[2] for row in seen_states], [(gid,), (), (gid,)], seen_states
+        )
+        stored = [row[0] for row in seen_states]
+        self.assertNotIn(
+            (gates.ELIGIBLE, gates.DEFERRED), list(zip(stored, stored[1:])), stored
+        )
+
+
+class Auto14PerformanceTests(unittest.TestCase):
+    def setUp(self):
+        self._tmp = []
+
+    def tearDown(self):

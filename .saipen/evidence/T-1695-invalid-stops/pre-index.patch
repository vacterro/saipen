new file mode 100644
index 00000000..7712a06e
--- /dev/null
+++ b/tools/saipen_engine/iteration_verdict.py
@@ -0,0 +1,405 @@
+"""Public machine-facing iteration verdict (T-1619 finishing repair).
+
+The ONE canonical projection a host iteration controller queries after every
+model turn, so the host never has to manufacture canonical booleans itself::
+
+    saipen iteration --json [--caps-json JSON] [--executor ID]
+
+``goal_complete``, ``executable_action_remains``, ``operator_due`` and
+``valve_tripped`` are derived here from the canonical owners -- STATE, BOARD,
+the shared router, autonomy recall and the goal authority -- never from prose
+and never by duplicated protocol logic in the host. The projection delegates
+the final precedence to ``iteration.decide_turn``.
+
+Capability truth comes from the candidate harness, mapped onto semantic
+capabilities (MODEL != EXECUTOR): literal host tool names are translated, and
+an unknown or absent mandatory capability fails closed. Identity keys (model,
+provider, route name) never decide.
+"""
+
+from __future__ import annotations
+
+from collections.abc import Mapping
+from pathlib import Path
+
+from . import iteration
+from .board import parse_board
+from .router import route_next
+from .state import binding_brake, parse_state_or_error
+
+#: Version of the machine contract. A host that requires a newer schema than
+#: this must fail safe (never VALID_TERMINAL); see
+#: ``verdict_allows_goal_complete_ui``.
+ITERATION_VERDICT_SCHEMA = 1
+
+#: Closed semantic capability vocabulary for operational continuation.
+FILESYSTEM_READ = "filesystem_read"
+FILESYSTEM_WRITE = "filesystem_write"
+PROCESS_EXECUTION = "process_execution"
+GIT = "git"
+PYTHON = "python"
+PATCH_APPLICATION = "patch_application"
+
+SEMANTIC_CAPABILITIES = frozenset(
+    {
+        FILESYSTEM_READ,
+        FILESYSTEM_WRITE,
+        PROCESS_EXECUTION,
+        GIT,
+        PYTHON,
+        PATCH_APPLICATION,
+    }
+)
+
+#: Host tool names onto semantic capabilities. A host without a literal
+#: "patch" tool but with safe filesystem_write capability satisfies
+#: ``patch_application`` through that mapping. ``read_tabular`` and
+#: ``system_todo_write`` deliberately grant nothing: tabular reads plus todo
+#: writes are not repository mutation execution. Anything unlisted grants
+#: nothing (fail closed for unknown mandatory capabilities).
+_HOST_TOOL_ALIASES: dict[str, frozenset] = {
+    "filesystem": frozenset({FILESYSTEM_READ, FILESYSTEM_WRITE}),
+    "filesystem_read": frozenset({FILESYSTEM_READ}),
+    "file_read": frozenset({FILESYSTEM_READ}),
+    "read": frozenset({FILESYSTEM_READ}),
+    "filesystem_write": frozenset({FILESYSTEM_WRITE, PATCH_APPLICATION}),
+    "file_write": frozenset({FILESYSTEM_WRITE, PATCH_APPLICATION}),
+    "write_file": frozenset({FILESYSTEM_WRITE, PATCH_APPLICATION}),
+    "shell": frozenset({PROCESS_EXECUTION}),
+    "bash": frozenset({PROCESS_EXECUTION}),
+    "sh": frozenset({PROCESS_EXECUTION}),
+    "terminal": frozenset({PROCESS_EXECUTION}),
+    "process_execution": frozenset({PROCESS_EXECUTION}),
+    "command_execution": frozenset({PROCESS_EXECUTION}),
+    "exec": frozenset({PROCESS_EXECUTION}),
+    "patch": frozenset({PATCH_APPLICATION}),
+    "patch_application": frozenset({PATCH_APPLICATION}),
+    "apply_patch": frozenset({PATCH_APPLICATION}),
+    "git": frozenset({GIT}),
+    "python": frozenset({PYTHON}),
+    "python3": frozenset({PYTHON}),
+}
+
+#: Keys that name WHO the candidate is, never WHAT it can do. They are
+#: ignored by normalization even when truthy: MODEL != EXECUTOR.
+_IDENTITY_KEYS = frozenset(
+    {
+        "model",
+        "provider",
+        "route",
+        "candidate",
+        "id",
+        "name",
+        "executor",
+        "incarnation",
+        "variant",
+        "effort",
+        "harness",
+    }
+)
+
+
+def _cap_truthy(value: object) -> bool:
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        return value.strip().lower() in ("true", "yes", "1", "available", "granted")
+    if value is None:
+        return False
+    return bool(value)
+
+
+def normalize_capabilities(raw: Mapping[str, object] | None) -> frozenset:
+    """Map one candidate's advertised tools onto semantic capabilities.
+
+    Only explicit advertised truth counts; an absent, unknown or falsy tool
+    grants nothing (fail closed). Identity keys never grant.
+    """
+    granted: set[str] = set()
+    if not isinstance(raw, Mapping):
+        return frozenset()
+    for key, value in raw.items():
+        name = str(key).strip().lower()
+        if name in _IDENTITY_KEYS:
+            continue
+        if not _cap_truthy(value):
+            continue
+        granted.update(_HOST_TOOL_ALIASES.get(name, frozenset()))
+    return frozenset(granted & SEMANTIC_CAPABILITIES)
+
+
+def required_for_state(state_requires: object) -> frozenset:
+    """The semantic capability set operational continuation needs here.
+
+    STATE ``requires`` carries the repository half (filesystem/git/python);
+    running ``saipen continue`` and mutating the tree additionally needs
+    process execution and patch application. Unknown STATE tokens grant
+    nothing on the candidate side, so they stay required (fail closed).
+    """
+    if isinstance(state_requires, (list, tuple, set, frozenset)):
+        names = [str(item) for item in state_requires]
+    else:
+        names = []
+    required = set(normalize_capabilities({name: True for name in names}))
+    # STATE tokens with no alias (e.g. a future requirement) must still be
+    # satisfiable only by an explicit grant: keep the raw token so no
+    # candidate passes it by accident.
+    for name in names:
+        token = name.strip().lower()
+        if token and token not in _HOST_TOOL_ALIASES and token not in _IDENTITY_KEYS:
+            required.add(token)
+    required.update({PROCESS_EXECUTION, PATCH_APPLICATION})
+    return frozenset(required)
+
+
+def admit_normalized(
+    candidate: Mapping[str, object] | None,
+    required: object,
+) -> tuple[bool, frozenset]:
+    """Admit one candidate's raw tool map against the required set.
+
+    Normalizes first, then delegates to the canonical ``iteration.admit``
+    primitive. Pure: reads nothing but its arguments, writes nothing.
+    """
+    required_set = frozenset(required) if required is not None else frozenset()
+    granted = {name: True for name in normalize_capabilities(candidate)}
+    return iteration.admit(granted, required_set)
+
+
+def _unreadable(reason: str) -> dict:
+    """Fail-safe verdict when canonical state cannot be read whole.
+
+    A provider returning final text is only MODEL_TURN_FINISHED; an unreadable
+    checkpoint is never evidence of SAIPEN_GOAL_FINISHED, so this pauses at
+    the runtime level instead of completing.
+    """
+    return {
+        "schema_version": ITERATION_VERDICT_SCHEMA,
+        "decision": iteration.RUNTIME_PAUSED,
+        "goal_complete": False,
+        "executable_action_remains": False,
+        "operator_due": False,
+        "valve_tripped": False,
+        "requires_human": False,
+        "canonical_task": "none",
+        "phase": "UNKNOWN",
+        "next_action": "NONE",
+        "execution_intent": "UNKNOWN",
+        "executor_assessed": False,
+        "executor_compatible": False,
+        "executor_id": None,
+        "missing_capabilities": [],
+        "route_reason": "state-unreadable",
+        "route_action": "NONE",
+        "state_readable": False,
+        "state_detail": reason,
+        "recall_decision": None,
+    }
+
+
+def _recall_decision(root: Path) -> str | None:
+    """The autonomy-recall turn-entry decision, or None when unavailable.
+
+    Consumes the canonical owner (``cold_recovery.auto_recall``) instead of
+    re-deriving turn-entry truth; any failure degrades to None, never to a
+    STOP and never to a kick.
+    """
+    try:
+        from .cold_recovery import auto_recall
+    except (ImportError, ValueError):
+        return None
+    try:
+        recall = auto_recall(root, {})
+    except Exception:
+        return None
+    if not isinstance(recall, dict):
+        return None
+    turn = recall.get("turn")
+    if isinstance(turn, dict):
+        decision = turn.get("decision")
+        return str(decision) if decision else None
+    return None
+
+
+def project_iteration_verdict(
+    root: Path | str,
+    *,
+    executor_caps: Mapping[str, object] | None = None,
+    runtime_info_path: Path | str | None = None,
+    executor_id: str | None = None,
+    all_candidates_exhausted: bool = False,
+) -> dict:
+    """Derive the closed iteration verdict from canonical SAIPEN state.
+
+    Read-only: opens STATE.md/BOARD.md (and LOG.md through recall) and
+    writes nothing. ``executor_caps`` is the CURRENT candidate's advertised
+    tool map; when omitted the executor is unassessed (never a mismatch).
+    ``runtime_info_path`` is a ``saipen runtime`` JSON document whose
+    ``capabilities`` object is used when no explicit caps are given.
+    """
+    base = Path(root)
+    try:
+        state_text = (base / ".saipen" / "STATE.md").read_text(encoding="utf-8-sig")
+        board_text = (base / ".saipen" / "BOARD.md").read_text(encoding="utf-8-sig")
+    except OSError as exc:
+        return _unreadable(f"canonical checkpoint not readable: {exc}")
+    state, state_error = parse_state_or_error(state_text)
+    if state_error or not state:
+        return _unreadable(f"STATE not parseable whole: {state_error or 'empty'}")
+    try:
+        board = parse_board(board_text)
+        tickets = board["tickets"]
+    except (ValueError, KeyError, AttributeError, TypeError) as exc:
+        return _unreadable(f"BOARD not parseable whole: {exc}")
+    if board.get("errors"):
+        verdict = _unreadable("BOARD carries parse errors: " + "; ".join(board["errors"][:3]))
+        verdict["decision"] = iteration.OPERATOR_WAIT
+        verdict["requires_human"] = True
+        verdict["route_reason"] = "board-malformed"
+        verdict["phase"] = str(state.get("phase") or "UNKNOWN")
+        verdict["canonical_task"] = str(state.get("task") or "none")
+        verdict["next_action"] = str(state.get("next_action") or "NONE")
+        return verdict
+
+    from .operations import GOAL_TICKET_CAP, GOAL_WAVE_CAP
+
+    phase = str(state.get("phase") or "UNKNOWN")
+    task = state.get("task")
+    canonical_task = str(task) if task not in (None, "") else "none"
+    next_action = str(state.get("next_action") or "NONE")
+    intent = state.get("execution_intent")
+
+    valve_tripped = bool(
+        intent == "goal"
+        and (
+            int(state.get("goal_waves") or 0) >= GOAL_WAVE_CAP
+            or int(state.get("goal_tickets") or 0) >= GOAL_TICKET_CAP
+        )
+    )
+
+    empty_todo = not any(t.get("section") == "## TODO" for t in tickets.values())
+    brake = binding_brake(state, empty_todo=empty_todo)
+    operator_due = brake is not None
+
+    recall = _recall_decision(base)
+    if recall in ("OPERATOR_WAIT", "USER_INPUT"):
+        operator_due = True
+
+    try:
+        routed = route_next(state_text, board_text)
+    except Exception:
+        routed = {}
+    route_reason = str(routed.get("reason") or "unknown")
+    route_action = str(routed.get("action") or "NONE")
+    executable_behavior = str(routed.get("executable_behavior") or "")
+    if routed.get("ok") is True:
+        executable_action_remains = (
+            executable_behavior != "RESTATE_AND_STOP"
+            and route_reason
+            not in (
+                "maintain",
+                "bootstrap",
+                "read-only-mode",
+                "wait",
+                "unblock",
+                "checkpoint-invalid",
+                "state-malformed",
+                "board-malformed",
+                "capability-invalid",
+            )
+            and route_action != "saipen status"
+        )
+    else:
+        # Recovery work is real executable work: the next iteration runs it.
+        executable_action_remains = (
+            route_reason in ("recovery-pending", "recovery-conflict")
+            and route_action == "saipen recover"
+        )
+
+    doing = [t for t in tickets.values() if t.get("section") == "## DOING"]
+    blocked = [t for t in tickets.values() if t.get("section") == "## BLOCKED"]
+    todo = [t for t in tickets.values() if t.get("section") == "## TODO"]
+    goal_complete = bool(
+        phase == "DONE"
+        and canonical_task == "none"
+        and not doing
+        and not blocked
+        and not todo
+    )
+
+    caps: Mapping[str, object] | None = executor_caps
+    if caps is None and runtime_info_path is not None:
+        try:
+            import json
+
+            blob = Path(runtime_info_path).read_bytes()
+            if len(blob) > 65536:
+                raise ValueError("runtime info exceeds 64 KiB")
+            document = json.loads(blob.decode("utf-8"))
+            if isinstance(document, dict) and isinstance(
+                document.get("capabilities"), dict
+            ):
+                caps = document["capabilities"]
+        except (OSError, ValueError, UnicodeDecodeError):
+            caps = None
+    required = required_for_state(state.get("requires"))
+    if caps is None:
+        assessed = False
+        compatible = True
+        missing: frozenset = frozenset()
+    else:
+        assessed = True
+        compatible, missing = admit_normalized(caps, required)
+    if all_candidates_exhausted and (not assessed or not compatible):
+        compatible = False
+
+    decision = iteration.decide_turn(
+        executor_compatible=compatible,
+        goal_complete=goal_complete,
+        executable_action_remains=executable_action_remains,
+        operator_due=operator_due,
+        valve_tripped=valve_tripped,
+        all_candidates_exhausted=bool(all_candidates_exhausted and not compatible),
+    )
+    return {
+        "schema_version": ITERATION_VERDICT_SCHEMA,
+        "decision": decision,
+        "goal_complete": goal_complete,
+        "executable_action_remains": executable_action_remains,
+        "operator_due": operator_due,
+        "valve_tripped": valve_tripped,
+        "requires_human": decision == iteration.OPERATOR_WAIT,
+        "canonical_task": canonical_task,
+        "phase": phase,
+        "next_action": next_action,
+        "execution_intent": str(intent) if intent else "normal",
+        "executor_assessed": assessed,
+        "executor_compatible": compatible,
+        "executor_id": executor_id,
+        "missing_capabilities": sorted(missing),
+        "route_reason": route_reason,
+        "route_action": route_action,
+        "state_readable": True,
+        "recall_decision": recall,
+    }
+
+
+def verdict_allows_goal_complete_ui(verdict: object) -> bool:
+    """May the host UI report goal completion on this verdict? One gate.
+
+    True only for a known-schema verdict whose decision is VALID_TERMINAL
+    with proven terminality on readable state. Unknown schemas, unknown
+    decisions, missing fields and unreadable state all refuse: an unknown
+    verdict is never evidence of completion.
+    """
+    if not isinstance(verdict, dict):
+        return False
+    if verdict.get("schema_version") != ITERATION_VERDICT_SCHEMA:
+        return False
+    if verdict.get("decision") not in iteration.TURN_DECISIONS:
+        return False
+    if verdict.get("state_readable") is False:
+        return False
+    if verdict.get("goal_complete") is not True:
+        return False
+    return iteration.may_report_goal_complete(str(verdict.get("decision")))
diff --git a/tools/saipen_engine/lifecycle_authority.py b/tools/saipen_engine/lifecycle_authority.py
new file mode 100644
index 00000000..88cc4246
--- /dev/null
+++ b/tools/saipen_engine/lifecycle_authority.py
@@ -0,0 +1,223 @@
+"""Lifecycle authority: canonical state that no journaled operation produced.
+
+Defect class this owns (T-1671, SRC-192). An executor that could not reach the
+SAIPEN control route wrote STATE, BOARD and LOG by hand in the documented field
+shapes: a `## DONE` row with `closure_mode`, RFC-shaped LOG events, a STATE
+whose `last_event` named its own hand-typed tail. Every reader accepted the
+bytes because they parse. The phantom-DONE and journal-gap recoveries already
+in `reconcile` judge a closure by BOARD fields and by LOG prose, and both are
+exactly what a hand can type.
+
+What a hand cannot type is an operation record. Every canonical operation
+appends its LOG event with an `[op: ...]` id and leaves a journal record under
+the recovery tree, and every operation that appends an event also writes
+`STATE.last_event`. So the newest LOG event whose id resolves to a record -- the
+FLOOR -- is the last point this checkout can prove an operation reached, and
+two facts above it have no operation behind them:
+
+  * `state-ahead-of-journal`: `STATE.last_event` names an event above the
+    floor. Only an operation moves that marker, and the event it names would
+    be the operation's own.
+  * `terminal-without-operation`: a `## DONE` ticket is named by an event above
+    the floor and no closure operation stands behind it at or below the floor.
+
+The boundary is self-establishing, like every provenance boundary here: with no
+ledger on the checkout (a fresh clone, a consumer copy) or no resolvable event
+at all, the verdict is UNAVAILABLE, never a finding. History at or below the
+floor is never judged, so closures that predate this contract are untouched --
+and because no operation may build on an unauthorized head (`operations._read`
+refuses), a new hand-written head can never sink below a later floor unseen.
+
+Not covered, and named so nobody reads it as covered: a BOARD row flipped to
+DONE with no LOG event and no STATE change leaves no trace this module reads.
+Closing that needs the journal to record the terminal set it wrote.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+from pathlib import Path
+
+#: The class this module names, in every refusal detail, finding and trace.
+CLASS = "UNAUTHORIZED_LIFECYCLE_WRITE"
+
+#: The refusal CODE. Deliberately the registered code every consumer already
+#: routes to recovery, not a new one: `command_resolution` (REGISTRY.json +
+#: COMMANDS.md) stands 10 bytes under its budget and a registry code costs
+#: 34, so the class rides the detail until that budget is decided (T-1639).
+CODE = "PROTOCOL_STATE_INVALID"
+
+#: The `_read(observe=...)` damage class a recovery planner names to see an
+#: unauthorized head instead of being refused by it.
+OBSERVABLE = "lifecycle_authority"
+
+AUTHORIZED = "AUTHORIZED"
+UNAVAILABLE = "UNAVAILABLE"
+UNAUTHORIZED = "UNAUTHORIZED"
+
+STATE_AHEAD = "state-ahead-of-journal"
+TERMINAL_UNBACKED = "terminal-without-operation"
+
+#: The recovery class every repair atom of this module carries.
+REPAIR_CLASS = "unauthorized-lifecycle-write"
+
+#: Operation classes that move a ticket into `## DONE` (or let an existing
+#: closure stand: `reconcile-` carries the legacy attestation and adoption
+#: decisions). A ticket with one of these at or below the floor was closed by
+#: an operation, and a hand-written note about it afterwards is only a note.
+CLOSURE_OP_CLASSES = (
+    "finish-",
+    "supersede-",
+    "resolve-external-",
+    "retire-",
+    "crew-defer-",
+    "crew-closure-",
+    "reconcile-",
+)
+
+#: Newest events examined while looking for the floor. The floor is normally
+#: the newest event itself; the bound only caps a pathological tail.
+_TAIL_WINDOW = 4096
+
+_TARGET_RE = re.compile(r"\[target: (T-\d+)\]")
+
+
+def _event_number(event: dict) -> int | None:
+    number = event.get("event")
+    if isinstance(number, int) and not isinstance(number, bool):
+        return number
+    return None
+
+
+def _resolver(root: Path):
+    """`(ledger_present, resolves)` for this checkout.
+
+    The cheap answer is a directory probe for the one id asked about; the full
+    ledger (which also reads the settled index that survives compaction) is
+    loaded once, and only for an id the probe did not find.
+    """
+    from .journal import OPS_DIR, SETTLED_DIR, resolvable_op_ids
+
+    ops = root / OPS_DIR
+    settled = root / SETTLED_DIR
+    present = ops.is_dir() or settled.is_dir()
+    full: list[set[str]] = []
+
+    def resolves(op_id: str | None) -> bool:
+        if not op_id or op_id in (".", "..") or "/" in op_id or "\\" in op_id:
+            return False
+        if os.path.exists(ops / op_id) or os.path.exists(settled / op_id):
+            return True
+        if not full:
+            full.append(resolvable_op_ids(root))
+        return op_id in full[0]
+
+    return present, resolves
+
+
+def _closed_by_operation(events, ticket: str, floor: int) -> bool:
+    """Does a closure operation stand behind this ticket at or below the floor?
+
+    Scoped to the ticket's newest canonical claim, for the reason
+    `reconcile._ticket_epoch` gives: an older completion never authorizes a
+    lifecycle that was claimed again after it.
+    """
+    epoch = 0
+    closures: list[int] = []
+    for event in events:
+        number = _event_number(event)
+        if number is None or number > floor or event.get("ticket") != ticket:
+            continue
+        op_id = str(event.get("op_id") or "")
+        if op_id.startswith("claim-") and str(event.get("text") or "").startswith(
+            "claimed via SAIOPS"
+        ):
+            epoch = max(epoch, number)
+        elif op_id.startswith(CLOSURE_OP_CLASSES):
+            closures.append(number)
+    return any(number >= epoch for number in closures)
+
+
+def assess(root: Path | str, state: dict | None, board: dict | None, events) -> dict:
+    """The lifecycle-authority verdict for the live canonical files.
+
+    `events` is the complete parsed history (sealed and active), as
+    `log.read_history_snapshot(...).events` returns it. Read-only.
+    """
+    root = Path(root)
+    verdict = {"status": UNAVAILABLE, "floor": None, "head": [], "findings": [], "detail": ""}
+    numbered = [event for event in (events or ()) if _event_number(event) is not None]
+    if not numbered:
+        return verdict
+    present, resolves = _resolver(root)
+    if not present:
+        return verdict
+    tail = sorted(numbered[-_TAIL_WINDOW:], key=_event_number, reverse=True)
+    floor = None
+    head: list[dict] = []
+    for event in tail:
+        if resolves(event.get("op_id")):
+            floor = _event_number(event)
+            break
+        head.append(event)
+    if floor is None:
+        return verdict
+    verdict["floor"] = floor
+    verdict["head"] = sorted(_event_number(event) for event in head)
+    findings: list[dict] = []
+    last_event = (state or {}).get("last_event")
+    if isinstance(last_event, int) and not isinstance(last_event, bool) and last_event > floor:
+        findings.append(
+            {
+                "rule": STATE_AHEAD,
+                "last_event": last_event,
+                "floor": floor,
+                "detail": (
+                    f"STATE.last_event is E-{last_event}, above E-{floor}, the newest "
+                    "event an operation record stands behind -- only an operation "
+                    "moves that marker, so STATE was advanced by hand"
+                ),
+            }
+        )
+    named: dict[str, list[int]] = {}
+    for event in head:
+        tickets = {event.get("ticket")} | set(_TARGET_RE.findall(event.get("text") or ""))
+        for ticket in tickets:
+            if ticket:
+                named.setdefault(ticket, []).append(_event_number(event))
+    for ticket, ticket_events in sorted(named.items()):
+        row = ((board or {}).get("tickets") or {}).get(ticket)
+        if not isinstance(row, dict) or row.get("section") != "## DONE":
+            continue
+        if _closed_by_operation(numbered, ticket, floor):
+            continue
+        shown = ", ".join(f"E-{number}" for number in sorted(ticket_events)[:4])
+        findings.append(
+            {
+                "rule": TERMINAL_UNBACKED,
+                "ticket": ticket,
+                "events": sorted(ticket_events),
+                "floor": floor,
+                "detail": (
+                    f"{ticket} sits under ## DONE on the word of {shown}, written "
+                    f"above E-{floor} with no operation record, and no closure "
+                    "operation stands behind it -- the completion was typed, not run"
+                ),
+            }
+        )
+    verdict["findings"] = findings
+    verdict["status"] = UNAUTHORIZED if findings else AUTHORIZED
+    verdict["detail"] = "; ".join(finding["detail"] for finding in findings[:3])
+    return verdict
+
+
+def refusal_detail(verdict: dict) -> str:
+    """One line for a refusal: what is unauthorized and the command that owns it."""
+    return (
+        f"lifecycle-authority: {CLASS} -- "
+        + verdict.get("detail", "")
+        + " -- canonical lifecycle state exists only through an operation; "
+        "`saipen recover` names the journaled repair that reopens what no "
+        "operation closed"
+    )
diff --git a/tools/saipen_engine/native_host_policy.py b/tools/saipen_engine/native_host_policy.py
new file mode 100644
index 00000000..b96796b1
--- /dev/null
+++ b/tools/saipen_engine/native_host_policy.py
@@ -0,0 +1,94 @@
+"""Compile the canonical host taxonomy into the self-contained native plugin.
+
+The installed OpenCode plugin must still decide an integration gap when Python
+or the skill runtime is missing. This checked facet contains decisions computed
+by host_taxonomy; it is not a second policy owner. Regenerate with
+`python -m saipen_engine.native_host_policy --write` from tools/.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+from pathlib import Path
+
+from . import host_taxonomy as taxonomy
+from . import paths
+
+BEGIN = "// BEGIN GENERATED HOST-INTEGRATION-01 POLICY"
+END = "// END GENERATED HOST-INTEGRATION-01 POLICY"
+GAP_CODES = {
+    "SAIPEN_GUARD_UNINSTALLED": "ENGINE_UNREACHABLE",
+    "SAIPEN_GUARD_UNREACHABLE": "ENGINE_UNREACHABLE",
+    "PLUGIN_RESTART_REQUIRED": "PLUGIN_RESTART_REQUIRED",
+}
+
+
+def facet() -> dict:
+    """Closed data read by the native transport without an interpreter."""
+    placeholder = "lineage-" + "f" * 32
+    canonical_identity = re.escape(paths.identity_file_content(placeholder))
+    canonical_identity = canonical_identity.replace(
+        re.escape(placeholder), "(lineage-[0-9a-f]{32})"
+    )
+    canonical_identity = canonical_identity.replace("\\\n", "\\r?\\n")
+    return {
+        "version": 1,
+        "default_mode": taxonomy.DEFAULT_MODE,
+        "strict_mode": taxonomy.MODE_STRICT,
+        "aliases": taxonomy.MODE_ALIASES,
+        "labels": taxonomy.MODE_LABELS,
+        "gap_codes": GAP_CODES,
+        "identity_observation": {
+            "root_env": paths.ENV_PROJECT_ROOT,
+            "lineage_env": paths.ENV_PROJECT_LINEAGE,
+            "memory_dir": paths.SAIPEN_DIR,
+            "identity_file": paths.IDENTITY_NAME,
+            "canonical_pattern": "^" + canonical_identity + "$",
+            "max_bytes": 4096,
+        },
+        "failures": {
+            code: {
+                "decisions": {
+                    mode: taxonomy.decide(mode, [{"code": code}])
+                    for mode in taxonomy.MODES
+                },
+                "operator_action": taxonomy.get(code).operator_action,
+            }
+            for code in taxonomy.codes()
+        },
+    }
+
+
+def fragment() -> str:
+    return (
+        BEGIN + "\nconst HOST_INTEGRATION_POLICY = "
+        + json.dumps(facet(), indent=2, ensure_ascii=False)
+        + ";\n" + END
+    )
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--write", action="store_true")
+    parser.add_argument("--plugin", type=Path)
+    args = parser.parse_args()
+    plugin = args.plugin or (
+        Path(__file__).resolve().parents[2]
+        / "extensions/adapters/opencode/saipen-guard.js"
+    )
+    text = plugin.read_text(encoding="utf-8")
+    first = text.index(BEGIN)
+    last = text.index(END, first) + len(END)
+    expected = fragment()
+    matches = text[first:last] == expected
+    if args.write and not matches:
+        plugin.write_text(text[:first] + expected + text[last:], encoding="utf-8")
+        matches = True
+    print(json.dumps({"ok": matches, "plugin": str(plugin)}))
+    return 0 if matches else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/saipen_engine/path_launcher.py b/tools/saipen_engine/path_launcher.py
new file mode 100644
index 00000000..dd973bcd
--- /dev/null
+++ b/tools/saipen_engine/path_launcher.py
@@ -0,0 +1,326 @@
+"""The per-user PATH launcher: `saipen` typed in any shell (T-1678, SRC-192).
+
+PATH_LAUNCHER is the first transport of `SAIPEN_ENTRY.json`, and until this
+module nothing created one. Measured on the operator's machine on 2026-10-08:
+every host answered degraded `no_canonical_path_launcher`, and an executor
+that typed `saipen` got "command not found" until two hand copies of the
+launchers were put in a directory on PATH (E-13246). A hand copy goes stale the
+moment the launcher it was copied from is re-rendered, and nothing reports it.
+
+One owner, three facts:
+
+* **Directory.** A DECLARED per-user directory: the first of `declared_dirs`
+  that is already on PATH. Nothing outside the account's home is written, and
+  PATH is never edited -- when no declared directory is on PATH the status
+  says so and names the one to add.
+* **Bytes.** Both launchers in the one form `bootstrap/cli_launcher.py`
+  renders for a home's own `bin/`: the canonical engine run by an interpreter
+  that exists. `entry_resolver.prove_launcher` proves them from their bytes,
+  exactly as it proves any other launcher.
+* **Ownership.** `<home>/.saipen/path-launcher.json` names every file this
+  module wrote with its digest. A file is replaced or removed only while it is
+  ours and unchanged, or while it already proves the canonical engine (a hand
+  copy of this home's own launcher, which install adopts). Any other `saipen`
+  in the directory belongs to someone else and is never touched.
+
+The uninstallers read the same record (`bootstrap/install_ownership.py
+remove-launcher`, or natively), so `install`, `status` and removal agree on
+one definition of "ours".
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import json
+import os
+import shutil
+import sys
+from pathlib import Path
+
+from . import entry_resolver
+
+SCHEMA = 1
+KIND = "saipen-path-launcher"
+RECORD = "path-launcher.json"
+WINDOWS_NAME = "saipen.cmd"
+POSIX_NAME = "saipen"
+
+CODE_READY = "PATH_LAUNCHER_READY"
+CODE_ABSENT = "PATH_LAUNCHER_ABSENT"
+CODE_STALE = "PATH_LAUNCHER_STALE"
+CODE_FOREIGN = "PATH_LAUNCHER_FOREIGN"
+CODE_SHADOWED = "PATH_LAUNCHER_SHADOWED"
+CODE_NO_DIRECTORY = "PATH_LAUNCHER_NO_DIRECTORY"
+CODE_INSTALLED = "PATH_LAUNCHER_INSTALLED"
+CODE_CURRENT = "PATH_LAUNCHER_CURRENT"
+CODE_REMOVED = "PATH_LAUNCHER_REMOVED"
+
+INSTALL_ACTION = "saipen host launcher install"
+#: The states `host repair` brings back: a launcher that is missing, or ours
+#: and no longer proving, or a hand copy that proves and is nobody's.
+REPAIRABLE = (CODE_ABSENT, CODE_STALE)
+
+
+def names() -> tuple[str, ...]:
+    """The launcher files of this platform. Windows gets both, because Git
+    Bash on Windows resolves the extensionless `saipen` and cmd.exe and
+    PowerShell resolve `saipen.cmd`."""
+    return (WINDOWS_NAME, POSIX_NAME) if os.name == "nt" else (POSIX_NAME,)
+
+
+def declared_dirs(home: Path | str | None = None) -> list[Path]:
+    """The per-user directories a PATH launcher may live in, in order. All of
+    them are inside the account's home; none is created unless PATH already
+    names it."""
+    base = Path(home) if home is not None else Path.home()
+    if os.name == "nt":
+        return [base / "bin", base / ".local" / "bin"]
+    return [base / ".local" / "bin", base / "bin"]
+
+
+def record_path(home: Path | str | None = None) -> Path:
+    base = Path(home) if home is not None else Path.home()
+    return base / ".saipen" / RECORD
+
+
+def render(python: str, engine: str) -> dict[str, bytes]:
+    """The exact bytes `bootstrap/cli_launcher.render_launchers` writes (the
+    test module pins the two equal): the form `prove_launcher` parses."""
+
+    def dq(value: str) -> str:
+        return '"' + str(value).replace('"', '\\"') + '"'
+
+    windows = "@echo off\r\n" + dq(python) + " " + dq(engine) + " %*\r\n"
+    posix = "#!/bin/sh\nexec " + dq(python) + " " + dq(engine) + ' "$@"\n'
+    rendered = {WINDOWS_NAME: windows.encode("utf-8"), POSIX_NAME: posix.encode("utf-8")}
+    return {name: rendered[name] for name in names()}
+
+
+def _digest(path: Path) -> str | None:
+    try:
+        return hashlib.sha256(path.read_bytes()).hexdigest()
+    except OSError:
+        return None
+
+
+def _norm(path: Path | str) -> str:
+    return os.path.normcase(os.path.abspath(str(path)))
+
+
+def _path_entries(env: dict) -> list[str]:
+    return [_norm(item) for item in str(env.get("PATH") or "").split(os.pathsep) if item.strip()]
+
+
+def select_dir(home: Path | str | None = None, env: dict | None = None) -> Path | None:
+    """The first declared directory PATH names, or None."""
+    entries = _path_entries(dict(os.environ if env is None else env))
+    for candidate in declared_dirs(home):
+        if _norm(candidate) in entries:
+            return candidate
+    return None
+
+
+def read_record(home: Path | str | None = None) -> dict:
+    """`{absolute path: sha256}` of the files this module wrote. A missing or
+    unreadable record owns nothing."""
+    try:
+        payload = json.loads(record_path(home).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return {}
+    files = payload.get("files") if isinstance(payload, dict) else None
+    if not isinstance(files, dict):
+        return {}
+    return {str(path): str(digest) for path, digest in files.items() if isinstance(digest, str)}
+
+
+def _owned(path: Path, record: dict) -> bool:
+    digest = _digest(path)
+    return digest is not None and any(
+        _norm(owned) == _norm(path) and expected == digest for owned, expected in record.items()
+    )
+
+
+def status(
+    engine: Path | str,
+    home: Path | str | None = None,
+    env: dict | None = None,
+) -> dict:
+    """The PATH launcher as the doctor reports it. Read-only."""
+    source_env = dict(os.environ if env is None else env)
+    directory = select_dir(home, source_env)
+    report: dict = {
+        "ok": False,
+        "code": CODE_NO_DIRECTORY,
+        "directory": str(directory) if directory else None,
+        "declared": [str(item) for item in declared_dirs(home)],
+        "engine": str(engine),
+        "files": {},
+        "reasons": [],
+        "action": None,
+    }
+    if directory is None:
+        report["reasons"].append(
+            "no declared per-user directory is on PATH: " + " or ".join(report["declared"])
+        )
+        report["action"] = f"add {report['declared'][0]} to PATH, then {INSTALL_ACTION}"
+        return report
+    record = read_record(home)
+    present = absent = foreign = stale = 0
+    for name in names():
+        path = directory / name
+        if not path.is_file():
+            report["files"][name] = "absent"
+            absent += 1
+            continue
+        present += 1
+        proof = entry_resolver.prove_launcher(path, engine)
+        owned = _owned(path, record)
+        if owned and proof["ok"]:
+            report["files"][name] = "owned"
+        elif proof["ok"]:
+            report["files"][name] = "unowned-proving"
+            stale += 1
+            report["reasons"].append(f"{path} proves the engine but no installer owns it")
+        elif owned:
+            report["files"][name] = "owned-stale"
+            stale += 1
+            report["reasons"].append(f"{path}: {proof['why']}")
+        else:
+            report["files"][name] = "foreign"
+            foreign += 1
+            report["reasons"].append(f"{path} is not ours and does not prove: {proof['why']}")
+    if foreign:
+        report["code"] = CODE_FOREIGN
+        report["action"] = (
+            f"remove or rename the foreign launcher in {directory}, then {INSTALL_ACTION}"
+        )
+        return report
+    if not present:
+        report["code"] = CODE_ABSENT
+        report["action"] = INSTALL_ACTION
+        return report
+    if stale or absent:
+        report["code"] = CODE_STALE
+        if absent:
+            report["reasons"].append("one launcher of the pair is missing")
+        report["action"] = INSTALL_ACTION
+        return report
+    which = shutil.which("saipen", path=source_env.get("PATH", ""))
+    if which is None or Path(_norm(which)).parent != Path(_norm(directory)):
+        report["code"] = CODE_SHADOWED
+        report["shadowed_by"] = which
+        report["reasons"].append(f"`saipen` resolves to {which}, earlier on PATH than {directory}")
+        report["action"] = f"move {directory} ahead of {Path(str(which)).parent} on PATH"
+        return report
+    report["ok"] = True
+    report["code"] = CODE_READY
+    return report
+
+
+def install(
+    engine: Path | str,
+    home: Path | str | None = None,
+    env: dict | None = None,
+    python: str | None = None,
+) -> dict:
+    """Write both launchers into the selected directory and own them.
+
+    Idempotent. Refuses, and writes nothing, when no declared directory is on
+    PATH or when a launcher there is someone else's.
+    """
+    before = status(engine, home, env)
+    if before["code"] in (CODE_NO_DIRECTORY, CODE_FOREIGN):
+        return {**before, "ok": False}
+    directory = Path(before["directory"])
+    interpreter = str(Path(python or sys.executable))
+    if not Path(interpreter).is_file():
+        return {
+            **before,
+            "ok": False,
+            "reasons": [f"the interpreter does not exist: {interpreter}"],
+        }
+    if before["code"] in (CODE_READY, CODE_SHADOWED):
+        return {**before, "ok": True, "code": CODE_CURRENT, "status": before["code"]}
+    record = read_record(home)
+    try:
+        directory.mkdir(parents=True, exist_ok=True)
+        for name, payload in render(interpreter, str(engine)).items():
+            target = directory / name
+            temporary = target.with_name(f".{name}.saipen-{os.getpid()}")
+            temporary.write_bytes(payload)
+            if name == POSIX_NAME:
+                with contextlib.suppress(OSError):
+                    temporary.chmod(0o755)
+            os.replace(temporary, target)
+            record = {
+                path: digest for path, digest in record.items() if _norm(path) != _norm(target)
+            }
+            record[str(target)] = hashlib.sha256(payload).hexdigest()
+        _write_record(home, record)
+    except OSError as exc:
+        return {**before, "ok": False, "reasons": [f"{type(exc).__name__}: {exc}"]}
+    after = status(engine, home, env)
+    return {
+        **after,
+        "ok": after["code"] in (CODE_READY, CODE_SHADOWED),
+        "code": CODE_INSTALLED,
+        "status": after["code"],
+        "previous": before["code"],
+    }
+
+
+def remove(home: Path | str | None = None) -> dict:
+    """Delete every launcher the record names whose bytes are still ours, then
+    the record. A file someone changed since it was written stays."""
+    record = read_record(home)
+    declared = {_norm(item) for item in declared_dirs(home)}
+    removed: list[str] = []
+    kept: list[str] = []
+    for owned, expected in record.items():
+        path = Path(owned)
+        if _norm(path.parent) not in declared or path.name not in (WINDOWS_NAME, POSIX_NAME):
+            kept.append(owned)
+            continue
+        if _digest(path) == expected:
+            with contextlib.suppress(FileNotFoundError):
+                path.unlink()
+            removed.append(owned)
+        elif path.exists():
+            kept.append(owned)
+    with contextlib.suppress(FileNotFoundError):
+        record_path(home).unlink()
+    return {"ok": True, "code": CODE_REMOVED, "removed": removed, "kept": kept}
+
+
+def _write_record(home: Path | str | None, files: dict) -> None:
+    path = record_path(home)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    body = json.dumps({"schema": SCHEMA, "kind": KIND, "files": files}, indent=2, sort_keys=True)
+    temporary = path.with_name(f".{path.name}.{os.getpid()}")
+    temporary.write_text(body + "\n", encoding="utf-8")
+    os.replace(temporary, path)
+
+
+__all__ = [
+    "CODE_ABSENT",
+    "CODE_CURRENT",
+    "CODE_FOREIGN",
+    "CODE_INSTALLED",
+    "CODE_NO_DIRECTORY",
+    "CODE_READY",
+    "CODE_REMOVED",
+    "CODE_SHADOWED",
+    "CODE_STALE",
+    "INSTALL_ACTION",
+    "REPAIRABLE",
+    "declared_dirs",
+    "install",
+    "names",
+    "read_record",
+    "record_path",
+    "remove",
+    "render",
+    "select_dir",
+    "status",
+]
diff --git a/tools/saipen_engine/project_block.py b/tools/saipen_engine/project_block.py
new file mode 100644
index 00000000..f861c0c0
--- /dev/null
+++ b/tools/saipen_engine/project_block.py
@@ -0,0 +1,510 @@
+"""The SAIPEN block inside a project's own instruction file (T-1654, SRC-188).
+
+An older generation told the agent that created a project to write a block
+between `<!-- SAIPEN:BEGIN -->` and `<!-- SAIPEN:END -->` into the project's
+`AGENTS.md`. That block names an absolute path into the profile of whoever ran
+the agent and tells the reader to clone the public repository when the path is
+missing. Every later generation stopped writing it and none reported it, so it
+outlives every upgrade: an account that cannot read the named path is told to
+clone, and the machine runtime that exists for exactly that account is never
+tried.
+
+This module is the one owner of that block. It reads the project's instruction
+files, says which carry a block of another generation, and replaces such a
+block with the current one. Three properties are the whole contract:
+
+* the current block is RELOCATABLE -- no absolute path, only the launcher
+  order every account can follow -- so it is one constant, compared by content;
+* the repair replaces the bytes from the opening marker to the closing marker
+  and nothing else. Files are handled as bytes, never decoded, so whatever
+  surrounds the block survives in whatever encoding it was written;
+* a block is never created, and text outside the markers is never rewritten:
+  the markers are the only bytes in a project file that are SAIPEN's.
+
+The block names its own revision. Two installs of different generations reach
+one project (the operator's installed copy and the machine runtime are
+refreshed at different moments), and without it each would rewrite the
+other's block on every run. An engine leaves a HIGHER revision alone -- unless
+that block breaks a rule every revision keeps (it tells the reader to clone,
+or names an absolute path), in which case the number is not believed.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import re
+import stat
+from pathlib import Path
+
+from .paths import safe_atomic_write_bytes
+
+BEGIN = b"<!-- SAIPEN:BEGIN -->"
+END = b"<!-- SAIPEN:END -->"
+
+#: The files a host reads from a project root as standing instructions. A
+#: closed list: the block is looked for where a host would load it, never by
+#: walking the project.
+INSTRUCTION_FILES = (
+    "AGENTS.md",
+    "CLAUDE.md",
+    "GEMINI.md",
+    ".cursorrules",
+    ".windsurfrules",
+    ".clinerules",
+    ".github/copilot-instructions.md",
+)
+
+#: An instruction file is prose. One larger than this is not read into memory.
+MAX_BYTES = 4 * 1024 * 1024
+
+STATUS_ACTION = "saipen host instructions"
+REPAIR_ACTION = "saipen host instructions repair"
+
+CODE_CURRENT = "PROJECT_BLOCK_CURRENT"
+CODE_ABSENT = "PROJECT_BLOCK_ABSENT"
+CODE_STALE = "PROJECT_BLOCK_STALE"
+CODE_MALFORMED = "PROJECT_BLOCK_MALFORMED"
+CODE_UNREADABLE = "PROJECT_BLOCK_UNREADABLE"
+CODE_REPAIRED = "PROJECT_BLOCK_REPAIRED"
+CODE_FAILED = "PROJECT_BLOCK_REPAIR_FAILED"
+CODE_NEWER = "PROJECT_BLOCK_NEWER"
+NOT_SAIPEN = "NOT_SAIPEN_PROJECT"
+
+CURRENT = "CURRENT"
+ABSENT = "ABSENT"
+STALE = "STALE"
+MALFORMED = "MALFORMED"
+UNREADABLE = "UNREADABLE"
+LINKED = "LINKED"
+HOST_SURFACE = "HOST_SURFACE"
+NEWER = "NEWER"
+
+#: The revision of the block text below. Raise it with EVERY change of that
+#: text: an engine that changed the text and kept the number would be undone
+#: by, and would undo, every install still writing the old text.
+BLOCK_REVISION = 1
+
+#: The current block. ASCII, LF, no absolute path. Editing it makes every
+#: block written before the edit another generation, which is the intent.
+#:
+#: It must bootstrap a host that delivers no block of its own (several
+#: registered hosts have no home-level instruction surface), so it names the
+#: first command for each kind of turn and where the cold-start kernel is: a
+#: path the runtime reports, never one written here. `continue` may answer
+#: with an executed step that carries no cold route, so the block also names
+#: the one command that always does.
+_CURRENT_LINES = (
+    "<!-- SAIPEN:BEGIN -->",
+    f"## saipen protocol (project block {BLOCK_REVISION})",
+    "This project is SAIPEN-managed: its memory is `.saipen/` here. Never edit",
+    "`.saipen/` BOARD, LOG or STATE by hand and never work around the protocol.",
+    "New task: run `saipen start '<the task, one line>'`. No new task (`cc`, bare",
+    "`saipen`): run `saipen continue --json`. Do what the answer says. Before the",
+    "first reply read the `boot` document named under `cold_route` in that answer",
+    "(`saipen status --json` always names it).",
+    "LAUNCHER ORDER -- use the first that runs:",
+    "1. `saipen` on PATH;",
+    "2. `<saipen_home>/bin/saipen` (POSIX, Git Bash) or",
+    "   `<saipen_home>\\bin\\saipen.cmd` (cmd, PowerShell), where `<saipen_home>`",
+    "   is the `saipen_home:` value in `.saipen/STATE.md`;",
+    "3. `%ProgramData%\\SAI\\SAIPEN\\bin\\saipen.cmd`, the machine runtime, when",
+    "   that home belongs to another user and cannot be read.",
+    "None runs: report which step failed and stop. Never search the disk for",
+    "SAIPEN, never clone or download a copy of it, and never ask for access to",
+    "another user's profile.",
+    "<!-- SAIPEN:END -->",
+)
+
+_DRIVE_PATH = re.compile(rb"[A-Za-z]:[\\/][^\s`'\"<>|]*")
+_HOME_PATH = re.compile(rb"(?<![\w<>.])/(?:home|Users|root)/[^\s`'\"<>|]*")
+_SKILL_HOME = re.compile(
+    rb"[\\/]\.(?:agents|claude|codex|gemini|kiro|cursor|config[\\/]opencode)[\\/]skills[\\/]saipen",
+    re.IGNORECASE,
+)
+_CLONE = re.compile(rb"\bclone\b", re.IGNORECASE)
+#: A clone the sentence forbids: the negation and the verb in one clause.
+#: `No install? clone ...` is an instruction; `never clone ...` is not.
+_FORBIDDEN_CLONE = re.compile(
+    rb"\b(?:never|not|nor|don't)\b[^.;:?!\r\n]{0,60}\bclone\b", re.IGNORECASE
+)
+_SAIPEN = re.compile(rb"saipen", re.IGNORECASE)
+#: The heading line is how an OLDER engine recognises a newer block, so every
+#: later revision keeps this exact shape and changes only the number.
+_REVISION = re.compile(
+    rb"^## saipen protocol \(project block (\d{1,6})\)[ \t]*\r?$", re.MULTILINE
+)
+
+
+def _tells_to_clone(line: bytes) -> bool:
+    """A clone the line instructs: one that is left once every clause that
+    forbids a clone is taken out, so `never clone it; clone X` still tells."""
+    return bool(_CLONE.search(_FORBIDDEN_CLONE.sub(b"", line)))
+
+#: How many outside-the-block lines one report names.
+_OUTSIDE_LIMIT = 8
+
+
+def current_block(newline: bytes = b"\n") -> bytes:
+    """The current block, opening marker to closing marker, in one line ending."""
+    return newline.join(line.encode("ascii") for line in _CURRENT_LINES)
+
+
+def _normalized(block: bytes) -> bytes:
+    return block.replace(b"\r\n", b"\n").strip()
+
+
+def _digest(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()[:16]
+
+
+def _span(data: bytes) -> tuple[int, int] | str:
+    """The one marker pair as `(start, end)`, or why there is not exactly one."""
+    opens = data.count(BEGIN)
+    closes = data.count(END)
+    if opens != 1 or closes != 1:
+        return f"{opens} opening and {closes} closing marker(s); exactly one pair is a block"
+    start = data.index(BEGIN)
+    end = data.index(END)
+    if end < start:
+        return "the closing marker comes before the opening one"
+    return start, end + len(END)
+
+
+def _revision(block: bytes) -> int | None:
+    """The revision a block names for itself, or None for one that names none."""
+    match = _REVISION.search(block)
+    return int(match.group(1)) if match else None
+
+
+def _steering(block: bytes) -> list[str]:
+    """What a block does that no revision may: the reasons it steers its
+    reader away from the runtime, most harmful first. Empty for a sound one."""
+    reasons: list[str] = []
+    if any(_tells_to_clone(line) for line in block.splitlines()):
+        reasons.append("tells the agent to clone a repository")
+    path = _DRIVE_PATH.search(block) or _HOME_PATH.search(block)
+    if path is not None:
+        named = path.group(0).decode("utf-8", "replace")[:80]
+        reasons.append(f"names an absolute path ({named})")
+    return reasons
+
+
+def _outside(name: str, data: bytes, span: tuple[int, int] | None) -> list[dict]:
+    """Lines outside the block that send a reader to a private install.
+
+    They are the operator's text: named so they can be seen, never rewritten.
+    """
+    found: list[dict] = []
+    line_no = 0
+    offset = 0
+    for line in data.splitlines(keepends=True):
+        line_no += 1
+        start, offset = offset, offset + len(line)
+        if span is not None and start < span[1] and offset > span[0]:
+            continue
+        kind = None
+        if _SKILL_HOME.search(line):
+            kind = "per-user-skill-home"
+        elif _SAIPEN.search(line) and _tells_to_clone(line):
+            kind = "clone-instruction"
+        if kind is not None:
+            found.append({"file": name, "line": line_no, "kind": kind})
+    return found
+
+
+def host_surfaces() -> frozenset[str]:
+    """Every host-level instruction file the installer writes, as comparable paths.
+
+    The same two markers delimit the host-level activation block there, and
+    that block has its own owner (`saipen host doctor`). A project root that
+    is also a host's configuration directory must not have it replaced by the
+    project block: two writers of one marker pair would undo each other on
+    every run. An unreadable registry names no surface, so nothing is skipped.
+    """
+    from .host_bootstrap import _expand, _load_adapters
+
+    found: set[str] = set()
+    for adapter in _load_adapters().values():
+        surfaces = list(adapter.get("instruction_surfaces") or [])
+        for loader in adapter.get("instruction_loaders") or []:
+            if isinstance(loader, dict):
+                surfaces.extend(loader.get("surfaces") or [])
+        for surface in surfaces:
+            path = _expand(surface)
+            if path is None or str(path).startswith("$"):
+                continue  # an unset variable names nothing on this machine
+            found.add(os.path.normcase(os.path.abspath(path)))
+    return frozenset(found)
+
+
+def _read(path: Path) -> tuple[bytes | None, str | None, str | None]:
+    """`(data, status, reason)`: the bytes, or the status that replaces them."""
+    try:
+        info = path.lstat()
+    except FileNotFoundError:
+        return None, None, None
+    except OSError as exc:
+        return None, UNREADABLE, f"cannot be examined: {exc}"
+    reparse = getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400)
+    if stat.S_ISLNK(info.st_mode) or (getattr(info, "st_file_attributes", 0) or 0) & reparse:
+        return None, LINKED, "a link, not a file of this project; not followed"
+    if not stat.S_ISREG(info.st_mode):
+        return None, None, None
+    if info.st_size > MAX_BYTES:
+        return None, UNREADABLE, f"larger than {MAX_BYTES} bytes; not read"
+    try:
+        return path.read_bytes(), None, None
+    except OSError as exc:
+        return None, UNREADABLE, f"cannot be read: {exc}"
+
+
+def inspect_file(
+    root: Path, name: str, surfaces: frozenset[str] = frozenset()
+) -> tuple[dict | None, list[dict], bytes | None]:
+    """One instruction file: its row, its outside-the-block lines, its bytes.
+
+    The row is None when the project has no such file. A file that is one of
+    `surfaces` (see `host_surfaces`) is named and not read.
+    """
+    path = root / name
+    if os.path.normcase(os.path.abspath(path)) in surfaces:
+        if not path.is_file():
+            return None, [], None
+        reason = "a host-level instruction file; `saipen host doctor` owns its block"
+        return {"file": name, "status": HOST_SURFACE, "reasons": [reason]}, [], None
+    data, status, reason = _read(path)
+    if data is None:
+        if status is None:
+            return None, [], None
+        return {"file": name, "status": status, "reasons": [reason]}, [], None
+    span = _span(data)
+    if isinstance(span, str):
+        if BEGIN not in data and END not in data:
+            return {"file": name, "status": ABSENT, "reasons": []}, _outside(name, data, None), data
+        return (
+            {"file": name, "status": MALFORMED, "reasons": [span]},
+            _outside(name, data, None),
+            data,
+        )
+    block = data[span[0] : span[1]]
+    row = {
+        "file": name,
+        "status": CURRENT,
+        "reasons": [],
+        "sha256": _digest(_normalized(block)),
+        "bytes": len(block),
+        "newline": "CRLF" if b"\r\n" in block else "LF",
+    }
+    if _normalized(block) != current_block(b"\n"):
+        steering = _steering(block)
+        revision = _revision(block)
+        if not steering and revision is not None and revision > BLOCK_REVISION:
+            row["status"] = NEWER
+            row["reasons"] = [
+                f"written by a newer SAIPEN (block {revision}); this engine writes "
+                f"block {BLOCK_REVISION} and leaves it"
+            ]
+        else:
+            row["status"] = STALE
+            row["reasons"] = [*steering, "is not the current project block"]
+    return row, _outside(name, data, span), data
+
+
+def _verdict(rows: list[dict]) -> tuple[str, str | None, str | None]:
+    """`(code, action, detail)` for a project's rows, worst status first."""
+    by_status: dict[str, list[dict]] = {}
+    for row in rows:
+        by_status.setdefault(row["status"], []).append(row)
+    if MALFORMED in by_status:
+        row = by_status[MALFORMED][0]
+        return (
+            CODE_MALFORMED,
+            f"edit {row['file']} to carry exactly one {BEGIN.decode()} ... {END.decode()} "
+            f"pair, then run `{REPAIR_ACTION}`",
+            f"{row['file']}: {row['reasons'][0]}",
+        )
+    if STALE in by_status:
+        row = by_status[STALE][0]
+        return (
+            CODE_STALE,
+            REPAIR_ACTION,
+            f"{row['file']} carries a SAIPEN block of another generation: "
+            + "; ".join(row["reasons"][:2]),
+        )
+    if UNREADABLE in by_status:
+        row = by_status[UNREADABLE][0]
+        return (
+            CODE_UNREADABLE,
+            f"make {row['file']} readable to this account and smaller than {MAX_BYTES} "
+            f"bytes, then run `{STATUS_ACTION}`",
+            f"{row['file']}: {row['reasons'][0]}",
+        )
+    if NEWER in by_status:
+        row = by_status[NEWER][0]
+        return CODE_NEWER, None, f"{row['file']}: {row['reasons'][0]}"
+    if CURRENT in by_status:
+        return CODE_CURRENT, None, None
+    return CODE_ABSENT, None, None
+
+
+def _not_a_project(root: Path) -> dict:
+    return {
+        "ok": False,
+        "code": NOT_SAIPEN,
+        "project_root": str(root),
+        "files": [],
+        "outside_block": [],
+        "written": [],
+        "action": None,
+        "detail": f"no .saipen/ under {root}; a project's instruction block is asked of a project",
+    }
+
+
+def status(project_root: Path | str) -> dict:
+    """Read-only: which instruction files of this project carry a SAIPEN block,
+    and of which generation. `ok` is true when nothing needs an action."""
+    root = Path(project_root)
+    if not (root / ".saipen").is_dir():
+        return _not_a_project(root)
+    rows: list[dict] = []
+    outside: list[dict] = []
+    surfaces = host_surfaces()
+    for name in INSTRUCTION_FILES:
+        row, lines, _data = inspect_file(root, name, surfaces)
+        if row is not None:
+            rows.append(row)
+            outside.extend(lines)
+    code, action, detail = _verdict(rows)
+    return {
+        "ok": code in (CODE_CURRENT, CODE_ABSENT, CODE_NEWER),
+        "code": code,
+        "project_root": str(root),
+        "files": rows,
+        "outside_block": outside[:_OUTSIDE_LIMIT],
+        "action": action,
+        "detail": detail,
+    }
+
+
+def projection(project_root: Path | str) -> dict:
+    """The verdict another diagnostic embeds: code, action and the files that
+    carry a block. Never raises: `continue` and `start` embed it, and an
+    advisory about a project file must not be able to stop either."""
+    try:
+        report = status(project_root)
+    except Exception as exc:  # a report is never failed by what it reports
+        return {"code": CODE_UNREADABLE, "action": None, "detail": str(exc)[:200], "files": []}
+    return {
+        "code": report["code"],
+        "action": report["action"],
+        "detail": report["detail"],
+        "files": [
+            {"file": row["file"], "status": row["status"]}
+            for row in report["files"]
+            if row["status"] != ABSENT
+        ],
+    }
+
+
+def repair(project_root: Path | str, *, dry_run: bool = False) -> dict:
+    """Replace every block of another generation with the current one.
+
+    Only a file whose markers form exactly one pair is written, and only from
+    its opening marker to its closing one, in the line ending the old block
+    used. A current project is answered with zero writes; a project with no
+    block gets none. The answer is the state AFTER the repair, plus what was
+    written.
+    """
+    root = Path(project_root)
+    if not (root / ".saipen").is_dir():
+        return _not_a_project(root)
+    written: list[dict] = []
+    failed: list[str] = []
+    surfaces = host_surfaces()
+    for name in INSTRUCTION_FILES:
+        row, _lines, data = inspect_file(root, name, surfaces)
+        if row is None or row["status"] != STALE or data is None:
+            continue
+        span = _span(data)
+        if isinstance(span, str):  # pragma: no cover - STALE implies one pair
+            continue
+        newline = b"\r\n" if row["newline"] == "CRLF" else b"\n"
+        updated = data[: span[0]] + current_block(newline) + data[span[1] :]
+        record = {
+            "file": name,
+            "before_sha256": _digest(data),
+            "after_sha256": _digest(updated),
+            "block_bytes_before": span[1] - span[0],
+            "block_bytes_after": len(updated) - len(data) + span[1] - span[0],
+            "outside_bytes_identical": True,
+        }
+        if not dry_run:
+            path = root / name
+            try:
+                mode = stat.S_IMODE(path.lstat().st_mode)
+                safe_atomic_write_bytes(
+                    path, updated, kind="project instruction file", ownership_root=root
+                )
+                # The replacement is a NEW file, created owner-only. The file
+                # it replaces was readable by whoever could read it before,
+                # and a repair must not be what takes that away.
+                os.chmod(path, mode)
+                landed = path.read_bytes()
+            except (OSError, ValueError) as exc:
+                failed.append(f"{name}: {exc}")
+                continue
+            record["outside_bytes_identical"] = (
+                landed[: span[0]] == data[: span[0]]
+                and landed[len(landed) - (len(data) - span[1]) :] == data[span[1] :]
+                and landed == updated
+            )
+            if not record["outside_bytes_identical"]:
+                failed.append(f"{name}: the bytes read back are not the bytes written")
+        written.append(record)
+    after = status(root)
+    if failed:
+        # The same command again would be refused the same way: the action is
+        # what has to change first, and the detail says why it was refused.
+        name = failed[0].split(":", 1)[0]
+        return {
+            **after,
+            "ok": False,
+            "code": CODE_FAILED,
+            "written": written,
+            "dry_run": dry_run,
+            "action": (
+                f"make {name} a regular file this account may replace, "
+                f"then run `{REPAIR_ACTION}`"
+            ),
+            "detail": "; ".join(failed)[:400],
+        }
+    if dry_run:
+        return {**after, "written": written, "dry_run": True}
+    code = CODE_REPAIRED if written and after["ok"] else after["code"]
+    return {**after, "code": code, "written": written, "dry_run": False}
+
+
+__all__ = [
+    "BEGIN",
+    "BLOCK_REVISION",
+    "CODE_ABSENT",
+    "CODE_CURRENT",
+    "CODE_FAILED",
+    "CODE_MALFORMED",
+    "CODE_NEWER",
+    "CODE_REPAIRED",
+    "CODE_STALE",
+    "CODE_UNREADABLE",
+    "END",
+    "INSTRUCTION_FILES",
+    "NOT_SAIPEN",
+    "REPAIR_ACTION",
+    "STATUS_ACTION",
+    "current_block",
+    "host_surfaces",
+    "inspect_file",
+    "projection",
+    "repair",
+    "status",
+]

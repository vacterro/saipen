index 00000000..83e8c5c0
--- /dev/null
+++ b/tools/test_t1665_guard_verbs.py
@@ -0,0 +1,99 @@
+"""T-1665: the guard and COMMANDS.md give one answer for every documented verb.
+
+Found in T-1640: typed in a guarded shell while no Work is active, `saipen
+clean` and `saipen translate` answered NO_ACTIVE_WORK with "'clean' is not a
+verb" -- while COMMANDS.md lists both, tools/saipen.py dispatches both and
+`saipen transition CLEAN` was admitted in the same state. COMMAND_EFFECTS.json
+`not_shell_canonical` carried them over from an older hand-written list.
+
+* ADMIT  -- the two phase verbs are admitted exactly as `saipen transition
+            PHASE` is, in both states the probe measured.
+* TRUTH  -- every verb the CLI dispatches, walked through the guard: none is
+            ever called "not a verb"; a verb a shell line does not run says
+            what is true and, where one exists, names the admitted spelling.
+"""
+
+from __future__ import annotations
+
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+sys.path.insert(0, str(TOOLS))
+
+from test_hermetic_env import isolate_host_session  # noqa: E402
+from test_guard_hostile_matrix import (  # noqa: E402
+    GuardEventHarness,
+    active_project,
+    fresh_project,
+)
+
+from saipen_engine import command_effects as CE  # noqa: E402
+from saipen_engine import guard_events  # noqa: E402
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def guard(root: Path, command: str) -> dict:
+    _code, data = GuardEventHarness.run(
+        GuardEventHarness.tool_event(root, "bash", {"command": command})
+    )
+    return data
+
+
+class PhaseVerbTests(unittest.TestCase):
+    def test_the_phase_verbs_are_admitted_as_their_transition_is(self):
+        for label, root in (
+            ("DONE, no Work", fresh_project()),
+            ("BUILD, own Work", active_project()),
+        ):
+            for verb, phase in (("clean", "CLEAN"), ("translate", "TRANSLATE")):
+                with self.subTest(state=label, verb=verb):
+                    direct = guard(root, f"saipen {verb}")
+                    transition = guard(root, f"saipen transition {phase}")
+                    self.assertTrue(transition.get("admitted"), transition)
+                    self.assertTrue(direct.get("admitted"), direct)
+                    self.assertEqual(
+                        (direct.get("event") or {}).get("action"),
+                        (transition.get("event") or {}).get("action"),
+                    )
+
+
+class VerbTruthTests(unittest.TestCase):
+    def test_no_verb_the_cli_dispatches_is_ever_called_not_a_verb(self):
+        root = fresh_project()
+        verbs = sorted(CE._VERBS)
+        self.assertIn("clean", verbs)
+        for verb in verbs:
+            with self.subTest(verb=verb):
+                problem = guard_events.saipen_line_problem(f"saipen {verb}")
+                if problem is not None:
+                    self.assertNotIn("is not a verb", problem[0], problem)
+                answer = guard(root, f"saipen {verb}")
+                self.assertNotIn("is not a verb", str(answer.get("detail") or ""), answer)
+                self.assertNotIn("is not a verb", str(answer.get("reason") or ""), answer)
+
+    def test_a_verb_a_shell_does_not_run_names_what_is_true(self):
+        reason, spelling = guard_events.saipen_line_problem("saipen init")
+        self.assertIn("is a SAIPEN verb", reason)
+        self.assertEqual(spelling, "saipen set")
+        self.assertTrue(CE.is_shell_canonical_verb("set"))
+        for verb in ("launch", "first-publish-confirm"):
+            with self.subTest(verb=verb):
+                reason, spelling = guard_events.saipen_line_problem(f"saipen {verb}")
+                self.assertIn("is a SAIPEN verb", reason)
+                self.assertIsNone(spelling)
+
+    def test_an_unknown_word_is_still_not_a_verb(self):
+        reason, _spelling = guard_events.saipen_line_problem("saipen frobnicate")
+        self.assertIn("is not a verb", reason)
+        reason, spelling = guard_events.saipen_line_problem("saipen statuz")
+        self.assertIn("did you mean `saipen status`", reason)
+        self.assertEqual(spelling, "saipen status")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1666_receipt_close.py b/tools/test_t1666_receipt_close.py
new file mode 100644
index 00000000..2a1e2eca
--- /dev/null
+++ b/tools/test_t1666_receipt_close.py
@@ -0,0 +1,184 @@
+"""T-1666: a finished source receipt closes when its last gate is met.
+
+`close_receipt` had one caller, `saipen source close`, and nothing said when to
+run it: 97 of this project's 148 ACTIVE receipts had complete coverage and
+every linked Work DONE, each re-proved on every validation and each keeping
+its Work's closed row on the BOARD. Now:
+
+* the command that meets the last gate closes the receipt -- `ticket done`
+  when the last linked Work reaches DONE (its finish already demanded
+  complete coverage), `source disp` when the last clause of a receipt bound
+  to Work that is already DONE reaches its disposition;
+* a receipt whose Work is still open, or that never produced Work, stays
+  ACTIVE;
+* entering CLEAN closes whatever an older engine left open, before the
+  BOARD scrub, so the same entry can prune the rows they held.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+from saipen_engine import intake  # noqa: E402
+from saipen_engine.operations import apply_claim, checkpoint  # noqa: E402
+from test_dependency_resume_liveness import AGENT, ResumeFixture  # noqa: E402
+
+ENGINE = TOOLS / "saipen.py"
+BODY = (
+    "# User request\n\n"
+    "priority: P1\n"
+    "verify: the request is answered\n\n"
+    "## Request\n\n"
+    "one request answered by one piece of work\n"
+)
+
+
+class _Receipts(ResumeFixture):
+    def cli(self, project: Path, *args: str) -> dict:
+        env = {k: v for k, v in os.environ.items() if not k.upper().startswith("SAIPEN")}
+        env.update(PWD=str(project), SAIPEN_CAPABILITY="no-publish", PYTHONUTF8="1")
+        proc = subprocess.run(
+            [
+                sys.executable,
+                "-B",
+                str(ENGINE),
+                "--project-root",
+                str(project),
+                "--agent",
+                AGENT,
+                "--json",
+                *args,
+            ],
+            stdin=subprocess.DEVNULL,
+            capture_output=True,
+            env=env,
+            cwd=str(project),
+            timeout=300,
+            check=False,
+        )
+        return json.loads(proc.stdout.decode("utf-8"))
+
+    def receipt(self, project: Path, work: str, *, settle: bool = True) -> str:
+        captured = intake.capture(project, BODY, source_kind="user_instruction", work=work)
+        self.assertTrue(captured.get("ok"), captured)
+        receipt = captured["receipt"]
+        added = intake.add_requirement(project, receipt, rid="R1", text="the request clause")
+        self.assertTrue(added.get("ok"), added)
+        if settle:
+            self.settle(project, receipt, work)
+        return receipt
+
+    def settle(self, project: Path, receipt: str, work: str) -> None:
+        disposed = intake.set_disposition(
+            project,
+            receipt,
+            f"{receipt}:R1",
+            "VERIFIED",
+            work=work,
+            evidence="E-001",
+            verification="focused test",
+        )
+        self.assertTrue(disposed.get("ok"), disposed)
+
+    def status(self, project: Path, receipt: str) -> str:
+        return str((intake._read_meta(project, receipt) or {}).get("status") or "CLOSED")
+
+    def ready_to_finish(self, project: Path, work: str) -> None:
+        self.assertTrue(apply_claim(project, work, AGENT, explicit=True).ok)
+        self.to_ship(project, work)
+        self.assertTrue(checkpoint(project, AGENT, "RUN", work, "acceptance -> PASS").ok)
+
+    def finish(self, project: Path, work: str) -> dict:
+        answer = self.cli(project, "ticket", "done", work, "--closure-mode", "own_patch")
+        self.assertTrue(answer.get("ok"), answer)
+        return answer
+
+    def finished_work(self, project: Path) -> str:
+        work = self.add(project, "answer the request")
+        self.ready_to_finish(project, work)
+        self.assertNotIn("source_closed", self.finish(project, work))
+        return work
+
+
+class LastGateTests(_Receipts):
+    def test_the_last_work_reaching_done_closes_its_receipt(self):
+        project = self.make_project()
+        work = self.add(project, "answer the request")
+        receipt = self.receipt(project, work)
+        self.ready_to_finish(project, work)
+        self.assertEqual(self.status(project, receipt), "ACTIVE")
+
+        answer = self.finish(project, work)
+        self.assertEqual(answer.get("source_closed", {}).get("closed"), [receipt], answer)
+        self.assertEqual(self.status(project, receipt), "CLOSED")
+
+    def test_the_last_clause_reaching_its_disposition_closes_its_receipt(self):
+        project = self.make_project()
+        work = self.finished_work(project)
+        receipt = self.receipt(project, work, settle=False)
+        self.assertEqual(self.status(project, receipt), "ACTIVE")
+
+        answer = self.cli(
+            project,
+            "source",
+            "disp",
+            receipt,
+            f"{receipt}:R1",
+            "VERIFIED",
+            "--work",
+            work,
+            "--evidence",
+            "E-001",
+            "--verification",
+            "focused test",
+        )
+        self.assertTrue(answer.get("ok"), answer)
+        self.assertEqual(answer.get("source_closed", {}).get("closed"), [receipt], answer)
+        self.assertEqual(self.status(project, receipt), "CLOSED")
+
+
+class StillOpenTests(_Receipts):
+    def test_a_receipt_whose_work_is_still_open_stays_active(self):
+        project = self.make_project()
+        first, second = self.add(project, "first part"), self.add(project, "second part")
+        receipt = self.receipt(project, first)
+        self.assertTrue(intake.link_work_to(project, receipt, second).get("ok"))
+        self.ready_to_finish(project, first)
+        self.assertNotIn("source_closed", self.finish(project, first))
+        self.assertEqual(self.status(project, receipt), "ACTIVE")
+        self.assertEqual(intake.closable_receipts(project), [])
+
+    def test_a_receipt_that_never_produced_work_is_not_swept(self):
+        project = self.make_project()
+        captured = intake.capture(project, BODY, source_kind="user_instruction")
+        self.assertTrue(captured.get("ok"), captured)
+        self.assertEqual(intake.closable_receipts(project), [])
+
+
+class CleanEntryTests(_Receipts):
+    def test_entering_clean_closes_what_an_older_engine_left_open(self):
+        project = self.make_project()
+        work = self.finished_work(project)
+        # What an engine before T-1666 left: complete, its Work DONE, and no
+        # command that ever closed it.
+        receipt = self.receipt(project, work)
+        self.assertEqual(intake.closable_receipts(project), [receipt])
+
+        answer = self.cli(project, "transition", "CLEAN")
+        self.assertTrue(answer.get("ok"), answer)
+        self.assertEqual(answer.get("source_closed", {}).get("closed"), [receipt], answer)
+        self.assertEqual(self.status(project, receipt), "CLOSED")
+        self.assertEqual(intake.closable_receipts(project), [])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1667_clean_compaction.py b/tools/test_t1667_clean_compaction.py
new file mode 100644
index 00000000..199ac277
--- /dev/null
+++ b/tools/test_t1667_clean_compaction.py
@@ -0,0 +1,181 @@
+"""T-1667: entering CLEAN runs the bounded journal compaction it orders.
+
+phases/clean.md step 4 told an agent to run `journal.compact_committed`, a
+function with no production caller and no verb, inside a namespace the guard
+protects -- reachable only by importing the engine in a shell. Entering CLEAN
+now runs it under the writer lock and reports what it dropped and what it
+left, beside the BOARD scrub and the LOG seal:
+
+* a COMMITTED operation left in the working directory moves to the settled
+  ledger with its staged bytes dropped and its record intact;
+* a queued post-settlement cleanup is retried and its marker cleared;
+* staged bytes a settlement left before the queue existed are found by one
+  sweep per checkout, so later passes stay bounded by the queue;
+* an operation of any other status keeps every byte;
+* nothing to act on says nothing, and validation stays clean throughout.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+from saipen_engine.fast_check import validate_project  # noqa: E402
+from saipen_engine.journal import (  # noqa: E402
+    CLEANUP_QUEUE_DIR,
+    LEGACY_SWEEP_MARKER,
+    OPS_DIR,
+    SETTLED_DIR,
+)
+from saipen_engine.operations import compact_journal  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+from test_t1640_board_scrub import AGENT, _cli, _done, _project  # noqa: E402
+
+PAYLOAD = b"staged bytes of a write that already committed\n" * 64
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def _settled_op(root: Path) -> Path:
+    """One real COMMITTED operation, written by the engine itself."""
+    before = set((root / SETTLED_DIR).iterdir()) if (root / SETTLED_DIR).is_dir() else set()
+    code, out, err = _cli(root, "checkpoint", "RUN", "a note for the journal", "--json")
+    assert code == 0, (out, err)
+    fresh = sorted(set((root / SETTLED_DIR).iterdir()) - before)
+    assert len(fresh) == 1, fresh
+    return fresh[0]
+
+
+def _record(entry: Path) -> bytes:
+    return (entry / "operation.json").read_bytes()
+
+
+class CleanEntryTests(unittest.TestCase):
+    def project(self) -> Path:
+        root = _project([_done(f"T-{n}", prose="short ") for n in range(1, 4)], phase="DONE")
+        self.addCleanup(shutil.rmtree, root, True)
+        return root
+
+    def enter_clean(self, root: Path) -> dict:
+        code, out, err = _cli(root, "transition", "CLEAN", "--json")
+        self.assertEqual(code, 0, (out, err))
+        return json.loads(out)
+
+    def test_a_committed_operation_in_the_working_directory_is_compacted(self):
+        root = self.project()
+        settled = _settled_op(root)
+        record = _record(settled)
+        unsettled = root / OPS_DIR / settled.name
+        unsettled.parent.mkdir(parents=True, exist_ok=True)
+        shutil.move(str(settled), str(unsettled))
+        (unsettled / "BOARD.md.staged").write_bytes(PAYLOAD)
+        self.assertEqual(validate_project(root), [])
+
+        report = self.enter_clean(root)["journal_compaction"]
+        self.assertTrue(report["ok"], report)
+        self.assertEqual(report["compacted"], [settled.name], report)
+        self.assertEqual(report["before"]["staged_bytes"], len(PAYLOAD))
+        self.assertEqual(report["after"], {"ops": 0, "queued": 0, "staged_bytes": 0})
+        self.assertFalse(unsettled.exists())
+        self.assertEqual(_record(settled), record, "the settled record keeps every byte")
+        self.assertEqual(list(settled.glob("*.staged")), [])
+        self.assertEqual(validate_project(root), [])
+
+    def test_a_queued_cleanup_is_retried_and_its_marker_cleared(self):
+        root = self.project()
+        settled = _settled_op(root)
+        (settled / "LOG.md.staged").write_bytes(PAYLOAD)
+        queue = root / CLEANUP_QUEUE_DIR
+        queue.mkdir(parents=True, exist_ok=True)
+        (queue / settled.name).write_text("", encoding="utf-8")
+
+        report = self.enter_clean(root)["journal_compaction"]
+        self.assertTrue(report["ok"], report)
+        self.assertIn(settled.name, report["compacted"])
+        self.assertEqual(report["before"]["queued"], 1)
+        self.assertEqual(report["after"]["queued"], 0)
+        self.assertEqual(list(settled.glob("*.staged")), [])
+        self.assertFalse((queue / settled.name).exists())
+        self.assertEqual(validate_project(root), [])
+
+    def test_after_the_one_legacy_sweep_nothing_to_compact_says_nothing(self):
+        root = self.project()
+        first = self.enter_clean(root)["journal_compaction"]
+        self.assertTrue(first["ok"], first)
+        self.assertEqual((first["legacy_queued"], first["compacted"]), ([], []))
+        self.assertTrue((root / LEGACY_SWEEP_MARKER).is_file())
+        _cli(root, "transition", "DONE", "--json")
+        self.assertNotIn("journal_compaction", self.enter_clean(root))
+        refused = compact_journal(root, AGENT).to_dict()
+        self.assertFalse(refused["ok"])
+        self.assertIs(refused["due"], False)
+
+    def test_staged_bytes_older_than_the_queue_are_found_once(self):
+        root = self.project()
+        resolved, kept = _settled_op(root), _settled_op(root)
+        for entry, status in ((resolved, "RESOLVED"), (kept, "VERIFIED")):
+            record = json.loads(_record(entry).decode("utf-8"))
+            record["status"] = status
+            (entry / "operation.json").write_text(json.dumps(record), encoding="utf-8")
+            (entry / "0_legacy.staged").write_bytes(PAYLOAD)
+        records = {entry: _record(entry) for entry in (resolved, kept)}
+
+        report = self.enter_clean(root)["journal_compaction"]
+        self.assertTrue(report["ok"], report)
+        self.assertEqual(report["legacy_queued"], [resolved.name], report)
+        self.assertEqual(report["compacted"], [resolved.name], report)
+        self.assertEqual(report["before"]["staged_bytes"], len(PAYLOAD))
+        self.assertEqual(report["after"]["staged_bytes"], 0)
+        self.assertEqual(list(resolved.glob("*.staged")), [])
+        self.assertEqual(len(list(kept.glob("*.staged"))), 1, "only COMMITTED/RESOLVED lose bytes")
+        self.assertEqual({e: _record(e) for e in records}, records)
+        self.assertEqual(validate_project(root), [])
+
+
+class StatusTests(unittest.TestCase):
+    """Only COMMITTED/RESOLVED operations lose staged bytes."""
+
+    def test_an_operation_of_another_status_keeps_every_byte(self):
+        root = _project([_done("T-1", prose="short ")], phase="DONE")
+        self.addCleanup(shutil.rmtree, root, True)
+        settled = _settled_op(root)
+        live = root / OPS_DIR / settled.name
+        live.parent.mkdir(parents=True, exist_ok=True)
+        shutil.move(str(settled), str(live))
+        record = json.loads(_record(live).decode("utf-8"))
+        record["status"] = "VERIFIED"
+        (live / "operation.json").write_text(json.dumps(record), encoding="utf-8")
+        (live / "BOARD.md.staged").write_bytes(PAYLOAD)
+        before = {p.name: p.read_bytes() for p in live.iterdir()}
+
+        report = compact_journal(root, AGENT).to_dict()
+        self.assertTrue(report["ok"], report)
+        self.assertEqual(report["compacted"], [])
+        self.assertIn(settled.name, report["skipped"])
+        self.assertEqual({p.name: p.read_bytes() for p in live.iterdir()}, before)
+        self.assertEqual(report["after"]["staged_bytes"], len(PAYLOAD))
+
+    def test_a_preview_writes_nothing(self):
+        root = _project([_done("T-1", prose="short ")], phase="DONE")
+        self.addCleanup(shutil.rmtree, root, True)
+        settled = _settled_op(root)
+        live = root / OPS_DIR / settled.name
+        live.parent.mkdir(parents=True, exist_ok=True)
+        shutil.move(str(settled), str(live))
+        (live / "BOARD.md.staged").write_bytes(PAYLOAD)
+        preview = compact_journal(root, AGENT, dry_run=True).to_dict()
+        self.assertEqual(preview["code"], "DRY_RUN", preview)
+        self.assertTrue((live / "BOARD.md.staged").is_file())
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1668_durable_stores_ship.py b/tools/test_t1668_durable_stores_ship.py
new file mode 100644
index 00000000..e57190e4
--- /dev/null
+++ b/tools/test_t1668_durable_stores_ship.py
@@ -0,0 +1,196 @@
+"""T-1668: a clone keeps every durable store a tracked file cites.
+
+Found in T-1640 REVIEW: a BOARD row over the live cap keeps a compact
+projection and cites its full record by `detail_ref` under
+`.saipen/recovery/board-compaction/`. This repository's `.gitignore` excluded
+`.saipen/recovery/*` and excepted only `log-detail`, so none of the 308 detail
+files was tracked while 101 live rows cited one; on a copy with the store moved
+aside, as a clone has it, 56 of 56 cited references did not resolve and
+`validate --gate core` printed the same findings as before.
+
+* SHIP     -- git itself answers, for every root `runtime_namespace` calls
+              durable under `.saipen/recovery/`, whether this repository's
+              `.gitignore` ships it; one that is ignored needs a recorded
+              `# unshipped-durable:` reason there, and a reason for a shipped
+              root is stale.
+* REPORT   -- the validator names a BOARD `detail_ref` that does not resolve,
+              and the full record its metadata names.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+from saipen_engine import runtime_namespace  # noqa: E402
+from test_guard_hostile_matrix import fresh_project  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+
+GIT = shutil.which("git")
+VALIDATE_PY = TOOLS / "validate.py"
+RECOVERY = ".saipen/recovery/"
+_REASON = re.compile(r"^# unshipped-durable: (\S+) -- (.+\S)\s*$", re.MULTILINE)
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def recorded_reasons(gitignore: str) -> dict[str, str]:
+    return dict(_REASON.findall(gitignore))
+
+
+def ignored(gitignore: str, paths: list[str]) -> set[str]:
+    """The paths git ignores under `gitignore`, asked of git in a scratch repo."""
+    with tempfile.TemporaryDirectory(prefix="saipen-t1668-git-") as raw:
+        repo = Path(raw)
+        subprocess.run([GIT, "init", "-q", str(repo)], check=True, capture_output=True)
+        (repo / ".gitignore").write_text(gitignore, encoding="utf-8")
+        # NUL-separated bytes: a text-mode pipe on Windows would hand git
+        # every path with a trailing CR, and git ignores none of those.
+        proc = subprocess.run(
+            [GIT, "-C", str(repo), "check-ignore", "--no-index", "--stdin", "-z"],
+            input=b"".join(path.encode("utf-8") + b"\0" for path in paths),
+            capture_output=True,
+            check=False,
+        )
+        return {item for item in proc.stdout.decode("utf-8").split("\0") if item}
+
+
+def problems(gitignore: str, roots: tuple[str, ...]) -> list[str]:
+    """Every durable recovery root this `.gitignore` drops without a reason,
+    and every recorded reason that no longer describes an ignored store."""
+    durable = [root for root in roots if root.startswith(RECOVERY)]
+    probes = {root: root + "probe/record.json" for root in durable}
+    dropped = {
+        root for root, probe in probes.items() if probe in ignored(gitignore, list(probes.values()))
+    }
+    reasons = recorded_reasons(gitignore)
+    found = [
+        f"{root} is ignored with no recorded reason" for root in sorted(dropped - set(reasons))
+    ]
+    found += [f"{root} has a reason but ships" for root in sorted(set(reasons) - dropped)]
+    found += [
+        f"{root} has a reason but is not a durable store"
+        for root in sorted(set(reasons) - set(durable))
+    ]
+    return found
+
+
+@unittest.skipUnless(GIT, "git unavailable")
+class ShipTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.gitignore = (ROOT / ".gitignore").read_text(encoding="utf-8")
+
+    def test_every_durable_recovery_store_ships_or_names_its_reason(self):
+        self.assertEqual(problems(self.gitignore, runtime_namespace.DURABLE_PROTECTED), [])
+        for root in ("board-compaction", "board-compaction-lineage", "log-detail", "board-scrub"):
+            with self.subTest(root=root):
+                probe = f"{RECOVERY}{root}/T-1/T-1-x.json"
+                self.assertNotIn(probe, ignored(self.gitignore, [probe]))
+        for reason in recorded_reasons(self.gitignore).values():
+            self.assertGreater(len(reason), 20, reason)
+
+    def test_a_new_durable_store_cannot_be_dropped_silently(self):
+        roots = (*runtime_namespace.DURABLE_PROTECTED, RECOVERY + "new-store/")
+        self.assertEqual(
+            problems(self.gitignore, roots),
+            [f"{RECOVERY}new-store/ is ignored with no recorded reason"],
+        )
+
+    def test_a_reason_for_a_store_that_ships_is_stale(self):
+        text = (
+            self.gitignore + "# unshipped-durable: .saipen/recovery/log-detail/ -- old note here\n"
+        )
+        self.assertIn(
+            ".saipen/recovery/log-detail/ has a reason but ships",
+            problems(text, runtime_namespace.DURABLE_PROTECTED),
+        )
+
+    def test_the_release_receipts_a_clone_resolves_closures_against_ship(self):
+        # closure._published_releases: the receipts a fresh clone must see.
+        probes = [
+            ".saipen/kitchen/release_receipt.json",
+            ".saipen/kitchen/release_receipts/T-1-v1.json",
+        ]
+        self.assertEqual(ignored(self.gitignore, probes), set())
+        self.assertIn(
+            ".saipen/kitchen/scratch.log", ignored(self.gitignore, [".saipen/kitchen/scratch.log"])
+        )
+
+    def test_the_compaction_lineage_root_is_durable(self):
+        from saipen_engine.board_compaction import LINEAGE_CHECKPOINT_ROOT
+
+        self.assertIn(LINEAGE_CHECKPOINT_ROOT + "/", runtime_namespace.DURABLE_PROTECTED)
+
+
+def _core_fails(root: Path) -> list[str]:
+    env = {k: v for k, v in os.environ.items() if not k.upper().startswith("SAIPEN")}
+    env["PYTHONUTF8"] = "1"
+    proc = subprocess.run(
+        [sys.executable, "-B", str(VALIDATE_PY), "--gate", "core"],
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        env=env,
+        cwd=str(root),
+        timeout=600,
+        check=False,
+    )
+    text = proc.stdout.decode("utf-8", errors="replace")
+    return [line for line in text.splitlines() if line.startswith("FAIL")]
+
+
+class ReportTests(unittest.TestCase):
+    DETAIL = ".saipen/recovery/board-compaction/T-0007/T-0007-abc.json"
+    ORIGINAL = ".saipen/recovery/board-compaction/T-0007/T-0007-abc.BOARD.md"
+
+    def project(self) -> Path:
+        root = fresh_project(phase="DONE", task="none", next_action="saipen continue")
+        board = root / ".saipen" / "BOARD.md"
+        board.write_text(
+            "# Board\n## DOING\n## TODO\n"
+            f"- [ ] T-0007 [P2] compact projection... | verify: proof | detail_ref: {self.DETAIL}\n"
+            "## DONE\n## BLOCKED\n",
+            encoding="utf-8",
+        )
+        return root
+
+    def dangling(self, root: Path) -> list[str]:
+        return [line for line in _core_fails(root) if "detail_ref does not resolve" in line]
+
+    def test_a_missing_record_is_reported_and_a_present_one_is_not(self):
+        root = self.project()
+        found = self.dangling(root)
+        self.assertEqual(len(found), 1, found)
+        self.assertIn("T-0007", found[0])
+        self.assertIn(self.DETAIL, found[0])
+        meta = root / self.DETAIL
+        meta.parent.mkdir(parents=True)
+        meta.write_text(json.dumps({"original_record_path": self.ORIGINAL}), encoding="utf-8")
+        (root / self.ORIGINAL).write_text("- [ ] T-0007 full text | verify: proof\n", "utf-8")
+        self.assertEqual(self.dangling(root), [])
+
+    def test_metadata_whose_full_record_is_gone_is_reported(self):
+        root = self.project()
+        meta = root / self.DETAIL
+        meta.parent.mkdir(parents=True)
+        meta.write_text(json.dumps({"original_record_path": self.ORIGINAL}), encoding="utf-8")
+        found = self.dangling(root)
+        self.assertEqual(len(found), 1, found)
+        self.assertIn(self.ORIGINAL, found[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1669_clean_done_projection.py b/tools/test_t1669_clean_done_projection.py
new file mode 100644
index 00000000..d87ad406
--- /dev/null
+++ b/tools/test_t1669_clean_done_projection.py
@@ -0,0 +1,281 @@
+"""T-1669: a transition into terminal DONE commits the router's route.
+
+Measured live (E-13182 / E-13186 / E-13187,
+`.saipen/evidence/T-1640-live-clean/validate.exit.txt`): a conformant CLEAN run
+made Work runnable before it exited, and `saipen transition DONE` then
+persisted `next_action: "PHASE DONE"` -- a value that is not a route at all.
+The validator read the contradiction correctly ("STATE.md audit route not
+followed ... but next_action is 'PHASE DONE'"; the inbox routed
+`PHASE SCOUT T-1304`), so the producer was the thing to repair, never the
+detector.
+
+DONE is terminal lifecycle state: what follows it is the SHARED router's
+answer over the PROPOSED post-transition bytes, exactly as `ticket done`
+already computes it (`operations._plan_finish_ticket`). Held here:
+
+  * the exact incident -- CLEAN -> DONE over routed runnable Work commits
+    `PHASE SCOUT <ticket>`, the operation's own report agrees with the bytes on
+    disk, and `validate.py --gate core` is green BEFORE any Work is claimed
+    (no later session may accidentally repair the field by claiming);
+  * a RED control -- the pre-fix artifact (`PHASE DONE`) is red on that same
+    fixture when it is driven through the real writer;
+  * CLEAN -> DONE with nothing routed stays router-consistent and green;
+  * non-DONE transitions keep their existing next_action contract.
+
+Run standalone:
+    python -B tools/test_t1669_clean_done_projection.py
+"""
+
+from __future__ import annotations
+
+import datetime
+import os
+import re
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+TOOLS = Path(__file__).resolve().parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+from saipen_engine import audit_inbox  # noqa: E402
+from saipen_engine.board import parse_board  # noqa: E402
+from saipen_engine.operations import transition_phase  # noqa: E402
+from saipen_engine.router import route_next  # noqa: E402
+from saipen_engine.state import parse_state  # noqa: E402
+from test_guard_hostile_matrix import fresh_project  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+
+AGENT = "test-agent"
+VALIDATE_PY = TOOLS / "validate.py"
+#: The layer number and the ticket the live incident measured.
+AUDIT_LAYER = 16
+TICKET = "T-1304"
+AUDIT_BODY = "# audit 16\n\nfindings that CLEAN freed Work for\n"
+
+
+def setUpModule() -> None:
+    # An outer host session must never bind these disposable fixtures.
+    isolate_host_session()
+
+
+def _utc() -> str:
+    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
+
+
+def _board(*, doing: str = "", todo: str = "") -> str:
+    lines = ["# Board", "## DOING"]
+    if doing:
+        lines.append(doing)
+    lines.append("## TODO")
+    if todo:
+        lines.append(todo)
+    lines += ["## DONE", "## BLOCKED"]
+    return "\n".join(lines) + "\n"
+
+
+def _state_text(root: Path) -> str:
+    return (root / ".saipen" / "STATE.md").read_text(encoding="utf-8")
+
+
+def _board_text(root: Path) -> str:
+    return (root / ".saipen" / "BOARD.md").read_text(encoding="utf-8")
+
+
+def _state(root: Path) -> dict:
+    return parse_state(_state_text(root))
+
+
+def _doing(root: Path) -> list[str]:
+    tickets = parse_board(_board_text(root))["tickets"]
+    return [tid for tid, t in tickets.items() if t["section"] == "## DOING"]
+
+
+def _transition_from(root: Path, predecessor: str) -> None:
+    """Point the fixture's history at a LEGAL predecessor of its phase.
+
+    `fresh_project` always stamps `transition_from: SHIP`; the fast check
+    validates the persisted pair, so a fixture in SCOUT has to say DONE.
+    """
+    path = root / ".saipen" / "STATE.md"
+    path.write_text(
+        re.sub(r"(?m)^transition_from:.*$", f"transition_from: {predecessor}", _state_text(root)),
+        encoding="utf-8",
+    )
+
+
+def _bind_active_audit(root: Path, work: str) -> dict:
+    """Layer 16 ACTIVE and bound to `work`, through the real inbox contract."""
+    layer = root / "audit" / f"{AUDIT_LAYER}.md"
+    layer.parent.mkdir(parents=True, exist_ok=True)
+    layer.write_text(AUDIT_BODY, encoding="utf-8")
+    rel = f"audit/{AUDIT_LAYER}.md"
+    captured = audit_inbox.capture_layer(root, rel, work=work)
+    assert captured["ok"], captured
+    audit_inbox.bind_layer(
+        root,
+        rel,
+        layer=AUDIT_LAYER,
+        generation=1,
+        file_sha256=captured["file_sha256"],
+        size_bytes=len(AUDIT_BODY.encode("utf-8")),
+        receipt_id=captured["receipt"],
+        receipt_sha256=captured["file_sha256"],
+        binding="exact",
+        linked_work=work,
+        state=audit_inbox.ACTIVE,
+    )
+    return audit_inbox.projection(root)
+
+
+def _clean_project_with_runnable_work() -> tuple[Path, dict]:
+    """The incident's shape: CLEAN with routed Work it just made runnable."""
+    root = fresh_project(phase="CLEAN", task="none", next_action="PHASE CLEAN")
+    (root / ".saipen" / "BOARD.md").write_text(
+        _board(todo=f"- [ ] {TICKET} [P2] runnable once CLEAN exits | verify: proof"),
+        encoding="utf-8",
+    )
+    return root, _bind_active_audit(root, TICKET)
+
+
+def _core_findings(root: Path) -> list[str]:
+    """Every FAIL/WARN line `validate.py --gate core` prints for `root`."""
+    env = {k: v for k, v in os.environ.items() if not k.upper().startswith("SAIPEN")}
+    env["PYTHONUTF8"] = "1"
+    proc = subprocess.run(
+        [sys.executable, "-B", str(VALIDATE_PY), "--gate", "core"],
+        stdin=subprocess.DEVNULL,
+        capture_output=True,
+        env=env,
+        cwd=str(root),
+        timeout=600,
+        check=False,
+    )
+    text = proc.stdout.decode("utf-8", errors="replace")
+    return [line for line in text.splitlines() if line.startswith(("FAIL", "WARN"))]
+
+
+def _core_fails(root: Path) -> list[str]:
+    return [line for line in _core_findings(root) if line.startswith("FAIL")]
+
+
+class CleanExitProjectsTheRouter(unittest.TestCase):
+    """The exact incident: CLEAN -> DONE over routed runnable Work."""
+
+    def test_clean_to_done_commits_the_routed_scout_before_any_claim(self):
+        root, projection = _clean_project_with_runnable_work()
+        # The inbox's route and the shared router's pick are the same fact:
+        # the layer's linked Work IS the topmost workable TODO, which is
+        # exactly what "CLEAN made it runnable" means.
+        self.assertEqual(projection["action"], f"PHASE SCOUT {TICKET}")
+        self.assertEqual(projection["layer"], AUDIT_LAYER)
+
+        result = transition_phase(root, "DONE", AGENT)
+        self.assertTrue(result.ok, result.to_dict())
+
+        state = _state(root)
+        self.assertEqual(state["phase"], "DONE")
+        self.assertEqual(state["task"], "none")
+        self.assertEqual(state["next_action"], f"PHASE SCOUT {TICKET}")
+        # The operation's report and the committed bytes are one fact.
+        self.assertEqual(result.data.get("next_action"), state["next_action"])
+        # ... and nothing has been claimed: the project must be valid as it
+        # stands, without a later session repairing next_action by working.
+        self.assertEqual(_doing(root), [])
+        self.assertEqual(_core_fails(root), [])
+
+
+class PreFixProjectionIsRed(unittest.TestCase):
+    """RED control: the artifact T-1669 measured, driven through the writer."""
+
+    def test_the_pre_fix_value_fails_the_same_fixture(self):
+        root, _projection = _clean_project_with_runnable_work()
+        # Pre-fix, `_plan_transition` persisted `PHASE DONE` without asking
+        # anyone. Feeding that exact value back through the real writer
+        # reproduces the measured artifact; the fixture is otherwise identical
+        # to the green case above.
+        with patch(
+            "saipen_engine.router.route_next",
+            return_value={"ok": True, "action": "PHASE DONE", "reason": "control"},
+        ):
+            result = transition_phase(root, "DONE", AGENT)
+        self.assertTrue(result.ok, result.to_dict())
+        self.assertEqual(_state(root)["next_action"], "PHASE DONE")
+
+        fails = _core_fails(root)
+        self.assertTrue(fails, "the pre-fix artifact must not validate")
+        self.assertTrue(
+            any("audit route not followed" in line for line in fails),
+            fails,
+        )
+        self.assertTrue(any(f"PHASE SCOUT {TICKET}" in line for line in fails), fails)
+
+
+class NoRoutedWorkStaysRouterConsistent(unittest.TestCase):
+    """CLEAN -> DONE with nothing to start: the router's answer, verbatim."""
+
+    def test_clean_to_done_without_routed_work_matches_the_router(self):
+        root = fresh_project(phase="CLEAN", task="none", next_action="PHASE CLEAN")
+        result = transition_phase(root, "DONE", AGENT)
+        self.assertTrue(result.ok, result.to_dict())
+
+        state = _state(root)
+        self.assertEqual(state["phase"], "DONE")
+        self.assertEqual(state["task"], "none")
+        # No audit layer, no workable TODO: whatever the shared router
+        # truthfully projects is the value, and it is never a stale PHASE DONE.
+        routed = route_next(_state_text(root), _board_text(root), current_agent=AGENT)
+        self.assertTrue(routed.get("ok"), routed)
+        self.assertEqual(state["next_action"], routed["action"])
+        self.assertNotEqual(state["next_action"], "PHASE DONE")
+        self.assertEqual(result.data.get("next_action"), state["next_action"])
+        self.assertEqual(_core_fails(root), [])
+
+
+class NonDoneTransitionsKeepTheirContract(unittest.TestCase):
+    """The repair is scoped to DONE; every other edge is untouched."""
+
+    def _active_project(self, phase: str, task: str, next_action: str) -> Path:
+        root = fresh_project(phase=phase, task=task, next_action=next_action)
+        (root / ".saipen" / "BOARD.md").write_text(
+            _board(
+                doing=f"- [/] {task} [P1] ordinary Work | verify: proof "
+                f"| owner: {AGENT} | claim_time: {_utc()}"
+            ),
+            encoding="utf-8",
+        )
+        return root
+
+    def test_a_ticket_bearing_transition_still_names_the_ticket(self):
+        root = self._active_project("SCOUT", "T-7", "PHASE SCOUT T-7")
+        _transition_from(root, "DONE")
+        planned = transition_phase(root, "BUILD", AGENT, "T-7", "regression", dry_run=True)
+        self.assertTrue(planned.ok, planned.to_dict())
+        self.assertEqual(planned.data.get("next_action"), "PHASE BUILD T-7")
+        # The dry run wrote nothing, including no projection.
+        self.assertEqual(_state(root)["next_action"], "PHASE SCOUT T-7")
+
+    def test_a_nonterminal_phase_keeps_its_phase_route(self):
+        root = self._active_project("BUILD", "T-7", "PHASE BUILD T-7")
+        result = transition_phase(root, "VERIFY", AGENT, "T-7", "regression")
+        self.assertTrue(result.ok, result.to_dict())
+        state = _state(root)
+        self.assertEqual(state["phase"], "VERIFY")
+        self.assertEqual(state["next_action"], "PHASE VERIFY T-7")
+        self.assertEqual(result.data.get("next_action"), state["next_action"])
+
+    def test_a_non_ticket_destination_keeps_its_plain_phase_route(self):
+        root = fresh_project(phase="DONE", task="none", next_action="saipen continue")
+        result = transition_phase(root, "PLAN", AGENT)
+        self.assertTrue(result.ok, result.to_dict())
+        state = _state(root)
+        self.assertEqual(state["phase"], "PLAN")
+        self.assertEqual(state["next_action"], "PHASE PLAN")
+        self.assertEqual(result.data.get("next_action"), state["next_action"])
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
diff --git a/tools/test_t1670_route_budgets.py b/tools/test_t1670_route_budgets.py
new file mode 100644
index 00000000..a6c115fe
--- /dev/null
+++ b/tools/test_t1670_route_budgets.py
@@ -0,0 +1,179 @@
+"""T-1670 (SRC-191): what one route loads is the budget, not the repository.
+
+`test_protocol_registry` capped `human_markdown_total`, the sum of every
+markdown file under `saipen/`, and re-derived the cap six times (300 -> 327
+KiB) as protocol law grew. On 2026-10-07 it stood at 334844 of 334848 bytes
+and blocked T-1663 although no route an agent executes loads more than its own
+declared budget. These controls pin the route model that replaces it:
+
+* PRE-FIX     -- a small clause in a document no route loads trips the old
+                 aggregate cap and passes every route budget.
+* GROWTH      -- unrelated growth raises the total, leaves every route byte
+                 count alone and stays PASS.
+* OVERFLOW    -- mandatory growth past a route budget (BOOT, a phase) FAILs.
+* TRANSITIVE  -- a declared `requires` chain A -> B -> C is counted whole.
+* OPTIONAL    -- a conditional reference never inflates the mandatory load.
+* BOOT        -- growth in VERIFY or FUTURE leaves the cold load byte-identical.
+* FILE        -- no single document may exceed `single_doc`, routed or not.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+PROTOCOL = ROOT / "saipen"
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+import protocol_budget  # noqa: E402
+
+#: The aggregate tripwire `test_protocol_registry` enforced before T-1670.
+OLD_AGGREGATE_CAP = 327 * 1024
+CLAUSE = "\nA small, valid clause of protocol law, routed nowhere.\n"
+
+
+class Scratch(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory(prefix="saipen-t1670-")
+        self.addCleanup(self._tmp.cleanup)
+        self.protocol = Path(self._tmp.name) / "saipen"
+        shutil.copytree(PROTOCOL, self.protocol)
+
+    def grow(self, rel: str, text: str) -> None:
+        path = self.protocol / rel
+        path.write_bytes(path.read_bytes() + text.encode("utf-8"))
+
+    def registry(self) -> dict:
+        return json.loads((self.protocol / "REGISTRY.json").read_text(encoding="utf-8-sig"))
+
+    def write_registry(self, registry: dict) -> None:
+        (self.protocol / "REGISTRY.json").write_text(json.dumps(registry, indent=2), "utf-8")
+
+    def routes(self, measured: dict) -> dict[str, int]:
+        return {name: measured[name] for name in measured["budgets"]}
+
+    def unrouted(self) -> str:
+        """A protocol document no route names, directly or through a surface."""
+        measured = protocol_budget.load_profiles(self.protocol)
+        named = {
+            doc
+            for routes in measured["profiles"].values()
+            for route in routes
+            for doc in (*route["must"], *route["conditional"])
+        }
+        surfaces = self.registry()["load_profiles"]["surfaces"]
+        named |= {doc for spec in surfaces.values() for doc in spec.get("files", ())}
+        candidates = [rel for rel in measured["documents"] if "/" not in rel and rel not in named]
+        self.assertIn("UI.md", candidates)
+        return "UI.md"
+
+
+class RouteBudgetTests(Scratch):
+    def test_pre_fix_control_a_routed_nowhere_clause_tripped_only_the_aggregate(self):
+        before = protocol_budget.load_profiles(self.protocol)
+        need = OLD_AGGREGATE_CAP - before["human_markdown_total"] + 1
+        self.grow(self.unrouted(), CLAUSE * (need // len(CLAUSE) + 1))
+        after = protocol_budget.load_profiles(self.protocol)
+        self.assertGreater(after["human_markdown_total"], OLD_AGGREGATE_CAP)
+        self.assertEqual(self.routes(after), self.routes(before))
+        self.assertEqual(protocol_budget.check(self.protocol), [])
+        self.assertIn("human_markdown_total", after["informational"])
+
+    def test_unrelated_growth_raises_the_total_and_moves_no_route(self):
+        before = protocol_budget.load_profiles(self.protocol)
+        self.grow(self.unrouted(), CLAUSE * 200)
+        after = protocol_budget.load_profiles(self.protocol)
+        self.assertGreater(after["human_markdown_total"], before["human_markdown_total"])
+        self.assertEqual(self.routes(after), self.routes(before))
+        self.assertEqual(protocol_budget.check(self.protocol), [])
+
+    def test_mandatory_growth_past_a_route_budget_fails(self):
+        for rel, profile in (("BOOT.md", "cold"), ("phases/build.md", "ordinary_phase")):
+            with self.subTest(rel=rel):
+                self.setUp()
+                measured = protocol_budget.load_profiles(self.protocol)
+                # The route counts the largest phase, so the grown document
+                # must become it: a whole budget's worth of bytes always does.
+                self.grow(rel, "x" * measured["budgets"][profile])
+                errors = protocol_budget.check(self.protocol)
+                self.assertTrue(any(error.startswith(f"{profile} ") for error in errors), errors)
+
+    def test_a_declared_dependency_chain_is_counted_whole(self):
+        before = protocol_budget.load_profiles(self.protocol)
+        (self.protocol / "B.md").write_text("b" * 300, encoding="utf-8")
+        (self.protocol / "C.md").write_text("c" * 200, encoding="utf-8")
+        registry = self.registry()
+        registry["load_profiles"]["requires"] = {"phases/done.md": ["B.md"], "B.md": ["C.md"]}
+        self.write_registry(registry)
+        after = protocol_budget.load_profiles(self.protocol)
+        self.assertEqual(after["ordinary_continue"], before["ordinary_continue"] + 500)
+        route = after["profiles"]["ordinary_continue"][0]
+        self.assertEqual(route["transitive"], ["B.md", "C.md"])
+        self.assertEqual(route["bytes"], sum(route["must"].values()))
+        self.assertEqual(after["cold"], before["cold"])
+
+    def test_a_dependency_cycle_is_a_declaration_error(self):
+        registry = self.registry()
+        registry["load_profiles"]["requires"] = {"CORE.md": ["OPS.md"], "OPS.md": ["CORE.md"]}
+        self.write_registry(registry)
+        with self.assertRaisesRegex(ValueError, "cycle"):
+            protocol_budget.load_profiles(self.protocol)
+
+    def test_an_optional_reference_does_not_inflate_the_mandatory_load(self):
+        before = protocol_budget.load_profiles(self.protocol)
+        registry = self.registry()
+        routes = registry["load_profiles"]["profiles"]["ordinary_phase"]["routes"]
+        routes[0]["conditional"].append("FUTURE.md")
+        self.write_registry(registry)
+        after = protocol_budget.load_profiles(self.protocol)
+        self.assertEqual(after["ordinary_phase"], before["ordinary_phase"])
+        self.assertIn("FUTURE.md", after["profiles"]["ordinary_phase"][0]["conditional"])
+
+    def test_verify_or_future_growth_leaves_the_cold_load_byte_identical(self):
+        before = protocol_budget.load_profiles(self.protocol)
+        cold_before = before["profiles"]["cold"]
+        self.grow("phases/verify.md", CLAUSE * 20)
+        self.grow("FUTURE.md", CLAUSE * 20)
+        after = protocol_budget.load_profiles(self.protocol)
+        self.assertEqual(after["profiles"]["cold"], cold_before)
+        self.assertEqual(after["cold"], before["cold"])
+
+    def test_one_enormous_document_fails_even_where_no_route_loads_it(self):
+        measured = protocol_budget.load_profiles(self.protocol)
+        rel = self.unrouted()
+        limit = measured["budgets"]["single_doc"]
+        self.grow(rel, "y" * (limit - measured["documents"][rel] + 1))
+        errors = protocol_budget.check(self.protocol)
+        self.assertEqual(errors, [f"file {rel} {limit + 1} > single_doc {limit}"])
+
+    def test_the_summary_is_one_line_per_route_and_names_the_total_informational(self):
+        lines = protocol_budget.summary(self.protocol)
+        budgets = self.registry()["load_profiles"]["budgets"]
+        self.assertEqual(len(lines), len(budgets) + 2)
+        for line, name in zip(lines, budgets):
+            self.assertTrue(line.startswith(name) and line.endswith("PASS"), line)
+        self.assertTrue(lines[-1].endswith("informational"), lines[-1])
+
+    def test_the_command_line_summary_exits_by_the_route_verdict(self):
+        proc = subprocess.run(
+            [sys.executable, "-B", str(TOOLS / "protocol_budget.py"), "--summary"],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            timeout=120,
+        )
+        self.assertEqual(proc.returncode, 0, proc.stdout + proc.stderr)
+        self.assertIn("human markdown total", proc.stdout)
+        self.assertLessEqual(len(proc.stdout.splitlines()), 12)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1671_lifecycle_authority.py b/tools/test_t1671_lifecycle_authority.py
new file mode 100644
index 00000000..ff5d8d29
--- /dev/null
+++ b/tools/test_t1671_lifecycle_authority.py
@@ -0,0 +1,359 @@
+"""T-1671 (SRC-192): a lifecycle typed by hand is not a lifecycle.
+
+The incident: an executor that could not find the `saipen` command wrote the
+lifecycle of its ticket by hand -- LOG events in the RFC skeleton, a `## DONE`
+row with `closure_mode`, a STATE whose `last_event` named its own tail -- and
+said so. Every reader accepted the bytes because they parse.
+
+These tests drive the real CLI against a project with a real operation ledger:
+two canonical operations run first, then the fixture writes exactly what that
+executor wrote. The unit half pins the boundaries of `lifecycle_authority`
+that a CLI fixture cannot reach cheaply.
+"""
+
+import os
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+sys.path.insert(0, str(TOOLS))
+
+import continuity_probes as probes  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+
+from saipen_engine import lifecycle_authority  # noqa: E402
+from saipen_engine.board import parse_board  # noqa: E402
+from saipen_engine.journal import OPS_DIR  # noqa: E402
+
+AGENT = "buffy"
+CODE = lifecycle_authority.CODE
+CLASS = lifecycle_authority.CLASS
+CANON = ("STATE.md", "BOARD.md", "LOG.md")
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def _project() -> Path:
+    """A git worktree with T-001 canonically claimed and moved to BUILD."""
+    root = probes.fresh_project("t1671")
+    subprocess.run(["git", "init", "-q", "."], cwd=root, check=True)
+    for args in (("continue",), ("claim", "T-001"), ("transition", "BUILD", "T-001", "scout done")):
+        answer = probes.cli(root, AGENT, *args)
+        assert answer.get("ok"), (args, answer)
+    return root
+
+
+def _state_field(root: Path, field: str, value: str) -> None:
+    path = root / ".saipen" / "STATE.md"
+    text = path.read_text(encoding="utf-8")
+    text, count = re.subn(rf"^{field}: .*$", f"{field}: {value}", text, flags=re.MULTILINE)
+    assert count == 1, (field, text)
+    path.write_text(text, encoding="utf-8", newline="\n")
+
+
+def _log_tail(root: Path) -> int:
+    text = (root / ".saipen" / "LOG.md").read_text(encoding="utf-8")
+    return max(int(match.group(1)) for match in re.finditer(r"\[E-(\d+)\]", text))
+
+
+def _type_the_lifecycle(root: Path, *, keep_task: bool = False) -> None:
+    """What the executor wrote: three LOG events, a DONE row, a DONE state."""
+    probes.append_log(root, "T-001", AGENT, "RUN: build -> widget implemented per ADR-7")
+    probes.append_log(
+        root, "T-001", AGENT,
+        "RUN: verify -> PASS [target: T-001] conf: high -- python tools/validate.py -> PASS",
+    )
+    probes.append_log(
+        root, "T-001", AGENT,
+        "DEC: T-001 DONE; lifecycle records written by hand against the RFC field shapes",
+    )
+    board = root / ".saipen" / "BOARD.md"
+    text = board.read_text(encoding="utf-8")
+    line = next(row for row in text.splitlines() if "T-001" in row)
+    text = text.replace(line + "\n", "")
+    done = re.sub(r"^- \[.\]", "- [x]", line) + " | closure_mode: own_patch"
+    board.write_text(text.replace("## DONE\n", "## DONE\n" + done + "\n"),
+                     encoding="utf-8", newline="\n")
+    _state_field(root, "phase", "DONE")
+    _state_field(root, "transition_from", "SHIP")
+    _state_field(root, "next_action", '"saipen continue"')
+    _state_field(root, "last_event", str(_log_tail(root)))
+    if not keep_task:
+        _state_field(root, "task", "none")
+
+
+def _bytes(root: Path) -> dict:
+    return {name: (root / ".saipen" / name).read_bytes() for name in CANON}
+
+
+def _lifecycle_fails(root: Path) -> list[str]:
+    _code, out = probes.validate(root)
+    return [line for line in out.splitlines()
+            if line.startswith("FAIL") and "lifecycle authority" in line]
+

+++ b/tools/test_t1642_history_notes.py
@@ -0,0 +1,110 @@
+"""T-1642: sealed history is a counted fact, not a WARN.
+
+A WARN no action can clear trains readers to skip the WARN block where the
+actionable findings print. Sealed segments are immutable by append-only, so a
+defect that lives only there is reported once as a `history:` PASS line, while
+the same defect written into the active log keeps its WARN or FAIL.
+"""
+
+from __future__ import annotations
+
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+from test_fixture_support import restamp_live_style  # noqa: E402
+from test_hermetic_env import hermetic_env, isolate_host_session  # noqa: E402
+
+SCENARIO = ROOT / "tests" / "scenarios" / "userperson-valid" / ".saipen"
+VALIDATOR = TOOLS / "validate.py"
+
+DATELESS = "- [E-001] [T-none] DEC: fixture bootstrap\n"
+DATED_FIRST = "- 08.08.26 00:00 [E-001] [T-none] DEC: fixture bootstrap\n"
+UNTRIPPED = (
+    "- 08.08.26 00:00 [E-001] [T-none] DEC: goal reauthorized -- "
+    "goal_waves 0->0, goal_tickets 3->0\n"
+)
+SECOND = "- 08.08.26 00:01 [E-002] [parent: E-001] [T-none] DEC: fixture continues\n"
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+class HistoryNoteTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self._tmp = tempfile.TemporaryDirectory(prefix="saipen-t1642-")
+        self.addCleanup(self._tmp.cleanup)
+        self.root = Path(self._tmp.name) / "project"
+        self.root.mkdir()
+        shutil.copytree(SCENARIO, self.root / ".saipen")
+        restamp_live_style(self.root / ".saipen")
+
+    def _project(self, *, sealed: str | None, active: str, goal: bool = False) -> None:
+        memory = self.root / ".saipen"
+        if sealed is not None:
+            (memory / "logs").mkdir()
+            (memory / "logs" / "LOG-001.md").write_text(sealed, encoding="utf-8")
+        (memory / "LOG.md").write_text(active, encoding="utf-8")
+        last = 2 if sealed is not None or active.count("[E-") == 2 else 1
+        state = (memory / "STATE.md").read_text(encoding="utf-8")
+        state = state.replace("last_event: 1\n", f"last_event: {last}\n")
+        if goal:
+            state = state.replace(
+                "mode: full\n",
+                "mode: full\nexecution_intent: goal\ngoal_waves: 0\ngoal_tickets: 0\n",
+            )
+        (memory / "STATE.md").write_text(state, encoding="utf-8")
+
+    def _validate(self) -> str:
+        done = subprocess.run(
+            [sys.executable, str(VALIDATOR), "--project-root", str(self.root), "--gate", "core"],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            env=hermetic_env(),
+            timeout=600,
+        )
+        return done.stdout + done.stderr
+
+    def test_a_sealed_dateless_entry_is_history_not_a_warn(self) -> None:
+        self._project(sealed=DATELESS, active=SECOND)
+        out = self._validate()
+        self.assertNotIn("[log-missing-date]", out)
+        self.assertIn("history: 1 sealed LOG entr(y/ies) predate the mandatory DATE", out)
+
+    def test_an_active_dateless_entry_still_fails(self) -> None:
+        self._project(sealed=None, active=DATELESS)
+        out = self._validate()
+        self.assertIn("has no DATE", out)
+        self.assertTrue(
+            any(line.startswith("FAIL") and "has no DATE" in line for line in out.splitlines()),
+            out,
+        )
+
+    def test_a_sealed_untripped_reauthorization_is_history(self) -> None:
+        self._project(sealed=UNTRIPPED, active=SECOND, goal=True)
+        out = self._validate()
+        self.assertNotIn("[goal-reauth-untripped]", out)
+        self.assertIn("history: 1 sealed `DEC: goal reauthorized` line(s)", out)
+
+    def test_an_active_untripped_reauthorization_still_warns(self) -> None:
+        self._project(
+            sealed=DATED_FIRST,
+            active=UNTRIPPED.replace("[E-001] [T-none]", "[E-002] [parent: E-001] [T-none]"),
+            goal=True,
+        )
+        out = self._validate()
+        self.assertIn("WARN [goal-reauth-untripped]", out)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1645_zero_hunt.py b/tools/test_t1645_zero_hunt.py
new file mode 100644
index 00000000..060a2c41
--- /dev/null
+++ b/tools/test_t1645_zero_hunt.py
@@ -0,0 +1,194 @@
+"""T-1645 / SRC-187: a cold agent reaches the current Work without hunting.
+
+A downstream agent given `/goal cc all` met `saipen: command not found`,
+searched the SAIPEN repository for a launcher, then grepped BOARD for its
+ticket and the filesystem for the ticket's source receipt. Every fact it
+hunted for was already known to the project: `.saipen/STATE.md` names
+`saipen_home`, and the router knows the current Work and its receipts.
+
+Pinned here:
+
+- the PATH-miss rule: one read of STATE's `saipen_home:` line, the launcher
+  under that home, the PROJECT root as working directory (BOOT, ACTIVATION);
+- routing precedes a generic skill or persona bootstrap (BOOT, ACTIVATION);
+- `continue --json` carries `work`: the routed ticket's BOARD record and the
+  exact paths of its source receipt, so entering the phase needs no search;
+- end to end, with `saipen` absent from PATH, the documented read plus the
+  home's own launcher route a fixture project to its current ticket.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import shutil
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+import test_t1614_future_gate as H  # noqa: E402
+from test_hermetic_env import hermetic_env, isolate_host_session  # noqa: E402
+
+BOOT = ROOT / "saipen" / "BOOT.md"
+ACTIVATION = ROOT / "saipen" / "ACTIVATION_BLOCK.md"
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def _flat(path: Path) -> str:
+    return " ".join(path.read_text(encoding="utf-8").split())
+
+
+def _home_from_state(project: Path) -> Path | None:
+    """The documented PATH-miss read: the `saipen_home:` line, YAML-unescaped."""
+    text = (project / ".saipen" / "STATE.md").read_text(encoding="utf-8")
+    match = re.search(r'(?m)^saipen_home:\s*"?([^"\r\n]+?)"?\s*$', text)
+    return Path(match.group(1).replace("\\\\", "\\")) if match else None
+
+
+def _env_without_saipen() -> dict:
+    env = hermetic_env()
+    keep = [
+        entry
+        for entry in env.get("PATH", "").split(os.pathsep)
+        if entry and not any((Path(entry) / name).exists() for name in ("saipen", "saipen.cmd"))
+    ]
+    env["PATH"] = os.pathsep.join(keep)
+    return env
+
+
+class BootstrapRuleTests(unittest.TestCase):
+    def test_boot_states_the_one_read_path_miss_rule(self):
+        boot = _flat(BOOT)
+        for phrase in (
+            "runs with the PROJECT root as working directory",
+            "else under `<saipen_home>` `bin/saipen`",
+            "`bin/saipen.cmd` (cmd, PowerShell)",
+            "A PATH miss costs one read: the `saipen_home:` line of `.saipen/STATE.md`",
+            "Never search or try another home",
+        ):
+            self.assertIn(phrase, boot)
+
+    def test_boot_puts_routing_before_a_generic_bootstrap(self):
+        boot = _flat(BOOT)
+        self.assertIn("Routing is the first operational action.", boot)
+        self.assertIn("precedes any generic skill or persona bootstrap", boot)
+        self.assertIn("never grep BOARD or search `.saipen` for them", boot)
+
+    def test_the_injected_block_names_the_launcher_and_the_order(self):
+        block = _flat(ACTIVATION)
+        self.assertIn("LAUNCHER: `saipen` not on PATH -> run `{{SAIPEN_HOME}}/bin/saipen`", block)
+        self.assertIn("`{{SAIPEN_HOME}}\\bin\\saipen.cmd`", block)
+        self.assertIn("Generic skill/persona bootstrap waits for routing.", block)
+
+    def test_the_injected_block_never_orders_a_public_clone(self):
+        # SRC-188: a public clone is not a project's runtime; the old line
+        # sent a cold agent to fetch HEAD and continue on a mismatched version.
+        block = _flat(ACTIVATION)
+        self.assertNotIn("clone github.com", block)
+        self.assertIn("never clone a public copy to continue Work", block)
+
+
+class WorkContextTests(unittest.TestCase):
+    def setUp(self):
+        self.base, self.project = H._project(intent="goal")
+        self.addCleanup(shutil.rmtree, self.base, True)
+        self.tid = H._add(self.project, "the current work")
+        board = self.project / ".saipen" / "BOARD.md"
+        text = board.read_text(encoding="utf-8")
+        line = next(ln for ln in text.splitlines() if f"] {self.tid} [" in ln)
+        board.write_text(text.replace(line, line + " | source_receipts: SRC-001"), encoding="utf-8")
+        active = self.project / ".saipen" / "intake" / "active"
+        active.mkdir(parents=True)
+        (active / "SRC-001.md").write_text("# User request\n\nthe current work\n", encoding="utf-8")
+
+    def _continue(self) -> dict:
+        proc = subprocess.run(
+            [
+                sys.executable,
+                str(TOOLS / "saipen.py"),
+                "continue",
+                "--json",
+                "--dry-run",
+                "--project-root",
+                str(self.project),
+            ],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            env=hermetic_env(),
+            timeout=300,
+        )
+        return json.loads(proc.stdout)
+
+    def test_continue_names_the_work_record_and_its_source_by_path(self):
+        payload = self._continue()
+        self.assertEqual(payload.get("ticket"), self.tid, payload)
+        work = payload.get("work")
+        self.assertIsInstance(work, dict, payload)
+        self.assertEqual(work["id"], self.tid)
+        self.assertIn(f"{self.tid} [", work["record"])
+        self.assertEqual(Path(work["board"]), self.project / ".saipen" / "BOARD.md")
+        [source] = work["source_receipts"]
+        self.assertEqual(source["id"], "SRC-001")
+        self.assertTrue(Path(source["body"]).is_file(), source)
+        self.assertNotIn("contract", source, "a locator names only paths that exist")
+
+
+class PathMissColdStartTests(unittest.TestCase):
+    """The incident: `saipen` is not on PATH and no session context exists."""
+
+    def setUp(self):
+        self.base, self.project = H._project(intent="goal")
+        self.addCleanup(shutil.rmtree, self.base, True)
+        self.tid = H._add(self.project, "the current work")
+        self.env = _env_without_saipen()
+        self.assertIsNone(shutil.which("saipen", path=self.env["PATH"]))
+
+    def _check(self, command: list[str]) -> None:
+        proc = subprocess.run(
+            [*command, "continue", "--json", "--dry-run"],
+            cwd=str(self.project),
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+            env=self.env,
+            timeout=300,
+        )
+        payload = json.loads(proc.stdout or "{}")
+        self.assertEqual(payload.get("ticket"), self.tid, proc.stdout + proc.stderr)
+        self.assertTrue(str(payload.get("action") or "").startswith("PHASE "), payload)
+        self.assertEqual(
+            Path(payload["cold_route"]["project_root"]).resolve(), self.project.resolve()
+        )
+        self.assertEqual((payload.get("work") or {}).get("id"), self.tid, payload)
+
+    def test_the_state_read_resolves_the_home_launcher(self):
+        home = _home_from_state(self.project)
+        self.assertIsNotNone(home)
+        self.assertEqual(home.resolve(), ROOT.resolve())
+        native = home / "bin" / ("saipen.cmd" if os.name == "nt" else "saipen")
+        if not native.is_file():
+            self.skipTest("this checkout carries no generated launcher in bin/")
+        self._check(["cmd", "/c", str(native)] if os.name == "nt" else [str(native)])
+
+    def test_git_bash_runs_the_posix_launcher_with_forward_slashes(self):
+        home = _home_from_state(self.project)
+        posix = home / "bin" / "saipen"
+        sh = shutil.which("sh", path=self.env["PATH"])
+        if not posix.is_file() or sh is None:
+            self.skipTest("no POSIX launcher or no sh on this host")
+        self._check([sh, str(posix).replace("\\", "/")])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1651_executor_admission.py b/tools/test_t1651_executor_admission.py
new file mode 100644
index 00000000..44acd979
--- /dev/null
+++ b/tools/test_t1651_executor_admission.py
@@ -0,0 +1,355 @@
+"""T-1651 / SRC-189: an executor is admitted for what the current step needs.
+
+The incident: a continuation task for a SAIPEN-managed C# project reached an
+executor that exposed only `read_tabular` and `system_todo_write`. It reasoned
+correctly for about fourteen seconds and then reported it could do nothing.
+T-1619 already answers that executor `EXECUTOR_CAPABILITY_MISMATCH`.
+
+SRC-189 asks for more than the rejection, and these cases bind the part this
+ticket delivers:
+
+* the admission is a CONTRACT a host reads (R011, R022): what the step
+  requires, what the executor was granted from the tools it actually
+  advertised, the result, what is missing and what follows;
+* the requirement is the PHASE's (R003, R016, R017): SCOUT reads, VERIFY and
+  REVIEW run the project's checks, and only a phase that edits the tree is
+  charged for editing it -- no executor is rejected for a capability the
+  current step does not require;
+* control-plane access is a capability of its own (R005);
+* an executor that advertises the filesystem and a shell is a full one (R015);
+* an exhausted pool is ONE blocker that names what was required and what each
+  executor lacked (R008).
+
+Every case is read-only against the project: the verdict writes nothing.
+"""
+
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+from saipen_engine import host_iteration as HI  # noqa: E402
+from saipen_engine import iteration  # noqa: E402
+from saipen_engine import iteration_verdict as IV  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+from test_t1614_future_gate import CURRENT_STYLE_CONTRACT, ROOT  # noqa: E402
+
+ENGINE = TOOLS / "saipen.py"
+
+#: What the incident executor advertised.
+SAIOPP = {"read_tabular": True, "system_todo_write": True}
+#: A full coding executor, in the words STATE `requires` uses.
+FULL = {"filesystem": True, "shell": True, "git": True, "python": True}
+#: Reads the repository and runs processes; cannot edit a file.
+RUNS_AND_READS = {"filesystem_read": True, "shell": True, "git": True, "python": True}
+#: Reads the repository and reaches the control plane; no shell at all.
+READS_ONLY = {"filesystem_read": True, "saipen_control": True, "git": True, "python": True}
+
+_SOURCE = {"SCOUT": "DONE", "BUILD": "SCOUT", "VERIFY": "BUILD", "REVIEW": "VERIFY",
+           "SHIP": "REVIEW"}
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def _memory(project: Path) -> dict[str, bytes]:
+    base = project / ".saipen"
+    return {p.name: p.read_bytes() for p in sorted(base.iterdir()) if p.is_file()}
+
+
+class _Project(unittest.TestCase):
+    """A managed C# project with one active ticket, in a chosen phase."""
+
+    requires = ("filesystem", "git", "python")
+
+    def project(self, phase: str = "BUILD", *, requires: tuple[str, ...] | None = None) -> Path:
+        base = Path(tempfile.mkdtemp(prefix="saipen-t1651-"))
+        self.addCleanup(shutil.rmtree, base, True)
+        root = base / "project"
+        (root / ".saipen").mkdir(parents=True)
+        (root / "src").mkdir()
+        (root / "src" / "Service.cs").write_text("class Service {}\n", encoding="utf-8")
+        wanted = self.requires if requires is None else requires
+        (root / ".saipen" / "STATE.md").write_text(
+            "---\n"
+            f"phase: {phase}\n"
+            "task: T-7\n"
+            f'next_action: "PHASE {phase} T-7"\n'
+            'blocker: ""\n'
+            f"transition_from: {_SOURCE[phase]}\n"
+            "saipen_version: 8\n"
+            "schema_version: 3\n"
+            "last_event: 1\n"
+            "style_contract: " + CURRENT_STYLE_CONTRACT + "\n"
+            f'saipen_home: "{str(ROOT).replace(chr(92), chr(92) * 2)}"\n'
+            "agent: tester\n"
+            "requires:\n" + "".join(f"  - {name}\n" for name in wanted) +
+            "mode: full\n"
+            "execution_intent: goal\n"
+            "goal_waves: 0\n"
+            "goal_tickets: 1\n"
+            'updated: "2026-10-07T00:00:00Z"\n'
+            "---\n",
+            encoding="utf-8",
+        )
+        (root / ".saipen" / "BOARD.md").write_text(
+            "## DOING\n"
+            "- [/] T-7 [P1] Change the C# service | verify: dotnet build and dotnet test pass"
+            " | owner: tester | claim_time: 2026-10-07T00:00:00Z\n"
+            "## TODO\n## DONE\n## BLOCKED\n",
+            encoding="utf-8",
+        )
+        (root / ".saipen" / "LOG.md").write_text(
+            "- 07.10.26 00:00 [E-001] [T-7] [agent: tester] RUN: fixture -> PASS\n",
+            encoding="utf-8",
+        )
+        return root
+
+    def verdict(self, phase: str, caps: dict | None, **kwargs) -> dict:
+        root = self.project(phase)
+        before = _memory(root)
+        found = IV.project_iteration_verdict(root, executor_caps=caps, **kwargs)
+        self.assertEqual(_memory(root), before, "the verdict writes nothing")
+        self.assertTrue(found["state_readable"], found)
+        return found
+
+
+class ContractTests(_Project):
+    """R011 / R022: required, granted, result, missing, next -- as data."""
+

+"""T-1659: "completed" in the operator checkpoint means what THIS run completed.
+
+The machine digest counted every ticket finished since the last stop
+operation. A project that is never stopped never resets that window: measured
+on 2026-10-07, one project answered `133 completed` after a run that finished
+one ticket (it has no stop operation in its whole history), and this
+repository answered 22. The count is the first thing the checkpoint says about
+the outcome, so it has to be about the run the operator is looking at.
+
+A run starts over at a stop and at every operator ingress: a user request, a
+goal. The stop REASON of the digest keeps reading the last stop alone.
+"""
+
+from __future__ import annotations
+
+import shutil
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+import test_t1614_future_gate as H  # noqa: E402
+from saipen_engine import response_surface as RS  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+
+FINISHED = "ticket finished via SAIOPS -- completion (from SHIP)"
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+class _Log(unittest.TestCase):
+    def setUp(self) -> None:
+        base, self.project = H._project()
+        self.addCleanup(shutil.rmtree, base, True)
+        self.lines: list[str] = []
+
+    def event(self, text: str, *, ticket: str = "", op: str = "", taxonomy: str = "DEC") -> int:
+        number = len(self.lines) + 1
+        parts = [f"- 01.09.26 00:{number % 60:02d} [E-{number:03d}]"]
+        if number > 1:
+            parts.append(f"[parent: E-{number - 1:03d}]")
+        if ticket:
+            parts.append(f"[{ticket}]")
+        parts.append("[agent: tester]")
+        if op:
+            parts.append(f"[op: {op}-{number:032x}]")
+        self.lines.append(" ".join(parts) + f" {taxonomy}: {text}")
+        return number
+
+    def finish(self, ticket: str) -> int:
+        return self.event(FINISHED, ticket=ticket, op="finish")
+
+    def facts(self, *, last_event: int | None = None) -> dict:
+        (self.project / ".saipen" / "LOG.md").write_text(
+            "\n".join(self.lines) + "\n", encoding="utf-8"
+        )
+        state = self.project / ".saipen" / "STATE.md"
+        number = len(self.lines) if last_event is None else last_event
+        state.write_text(
+            "\n".join(
+                f"last_event: {number}" if line.startswith("last_event:") else line
+                for line in state.read_text(encoding="utf-8").splitlines()
+            )
+            + "\n",
+            encoding="utf-8",
+        )
+        return RS.canonical_facts(self.project)
+
+
+class RunWindowTests(_Log):
+    def test_without_a_boundary_every_finish_counts(self):
+        self.finish("T-1")
+        self.finish("T-2")
+        self.assertEqual(self.facts()["completed"], ["T-1", "T-2"])
+
+    def test_a_stop_starts_the_run_over(self):
+        self.finish("T-1")
+        self.event("stopped via SAIOPS checkpoint", op="stop")
+        self.finish("T-2")
+        self.assertEqual(self.facts()["completed"], ["T-2"])
+
+    def test_an_operator_request_starts_the_run_over(self):
+        self.finish("T-1")
+        self.event("user request SRC-002 projected as T-2", ticket="T-2", op="userreq")
+        self.finish("T-2")
+        self.assertEqual(self.facts()["completed"], ["T-2"])
+
+    def test_a_goal_starts_the_run_over(self):
+        for op in ("goal", "goal-entry"):
+            with self.subTest(op):
+                self.lines = []
+                self.finish("T-1")
+                self.event("goal entered", op=op)
+                self.finish("T-2")
+                self.assertEqual(self.facts()["completed"], ["T-2"])
+
+    def test_a_machine_operation_is_not_a_boundary(self):
+        self.finish("T-1")
+        for op in ("claim", "checkpoint", "transition", "scope", "reconcile", "ticket"):
+            self.event(f"{op} recorded", ticket="T-2", op=op, taxonomy="RUN")
+        self.finish("T-2")
+        self.assertEqual(self.facts()["completed"], ["T-1", "T-2"])
+
+    def test_the_pointer_follows_the_same_window(self):
+        self.event("verify -> PASS [target: T-1] conf: high", ticket="T-1", op="checkpoint",
+                   taxonomy="RUN")
+        self.finish("T-1")
+        self.event("user request SRC-002 projected as T-2", ticket="T-2", op="userreq")
+        verified = self.event("verify -> PASS [target: T-2] conf: high", ticket="T-2",
+                              op="checkpoint", taxonomy="RUN")
+        finished = self.finish("T-2")
+        refs = self.facts()["detail_refs"]
+        self.assertEqual(refs, [f"E-{verified:03d}", f"E-{finished:03d}"])
+
+    def test_the_stop_reason_still_reads_the_last_stop_alone(self):
+        self.finish("T-1")
+        stopped = self.event("stopped via SAIOPS checkpoint", op="stop")
+        self.assertEqual(self.facts(last_event=stopped)["response_reason"], "stop")
+        self.event("user request SRC-002 projected as T-2", ticket="T-2", op="userreq")
+        self.assertEqual(self.facts()["response_reason"], "final", "an ingress is not a stop")
+
+    def test_the_checkpoint_names_the_one_ticket_of_this_run(self):
+        """The measured shape: a long history that was never stopped, one
+        operator request, one ticket finished after it."""
+        for number in range(1, 41):
+            self.finish(f"T-{number}")
+        self.event("user request SRC-009 projected as T-41", ticket="T-41", op="userreq")
+        self.finish("T-41")
+        facts = self.facts()
+        self.assertEqual(facts["completed"], ["T-41"])
+        text = RS.digest_from_facts({**facts, "phase": "DONE"}, reason="status", language="et")
+        result = RS.parse_surface(text)[0]["RESULT"]
+        self.assertIn("T-41 lõpetatud", result)
+        self.assertNotIn("41 lõpetatud;", result.replace("T-41 lõpetatud", ""))
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1661_suite_projection.py b/tools/test_t1661_suite_projection.py
new file mode 100644
index 00000000..2a488beb
--- /dev/null
+++ b/tools/test_t1661_suite_projection.py
@@ -0,0 +1,296 @@
+"""T-1661: a declared suite is named where the next act is chosen.
+
+T-1658 gave a project one declared suite, an engine run and a typed record --
+and no answer of the engine named the run command. Whether the checkpoint
+could state suite totals then depended on an agent remembering one row of
+COMMANDS.md.
+
+The turn-entry answers (`continue`, `status`) and the `transition` answer now
+carry a `suite` field with the exact run command, and only when there is a run
+to do: a suite is declared, the phase is one that proves the tree (VERIFY,
+REVIEW, SHIP) and this tree has no record. A project that declares no suite
+gets no field, and neither does a tree that already has its record.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+from saipen_engine import phases  # noqa: E402
+from saipen_engine import suite_record as SR  # noqa: E402
+from test_hermetic_env import isolate_host_session  # noqa: E402
+from test_orchestration_repair import OrchestrationFixture  # noqa: E402
+
+ENGINE = TOOLS / "saipen.py"
+RUN = "saipen test suite run T-7"
+SUMMARY = "=== 3 passed in 0.10s ==="
+
+
+def setUpModule() -> None:
+    isolate_host_session()
+
+
+def _git(project: Path, *args: str) -> None:
+    subprocess.run(
+        ["git", "-c", "user.name=t", "-c", "user.email=t@example.invalid", *args],
+        cwd=project, stdin=subprocess.DEVNULL, capture_output=True, check=True, timeout=120,
+    )
+
+
+class _Suite(OrchestrationFixture):
+    """An active ticket T-7 in BUILD, a git tree and a scripted green suite."""
+
+    def setUp(self) -> None:
+        self.project = self.make_project(active=True)
+        (self.project / "suite.py").write_text(f"print({SUMMARY!r})\n", encoding="utf-8")
+        (self.project / "main.py").write_text("value = 1\n", encoding="utf-8")
+        _git(self.project, "init", "-q")
+        _git(self.project, "add", "-A")
+        _git(self.project, "commit", "-q", "-m", "fixture")
+        self.command = [sys.executable, "-B", "suite.py"]
+
+    def phase(self, name: str) -> None:
+        """Rewrite STATE to a VALID state in `name`; a malformed one would make
+        every "no field" assertion pass for the wrong reason."""
+        bearing = name in phases.TICKET_BEARING_PHASES
+        # A phase enterable from anywhere names no source in the table.
+        source = next(
+            (tf for tf, allowed in sorted(phases.VALID_TRANSITIONS.items()) if name in allowed),
+            "DONE",
+        )
+        fields = {
+            "phase": name,
+            "task": "T-7" if bearing else "none",
+            "next_action": f'"PHASE {name} T-7"' if bearing else '"saipen continue"',
+            "transition_from": source,
+        }
+        path = self.project / ".saipen" / "STATE.md"
+        lines = [
+            f"{line.split(':', 1)[0]}: {fields[line.split(':', 1)[0]]}"
+            if line.split(":", 1)[0] in fields
+            else line
+            for line in path.read_text(encoding="utf-8").splitlines()
+        ]
+        path.write_text("\n".join(lines) + "\n", encoding="utf-8")
+        self.assertEqual(self.state(self.project)["phase"], name)
+
+    def record(self) -> None:
+        SR.write_record(self.project, SR.run(self.project))
+
+    def cli(self, *args: str):
+        """One engine call bound to the fixture twice over.
+
+        The root goes FIRST: appended after the words, it lands behind the
+        `--` of `declare -- <command>`, becomes part of the suite command, and
+        the call binds whatever project the working directory is in. That
+        directory is therefore the fixture too, never the repository the tests
+        run from -- measured on 2026-10-07: five `suite declared` lines in this
+        repository's own LOG before the first assertion failed.
+        """
+        env = {k: v for k, v in os.environ.items() if not k.upper().startswith("SAIPEN")}
+        env["PWD"] = str(self.project)
+        proc = subprocess.run(
+            [sys.executable, "-B", str(ENGINE), "--project-root", str(self.project), *args],
+            stdin=subprocess.DEVNULL, capture_output=True, env=env, cwd=str(self.project),
+            timeout=300, check=False,
+        )
+        return proc.returncode, proc.stdout.decode("utf-8")
+
+
+class ProjectionTests(_Suite):
+    def test_a_project_that_declares_no_suite_gets_no_field(self):
+        for phase in ("VERIFY", "REVIEW", "SHIP", "BUILD"):
+            with self.subTest(phase):
+                self.phase(phase)
+                self.assertIsNone(SR.projection(self.project))
+
+    def test_the_run_command_is_named_while_the_tree_has_no_record(self):
+        SR.declare(self.project, self.command)
+        for phase in ("VERIFY", "REVIEW", "SHIP"):
+            with self.subTest(phase):
+                self.phase(phase)
+                found = SR.projection(self.project)
+                self.assertEqual(found["command"], RUN)
+                self.assertIn("no record of the current tree", found["reason"])
+
+    def test_nothing_is_named_once_the_tree_has_its_record(self):
+        SR.declare(self.project, self.command)
+        self.phase("VERIFY")
+        self.record()
+        self.assertIsNone(SR.projection(self.project))
+        (self.project / "main.py").write_text("value = 2\n", encoding="utf-8")
+        self.assertEqual(SR.projection(self.project)["command"], RUN, "the tree moved on")
+        self.record()
+        self.assertIsNone(SR.projection(self.project))
+
+    def test_a_red_record_of_this_tree_is_still_its_record(self):
+        """The field means "this tree was not run", never "run it until green"."""
+        (self.project / "suite.py").write_text(
+            "import sys\nprint('=== 1 failed, 2 passed in 0.10s ===')\nsys.exit(1)\n",
+            encoding="utf-8",
+        )
+        SR.declare(self.project, self.command)
+        self.phase("VERIFY")
+        self.record()
+        self.assertIsNone(SR.projection(self.project))
+
+    def test_the_phases_that_do_not_prove_the_tree_carry_no_field(self):
+        SR.declare(self.project, self.command)
+        for phase in ("SCOUT", "BUILD", "DONE", "BLOCKED", "PLAN", "CLEAN"):
+            with self.subTest(phase):
+                self.phase(phase)
+                self.assertIsNone(SR.projection(self.project))
+
+    def test_a_damaged_declaration_or_state_is_silence_not_a_crash(self):
+        SR.declare(self.project, self.command)
+        self.phase("VERIFY")
+        declaration = self.project / SR.DECLARATION_REL
+        kept = declaration.read_bytes()
+        declaration.write_text("{", encoding="utf-8")
+        self.assertIsNone(SR.projection(self.project))
+        declaration.write_bytes(kept)
+        (self.project / ".saipen" / "STATE.md").unlink()
+        self.assertIsNone(SR.projection(self.project))
+
+    def test_the_named_command_is_one_the_guard_admits(self):
+        from saipen_engine import guard_events
+
+        SR.declare(self.project, self.command)
+        self.phase("VERIFY")
+        command = SR.projection(self.project)["command"]
+        self.assertIsNotNone(guard_events._saipen_cli_verb(command), command)
+
+
+class AnswerTests(_Suite):
+    def test_transition_to_verify_and_continue_name_the_run_then_fall_silent(self):
+        rc, out = self.cli("continue", "--json")
+        self.assertEqual(rc, 0, out)
+        self.assertNotIn("suite", json.loads(out), "nothing declared, nothing named")
+
+        rc, out = self.cli("test", "suite", "declare", "--json", "--", *self.command)
+        self.assertEqual((rc, json.loads(out)["code"]), (0, "SUITE_DECLARED"), out)
+        rc, out = self.cli("continue", "--json")
+        self.assertNotIn("suite", json.loads(out), "BUILD does not prove the tree")
+
+        rc, out = self.cli("transition", "VERIFY", "T-7", "build recorded", "--json")
+        moved = json.loads(out)
+        self.assertEqual((rc, moved["code"]), (0, "TRANSITIONED"), out)
+        self.assertEqual(moved["suite"]["command"], RUN)
+
+        rc, out = self.cli("continue", "--json")
+        self.assertEqual(json.loads(out)["suite"]["command"], RUN, out)
+        rc, out = self.cli("status", "--json")
+        self.assertEqual(json.loads(out)["suite"]["command"], RUN, out)
+        rc, out = self.cli("continue")
+        self.assertIn("suite: " + RUN, out.splitlines(), "the plain answer names it too")
+
+        rc, out = self.cli("test", "suite", "run", "T-7", "--json")
+        ran = json.loads(out)
+        self.assertEqual((rc, ran["code"], ran["verdict"]), (0, "SUITE_RECORDED", "PASS"), out)
+        rc, out = self.cli("continue", "--json")
+        self.assertNotIn("suite", json.loads(out), "this tree has its record")
+        rc, out = self.cli("status", "--json")
+        self.assertNotIn("suite", json.loads(out))
+
+    def test_the_harness_binds_the_fixture_and_never_the_repository_it_runs_from(self):
+        """The leak this module once had, asked directly: an engine call whose
+        words end in `-- <command>` must still land in the fixture."""
+        rc, out = self.cli("test", "suite", "declare", "--json", "--", *self.command)
+        self.assertEqual((rc, json.loads(out)["command"]), (0, self.command), out)
+        declared, error = SR.load_declaration(self.project)
+        self.assertIsNone(error)
+        self.assertEqual(declared["command"], self.command)
+        log = (self.project / ".saipen" / "LOG.md").read_text(encoding="utf-8")
+        self.assertIn("suite declared -- command:" + declared["command_sha256"][:16], log)
+
+    def test_a_refused_transition_and_other_commands_carry_no_field(self):
+        self.cli("test", "suite", "declare", "--json", "--", *self.command)
+        self.phase("VERIFY")
+        rc, out = self.cli("transition", "SHIP", "T-7", "skipping review", "--json")
+        refused = json.loads(out)
+        self.assertFalse(refused["ok"], out)
+        self.assertNotIn("suite", refused)
+        rc, out = self.cli("checkpoint", "RUN", "T-7", "a note", "--json")
+        self.assertEqual(rc, 0, out)
+        self.assertNotIn("suite", json.loads(out), "only the answers that choose the next act")
+
+
+class WithdrawTests(_Suite):
+    """A declaration has an inverse the engine owns: without one, undoing a
+    declaration meant writing into the namespace a file tool is refused in."""
+
+    def test_withdraw_removes_the_declaration_and_keeps_the_records(self):
+        with self.assertRaises(LookupError):
+            SR.withdraw(self.project)
+        SR.declare(self.project, self.command)
+        self.phase("VERIFY")
+        self.record()
+        result = SR.withdraw(self.project)
+        self.assertEqual(result["previous_sha256"], SR.command_digest(self.command))
+        self.assertIsNone(result["was_invalid"])
+        self.assertEqual(SR.load_declaration(self.project), (None, None))
+        self.assertEqual(len(list((self.project / SR.RECORD_DIR_REL).glob("*-*.json"))), 1)
+        self.assertIsNone(SR.newest_record(self.project), "no declaration, no suite claim")
+        self.assertIsNone(SR.projection(self.project))
+        with self.assertRaises(LookupError):
+            SR.withdraw(self.project)
+
+    def test_the_command_withdraws_once_and_says_what_it_removed(self):
+        rc, out = self.cli("test", "suite", "withdraw", "--json")
+        refused = json.loads(out)
+        self.assertEqual((rc, refused["code"], refused["suite"]),
+                         (1, "VALIDATION_FAILED", "NOT_DECLARED"), out)
+        self.cli("test", "suite", "declare", "--json", "--", *self.command)
+        digest = SR.command_digest(self.command)
+        rc, out = self.cli("test", "suite", "withdraw", "--dry-run", "--json")
+        self.assertEqual((rc, json.loads(out)["code"]), (0, "SUITE_WITHDRAW_PLAN"), out)
+        self.assertIsNotNone(SR.load_declaration(self.project)[0], "a preview removes nothing")
+        rc, out = self.cli("test", "suite", "withdraw", "--json")
+        gone = json.loads(out)
+        self.assertEqual((rc, gone["code"], gone["previous_sha256"]),
+                         (0, "SUITE_WITHDRAWN", digest), out)
+        log = (self.project / ".saipen" / "LOG.md").read_text(encoding="utf-8")
+        self.assertIn("suite withdrawn -- command:" + digest[:16], log)
+        rc, out = self.cli("test", "suite", "--json")
+        self.assertEqual((rc, json.loads(out)["declared"]), (0, False), out)
+
+    def test_a_damaged_declaration_can_be_withdrawn(self):
+        SR.declare(self.project, self.command)
+        (self.project / SR.DECLARATION_REL).write_text("{", encoding="utf-8")
+        rc, out = self.cli("test", "suite", "withdraw", "--json")
+        gone = json.loads(out)
+        self.assertEqual((rc, gone["code"], gone["previous_sha256"]),
+                         (0, "SUITE_WITHDRAWN", None), out)
+        self.assertIn("unreadable", gone["was_invalid"])
+        self.assertEqual(SR.load_declaration(self.project), (None, None))
+        log = (self.project / ".saipen" / "LOG.md").read_text(encoding="utf-8")
+        self.assertIn("suite withdrawn -- an unreadable declaration", log)
+
+    def test_withdraw_writes_and_is_refused_in_a_read_only_session(self):
+        from saipen_engine.command_effects import classify_tokens
+
+        self.assertEqual(classify_tokens("saipen test suite withdraw".split()), "EXECUTION")
+        SR.declare(self.project, self.command)
+        env = {k: v for k, v in os.environ.items() if not k.upper().startswith("SAIPEN")}
+        env.update(PWD=str(self.project), SAIPEN_CAPABILITY="read-only")
+        proc = subprocess.run(
+            [sys.executable, "-B", str(ENGINE), "--project-root", str(self.project),
+             "test", "suite", "withdraw", "--json"],
+            stdin=subprocess.DEVNULL, capture_output=True, env=env, cwd=str(self.project),
+            timeout=300, check=False,
+        )
+        self.assertNotEqual(proc.returncode, 0)
+        self.assertIsNotNone(SR.load_declaration(self.project)[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/test_t1662_repository_interlock.py b/tools/test_t1662_repository_interlock.py
new file mode 100644
index 00000000..316fe8e4
--- /dev/null
+++ b/tools/test_t1662_repository_interlock.py
@@ -0,0 +1,227 @@
+"""T-1662: no test may bind the repository it runs from for a write.
+
+A test that shells the engine and loses its explicit root binds the working
+directory's project. From inside this repository that project is this
+repository, and the write SUCCEEDS against the wrong ledger, so nothing fails.
+Measured twice: receipts and tickets minted here by host fixtures on
+2026-09-16, and five `suite declared` LOG events written here on 2026-10-07 by
+a module whose `--project-root` landed behind the `--` of `declare`. Each
+repair was made in the one test that leaked.
+
+One interlock closes the class: `isolate_host_session` names the repository
+root in `FORBID_SAIPEN_PROJECT_WRITE`, and the engine refuses a mutating
+command that resolves to that root, before dispatch and with zero writes. A
+diagnostic command, a dry run and a fixture root still work.
+
+The engine cases use a fixture AS the held repository: a test of this
+interlock that pointed it at the real one would be the leak it describes.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import subprocess
+import sys
+import unittest
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+if str(TOOLS) not in sys.path:
+    sys.path.insert(0, str(TOOLS))
+
+import test_hermetic_env as HE  # noqa: E402
+from saipen_engine import paths  # noqa: E402
+from saipen_engine.errors import CODES  # noqa: E402
+from test_orchestration_repair import OrchestrationFixture  # noqa: E402
+
+ENGINE = TOOLS / "saipen.py"
+
+
+def setUpModule() -> None:
+    HE.isolate_host_session()
+
+
+def _memory(project: Path) -> dict[str, bytes]:
+    """Every byte of a project's memory, by relative path."""
+    base = project / ".saipen"
+    return {
+        path.relative_to(base).as_posix(): path.read_bytes()
+        for path in sorted(base.rglob("*"))
+        if path.is_file()
+    }
+
+
+class ArmingTests(unittest.TestCase):
+    def test_the_session_names_the_repository_it_runs_from(self):
+        self.assertEqual(HE.FORBID_PROJECT_WRITE, paths.ENV_FORBID_PROJECT_WRITE)
+        self.assertTrue(os.path.samefile(HE.REPOSITORY_ROOT, TOOLS.parent))
+        self.assertEqual(os.environ.get(HE.FORBID_PROJECT_WRITE), HE.REPOSITORY_ROOT)
+
+    def test_a_child_environment_carries_it_unless_a_test_says_otherwise(self):
+        self.assertEqual(HE.hermetic_env()[HE.FORBID_PROJECT_WRITE], HE.REPOSITORY_ROOT)
+        self.assertEqual(HE.hermetic_env({})[HE.FORBID_PROJECT_WRITE], HE.REPOSITORY_ROOT)
+        self.assertNotIn(
+            HE.FORBID_PROJECT_WRITE, HE.hermetic_env(FORBID_SAIPEN_PROJECT_WRITE=None)
+        )
+
+    def test_the_name_survives_every_way_a_test_strips_the_session(self):
+        """Many modules build a child environment by dropping every variable
+        whose name opens with `SAIPEN`; the engine drops its binding carriers
+        by name. A child stripped that way is exactly the child that falls
+        back to the working directory, so the interlock must outlive each."""
+        name = HE.FORBID_PROJECT_WRITE
+        base = {name: "held", "SAIPEN_AGENT": "seat", "SAIPEN_PROJECT_ROOT": "p", "PATH": "x"}
+        survivors = {
+            "prefix with an underscore": {
+                k: v for k, v in base.items() if not k.startswith("SAIPEN_")
+            },
+            "prefix in any case": {
+                k: v for k, v in base.items() if not k.upper().startswith("SAIPEN")
+            },
+            "the engine's binding carriers": paths.unbound_environment(base),
+            "the host-session variables": {
+                k: v for k, v in base.items() if k not in HE.HOST_SESSION_VARIABLES
+            },
+        }
+        for idiom, env in survivors.items():
+            with self.subTest(idiom):
+                self.assertEqual(env.get(name), "held")
+                self.assertNotIn("SAIPEN_PROJECT_ROOT", env, "the idiom did strip something")
+        self.assertNotIn(name, paths.PROJECT_BINDING_ENV)
+        self.assertNotIn(name, HE.HOST_SESSION_VARIABLES)
+
+    def test_no_test_module_names_the_interlock_to_take_it_off_by_hand(self):
+        """Disarming is `hermetic_env(FORBID_SAIPEN_PROJECT_WRITE=None)` in the
+        one module that tests the interlock, so the intent is one reviewable
+        line and not a pattern to copy."""
+        named = [
+            path.name
+            for path in sorted(TOOLS.glob("test_*.py"))
+            if path.name not in (Path(__file__).name, "test_hermetic_env.py")
+            and re.search(r"FORBID_(?:SAIPEN_)?PROJECT_WRITE", path.read_text(encoding="utf-8"))
+        ]
+        self.assertEqual(named, [])
+
+
+class HeldRootTests(unittest.TestCase):
+    def setUp(self) -> None:
+        self.addCleanup(os.environ.__setitem__, HE.FORBID_PROJECT_WRITE, HE.REPOSITORY_ROOT)
+
+    def test_the_held_root_is_recognised_however_it_is_spelled(self):
+        here = Path(__file__).resolve().parent
+        os.environ[HE.FORBID_PROJECT_WRITE] = str(here)
+        for spelling in (str(here), str(here) + os.sep, str(here / "x" / ".."), here):
+            with self.subTest(spelling=str(spelling)):
+                self.assertEqual(paths.write_forbidden_root(spelling), str(here))
+        if os.name == "nt":
+            self.assertEqual(paths.write_forbidden_root(str(here).swapcase()), str(here))
+        self.assertIsNone(paths.write_forbidden_root(here.parent))
+        self.assertIsNone(paths.write_forbidden_root(here / "saipen_engine"))
+
+    def test_an_unarmed_or_empty_interlock_holds_nothing(self):
+        here = Path(__file__).resolve().parent
+        for value in ("", "   "):
+            os.environ[HE.FORBID_PROJECT_WRITE] = value
+            self.assertIsNone(paths.write_forbidden_root(here))
+        del os.environ[HE.FORBID_PROJECT_WRITE]
+        self.assertIsNone(paths.write_forbidden_root(here))
+
+    def test_a_held_path_that_does_not_exist_matches_only_itself(self):
+        gone = Path(__file__).resolve().parent / "no-such-directory-t1662"
+        os.environ[HE.FORBID_PROJECT_WRITE] = str(gone)
+        self.assertEqual(paths.write_forbidden_root(gone), str(gone))
+        self.assertIsNone(paths.write_forbidden_root(gone.parent))
+
+
+class EngineTests(OrchestrationFixture):
+    """`self.held` plays the repository a test session runs from."""
+
+    def setUp(self) -> None:
+        self.held = self.make_project(active=True)
+        self.other = self.make_project(active=True)
+
+    def engine(self, *args: str, cwd: Path | None = None, held: str | None = "held"):
+        env = HE.hermetic_env(
+            FORBID_SAIPEN_PROJECT_WRITE=str(self.held) if held == "held" else held,
+            PWD=str(cwd or self.held),
+        )
+        # `--json` goes first for the reason the root does: behind a `--` it
+        # would be payload.
+        proc = subprocess.run(
+            [sys.executable, "-B", str(ENGINE), "--json", *args],
+            stdin=subprocess.DEVNULL, capture_output=True, env=env,
+            cwd=str(cwd or self.held), timeout=300, check=False,
+        )
+        return proc.returncode, json.loads(proc.stdout.decode("utf-8"))
+
+    def assert_refused(self, rc: int, answer: dict, before: dict[str, bytes]) -> None:
+        self.assertEqual(
+            (rc, answer["ok"], answer["code"]), (1, False, "CAPABILITY_DENIED"), answer
+        )
+        self.assertEqual(answer["interlock"], HE.FORBID_PROJECT_WRITE)
+        self.assertIn(answer["code"], CODES)
+        self.assertIn("--project-root", answer["detail"])
+        self.assertEqual(_memory(self.held), before, "a refusal writes nothing")
+
+    def test_a_write_with_no_explicit_root_from_inside_the_repository_is_refused(self):
+        """The measured leak: the child binds its working directory's project."""
+        before = _memory(self.held)
+        for words in (
+            ("checkpoint", "DEC", "a line that must not land"),
+            ("transition", "VERIFY", "T-7", "build recorded"),
+            ("ticket", "add", "P3", "a ticket that must not land", "--verify", "none"),
+            ("test", "suite", "declare", "--", sys.executable, "-B", "suite.py"),
+            ("continue",),
+        ):
+            with self.subTest(words=words):
+                self.assert_refused(*self.engine(*words), before)
+
+    def test_naming_the_repository_explicitly_is_refused_too(self):
+        before = _memory(self.held)
+        rc, answer = self.engine(
+            "--project-root", str(self.held), "checkpoint", "DEC", "explicit", cwd=self.other
+        )
+        self.assert_refused(rc, answer, before)
+
+    def test_a_root_lost_behind_the_double_dash_lands_nowhere(self):
+        """The shape of 2026-10-07: the fixture root rides in the payload."""
+        before, other_before = _memory(self.held), _memory(self.other)
+        rc, answer = self.engine(
+            "test", "suite", "declare", "--", sys.executable, "-B", "suite.py",
+            "--project-root", str(self.other),
+        )
+        self.assert_refused(rc, answer, before)
+        self.assertEqual(_memory(self.other), other_before)
+
+    def test_reading_the_repository_still_works(self):
+        before = _memory(self.held)
+        for words in (("status",), ("next",), ("test", "suite"), ("knowledge", "status")):
+            with self.subTest(words=words):
+                rc, answer = self.engine(*words)
+                self.assertEqual((rc, answer["ok"]), (0, True), answer)
+        rc, answer = self.engine("checkpoint", "DEC", "a preview", "--dry-run")
+        self.assertEqual((rc, answer["ok"]), (0, True), answer)
+        self.assertEqual(_memory(self.held), before, "a dry run writes nothing")
+
+    def test_a_fixture_root_is_written_as_before(self):
+        before = _memory(self.held)
+        rc, answer = self.engine(
+            "--project-root", str(self.other), "checkpoint", "DEC", "lands in the fixture"
+        )
+        self.assertEqual((rc, answer["code"]), (0, "CHECKPOINTED"), answer)
+        self.assertIn(b"lands in the fixture", _memory(self.other)["LOG.md"])
+        rc, answer = self.engine("checkpoint", "DEC", "from the fixture itself", cwd=self.other)
+        self.assertEqual((rc, answer["code"]), (0, "CHECKPOINTED"), answer)
+        self.assertEqual(_memory(self.held), before)
+
+    def test_without_the_interlock_the_same_command_writes(self):
+        """The control: what refuses above is the interlock and nothing else."""
+        rc, answer = self.engine("checkpoint", "DEC", "no interlock", held=None)
+        self.assertEqual((rc, answer["code"]), (0, "CHECKPOINTED"), answer)
+        self.assertIn(b"no interlock", _memory(self.held)["LOG.md"])
+
+
+if __name__ == "__main__":
+    unittest.main()

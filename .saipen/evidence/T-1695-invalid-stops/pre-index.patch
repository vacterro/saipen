@@ -0,0 +1,762 @@
+"""T-1623 regression matrix for the separated SAIPEN host-authority broker.
+
+Evidence classes, kept apart on purpose:
+
+* AUTHORITY  -- the broker's own decisions: who it authenticates, what a
+                capability binds, what survives a restart, what an expiry does.
+* OWNER      -- how `protocol_admission` consumes the broker: admission,
+                staleness, refresh, and the ledger provenance question.
+* HOST       -- the real Claude Code hook artifact, run as a subprocess, with a
+                real endpoint, a real broker, and a client whose OS image name
+                is the host's own.
+* ATTACK     -- the same-user clients the boundary exists to refuse: an ordinary
+                Python import, a forged or transplanted capability, a hand-built
+                ledger record.
+
+The host case uses a faithful stand-in: a copy of this interpreter named
+`claude.exe`. The broker authenticates by OS image and parent chain, and the OS
+is the only thing that can assert an image name, so the test asserts it the way
+the machine does -- by putting that name on a process. Nothing about the broker
+is simulated in that case: the pipe, the process identity, the in-memory key and
+the ledger are all real. Those cases are skipped where the stand-in cannot run.
+
+Two consequences are asserted rather than worked around, because they are the
+boundary working: a client OUTSIDE the host's tree cannot even ask about a
+record (`verify-record` is authenticated too), and a degraded permit writes no
+record at all.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+for _entry in (str(TOOLS), str(ROOT), str(ROOT / "bootstrap")):
+    if _entry not in sys.path:
+        sys.path.insert(0, _entry)
+
+from saipen_engine import host_authority_broker as HB  # noqa: E402
+from saipen_engine import host_authority_client as HC  # noqa: E402
+from saipen_engine import host_authority_transport as HT  # noqa: E402
+from saipen_engine import protocol_admission as PA  # noqa: E402
+import install_host_guard  # noqa: E402
+from test_protocol_admission import World  # noqa: E402
+
+
+def isolate_profile(test: unittest.TestCase, tmp: Path) -> Path:
+    """Point this process at a disposable per-user runtime root.
+
+    The broker's runtime root is per-user (`Path.home()/.saipen/authority`), so a
+    test that wants to meet a broker must move the user home rather than write
+    into the operator's. Nothing in the broker reads an environment variable for
+    AUTHORITY; this only relocates non-authoritative runtime state.
+    """
+    profile = tmp / "userprofile"
+    profile.mkdir(parents=True, exist_ok=True)
+    patcher = mock.patch.dict(
+        os.environ,
+        {
+            "USERPROFILE": str(profile),
+            "HOME": str(profile),
+            "HOMEDRIVE": "",
+            "HOMEPATH": "",
+        },
+    )
+    patcher.start()
+    test.addCleanup(patcher.stop)
+    return profile / ".saipen" / "authority"
+
+HOOK = ROOT / "extensions" / "adapters" / "claude" / "saipen-guard.py"
+HOST_IMAGES = ["claude.exe", "claude", "claude-code", "claude-code.exe"]
+WINDOWS = os.name == "nt"
+PYTHON_HOME = str(Path(sys.executable).resolve().parent)
+
+
+def host_stand_in(tmp: Path) -> Path | None:
+    """A process image named like the host application, or None where impossible."""
+    target = tmp / "simhost"
+    target.mkdir(parents=True, exist_ok=True)
+    binary = target / ("claude.exe" if WINDOWS else "claude")
+    source = Path(sys.executable).resolve()
+    try:
+        shutil.copy2(source, binary)
+        for pattern in ("python3*.dll", "python3*.zip", "vcruntime*.dll"):
+            for item in source.parent.glob(pattern):
+                with contextlib.suppress(OSError, shutil.SameFileError):
+                    shutil.copy2(item, target / item.name)
+        probe = subprocess.run(
+            [str(binary), "-c", "import json, pathlib, subprocess"],
+            capture_output=True,
+            check=False,
+            timeout=60,
+            env={**os.environ, "PYTHONHOME": PYTHON_HOME},
+        )
+    except (OSError, subprocess.SubprocessError):
+        return None
+    return binary if probe.returncode == 0 else None
+
+
+class Harness:
+    """A real broker on a real endpoint in a per-test runtime root."""
+
+    def __init__(self, runtime: Path, *, config: dict | None = None, clock=None) -> None:
+        self.runtime = Path(runtime)
+        self.runtime.mkdir(parents=True, exist_ok=True)
+        self.broker = HB.Broker(
+            saipen_root=ROOT,
+            runtime=self.runtime,
+            config=dict(config or HB.settings()),
+            clock=clock or HB._now,
+        )
+        self.stop = threading.Event()
+        self.thread = threading.Thread(
+            target=HT.serve,
+            kwargs={
+                "name": HB.endpoint_name(self.runtime),
+                "handler": self.broker.handle,
+                "stop": self.stop,
+            },
+            daemon=True,
+        )
+        self.thread.start()
+        self.await_ready()
+
+    def await_ready(self, timeout: float = 15.0) -> None:
+        deadline = time.time() + timeout
+        while time.time() < deadline:
+            if HB.health(self.runtime, timeout=0.5):
+                return
+            time.sleep(0.05)
+        raise AssertionError("the broker never became reachable")
+
+    @property
+    def instance(self) -> str:
+        return self.broker.authority.instance
+
+    def close(self) -> None:
+        self.stop.set()
+        self.thread.join(timeout=5)
+
+    def admitted(
+        self,
+        world: World,
+        *,
+        session: str = "session-1",
+        event: str = "UserPromptSubmit",
+        model: object = "model-a",
+        provider: object = "provider-a",
+        project: object = None,
+    ) -> dict:
+        return HB.request(
+            {
+                "op": "admission",
+                "project": str(project if project is not None else world.project),
+                "session": session,
+                "host": "claude",
+                "model": model,
+                "provider": provider,
+                "authority_root": str(world.authority),
+                "home": str(world.home),
+                "event": event,
+            },
+            runtime=self.runtime,
+        )
+
+    def verify(self, capability: str, world: World, **overrides) -> dict:
+        fields = {
+            "session": "session-1",
+            "model": "model-a",
+            "provider": "provider-a",
+            **overrides,
+        }
+        return HB.request(
+            {
+                "op": "verify",
+                "project": str(fields.pop("project", world.project)),
+                "host": "claude",
+                **fields,
+                "capability": capability,
+            },
+            runtime=self.runtime,
+        )
+
+

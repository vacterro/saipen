diff --git a/tools/authority_service.py b/tools/authority_service.py
new file mode 100644
index 00000000..b87bac7a
--- /dev/null
+++ b/tools/authority_service.py
@@ -0,0 +1,198 @@
+"""Process entry for the SAIPEN host-authority broker.
+
+This is the artifact the hook starts when no authority answers, and the artifact
+the operator's login entry starts so the authority is already there. It carries
+no admission logic of its own: it resolves the SAIPEN home, then hands control
+to `saipen_engine.host_authority_broker`, which owns the key, the ledger and
+every trust decision.
+
+Operator surface (diagnostics, never required for ordinary GUI use):
+
+    authority_service.py serve            run the broker in this process
+    authority_service.py start            start it detached and wait for health
+    authority_service.py stop             ask the running broker to shut down
+    authority_service.py status --json    health, identity and policy
+    authority_service.py identify --json  how the broker will see THIS process
+    authority_service.py mode MODE        strict | degraded, explicit only
+    authority_service.py install-startup  per-user login autostart
+    authority_service.py remove-startup   remove that login entry
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+
+TOOLS = Path(__file__).resolve().parent
+ROOT = TOOLS.parent
+for _entry in (str(TOOLS), str(ROOT)):
+    if _entry not in sys.path:
+        sys.path.insert(0, _entry)
+
+from saipen_engine import host_authority_broker as broker  # noqa: E402
+from saipen_engine import host_authority_client as client  # noqa: E402
+
+RUN_KEY = r"Software\Microsoft\Windows\CurrentVersion\Run"
+RUN_VALUE = "SaipenAuthority"
+
+
+def _emit(payload: dict, as_json: bool) -> None:
+    if as_json:
+        print(json.dumps(payload, ensure_ascii=False, sort_keys=True))
+        return
+    for key, value in payload.items():
+        if key in ("ok", "code"):
+            continue
+        print(f"{key}: {value}")
+    print(f"ok: {payload.get('ok')}")
+
+
+def _startup_command(saipen_root: Path | None, runtime: Path | None) -> str:
+    argv = [sys.executable, str(Path(__file__).resolve()), "serve"]
+    if saipen_root is not None:
+        argv += ["--saipen-root", str(saipen_root)]
+    if runtime is not None:
+        argv += ["--runtime", str(runtime)]
+    return " ".join(f'"{part}"' if " " in part else part for part in argv)
+
+
+def install_startup(saipen_root: Path | None, runtime: Path | None) -> dict:
+    """Register a per-user login entry. The operator stays able to remove it,
+    and nothing about this entry grants admission on its own."""
+    if os.name != "nt":
+        return {
+            "ok": False,
+            "code": "UNSUPPORTED_PLATFORM",
+            "detail": "login autostart is implemented for Windows runs only",
+        }
+    try:
+        import winreg
+    except ImportError:
+        return {"ok": False, "code": "UNSUPPORTED_PLATFORM", "detail": "winreg unavailable"}
+    command = _startup_command(saipen_root, runtime)
+    try:
+        with winreg.CreateKeyEx(
+            winreg.HKEY_CURRENT_USER, RUN_KEY, 0, winreg.KEY_SET_VALUE
+        ) as key:
+            winreg.SetValueEx(key, RUN_VALUE, 0, winreg.REG_SZ, command)
+    except OSError as exc:
+        return {"ok": False, "code": "IO_FAILED", "detail": str(exc)}
+    return {"ok": True, "code": "AUTHORITY_STARTUP_INSTALLED", "command": command}
+
+
+def remove_startup() -> dict:
+    if os.name != "nt":
+        return {
+            "ok": False,
+            "code": "UNSUPPORTED_PLATFORM",
+            "detail": "login autostart is implemented for Windows runs only",
+        }
+    try:
+        import winreg
+    except ImportError:
+        return {"ok": False, "code": "UNSUPPORTED_PLATFORM", "detail": "winreg unavailable"}
+    try:
+        with winreg.OpenKey(
+            winreg.HKEY_CURRENT_USER, RUN_KEY, 0, winreg.KEY_SET_VALUE
+        ) as key:
+            winreg.DeleteValue(key, RUN_VALUE)
+    except FileNotFoundError:
+        return {"ok": True, "code": "AUTHORITY_STARTUP_ABSENT", "removed": False}
+    except OSError as exc:
+        return {"ok": False, "code": "IO_FAILED", "detail": str(exc)}
+    return {"ok": True, "code": "AUTHORITY_STARTUP_REMOVED", "removed": True}
+
+
+def status_view(runtime: Path | None) -> dict:
+    live = client.status(runtime)
+    if live:
+        return {"ok": True, **live}
+    stored = broker.read_status(runtime)
+    return {
+        "ok": False,
+        "code": "BROKER_UNREACHABLE",
+        "detail": "no host-authority broker answered",
+        "runtime_root": str(broker.runtime_root(runtime)),
+        "endpoint": broker.endpoint_name(runtime),
+        "log": str(broker.log_path(runtime)),
+        "last_status": stored,
+        "identity": client.identify_self(),
+    }
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument(
+        "command",
+        choices=(
+            "serve",
+            "start",
+            "stop",
+            "status",
+            "identify",
+            "mode",
+            "install-startup",
+            "remove-startup",
+        ),
+    )
+    parser.add_argument("mode", nargs="?", default=None, help="strict | degraded")
+    parser.add_argument("--saipen-root", type=Path, default=None)
+    parser.add_argument("--runtime", type=Path, default=None)
+    parser.add_argument("--home", type=Path, default=None, help="operator home for the mode file")
+    parser.add_argument("--idle-seconds", type=int, default=None)
+    parser.add_argument("--max-requests", type=int, default=None, help="diagnostic bound")
+    parser.add_argument("--wait", type=float, default=6.0)
+    parser.add_argument("--json", action="store_true")
+    args = parser.parse_args(argv)
+
+    if args.command == "serve":
+        if args.idle_seconds is None:
+            args.idle_seconds = int(broker.settings().get("idle_exit_seconds") or 0)
+        return broker.run_service(
+            saipen_root=args.saipen_root,
+            runtime=args.runtime,
+            idle_seconds=args.idle_seconds,
+            max_requests=args.max_requests,
+        )
+    if args.command == "start":
+        report = client.ensure(args.saipen_root, runtime=args.runtime, wait=args.wait)
+        _emit(report, args.json)
+        return 0 if report.get("ok") else 1
+    if args.command == "stop":
+        report = client.shutdown(args.runtime)
+        _emit(report, args.json)
+        return 0 if report.get("ok") else 1
+    if args.command == "status":
+        _emit(status_view(args.runtime), args.json)
+        return 0
+    if args.command == "identify":
+        report = client.identify_self()
+        report["is_host_client"] = report.pop("ok")
+        report["pid"] = os.getpid()
+        _emit(report, args.json)
+        return 0 if report.get("is_host_client") else 1
+    if args.command == "mode":
+        if args.mode is None:
+            mode = client.authority_mode(args.home)
+            _emit(
+                {"ok": True, "code": "AUTHORITY_MODE", "mode": mode, "path": str(client.mode_path(args.home))},
+                args.json,
+            )
+            return 0
+        report = client.set_authority_mode(args.mode, args.home)
+        _emit(report, args.json)
+        return 0 if report.get("ok") else 2
+    if args.command == "install-startup":
+        report = install_startup(args.saipen_root, args.runtime)
+        _emit(report, args.json)
+        return 0 if report.get("ok") else 1
+    report = remove_startup()
+    _emit(report, args.json)
+    return 0 if report.get("ok") else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tools/retired_host_hook.py b/tools/retired_host_hook.py
new file mode 100644
index 00000000..0d24a107
--- /dev/null
+++ b/tools/retired_host_hook.py
@@ -0,0 +1,15 @@
+"""Retired SAIPEN host hook. SAIPEN was uninstalled; this file gates nothing.
+
+A host application that was running when SAIPEN was uninstalled keeps the hook
+command it loaded at start. A session started before hook commands carried
+their own missing-file guard would run that command against a file that is
+gone, the interpreter would exit with status 2, and the host would read that
+as a hook that BLOCKS the event: every prompt of a session whose only fault is
+predating the uninstall. This file stands where the hook stood so that command
+exits 0 and does nothing.
+
+Safe to delete once no such session is running. The installer replaces it and
+the uninstaller removes it when no host application is alive.
+"""
+
+SAIPEN_RETIRED_HOST_HOOK = True
diff --git a/tools/saipen_engine/board_scrub.py b/tools/saipen_engine/board_scrub.py
new file mode 100644
index 00000000..87339dd0
--- /dev/null
+++ b/tools/saipen_engine/board_scrub.py
@@ -0,0 +1,174 @@
+"""Which closed BOARD records a CLEAN scrub may prune (T-1640).
+
+`phases/clean.md` step 1 told an agent to prune old `## DONE` entries, and the
+validator repeated it on every run as `board-soft-cap`. No agent could: the
+BOARD is a protected canonical file and no engine verb pruned a record. The
+last scrub that did happen (18.09.26, by hand, before the guard) restored five
+validator FAILs on the way, because its retention rule looked one hop off the
+live sections and a kept row went on naming a pruned one.
+
+This module is the retention rule, stated once and read by both the operation
+that prunes (`operations.scrub_board`) and the validator finding that asks for
+it. A closed record is KEPT while any of these holds:
+
+  reference  a record that stays names it in `needs:`, `blocked_on:`,
+             `superseded_by:` or `implementation_source:` -- every edge a
+             validator resolves on the BOARD, followed transitively, because a
+             kept record's own references must keep resolving;
+  receipt    an ACTIVE source receipt names it (primary or member Work, or a
+             coverage clause bound to it), or its own `source_receipts:` names
+             an ACTIVE receipt: the row is that Work's existence record and
+             the receipt's later verbs look it up;
+  unproven   the complete LOG history holds no closing event for it, so the
+             BOARD row is the only record that it closed at all.
+
+Everything else in `## DONE` is closed-ticket text nothing reads from the
+BOARD any more. It is moved, never dropped: the operation writes the pruned
+rows verbatim under `SCRUB_EVIDENCE_ROOT` in the plan that removes them.
+
+The cap this replaces measured the whole file against ~16 KB. No route could
+ever meet that on a project whose open work alone is larger -- this
+repository's live rows were 55 KB when it was measured -- so the number is
+restated against what a scrub can actually clear: the prunable text.
+"""
+
+from __future__ import annotations
+
+import re
+from dataclasses import dataclass
+from pathlib import Path
+
+#: Where a scrub keeps the rows it pruned, one directory per operation.
+SCRUB_EVIDENCE_ROOT = ".saipen/recovery/board-scrub"
+
+#: Prunable closed-ticket text past this is due for a scrub, and under it is
+#: left alone: recent closed rows are cheap context on a small board.
+SCRUB_DUE_BYTES = 16 * 1024
+
+#: Operations that move a record to `## DONE`. An event of one of these
+#: classes bearing the ticket's id is the permanent LOG evidence
+#: `phases/clean.md` requires before the row may leave the BOARD.
+CLOSING_OP_CLASSES = (
+    "finish-",
+    "supersede-",
+    "resolve-external-",
+    "crew-defer-",
+    "clear-wait-role-",
+)
+
+_TICKET_RE = re.compile(r"\bT-\d+\b")
+_RECEIPT_RE = re.compile(r"\bSRC-\d+\b")
+#: Scalar fields of a kept record whose ids a validator resolves on the BOARD.
+_REFERENCE_FIELDS = ("blocked_on", "superseded_by", "implementation_source")
+
+
+@dataclass(frozen=True)
+class Selection:
+    """What one scrub of one BOARD would prune and what it would keep."""
+
+    #: Closed records to prune, in BOARD order.
+    pruned: tuple[str, ...]
+    #: Their size in the BOARD, counting one line terminator per record.
+    pruned_bytes: int
+    #: Every closed record that stays -> the guard that keeps it.
+    kept: dict[str, str]
+
+    @property
+    def due(self) -> bool:
+        return self.pruned_bytes > SCRUB_DUE_BYTES
+
+    def kept_by(self) -> dict[str, int]:
+        counts: dict[str, int] = {}
+        for guard in self.kept.values():
+            counts[guard] = counts.get(guard, 0) + 1
+        return dict(sorted(counts.items()))
+
+
+def receipt_holds(project_root: Path | str) -> tuple[set[str], set[str]]:
+    """`(ACTIVE receipt ids, every Work an ACTIVE receipt names)`.
+
+    Raises `ValueError`/`OSError` when the intake surface cannot be read. A
+    caller that prunes must refuse on that: an unreadable receipt is not a
+    receipt that holds nothing.
+    """
+    from . import intake
+
+    root = Path(project_root)
+    active = intake._read_index(root).get("active") or {}
+    if not isinstance(active, dict):
+        raise ValueError("source intake index active projection is not an object")
+    works: set[str] = set()
+    for receipt_id in sorted(active):
+        works |= intake.linked_works(intake._read_meta(root, receipt_id))
+        rows = intake._read_coverage(root, receipt_id).get("requirements") or {}
+        for row in rows.values():
+            work = str(row.get("work") or "").strip() if isinstance(row, dict) else ""
+            if work:
+                works.add(work)
+    return set(active), works
+
+
+def closed_in_history(events, ticket_ids) -> set[str]:
+    """The ids among `ticket_ids` that a closing operation wrote an event for."""
+    wanted = set(ticket_ids)
+    proven: set[str] = set()
+    for event in events:
+        ticket = event.get("ticket")
+        if ticket in wanted and str(event.get("op_id") or "").startswith(CLOSING_OP_CLASSES):
+            proven.add(ticket)
+    return proven
+
+
+def _receipts_named(ticket: dict) -> set[str]:
+    return set(_RECEIPT_RE.findall(str((ticket.get("fields") or {}).get("source_receipts") or "")))
+
+
+def _references(ticket: dict, by_receipt: dict[str, set[str]]) -> set[str]:
+    """Every record this one names through an edge a validator resolves."""
+    fields = ticket.get("fields") or {}
+    named = set(ticket.get("needs") or [])
+    for key in _REFERENCE_FIELDS:
+        value = str(fields.get(key) or "")
+        named.update(_TICKET_RE.findall(value))
+        if key == "implementation_source":
+            # A Source is provenance, not publication: the resolver follows it
+            # to the Work it produced, so that Work is named here too.
+            for receipt in _RECEIPT_RE.findall(value):
+                named.update(by_receipt.get(receipt, ()))
+    return named
+
+
+def select(tickets: dict, events, active_receipts: set[str], receipt_works: set[str]) -> Selection:
+    """Apply the retention rule to one parsed BOARD.
+
+    Pure: `tickets` is `parse_board(...)["tickets"]`, `events` the complete
+    history, and the two sets come from `receipt_holds`. Nothing is read from
+    disk here, so the operation plans on exactly the documents it will bind.
+    """
+    done = [tid for tid, ticket in tickets.items() if ticket.get("section") == "## DONE"]
+    proven = closed_in_history(events, done)
+    by_receipt: dict[str, set[str]] = {}
+    for tid, ticket in tickets.items():
+        for receipt in _receipts_named(ticket):
+            by_receipt.setdefault(receipt, set()).add(tid)
+
+    kept: dict[str, str] = {}
+    frontier = [tid for tid, ticket in tickets.items() if ticket.get("section") != "## DONE"]
+    for tid in done:
+        if tid in receipt_works or _receipts_named(tickets[tid]) & active_receipts:
+            kept[tid] = "receipt"
+        elif tid not in proven:
+            kept[tid] = "unproven"
+    frontier.extend(kept)
+    while frontier:
+        for named in _references(tickets[frontier.pop()], by_receipt):
+            if named in kept or tickets.get(named, {}).get("section") != "## DONE":
+                continue
+            kept[named] = "reference"
+            frontier.append(named)
+
+    pruned = sorted(
+        (tid for tid in done if tid not in kept), key=lambda tid: tickets[tid].get("line_no") or 0
+    )
+    size = sum(len(str(tickets[tid].get("raw") or "").encode("utf-8")) + 1 for tid in pruned)
+    return Selection(tuple(pruned), size, kept)
diff --git a/tools/saipen_engine/cli_grammar.py b/tools/saipen_engine/cli_grammar.py
new file mode 100644
index 00000000..ac9b6ec9
--- /dev/null
+++ b/tools/saipen_engine/cli_grammar.py
@@ -0,0 +1,62 @@
+"""Shared lexical roles for shell-decoded SAIPEN option operands."""
+
+from __future__ import annotations
+
+from collections.abc import Collection, Sequence
+
+
+VALUE_OPTIONS = frozenset({
+    "--action", "--adapter", "--admission-session", "--adopt-legacy", "--agent",
+    "--amends", "--apply-approved-repair", "--attempted-condition",
+    "--attest-legacy-done", "--authority", "--authority-root", "--body",
+    "--budget", "--by", "--cap", "--caps-file", "--carrier-hex", "--carrier-json",
+    "--category", "--class", "--closure-cohort", "--closure-mode", "--cohort",
+    "--contract", "--cwd", "--days", "--delta", "--detail-mode", "--discovery-event",
+    "--environment", "--event-cwd", "--event-json", "--evidence", "--executor",
+    "--field", "--file", "--fixed-by", "--gate", "--handoff", "--helper-reason",
+    "--hex", "--home", "--host", "--host-lineage", "--host-root", "--implementation",
+    "--implementation-source", "--include-hex", "--invalidated-by", "--item-id",
+    "--k", "--keep", "--kind", "--label", "--max-files", "--max-matches", "--model",
+    "--needs", "--note", "--operation-id", "--package", "--paths", "--priority",
+    "--producer", "--profile", "--project-root", "--provider", "--python",
+    "--reason", "--reassign", "--rebuild-command", "--receipt", "--recurrence",
+    "--regression", "--replacement", "--report", "--reproduced", "--request",
+    "--resolution", "--resolve-duplicate-id", "--retry_not_before", "--role",
+    "--root", "--run", "--runtime", "--runtime-info", "--scope", "--scope-hex",
+    "--session", "--sha256", "--slice", "--successor", "--supersedes", "--task-class",
+    "--ticket", "--timeout", "--to", "--unknown", "--verification", "--verify",
+    "--weak-model", "--when-environment", "--work", "--workspace",
+})
+
+
+def option_value_positions(argv: Sequence[str]) -> set[int]:
+    """Locate opaque operands before interpreting any global option or `--`."""
+    positions: set[int] = set()
+    index = 0
+    while index < len(argv):
+        if argv[index] == "--":
+            break
+        if argv[index] == "--text":
+            # audit enqueue owns the complete remaining body, not just one
+            # word; its grammar does not interpret later switches either.
+            positions.update(range(index + 1, len(argv)))
+            break
+        if argv[index] in VALUE_OPTIONS and index + 1 < len(argv):
+            positions.add(index + 1)
+            index += 2
+        else:
+            index += 1
+    return positions
+
+
+def has_option(argv: Sequence[str], options: Collection[str]) -> bool:
+    """Only an unconsumed token before the real boundary is a switch."""
+    values = option_value_positions(argv)
+    for index, token in enumerate(argv):
+        if index in values:
+            continue
+        if token == "--":
+            break
+        if token in options:
+            return True
+    return False
diff --git a/tools/saipen_engine/goal_authority.py b/tools/saipen_engine/goal_authority.py
new file mode 100644
index 00000000..1793a9a2
--- /dev/null
+++ b/tools/saipen_engine/goal_authority.py
@@ -0,0 +1,129 @@
+"""GOAL-01: one continuation grant, independent of who invokes continue.
+
+STATE records the scope. The existing source/journal owners prove its origin;
+an invocation, a remembered request or a convenient counter value proves none.
+"""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+FIELDS = ("continuation_authority", "authority_source", "authority_until", "safety_valve_mode")
+
+
+def grant_fields(source: str) -> dict:
+    return dict(zip(FIELDS, ("operator_persistent", source, "goal_complete", "checkpoint")))
+
+
+def shape_errors(state: dict) -> list[str]:
+    present = [key for key in FIELDS if key in state]
+    if not present:
+        return []  # Legacy goals are bounded; absence never grants persistence.
+    if state.get("execution_intent") != "goal":
+        return ["continuation authority is legal only with execution_intent goal"]
+    if len(present) != len(FIELDS):
+        return ["continuation authority requires the complete authority family"]
+    from .registry import load_registry, require_mapping
+
+    policy = require_mapping(load_registry(), "goal_authority")
+    for field, key in ((FIELDS[0], "continuation"), (FIELDS[2], "until"), (FIELDS[3], "valve")):
+        if state.get(field) not in policy[key]:
+            return [f"{field} outside its closed enum"]
+    persistent = state[FIELDS[0]] == "operator_persistent"
+    expected = ("goal_complete", "checkpoint") if persistent else ("budget", "hard_wait")
+    if (state[FIELDS[2]], state[FIELDS[3]]) != expected:
+        return ["continuation authority has an inconsistent scope/valve tuple"]
+    source = state.get("authority_source")
+    if not isinstance(source, str) or not re.fullmatch(r"(?:E|SRC)-0*[1-9][0-9]*", source):
+        return ["authority_source must name its SRC or GOAL event"]
+    if persistent and not re.fullmatch(r"goal-[0-9a-f]{16}", str(state.get("goal_ingress") or "")):
+        return ["persistent authority requires its goal_ingress binding"]
+    return []
+
+
+def persistent(state: dict) -> bool:
+    return state.get("continuation_authority") == "operator_persistent" and not shape_errors(state)
+
+
+def prove(root: Path | str, state: dict, *, history_events=None, dependencies=None) -> list[str]:
+    """Verify the original grant, not a stronger carrier supplied on a retry."""
+    errors = shape_errors(state)
+    if errors or not persistent(state):
+        return errors
+    from . import operator_task
+
+    source = state["authority_source"]
+    if not source.startswith("E-"):
+        return ["persistent authority requires its canonical goal-entry event"]
+    from .journal import Journal, hash_file_dependency, semantic_receipts_for_operation_safe
+    from .log import read_history_snapshot
+
+    if history_events is None:
+        history_events = read_history_snapshot(Path(root), lean=True).events
+    pivots = [event for event in history_events if event.get("taxonomy") == "DEC"
+              and str(event.get("text") or "").startswith("goal pivot --")
+              and int(event.get("event") or 0) <= int(state.get("last_event") or 0)]
+    if not pivots or source != f"E-{pivots[-1]['event']}":
+        return ["persistent authority does not name the current goal pivot"]
+    records, problems = semantic_receipts_for_operation_safe(Path(root), "goal_entry")
+    if problems:
+        return ["continuation grant journal is corrupt: " + "; ".join(problems[:2])]
+    for record in records:
+        metadata = record.get("receipt_metadata")
+        grant = metadata.get("goal_authority") if isinstance(metadata, dict) else None
+        if not isinstance(grant, dict) or grant.get("authority_source") != source:
+            continue
+        if (record.get("status") != "COMMITTED"
+                or record.get("op_id") != pivots[-1].get("op_id")
+                or grant.get("goal_ingress") != state.get("goal_ingress")):
+            continue
+        if any(grant.get(key) != state[key] for key in FIELDS):
+            continue
+        if operator_task.authority_for_provenance(grant.get("request_provenance"))["goal_pivot"]:
+            if dependencies is not None:
+                journal = Journal(Path(root), record["op_id"])
+                try:
+                    before = hash_file_dependency(journal.manifest)
+                    live = journal.read()
+                    after = hash_file_dependency(journal.manifest)
+                except (OSError, ValueError):
+                    return ["continuation grant became unreadable while being read"]
+                if live != record or before != after:
+                    return ["continuation grant changed while being read"]
+                dependencies[journal.manifest.relative_to(Path(root)).as_posix()] = before
+            return []
+    return ["persistent authority has no committed operator grant for this goal"]
+
+
+def fresh_cc_provenance() -> dict | None:
+    """A declared operator carrier for the resume key, not CLI spelling."""
+    from . import operator_task
+
+    for text in ("cc", "\u0441\u0441", "saipen", "saipen continue", "saipen continue --json"):
+        provenance = operator_task.witness(text)
+        if not provenance.get("code") and operator_task.authority_for_provenance(provenance)[
+            "reset_bounded_authority"
+        ]:
+            return provenance
+    return None
+
+
+def reset_authority(root: Path | str, state: dict, source: str | None = None) -> dict:
+    """Decide whether this reset spends an existing grant or a fresh one."""
+    from . import operator_task
+
+    if source is not None and not operator_task.authority_for_receipt(
+        Path(root), source
+    )["reset_bounded_authority"]:
+        return {"mode": "wait", "detail": "the named Source has no operator reset authority"}
+    if persistent(state):
+        errors = prove(root, state)
+        return ({"mode": "wait", "detail": "; ".join(errors)} if errors
+                else {"mode": "checkpoint", "source": state["authority_source"]})
+    if source is not None:
+        return {"mode": "reauthorize", "source": source}
+    provenance = fresh_cc_provenance()
+    if provenance:
+        return {"mode": "reauthorize", "source": "operator_carrier", "provenance": provenance}
+    return {"mode": "wait", "detail": "bounded run requires a fresh operator cc"}
diff --git a/tools/saipen_engine/host_authority_broker.py b/tools/saipen_engine/host_authority_broker.py
new file mode 100644
index 00000000..0b613503
--- /dev/null
+++ b/tools/saipen_engine/host_authority_broker.py
@@ -0,0 +1,1072 @@
+"""The SAIPEN host-authority broker: the separated local admission authority.
+
+Defect class this closes: T-1563 established that a same-user Python hook cannot
+prove host provenance, because the hook and any model-executed Python run as the
+same OS principal, so every locally minted token is self-attestation. That
+conclusion is right, and on its own it left the operator with a GUI that could
+not be used: Claude Code's prompt boundary refused every prompt and the only
+honest diagnostic was "a separated host authority is required".
+
+This module IS that separated authority -- a local service that
+
+* runs as its own process, outside the hook's process, and outlives a Claude GUI
+  restart;
+* keeps its signing key in memory only, so no writable file is authority and no
+  capability can be forged from readable bytes;
+* identifies the client by OS-derived process identity (image and parent chain)
+  rather than by anything the client sends, so an arbitrary same-user Python
+  process that is not a descendant of the host application cannot mint or
+  replay admission;
+* issues short-lived capabilities bound to the host adapter, the project, the
+  Claude session, the model, the provider, the delivered authority fingerprints
+  and a broker generation, and refuses a capability presented against any other
+  binding;
+* owns the admission ledger write, so the ledger record's provenance can only be
+  checked against this live broker;
+* fails closed when it cannot identify a client, and never accepts prose, prompt
+  text, an environment variable or a magic phrase as admission.
+
+Security boundary, stated honestly. The trust anchor is the OS process tree: a
+client that is a descendant of the host application's own process is the
+adapter, and a client that is not is refused. That is a real separation between
+the GUI's own hook path and an unrelated same-user script, and it is not a
+boundary against code injected INTO the host process, which no local scheme can
+defend. `authenticator` identity is derived, never accepted: the request carries
+a project, a session and a host name because those select the scope, and it
+carries no identity claim at all.
+
+The broker answers one JSON frame per connection and never crashes on a
+malformed request; `serve` is bounded and returns when its stop event is set.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import hashlib
+import hmac
+import json
+import os
+import secrets
+import subprocess
+import sys
+import threading
+import time
+from dataclasses import dataclass, field
+from pathlib import Path
+
+from . import host_authority_process as proc
+from . import host_authority_transport as transport
+
+SERVICE = "saipen-authority-broker"
+WIRE_VERSION = 1
+SCHEMA_VERSION = 1
+CAPABILITY_PREFIX = "cap"
+
+#: How long a minted capability is accepted. Short by design: a stale session
+#: re-admits automatically on its next prompt.
+DEFAULT_TTL_SECONDS = 900
+#: A broker that has never served an authenticated client for this long exits.
+#: Zero disables the idle exit.
+DEFAULT_IDLE_SECONDS = 1800
+DEFAULT_ANCESTRY_LIMIT = 16
+#: Bounded identity report attached to refusals, so the operator sees the chain.
+MAX_CHAIN_REPORTED = 8
+
+#: Image names that count as "the host application". Configuration, not policy
+#: code: an operator whose GUI binary differs edits the registry, not this file.
+HOST_IMAGES = ("claude.exe", "claude", "claude-code", "claude-code.exe")
+
+MODE_STRICT = "strict"
+MODE_DEGRADED = "degraded"
+MODES = (MODE_STRICT, MODE_DEGRADED)
+
+#: Refusal codes. Registered in REGISTRY.json `error_codes`.
+CODE_NOT_AUTHENTICATED = "BROKER_CLIENT_NOT_AUTHENTICATED"
+CODE_IDENTITY_UNAVAILABLE = "BROKER_PEER_IDENTITY_UNAVAILABLE"
+CODE_BAD_REQUEST = "BROKER_BAD_REQUEST"
+CODE_CAPABILITY_INVALID = "BROKER_CAPABILITY_INVALID"
+CODE_CAPABILITY_EXPIRED = "BROKER_CAPABILITY_EXPIRED"
+CODE_CAPABILITY_REPLAY = "BROKER_CAPABILITY_REPLAY"
+CODE_BINDING_MISMATCH = "BROKER_BINDING_MISMATCH"
+CODE_GENERATION_STALE = "BROKER_GENERATION_STALE"
+CODE_UNKNOWN_OP = "BROKER_UNKNOWN_OP"
+CODE_EXISTS = "BROKER_ALREADY_RUNNING"
+#: The one line the operator surface uses when nothing answers.
+AUTHORITY_HINT = (
+    "no host-authority broker answered; the prompt boundary starts it automatically "
+    "when the asking process belongs to the host application"
+)
+
+_CAPABILITY_FIELDS = (
+    "instance",
+    "capability_id",
+    "expires",
+    "project",
+    "session",
+    "host",
+    "model",
+    "provider",
+    "adapter",
+    "authority",
+    "generation",
+)
+
+DEFAULT_SETTINGS = {
+    "host_images": list(HOST_IMAGES),
+    "ancestry_limit": DEFAULT_ANCESTRY_LIMIT,
+    "capability_ttl_seconds": DEFAULT_TTL_SECONDS,
+    "idle_exit_seconds": DEFAULT_IDLE_SECONDS,
+}
+
+
+# ------------------------------------------------------------------ helpers
+
+
+def _sha(text: object, size: int = 64) -> str:
+    return hashlib.sha256(str(text).encode("utf-8", errors="replace")).hexdigest()[:size]
+
+
+def _now() -> float:
+    return time.time()
+
+
+def _bind_fingerprint(value: object, size: int = 24) -> str:
+    return _sha(value, size)
+
+
+def runtime_root(explicit: Path | None = None) -> Path:
+    """The per-user directory holding this service's non-authoritative runtime
+    state (singleton lock, health file, spawn log). Nothing in it is authority:
+    the signing key lives in broker memory only."""
+    if explicit is not None:
+        return Path(explicit)
+    return Path.home() / ".saipen" / "authority"
+
+
+def scope(explicit: Path | None = None) -> str:
+    """The endpoint scope token. One broker per user runtime root, so every
+    process of this user -- and only this user -- meets the same endpoint."""
+    root = runtime_root(explicit)
+    return _sha(os.path.normcase(str(root.resolve())), 24)
+
+
+def endpoint_name(explicit: Path | None = None) -> str:
+    return transport.endpoint(scope(explicit))
+
+
+def instance_id() -> str:
+    return "broker-" + secrets.token_hex(12)
+
+
+def settings(policy: dict | None = None) -> dict:
+    """The broker's own settings from the protocol registry, with defaults."""
+    merged = dict(DEFAULT_SETTINGS)
+    if policy is None:
+        try:
+            from .registry import load_registry
+
+            policy = (load_registry().get("protocol_admission") or {}).get("host_authority")
+        except Exception:
+            policy = None
+    if isinstance(policy, dict):
+        for key in DEFAULT_SETTINGS:
+            if key in policy:
+                merged[key] = policy[key]
+    merged["host_images"] = [str(item) for item in (merged.get("host_images") or [])]
+    for key in ("ancestry_limit", "capability_ttl_seconds", "idle_exit_seconds"):
+        try:
+            merged[key] = int(merged[key])
+        except (TypeError, ValueError):
+            merged[key] = DEFAULT_SETTINGS[key]
+    return merged
+
+
+def binding(project: Path | str | None, session: str, host: str, model, provider) -> dict:
+    """The scope a capability is bound to. Every field is compared, not hashed
+    away: two projects, sessions, models or providers never share a capability."""
+    try:
+        resolved = Path(project).resolve() if project else ""
+    except (OSError, ValueError):
+        resolved = str(project or "")
+    return {
+        "project": _bind_fingerprint(os.path.normcase(str(resolved))),
+        "session": _bind_fingerprint(session),
+        "host": str(host or ""),
+        "model": str(model or ""),
+        "provider": str(provider or ""),
+    }
+
+
+def adapter_fingerprint(saipen_root: Path | None) -> str:
+    """The installed Claude adapter's own bytes. The broker reads the artifact
+    itself; a client never supplies this field."""
+    if saipen_root is None:
+        return ""
+    artifact = Path(saipen_root) / "extensions" / "adapters" / "claude" / "saipen-guard.py"
+    try:
+        return hashlib.sha256(artifact.read_bytes()).hexdigest()
+    except OSError:
+        return ""
+
+
+# ------------------------------------------------------------------- capability
+
+
+@dataclass(frozen=True)
+class Minted:
+    capability: str
+    fields: dict
+
+
+class Authority:
+    """The broker's in-memory authority: one ephemeral key, one generation.
+
+    The key is generated per broker process and never written anywhere. A broker
+    restart therefore invalidates every capability it issued, which is what
+    "generation" means here: the client re-admits automatically instead of the
+    old token surviving a changed authority.
+    """
+
+    def __init__(self, *, ttl_seconds: int = DEFAULT_TTL_SECONDS, clock=_now) -> None:
+        self.key = secrets.token_bytes(32)
+        self.instance = instance_id()
+        self.ttl_seconds = int(ttl_seconds)
+        self.clock = clock
+        self.started = clock()
+        self._issued: dict[str, tuple[dict, float]] = {}
+        self._lock = threading.Lock()
+
+    def _mac(self, fields: dict) -> str:
+        material = "|".join(str(fields.get(name, "")) for name in _CAPABILITY_FIELDS)
+        return hmac.new(self.key, material.encode("utf-8"), hashlib.sha256).hexdigest()
+
+    def mint(
+        self,
+        binding_fields: dict,
+        *,
+        generation: str,
+        adapter: str,
+        authority: str,
+    ) -> Minted:
+        issued = self.clock()
+        expires = issued + self.ttl_seconds
+        fields = {
+            "instance": self.instance,
+            "capability_id": secrets.token_hex(8),
+            "issued": issued,
+            "expires": expires,
+            **binding_fields,
+            "adapter": adapter,
+            "authority": authority,
+            "generation": generation,
+        }
+        fields["mac"] = self._mac(fields)
+        capability = ".".join(
+            [
+                CAPABILITY_PREFIX,
+                fields["instance"],
+                str(int(expires)),
+                fields["capability_id"],
+                fields["mac"],
+            ]
+        )
+        with self._lock:
+            self._issued[fields["capability_id"]] = (dict(fields), expires)
+            if len(self._issued) > 4096:
+                cutoff = issued - self.ttl_seconds
+                self._issued = {
+                    key: value for key, value in self._issued.items() if value[1] > cutoff
+                }
+        return Minted(capability=capability, fields=fields)
+
+    def verify(self, capability: object, binding_fields: dict) -> tuple[bool, str | None, str]:
+        """(ok, refusal code, detail). Replay, expiry, a foreign generation and a
+        transplanted binding are all distinct refusals, never one generic error.
+
+        Two independent things are required: the capability must name an entry
+        THIS process minted (so replay from a written-down string fails), and its
+        mac must recompute from the broker's in-memory key (so a forged shape
+        fails even if a capability id were guessed).
+        """
+        if not isinstance(capability, str) or not capability:
+            return False, CODE_CAPABILITY_INVALID, "no capability presented"
+        parts = capability.split(".")
+        if len(parts) != 5 or parts[0] != CAPABILITY_PREFIX:
+            return False, CODE_CAPABILITY_INVALID, "malformed capability"
+        _, instance, expires_text, capability_id, mac = parts
+        if instance != self.instance:
+            return False, CODE_CAPABILITY_INVALID, "capability was issued by another generation"
+        try:
+            expires = float(expires_text)
+        except ValueError:
+            return False, CODE_CAPABILITY_INVALID, "unreadable expiry"
+        with self._lock:
+            known = self._issued.get(capability_id)
+        if known is None:
+            return False, CODE_CAPABILITY_REPLAY, "capability is not one this broker issued"
+        fields, minted_expires = known
+        if self.clock() > expires or self.clock() > minted_expires:
+            return False, CODE_CAPABILITY_EXPIRED, "capability has expired"
+        if str(int(expires)) != str(int(minted_expires)):
+            return False, CODE_CAPABILITY_INVALID, "presented expiry is not the minted expiry"
+        for name in ("project", "session", "host", "model", "provider"):
+            if str(fields.get(name, "")) != str(binding_fields.get(name, "")):
+                return (
+                    False,
+                    CODE_BINDING_MISMATCH,
+                    f"capability is bound to another {name}",
+                )
+        if not hmac.compare_digest(self._mac(fields), str(mac)):
+            return False, CODE_CAPABILITY_INVALID, "capability mac does not verify"
+        return True, None, "capability verified against the issuing broker"
+
+
+def capability_fields(capability: str) -> dict:
+    """A JSON-safe, non-secret view of a capability for diagnostics."""
+    parts = str(capability or "").split(".")
+    if len(parts) != 5:
+        return {"valid_shape": False}
+    return {
+        "valid_shape": True,
+        "prefix": parts[0],
+        "instance": parts[1],
+        "expires": parts[2],
+        "capability_id": parts[3],
+    }
+
+
+# ------------------------------------------------------------------- ledger
+
+
+class Ledger:
+    """The admission ledger, owned by the broker.
+
+    The provenance of every record is an HMAC under the broker's in-memory key,
+    so a record written by an ordinary same-user process cannot be made to look
+    authoritative: verification is a question only this live broker can answer.
+    """
+
+    def __init__(self, authority: Authority) -> None:
+        self.authority = authority
+
+    #: The two fields that carry integrity rather than content.
+    UNSEALED = ("seal", "provenance")
+
+    def _provenance(self, body: dict) -> dict:
+        material = json.dumps(body, sort_keys=True, ensure_ascii=False).encode("utf-8")
+        return {
+            "kid": self.authority.instance,
+            "alg": "hmac-sha256",
+            "mac": hmac.new(self.authority.key, material, hashlib.sha256).hexdigest(),
+        }
+
+    def seal(self, record: dict, capability: str, delivery_digest: dict) -> dict:
+        """The record the owner reads, plus the provenance only this broker can
+        reproduce. The corruption seal is the owner's own function, computed over
+        the same body, so a broker record and a locally built one are the same
+        shape and the difference between them is the keyed provenance."""
+        from . import protocol_admission as pa
+
+        body = {key: value for key, value in record.items() if key not in self.UNSEALED}
+        body["delivered"] = delivery_digest
+        body["capability_shape"] = capability_fields(capability)
+        body["seal"] = pa._seal(body)
+        body["provenance"] = self._provenance(body)
+        return body
+
+    def verify(self, record: dict) -> tuple[bool, str]:
+        provenance = record.get("provenance")
+        if not isinstance(provenance, dict):
+            return False, "record carries no provenance"
+        if provenance.get("kid") != self.authority.instance:
+            return False, "record was provenanced by another generation"
+        if provenance.get("alg") != "hmac-sha256":
+            return False, "record provenance algorithm is not this broker's"
+        body = {key: value for key, value in record.items() if key != "provenance"}
+        material = json.dumps(body, sort_keys=True, ensure_ascii=False).encode("utf-8")
+        expected = hmac.new(self.authority.key, material, hashlib.sha256).hexdigest()
+        if not hmac.compare_digest(str(provenance.get("mac") or ""), expected):
+            return False, "record provenance mac does not verify"
+        return True, "record verified against the issuing broker"
+
+    @staticmethod
+    def path(project_root: Path, session: str) -> Path:
+        from . import protocol_admission as pa
+
+        return Path(pa._ledger_path(Path(project_root), session))
+
+    def read(self, project_root: Path, session: str) -> dict | None:
+        try:
+            record = json.loads(self.path(project_root, session).read_text(encoding="utf-8"))
+        except (OSError, ValueError):
+            return None
+        if not isinstance(record, dict) or record.get("schema") != SCHEMA_VERSION:
+            return None
+        if record.get("session") != session:
+            return None
+        return record
+
+    def write(self, project_root: Path, session: str, record: dict) -> bool:
+        path = self.path(project_root, session)
+        try:
+            path.parent.mkdir(parents=True, exist_ok=True)
+        except OSError:
+            return False
+        temporary = path.with_suffix(".partial")
+        try:
+            temporary.write_text(json.dumps(record, ensure_ascii=False), encoding="utf-8")
+            os.replace(temporary, path)
+        except OSError:
+            with contextlib.suppress(OSError):
+                temporary.unlink()
+            return False
+        return True
+
+    def remove(self, project_root: Path, session: str) -> bool:
+        with contextlib.suppress(OSError):
+            self.path(project_root, session).unlink()
+            return True
+        return False
+
+
+# ------------------------------------------------------------------- broker
+
+
+@dataclass
+class Stats:
+    started: float = field(default_factory=_now)
+    served: int = 0
+    authenticated: int = 0
+    refused: int = 0
+    last_client: dict | None = None
+    last_activity: float = field(default_factory=_now)
+
+
+class Broker:
+    """One live authority. Holds the key, the ledger and the counts."""
+
+    def __init__(
+        self,
+        *,
+        saipen_root: Path | None = None,
+        runtime: Path | None = None,
+        config: dict | None = None,
+        max_requests: int | None = None,
+        clock=_now,
+    ) -> None:
+        self.config = dict(config) if config is not None else settings()
+        self.authority = Authority(
+            ttl_seconds=int(self.config.get("capability_ttl_seconds") or DEFAULT_TTL_SECONDS),
+            clock=clock,
+        )
+        self.ledger = Ledger(self.authority)
+        self.saipen_root = Path(saipen_root) if saipen_root else None
+        self.runtime = runtime_root(runtime)
+        self.max_requests = max_requests
+        self.stats = Stats()
+        self.stop = threading.Event()
+        self.clock = clock
+
+    # ---------------------------------------------------------- identity
+
+    def identify(self, peer) -> tuple[bool, str | None, dict]:
+        """Authenticate the client from the OS, never from the request."""
+        limit = int(self.config.get("ancestry_limit") or DEFAULT_ANCESTRY_LIMIT)
+        if peer is None or getattr(peer, "pid", None) is None:
+            return (
+                False,
+                CODE_IDENTITY_UNAVAILABLE,
+                {
+                    "transport": getattr(peer, "kind", "unknown"),
+                    "detail": "the platform reported no client pid for this connection",
+                    "identity": {"supported": proc.platform_supported(), "chain": []},
+                },
+            )
+        report = proc.describe(int(peer.pid), limit)
+        ancestor = proc.host_ancestor(
+            int(peer.pid), list(self.config.get("host_images") or []), limit
+        )
+        if ancestor is None:
+            return (
+                False,
+                CODE_NOT_AUTHENTICATED,
+                {
+                    "transport": getattr(peer, "kind", "unknown"),
+                    "detail": (
+                        "the connecting process is not a descendant of a registered host "
+                        "application, so it cannot prove the host/adapter binding"
+                    ),
+                    "host_images": list(self.config.get("host_images") or []),
+                    "identity": {
+                        "supported": report.get("supported"),
+                        "chain": (report.get("chain") or [])[:MAX_CHAIN_REPORTED],
+                        "detail": report.get("detail"),
+                    },
+                },
+            )
+        return (
+            True,
+            None,
+            {
+                "transport": getattr(peer, "kind", "unknown"),
+                "pid": int(peer.pid),
+                "host_image": ancestor.name,
+                "host_pid": ancestor.pid,
+                "chain": (report.get("chain") or [])[:MAX_CHAIN_REPORTED],
+            },
+        )
+
+    # ------------------------------------------------------------ ops
+
+    def handle(self, payload: object, peer) -> dict:
+        self.stats.served += 1
+        if not isinstance(payload, dict):
+            return self._refuse(CODE_BAD_REQUEST, "request is not a JSON object")
+        op = payload.get("op")
+        if payload.get("v") not in (None, WIRE_VERSION):
+            return self._refuse(CODE_BAD_REQUEST, "unsupported wire version")
+        if op == "ping":
+            return self._ping()
+        if op == "status":
+            return self._status(peer)
+        if op not in ("authorize", "admission", "invalidate", "verify", "verify-record", "shutdown"):
+            return self._refuse(CODE_UNKNOWN_OP, f"unknown op {op!r}")
+        ok, code, detail = self.identify(peer)
+        if not ok:
+            # The identity detail is the refusal detail: it names what the OS
+            # saw, which is the only thing that explains a refusal here.
+            return self._refuse(code, str(detail.get("detail") or "client refused"), identity=detail)
+        self.stats.authenticated += 1
+        self.stats.last_client = detail
+        self.stats.last_activity = self.clock()
+        if op == "authorize":
+            return self._authorize(payload, detail)
+        if op == "admission":
+            return self._admission(payload, detail)
+        if op == "invalidate":
+            return self._invalidate(payload, detail)
+        if op == "verify":
+            return self._verify(payload)
+        if op == "verify-record":
+            return self._verify_record(payload)
+        self.stop.set()
+        return {"ok": True, "code": "BROKER_SHUTDOWN", "detail": "shutdown requested", "identity": detail}
+
+    def _refuse(self, code: str | None, detail: str, **extra) -> dict:
+        self.stats.refused += 1
+        return {"ok": False, "code": code, "detail": detail, **extra}
+
+    def _ping(self) -> dict:
+        return {
+            "ok": True,
+            "service": SERVICE,
+            "instance": self.authority.instance,
+            "started": self.authority.started,
+            "protocol": WIRE_VERSION,
+        }
+
+    def _status(self, peer) -> dict:
+        ok, code, detail = self.identify(peer)
+        view = {
+            "ok": True,
+            "service": SERVICE,
+            "instance": self.authority.instance,
+            "protocol": WIRE_VERSION,
+            "started": self.authority.started,
+            "uptime": self.clock() - self.authority.started,
+            "served": self.stats.served,
+            "authenticated_requests": self.stats.authenticated,
+            "refused_requests": self.stats.refused,
+            "last_client": self.stats.last_client,
+            "authenticated": ok,
+            "identity_supported": proc.platform_supported(),
+            "peer_identity_supported": transport.peer_supported(),
+            "transport": transport.endpoint(scope(self.runtime)),
+            "runtime_root": str(self.runtime),
+            "host_images": list(self.config.get("host_images") or []),
+            "capability_ttl_seconds": int(
+                self.config.get("capability_ttl_seconds") or DEFAULT_TTL_SECONDS
+            ),
+            "saipen_root": str(self.saipen_root) if self.saipen_root else None,
+        }
+        if not ok:
+            view["code"] = code
+            view["detail"] = detail
+        return view
+
+    def _scope(self, payload: dict) -> tuple[dict | None, dict | None]:
+        """(binding, refusal). The project must really be a bound SAIPEN project."""
+        project = payload.get("project")
+        session = payload.get("session")
+        host = payload.get("host")
+        if not isinstance(session, str) or not session:
+            return None, self._refuse(CODE_BAD_REQUEST, "session is required")
+        if not isinstance(host, str) or not host:
+            return None, self._refuse(CODE_BAD_REQUEST, "host is required")
+        if not project:
+            return None, self._refuse(CODE_BAD_REQUEST, "project is required")
+        try:
+            root = Path(str(project)).resolve()
+        except (OSError, ValueError):
+            return None, self._refuse(CODE_BAD_REQUEST, "project path is unreadable")
+        if not (root / ".saipen" / "STATE.md").is_file():
+            return None, self._refuse(CODE_BAD_REQUEST, f"not a bound SAIPEN project: {root}")
+        return {
+            "root": root,
+            "session": session,
+            "host": host,
+            "model": payload.get("model"),
+            "provider": payload.get("provider"),
+            "authority_root": payload.get("authority_root"),
+            "home": payload.get("home"),
+            "event": payload.get("event") or "hook",
+        }, None
+
+    def _context(self, scope_fields: dict):
+        from . import protocol_admission as pa
+
+        return pa.Context(
+            project_root=scope_fields["root"],
+            session_id=scope_fields["session"],
+            host=scope_fields["host"],
+            model=scope_fields["model"],
+            provider=scope_fields["provider"],
+            authority_root=(
+                Path(scope_fields["authority_root"]) if scope_fields["authority_root"] else None
+            ),
+            home=Path(scope_fields["home"]) if scope_fields["home"] else None,
+        )
+
+    def _authorize(self, payload: dict, identity: dict) -> dict:
+        """Read-only: may this authenticated client act on this scope at all?"""
+        scope_fields, refusal = self._scope(payload)
+        if refusal is not None:
+            return refusal
+        capability = payload.get("capability")
+        if capability:
+            ok, code, detail = self.authority.verify(capability, binding(
+                scope_fields["root"], scope_fields["session"], scope_fields["host"],
+                scope_fields["model"], scope_fields["provider"],
+            ))
+            return {
+                "ok": ok,
+                "code": code,
+                "detail": detail,
+                "event": payload.get("verb") or "hook",
+                "identity": identity,
+            }
+        self.stats.last_activity = self.clock()
+        return {
+            "ok": True,
+            "code": None,
+            "detail": "client is a descendant of a registered host application",
+            "event": payload.get("verb") or "hook",
+            "identity": identity,
+        }
+
+    def _admission(self, payload: dict, identity: dict) -> dict:
+        from . import protocol_admission as pa
+
+        scope_fields, refusal = self._scope(payload)
+        if refusal is not None:
+            return refusal
+        ctx = self._context(scope_fields)
+        policy = pa.load_policy()
+        found = pa.components(ctx, policy)
+        if found["problems"]:
+            verdict = pa._verdict(
+                pa.STATE_REFUSED,
+                problems=found["problems"],
+                stale=[],
+                warnings=found["warnings"],
+                unobserved=[],
+            )
+            verdict["delivery"] = ""
+            verdict["failed_component"] = "authority"
+            return {"ok": False, **verdict, "identity": identity}
+
+        generation = pa.generation(found["proofs"])
+        scope_binding = binding(
+            scope_fields["root"],
+            scope_fields["session"],
+            scope_fields["host"],
+            scope_fields["model"],
+            scope_fields["provider"],
+        )
+        adapter = adapter_fingerprint(self.saipen_root)
+        authority_digest = _sha(json.dumps(found["proofs"], sort_keys=True))
+        record = self.ledger.read(scope_fields["root"], scope_fields["session"])
+        proven = bool(record) and self.ledger.verify(record)[0]
+
+        if proven:
+            stale = pa.staleness(record, ctx, found["proofs"])
+            if not stale:
+                return {
+                    "ok": True,
+                    **pa._verdict(
+                        pa.STATE_ADMITTED,
+                        problems=[],
+                        stale=[],
+                        warnings=found["warnings"],
+                        unobserved=[],
+                        generation=generation,
+                        token=record.get("token"),
+                    ),
+                    "delivery": "",
+                    "previous_state": pa.STATE_ADMITTED,
+                    "capability": record.get("capability"),
+                    "capability_fields": record.get("capability_shape"),
+                    "record_written": False,
+                    "instance": self.authority.instance,
+                    "identity": identity,
+                }
+            state = pa.STATE_STALE
+            stale_names = stale
+        else:
+            state = pa.STATE_BINDING
+            stale_names = []
+
+        minted = self.authority.mint(
+            scope_binding,
+            generation=generation,
+            adapter=adapter,
+            authority=authority_digest,
+        )
+        token = "tok-" + _sha(json.dumps([generation, scope_fields["session"],
+                                           scope_fields["model"], scope_fields["provider"]]), 32)
+        delivered = {
+            name: _sha(found["texts"][name])
+            for name in pa.AUTHORITY_DOCUMENTS
+            if name in found["texts"]
+        }
+        delivered.update(
+            {f"skill:{skill['name']}": skill["fingerprint"]
+             for skill in found["skills"] if skill.get("resolved")}
+        )
+        record_body = {
+            "schema": SCHEMA_VERSION,
+            "session": scope_fields["session"],
+            "host": scope_fields["host"],
+            "model": scope_fields["model"],
+            "provider": scope_fields["provider"],
+            "proofs": found["proofs"],
+            "generation": generation,
+            "token": token,
+            "adapter": adapter,
+            "authority": authority_digest,
+            "binding": scope_binding,
+            "issued": minted.fields["issued"],
+            "expires": minted.fields["expires"],
+            "capability": minted.capability,
+            "event": scope_fields["event"],
+            "client": identity,
+        }
+        record_body = self.ledger.seal(record_body, minted.capability, delivered)
+        written = self.ledger.write(scope_fields["root"], scope_fields["session"], record_body)
+        verdict = pa._verdict(
+            pa.STATE_ADMITTED,
+            problems=[],
+            stale=stale_names,
+            warnings=found["warnings"],
+            unobserved=[],
+            generation=generation,
+            token=token,
+        )
+        verdict["delivery"] = pa._delivery(found, generation)
+        return {
+            "ok": True,
+            **verdict,
+            # What the session was before this handshake: BINDING (nothing yet)
+            # or STALE (a proven generation changed). The answer is ADMITTED
+            # either way, because this call just minted and wrote the record.
+            "previous_state": state,
+            "capability": minted.capability,
+            "capability_fields": capability_fields(minted.capability),
+            "record_written": written,
+            "expires": minted.fields["expires"],
+            "instance": self.authority.instance,
+            "identity": identity,
+        }
+
+    def _invalidate(self, payload: dict, identity: dict) -> dict:
+        scope_fields, refusal = self._scope(payload)
+        if refusal is not None:
+            return refusal
+        removed = self.ledger.remove(scope_fields["root"], scope_fields["session"])
+        return {
+            "ok": True,
+            "code": None,
+            "removed": removed,
+            "reason": str(payload.get("reason") or ""),
+            "identity": identity,
+        }
+
+    def _verify(self, payload: dict) -> dict:
+        capability = payload.get("capability")
+        scope_fields, refusal = self._scope(payload)
+        if refusal is not None:
+            return refusal
+        ok, code, detail = self.authority.verify(
+            capability,
+            binding(
+                scope_fields["root"],
+                scope_fields["session"],
+                scope_fields["host"],
+                scope_fields["model"],
+                scope_fields["provider"],
+            ),
+        )
+        return {"ok": ok, "code": code, "detail": detail}
+
+    def _verify_record(self, payload: dict) -> dict:
+        record = payload.get("record")
+        if not isinstance(record, dict):
+            return self._refuse(CODE_BAD_REQUEST, "record is required")
+        ok, detail = self.ledger.verify(record)
+        return {"ok": ok, "code": None if ok else CODE_CAPABILITY_INVALID, "detail": detail}
+
+
+# ------------------------------------------------------------- lifecycle
+
+
+def health(runtime: Path | None = None, *, timeout: float = 1.0) -> dict | None:
+    """The running broker's own report, or None when nothing answers."""
+    try:
+        reply = transport.request(
+            endpoint_name(runtime), {"v": WIRE_VERSION, "op": "ping"}, timeout=timeout
+        )
+    except transport.TransportError:
+        return None
+    return reply if isinstance(reply, dict) and reply.get("ok") else None
+
+
+def _pid_alive(pid: int) -> bool:
+    try:
+        if os.name == "nt":
+            fact = proc.process_fact(int(pid))
+            return fact is not None
+        os.kill(int(pid), 0)
+    except (OSError, ValueError, ProcessLookupError):
+        return False
+    return True
+
+
+def lock_path(runtime: Path | None = None) -> Path:
+    return runtime_root(runtime) / "broker.lock"
+
+
+def status_path(runtime: Path | None = None) -> Path:
+    return runtime_root(runtime) / "broker.json"
+
+
+def log_path(runtime: Path | None = None) -> Path:
+    return runtime_root(runtime) / "broker.log"
+
+
+def acquire_lock(runtime: Path | None = None) -> tuple[bool, str]:
+    """Singleton by owner pid: (acquired, detail). A stale lock is reclaimed."""
+    path = lock_path(runtime)
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+    except OSError as exc:
+        return False, f"runtime directory is not writable: {exc}"
+    for _attempt in range(2):
+        try:
+            handle = os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+        except FileExistsError:
+            try:
+                holder = json.loads(path.read_text(encoding="utf-8"))
+                pid = int(holder.get("pid") or 0)
+            except (OSError, ValueError, TypeError):
+                pid = 0
+            if pid and _pid_alive(pid):
+                return False, f"another broker is already running (pid {pid})"
+            with contextlib.suppress(OSError):
+                path.unlink()
+            continue
+        except OSError as exc:
+            return False, f"lock cannot be created: {exc}"
+        with os.fdopen(handle, "w", encoding="utf-8") as stream:
+            stream.write(json.dumps({"pid": os.getpid(), "started": _now()}))
+        return True, "acquired"
+    return False, "another broker holds the lock"
+
+
+def release_lock(runtime: Path | None = None) -> None:
+    with contextlib.suppress(OSError):
+        lock_path(runtime).unlink()
+
+
+def write_status(payload: dict, runtime: Path | None = None) -> bool:
+    path = status_path(runtime)
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
+    except OSError:
+        return False
+    return True
+
+
+def read_status(runtime: Path | None = None) -> dict | None:
+    try:
+        payload = json.loads(status_path(runtime).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    return payload if isinstance(payload, dict) else None
+
+
+def spawn(
+    saipen_root: Path | None,
+    *,
+    runtime: Path | None = None,
+    wait: float = 6.0,
+) -> dict:
+    """Start a detached broker process and wait for it to answer. Bounded.
+
+    The child is fully detached: it is not a terminal job, it survives the GUI,
+    and it inherits no stdin. Its stdout and stderr go to the runtime log, which
+    is the file the recovery diagnostics point the operator at.
+    """
+    entry = Path(__file__).resolve().parents[1] / "authority_service.py"
+    if not entry.is_file():
+        return {"ok": False, "started": False, "detail": f"service entry is missing: {entry}"}
+    log = log_path(runtime)
+    try:
+        log.parent.mkdir(parents=True, exist_ok=True)
+        stream = open(log, "ab")  # noqa: SIM115 - the child owns this handle
+    except OSError as exc:
+        return {"ok": False, "started": False, "detail": f"spawn log is not writable: {exc}"}
+    argv = [sys.executable, str(entry), "serve"]
+    if saipen_root is not None:
+        argv += ["--saipen-root", str(saipen_root)]
+    if runtime is not None:
+        argv += ["--runtime", str(runtime)]
+    options: dict = {"stdin": subprocess.DEVNULL, "stdout": stream, "stderr": stream,
+                     "close_fds": True}
+    if os.name == "nt":
+        options["creationflags"] = 0x00000008 | 0x00000200  # DETACHED_PROCESS|NEW_GROUP
+    else:
+        options["start_new_session"] = True
+    try:
+        child = subprocess.Popen(argv, **options)
+    except (OSError, ValueError) as exc:
+        stream.close()
+        return {"ok": False, "started": False, "detail": f"broker could not be started: {exc}"}
+    deadline = _now() + max(0.0, wait)
+    attempts = 0
+    while _now() < deadline:
+        time.sleep(0.15)
+        attempts += 1
+        report = health(runtime, timeout=1.0)
+        if report:
+            return {
+                "ok": True,
+                "started": True,
+                "pid": child.pid,
+                "attempts": attempts,
+                "instance": report.get("instance"),
+                "log": str(log),
+            }
+    return {
+        "ok": False,
+        "started": True,
+        "pid": child.pid,
+        "attempts": attempts,
+        "detail": "the started broker did not answer within the wait budget",
+        "log": str(log),
+    }
+
+
+def run_service(
+    *,
+    saipen_root: Path | None = None,
+    runtime: Path | None = None,
+    idle_seconds: int | None = None,
+    max_requests: int | None = None,
+    stop: threading.Event | None = None,
+) -> int:
+    """Run the broker until stopped. Returns a process exit code."""
+    config = settings()
+    idle = int(config.get("idle_exit_seconds") or 0) if idle_seconds is None else int(idle_seconds)
+    acquired, detail = acquire_lock(runtime)
+    if not acquired:
+        return 0 if "already running" in detail else 1
+    broker = Broker(saipen_root=saipen_root, runtime=runtime, config=config,
+                    max_requests=max_requests)
+    stop_event = stop if stop is not None else broker.stop
+    watchdog: threading.Thread | None = None
+
+    def idle_watch() -> None:
+        while not stop_event.wait(5.0):
+            if broker.clock() - broker.stats.last_activity > idle:
+                stop_event.set()
+                return
+
+    write_status(
+        {
+            "ok": True,
+            "pid": os.getpid(),
+            "instance": broker.authority.instance,
+            "started": broker.authority.started,
+            "runtime_root": str(broker.runtime),
+            "saipen_root": str(saipen_root) if saipen_root else None,
+            "log": str(log_path(runtime)),
+        },
+        runtime,
+    )
+    if idle > 0:
+        watchdog = threading.Thread(target=idle_watch, daemon=True)
+        watchdog.start()
+    try:
+        transport.serve(
+            transport.endpoint(scope(runtime)),
+            broker.handle,
+            stop=stop_event,
+            max_requests=max_requests,
+        )
+    except transport.TransportError as exc:
+        write_status({"ok": False, "code": exc.kind, "detail": exc.detail}, runtime)
+        return 1
+    finally:
+        broker.stop.set()
+        release_lock(runtime)
+        with contextlib.suppress(OSError):
+            status_path(runtime).unlink()
+    return 0
+
+
+def request(payload: dict, *, runtime: Path | None = None, timeout: float = 5.0) -> dict:
+    """One client call. Raises transport.TransportError when nothing answers."""
+    body = {"v": WIRE_VERSION, **payload}
+    return transport.request(endpoint_name(runtime), body, timeout=timeout)
+
+
+__all__ = [
+    "AUTHORITY_HINT",
+    "Broker",
+    "Authority",
+    "Ledger",
+    "MODE_DEGRADED",
+    "MODE_STRICT",
+    "MODES",
+    "SERVICE",
+    "WIRE_VERSION",
+    "acquire_lock",
+    "adapter_fingerprint",
+    "binding",
+    "capability_fields",
+    "endpoint_name",
+    "health",
+    "instance_id",
+    "log_path",
+    "read_status",
+    "release_lock",
+    "request",
+    "run_service",
+    "runtime_root",
+    "scope",
+    "settings",
+    "spawn",
+    "status_path",
+    "write_status",
+]
diff --git a/tools/saipen_engine/host_authority_client.py b/tools/saipen_engine/host_authority_client.py
new file mode 100644
index 00000000..b4a845db
--- /dev/null
+++ b/tools/saipen_engine/host_authority_client.py
@@ -0,0 +1,490 @@
+"""Guard-side client of the SAIPEN host-authority broker.
+
+The Claude Code hook and the canonical engine never mint admission, and this
+module is where they stop pretending they can. It asks the broker, and the
+broker answers after identifying the asking process from the operating system.
+Nothing here decides an admission state: the verdict, the capability and the
+ledger record all come back from the broker, and a request this module cannot
+deliver is reported as unreachable rather than invented.
+
+Recovery is bounded and explicit. When no broker answers, the client attempts
+exactly one automatic start -- and only when its own process is a descendant of
+a registered host application, because starting a service on behalf of a random
+same-user shell is neither useful nor safe -- then retries the handshake once.
+Every step is recorded in the returned `recovery` block so the diagnostic the
+operator sees can name the component that failed and the recovery that was
+attempted, instead of repeating that an authority "is required".
+
+The degraded fallback is deliberately NOT automatic. It is read from an
+operator-owned file (`~/.saipen/authority.json`, `{"mode": "degraded"}`) that
+this module never writes on its own, so a strict host cannot silently become a
+degraded one; a missing, unreadable or unrecognized file is strict.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+from pathlib import Path
+
+from . import host_authority_broker as broker
+from . import host_authority_process as proc
+from . import host_authority_transport as transport
+
+#: One admission handshake. The hook's own budget is 45s, so this stays small.
+REQUEST_TIMEOUT = 10.0
+#: A provenance question is answered from memory; it must not stall a reply.
+VERIFY_TIMEOUT = 2.0
+PING_TIMEOUT = 1.0
+MAX_CHAIN = 8
+
+CODE_UNREACHABLE = "BROKER_UNREACHABLE"
+CODE_NOT_HOST_CLIENT = "BROKER_NOT_A_HOST_CLIENT"
+
+
+def mode_path(home: Path | None = None) -> Path:
+    base = Path(home) if home is not None else Path.home()
+    return base / ".saipen" / "authority.json"
+
+
+def authority_mode(home: Path | None = None) -> str:
+    """The operator's explicit admission mode. Anything unrecognized is strict."""
+    try:
+        payload = json.loads(mode_path(home).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return broker.MODE_STRICT
+    if not isinstance(payload, dict):
+        return broker.MODE_STRICT
+    mode = str(payload.get("mode") or "").strip().lower()
+    return mode if mode in broker.MODES else broker.MODE_STRICT
+
+
+def set_authority_mode(mode: object, home: Path | None = None) -> dict:
+    """Write the operator's mode choice. Refuses an unrecognized value loudly
+    rather than falling back, and never writes anything else."""
+    normalized = str(mode or "").strip().lower()
+    if normalized not in broker.MODES:
+        return {
+            "ok": False,
+            "code": "VALIDATION_FAILED",
+            "detail": "mode must be one of " + ", ".join(broker.MODES),
+        }
+    path = mode_path(home)
+    try:
+        path.parent.mkdir(parents=True, exist_ok=True)
+        path.write_text(
+            json.dumps({"mode": normalized, "set_by": "operator"}, indent=2) + "\n",
+            encoding="utf-8",
+        )
+    except OSError as exc:
+        return {"ok": False, "code": "IO_FAILED", "detail": str(exc)}
+    return {"ok": True, "code": "AUTHORITY_MODE_SET", "mode": normalized, "path": str(path)}
+
+
+def _call(payload: dict, *, runtime: Path | None, timeout: float) -> dict | None:
+    try:
+        reply = broker.request(payload, runtime=runtime, timeout=timeout)
+    except transport.TransportError:
+        return None
+    return reply if isinstance(reply, dict) else None
+
+
+def health(runtime: Path | None = None) -> dict | None:
+    return broker.health(runtime, timeout=PING_TIMEOUT)
+
+
+def status(runtime: Path | None = None) -> dict | None:
+    """The broker's own health report, including whether THIS process was
+    accepted as a host client. The socket identifies the caller; this module
+    never sends an identity claim."""
+    return _call({"op": "status"}, runtime=runtime, timeout=PING_TIMEOUT)
+
+
+def identify_self(host_images: object = None, limit: int = 16) -> dict:
+    """How the broker will see this process: image and parent chain."""
+    images = list(host_images or broker.settings().get("host_images") or [])
+    report = proc.describe(os.getpid(), limit)
+    ancestor = proc.host_ancestor(os.getpid(), images, limit)
+    return {
+        "ok": ancestor is not None,
+        "host_image": ancestor.name if ancestor else None,
+        "host_pid": ancestor.pid if ancestor else None,
+        "host_images": images,
+        "supported": report.get("supported"),
+        "chain": (report.get("chain") or [])[:MAX_CHAIN],
+        "detail": report.get("detail"),
+    }
+
+
+def ensure(
+    saipen_root: Path | None = None,
+    *,
+    runtime: Path | None = None,
+    wait: float = 6.0,
+) -> dict:
+    """Ping, and if nothing answers, start one detached broker and wait for it.
+
+    Bounded: at most one start attempt and a `wait`-second budget. Returns what
+    was attempted whether or not it worked, so the caller can report recovery
+    instead of a dead end.
+    """
+    report = health(runtime)
+    if report:
+        return {
+            "ok": True,
+            "state": "running",
+            "found": True,
+            "started": False,
+            "attempts": 1,
+            "instance": report.get("instance"),
+            "health": report,
+        }
+    identity = identify_self()
+    if not identity["ok"]:
+        return {
+            "ok": False,
+            "state": "not_a_host_client",
+            "found": False,
+            "started": False,
+            "attempts": 1,
+            "code": CODE_NOT_HOST_CLIENT,
+            "identity": identity,
+            "detail": (
+                "this process is not a descendant of a registered host application, "
+                "so no broker was started on its behalf"
+            ),
+        }
+    started = broker.spawn(saipen_root, runtime=runtime, wait=wait)
+    return {
+        "ok": bool(started.get("ok")),
+        "state": "started" if started.get("ok") else "start_failed",
+        "found": False,
+        "started": bool(started.get("started")),
+        "attempts": 1 + int(started.get("attempts") or 0),
+        "instance": started.get("instance"),
+        "pid": started.get("pid"),
+        "log": started.get("log"),
+        "identity": identity,
+        "detail": started.get("detail"),
+    }
+
+
+def _payload(
+    *,
+    project: Path | str | None,
+    session: str,
+    host: str,
+    model: object = None,
+    provider: object = None,
+    authority_root: Path | str | None = None,
+    home: Path | str | None = None,
+    event: str | None = None,
+    capability: object = None,
+    verb: str | None = None,
+) -> dict:
+    payload: dict = {
+        "project": str(project) if project else "",
+        "session": str(session or ""),
+        "host": str(host or ""),
+        "model": str(model) if model else "",
+        "provider": str(provider) if provider else "",
+    }
+    if authority_root:
+        payload["authority_root"] = str(authority_root)
+    if home:
+        payload["home"] = str(home)
+    if event:
+        payload["event"] = str(event)
+    if capability:
+        payload["capability"] = str(capability)
+    if verb:
+        payload["verb"] = str(verb)
+    return payload
+
+
+def _recovery(
+    *,
+    attempted: list[str],
+    ensured: dict | None = None,
+    log: object = None,
+) -> dict:
+    # `answered` is the state when the first call was served and no recovery was
+    # needed: saying `unreachable` there would send the operator hunting for a
+    # service that is running.
+    block = {
+        "component": "SAIPEN host-authority broker",
+        "attempted": list(attempted),
+        "started": bool((ensured or {}).get("started")),
+        "state": (ensured or {}).get("state") or "answered",
+        "log": str(log or (ensured or {}).get("log") or broker.log_path()),
+        "identity": (ensured or {}).get("identity"),
+        "detail": (ensured or {}).get("detail"),
+    }
+    return block
+
+
+def attempt_admission(
+    *,
+    project: Path | str | None,
+    session: str,
+    host: str,
+    model: object = None,
+    provider: object = None,
+    authority_root: Path | str | None = None,
+    home: Path | str | None = None,
+    event: str = "UserPromptSubmit",
+    runtime: Path | None = None,
+) -> dict:
+    """One admission handshake with automatic, bounded recovery.
+
+    Returns `{reachable, refused, verdict, recovery, code, detail}` and never
+    raises. `reachable` False means no broker answered even after the recovery
+    attempt; `refused` True means a broker answered and refused THIS client.
+    """
+    payload = _payload(
+        project=project,
+        session=session,
+        host=host,
+        model=model,
+        provider=provider,
+        authority_root=authority_root,
+        home=home,
+        event=event,
+    )
+    attempted = ["connect"]
+    reply = _call({"op": "admission", **payload}, runtime=runtime, timeout=REQUEST_TIMEOUT)
+    ensured: dict | None = None
+    saipen_root = Path(authority_root) if authority_root else None
+    if reply is None:
+        ensured = ensure(saipen_root, runtime=runtime)
+        attempted.append("start")
+        if ensured.get("ok"):
+            attempted.append("retry")
+            reply = _call(
+                {"op": "admission", **payload}, runtime=runtime, timeout=REQUEST_TIMEOUT
+            )
+    recovery = _recovery(attempted=attempted, ensured=ensured)
+    if reply is None:
+        return {
+            "reachable": False,
+            "refused": False,
+            "verdict": None,
+            "recovery": recovery,
+            "code": CODE_UNREACHABLE,
+            "detail": recovery.get("detail") or "no host-authority broker answered",
+        }
+    if reply.get("state") is None and reply.get("ok") is False:
+        # A broker answered and refused THIS client: the service is up, the
+        # binding is not recognized, and the recovery state must say so instead
+        # of claiming the authority was missing.
+        recovery["state"] = "refused"
+        recovery["refused_code"] = reply.get("code")
+        recovery["refused_detail"] = reply.get("detail")
+        recovery["broker_identity"] = reply.get("identity")
+        return {
+            "reachable": True,
+            "refused": True,
+            "verdict": None,
+            "recovery": recovery,
+            "code": reply.get("code"),
+            "detail": reply.get("detail"),
+            "identity": reply.get("identity"),
+        }
+    return {
+        "reachable": True,
+        "refused": False,
+        "verdict": reply,
+        "recovery": recovery,
+        "code": None,
+        "detail": None,
+    }
+
+
+def invalidate(
+    *,
+    project: Path | str | None,
+    session: str,
+    host: str = "claude",
+    reason: str = "",
+    model: object = None,
+    provider: object = None,
+    authority_root: Path | str | None = None,
+    home: Path | str | None = None,
+    runtime: Path | None = None,
+) -> dict | None:
+    """Remove this session's record through the broker. None when no broker
+    answers, so the caller keeps its own fail-closed path rather than guessing."""
+    reply = _call(
+        {
+            "op": "invalidate",
+            **_payload(
+                project=project,
+                session=session,
+                host=host,
+                model=model,
+                provider=provider,
+                authority_root=authority_root,
+                home=home,
+                event=reason,
+            ),
+        },
+        runtime=runtime,
+        timeout=REQUEST_TIMEOUT,
+    )
+    return reply
+
+
+def authorize(
+    *,
+    project: Path | str | None,
+    session: str,
+    host: str,
+    verb: str,
+    model: object = None,
+    provider: object = None,
+    capability: object = None,
+    authority_root: Path | str | None = None,
+    home: Path | str | None = None,
+    runtime: Path | None = None,
+) -> dict | None:
+    """May this authenticated client perform `verb` here? None when unreachable."""
+    return _call(
+        {
+            "op": "authorize",
+            **_payload(
+                project=project,
+                session=session,
+                host=host,
+                model=model,
+                provider=provider,
+                authority_root=authority_root,
+                home=home,
+                capability=capability,
+                verb=verb,
+            ),
+        },
+        runtime=runtime,
+        timeout=REQUEST_TIMEOUT,
+    )
+
+
+def verify_capability(
+    capability: object,
+    *,
+    project: Path | str | None,
+    session: str,
+    host: str,
+    model: object = None,
+    provider: object = None,
+    runtime: Path | None = None,
+) -> bool:
+    if not capability:
+        return False
+    reply = _call(
+        {
+            "op": "verify",
+            **_payload(
+                project=project,
+                session=session,
+                host=host,
+                model=model,
+                provider=provider,
+                capability=capability,
+            ),
+        },
+        runtime=runtime,
+        timeout=VERIFY_TIMEOUT,
+    )
+    return bool(reply and reply.get("ok"))
+
+
+def verify_record(record: object, *, runtime: Path | None = None) -> bool:
+    """Is this ledger record one the live broker wrote?
+
+    A record with no provenance, a provenance from another generation, or a mac
+    this broker cannot reproduce is False. No broker at all is also False: a
+    record is never authoritative merely because it is well formed.
+    """
+    if not isinstance(record, dict) or not isinstance(record.get("provenance"), dict):
+        return False
+    reply = _call({"op": "verify-record", "record": record}, runtime=runtime, timeout=VERIFY_TIMEOUT)
+    return bool(reply and reply.get("ok"))
+
+
+def shutdown(runtime: Path | None = None) -> dict:
+    reply = _call({"op": "shutdown"}, runtime=runtime, timeout=REQUEST_TIMEOUT)
+    if reply is None:
+        return {"ok": False, "code": CODE_UNREACHABLE, "detail": "no broker answered"}
+    return reply
+
+
+def describe_recovery(outcome: dict) -> str:
+    """One bounded sentence naming the failed component and the attempted
+    recovery. The operator reads this instead of "authority is required"."""
+    recovery = outcome.get("recovery") or {}
+    attempted = ", ".join(recovery.get("attempted") or []) or "none"
+    detail = outcome.get("detail") or recovery.get("detail") or "no detail reported"
+    log = recovery.get("log")
+    text = (
+        f"component {recovery.get('component') or 'SAIPEN host-authority broker'} "
+        f"recovery-attempted [{attempted}] state {recovery.get('state')} -- {detail}"
+    )
+    if log:
+        text += f" (log {log})"
+    return text[:480]
+
+
+def recovery_actions(outcome: dict) -> list[str]:
+    """The concrete human actions this failure leaves open, most useful first."""
+    actions: list[str] = ["Retry the prompt"]
+    if outcome.get("refused"):
+        actions.append("Open diagnostics: saipen authority status")
+        return actions
+    actions.append("Start the authority service: saipen authority start")
+    actions.append(f"Open diagnostics: {broker.log_path()}")
+    actions.append("Policy permitting only: saipen authority mode degraded")
+    return actions
+
+
+def degraded_notice(problems: object = None) -> str:
+    """The visible marker for a degraded session. Never claims admission.
+
+    The specific host-authority proof that was missing travels with the notice,
+    so the operator sees WHY the session is unverified instead of a bare
+    downgrade they cannot act on.
+    """
+    reasons: list[str] = []
+    for item in problems or []:
+        if isinstance(item, dict) and item.get("reason"):
+            reasons.append(str(item["reason"]))
+    detail = (" Missing proof: " + "; ".join(reasons) + ".") if reasons else ""
+    return (
+        "SAIPEN DEGRADED -- host admission unverified. "
+        "SAIPEN ADMISSION UNVERIFIED/DEGRADED (SAIPEN_ADMISSION_UNVERIFIED): the separated "
+        "host-authority broker could not be consulted, and the operator's policy explicitly "
+        "allows this prompt to proceed." + detail + " This is NOT mechanical protocol "
+        "admission; protected SAIPEN authority and evidence mutations remain refused. "
+        "Restore the authority with `saipen authority start`."
+    )
+
+
+__all__ = [
+    "CODE_NOT_HOST_CLIENT",
+    "CODE_UNREACHABLE",
+    "attempt_admission",
+    "authority_mode",
+    "authorize",
+    "degraded_notice",
+    "describe_recovery",
+    "ensure",
+    "health",
+    "identify_self",
+    "invalidate",
+    "mode_path",
+    "recovery_actions",
+    "set_authority_mode",
+    "shutdown",
+    "status",
+    "verify_capability",
+    "verify_record",
+]
diff --git a/tools/saipen_engine/host_authority_identity.py b/tools/saipen_engine/host_authority_identity.py
new file mode 100644
index 00000000..2491e826
--- /dev/null
+++ b/tools/saipen_engine/host_authority_identity.py
@@ -0,0 +1,434 @@
+"""Proof that an authority request came from the host's own hook invocation.
+
+Defect class: the first separated authority (T-1623) admitted any process that
+had the host application somewhere above it. Every command a model runs through
+the host's shell tool is such a process, so the one caller the boundary exists
+to refuse -- model-executed code asking for its own admission -- passed. A copy
+of an ordinary interpreter renamed to the host's image name passed as well.
+
+"Descendant of the host" is therefore not the claim. The claim proven here is
+narrower and is the only one the host alone can make true:
+
+    host application            a verified image (name, and its code signer
+        |                       where the platform can report one)
+        +-- hook shell(s)       each started to run EXACTLY the hook command
+              |                 and nothing else
+              +-- hook          the installed hook artifact, shipped bytes,
+                    |           declaring the same host the request names
+                    +-- engine  optionally, the engine the hook started
+
+A shell tool wraps a model's command in its own bootstrap, so its command line
+is never exactly the hook command; a hook command re-run from inside such a
+shell sits under that extra shell and fails the same test. A renamed
+interpreter carries its own publisher's signature, not the host's.
+
+Limits, stated because a boundary that hides them is worth less: this proves
+the SHAPE of the invocation from what the operating system reports about live
+processes. It is not a defense against code running inside the host process, a
+same-user process that rewrites the installed hook, or one that forges its
+parent with a debugging API. Those are outside what any same-user local scheme
+can prove, and nothing here claims otherwise.
+
+Pure logic: the caller supplies the observed chain and the two observations
+that need the platform (`signer_of`, `artifact_current`), so every branch is
+testable without spawning a process.
+"""
+
+from __future__ import annotations
+
+import os
+import shlex
+from dataclasses import dataclass, field
+from typing import Callable, Sequence
+
+#: Refusal reasons. Detail codes of one wire refusal, never policy by themselves.
+REASON_IDENTITY_UNAVAILABLE = "IDENTITY_UNAVAILABLE"
+REASON_NOT_HOST_DESCENDANT = "NOT_HOST_DESCENDANT"
+REASON_HOOK_NOT_FOUND = "HOOK_NOT_FOUND"
+REASON_HOOK_CHAIN_UNRECOGNIZED = "HOOK_CHAIN_UNRECOGNIZED"
+REASON_HOOK_HOST_MISMATCH = "HOOK_HOST_MISMATCH"
+REASON_HOOK_ARTIFACT_MISMATCH = "HOOK_ARTIFACT_MISMATCH"
+REASON_HOST_IMAGE_UNVERIFIED = "HOST_IMAGE_UNVERIFIED"
+REASON_PARENT_REUSED = "PARENT_REUSED"
+
+DEFAULT_SHELLS = (
+    "bash.exe",
+    "bash",
+    "sh.exe",
+    "sh",
+    "dash",
+    "zsh",
+    "cmd.exe",
+    "powershell.exe",
+    "pwsh.exe",
+    "pwsh",
+)
+#: Engine entries the hook is allowed to have started, relative to its root.
+DEFAULT_ENGINE_ENTRIES = ("tools/saipen.py",)
+#: An interpreter launcher may re-execute itself once (venv shims, `py`).
+_MAX_REEXEC = 2
+_MAX_ENGINE_HOPS = 2
+
+
+@dataclass(frozen=True)
+class IdentityPolicy:
+    """What counts as the host, its hook and the shells that may run the hook."""
+
+    host: str
+    host_images: tuple[str, ...]
+    #: Installed hook artifact paths (any spelling; compared normalized).
+    hook_artifacts: tuple[str, ...]
+    #: Code-signer names the host image must carry. Empty: not required.
+    host_signers: tuple[str, ...] = ()
+    shells: tuple[str, ...] = DEFAULT_SHELLS
+    engine_entries: tuple[str, ...] = DEFAULT_ENGINE_ENTRIES
+    max_shells: int = 4
+
+
+@dataclass(frozen=True)
+class Proof:
+    ok: bool
+    reason: str | None = None
+    detail: str = ""
+    host_pid: int | None = None
+    host_image: str | None = None
+    host_signer: str | None = None
+    hook_pid: int | None = None
+    hook_root: str | None = None
+    shells: int = 0
+    chain: list[dict] = field(default_factory=list)
+
+    def as_dict(self) -> dict:
+        return {
+            "ok": self.ok,
+            "reason": self.reason,
+            "detail": self.detail,
+            "host_pid": self.host_pid,
+            "host_image": self.host_image,
+            "host_signer": self.host_signer,
+            "hook_pid": self.hook_pid,
+            "hook_root": self.hook_root,
+            "shells": self.shells,
+            "chain": self.chain,
+        }
+
+
+def norm_path(value: object) -> str:
+    """One spelling for a path-like token: forward slashes, case-folded where
+    the platform is, and an MSYS drive (`/c/x`) read as the drive it names."""
+    text = str(value or "").strip().strip("\"'").replace("\\", "/")
+    if len(text) >= 3 and text[0] == "/" and text[2] == "/" and text[1].isalpha():
+        text = text[1] + ":" + text[2:]
+    while "//" in text[1:]:
+        text = text[0] + text[1:].replace("//", "/")
+    if len(text) > 3:
+        text = text.rstrip("/")
+    return text.lower() if os.name == "nt" or (len(text) > 1 and text[1] == ":") else text
+
+
+def _basename(value: object) -> str:
+    return norm_path(value).rsplit("/", 1)[-1]
+
+
+def _stem(name: str) -> str:
+    return name[:-4] if name.endswith(".exe") else name
+
+
+def _name_matches(image: object, wanted: Sequence[str]) -> bool:
+    path = norm_path(image)
+    name = path.rsplit("/", 1)[-1]
+    for candidate in wanted:
+        target = norm_path(candidate)
+        if not target:
+            continue
+        if "/" in target:
+            if path == target:
+                return True
+        elif name == target or _stem(name) == _stem(target):
+            return True
+    return False
+
+
+def _same_token(left: str, right: str, *, executable: bool = False) -> bool:
+    """Two command tokens name the same thing. Flags compare exactly; anything
+    path-like compares by normalized path; an executable given without a
+    directory compares by name, because the shell resolved it through PATH."""
+    if left == right:
+        return True
+    a, b = norm_path(left), norm_path(right)
+    if a == b:
+        return True
+    if executable and ("/" not in a or "/" not in b):
+        return _stem(a.rsplit("/", 1)[-1]) == _stem(b.rsplit("/", 1)[-1])
+    return False
+
+
+def _same_argv(payload: Sequence[str], argv: Sequence[str]) -> bool:
+    if len(payload) != len(argv) or not argv:
+        return False
+    if not _same_token(payload[0], argv[0], executable=True):
+        return False
+    return all(_same_token(a, b) for a, b in zip(payload[1:], argv[1:]))
+
+
+def _payload_tokens(payload: str) -> list[list[str]]:
+    """Every way a shell could have split its command string."""
+    found: list[list[str]] = []
+    for posix in (True, False):
+        try:
+            tokens = shlex.split(payload, posix=posix)
+        except ValueError:
+            continue
+        if not posix:
+            tokens = [token.strip("\"'") for token in tokens]
+        if tokens and tokens not in found:
+            found.append(tokens)
+    return found
+
+
+def _flag(argv: Sequence[str], name: str) -> str | None:
+    for index, token in enumerate(argv):
+        if token == name and index + 1 < len(argv):
+            return argv[index + 1]
+        if token.startswith(name + "="):
+            return token.split("=", 1)[1]
+    return None
+
+
+def _script(argv: Sequence[str] | None) -> str | None:
+    """The script an interpreter command line runs, or None.
+
+    Strict on purpose: the script is the FIRST argument and nothing else. The
+    installer writes `<interpreter> <hook> --host ...` with no interpreter
+    option, and reading past options would let `-X <hook path> other.py` pass
+    an option value off as the script being run.
+    """
+    if not argv or len(argv) < 2:
+        return None
+    token = argv[1]
+    return None if token.startswith("-") else token
+
+
+#: The flag after which a shell's command line carries the command to run.
+_COMMAND_FLAGS = ("-c", "/c", "-command", "-encodedcommand")
+
+
+def _shell_payloads(argv: Sequence[str]) -> list[list[str]]:
+    """Every reading of "the command this shell was started to run"."""
+    readings: list[list[str]] = []
+    if len(argv) >= 3:
+        readings.extend(_payload_tokens(argv[-1]))
+    for index, token in enumerate(argv[1:], start=1):
+        if token.lower() in _COMMAND_FLAGS:
+            tail = list(argv[index + 1 :])
+            if len(tail) > 1 and tail not in readings:
+                readings.append(tail)
+            break
+    return readings
+
+
+def _view(fact) -> dict:
+    argv = list(getattr(fact, "argv", None) or [])
+    return {
+        "pid": fact.pid,
+        "ppid": fact.ppid,
+        "image": fact.image,
+        "name": fact.name,
+        "argv": [token[:160] for token in argv[:8]],
+    }
+
+
+def prove_hook_invocation(
+    chain: Sequence,
+    policy: IdentityPolicy,
+    *,
+    signer_of: Callable[[str], str | None] | None = None,
+    artifact_current: Callable[[str], bool] | None = None,
+    report_limit: int = 8,
+) -> Proof:
+    """Decide whether `chain` (peer first, then each parent) is the host's hook.
+
+    Never raises. A chain this function cannot read to the end is refused with
+    the reason that stopped it, and that reason is what the operator is shown.
+    """
+    facts = list(chain or [])
+    view = [_view(fact) for fact in facts[:report_limit]]
+
+    def refuse(reason: str, detail: str, **extra) -> Proof:
+        return Proof(ok=False, reason=reason, detail=detail, chain=view, **extra)
+
+    if not facts:
+        return refuse(REASON_IDENTITY_UNAVAILABLE, "the platform reported no process identity")
+
+    # A parent that started AFTER its child is not that child's parent: the pid
+    # was reused. Everything above the reused link is unrelated.
+    for index in range(len(facts) - 1):
+        child, parent = facts[index], facts[index + 1]
+        child_born = getattr(child, "created", None)
+        parent_born = getattr(parent, "created", None)
+        if child_born is not None and parent_born is not None and parent_born > child_born:
+            facts = facts[: index + 1]
+            if not any(_name_matches(item.image, policy.host_images) for item in facts):
+                return refuse(
+                    REASON_PARENT_REUSED,
+                    f"process {child.pid} names a parent pid that was reused by a newer process",
+                )
+            break
+
+    artifacts = {norm_path(item) for item in policy.hook_artifacts if str(item).strip()}
+
+    # 1. The hook: the peer itself, or the process that started the peer's engine.
+    hook_index = None
+    for index, fact in enumerate(facts[: _MAX_ENGINE_HOPS + 1]):
+        script = _script(getattr(fact, "argv", None))
+        if script is not None and norm_path(script) in artifacts:
+            hook_index = index
+            break
+    if hook_index is None:
+        if not any(_name_matches(item.image, policy.host_images) for item in facts):
+            return refuse(
+                REASON_NOT_HOST_DESCENDANT,
+                "the connecting process is not started by a registered host application",
+            )
+        return refuse(
+            REASON_HOOK_NOT_FOUND,
+            "the connecting process is under the host application but is not the "
+            "installed host hook or the engine it started (a shell tool call is not a hook)",
+        )
+    hook = facts[hook_index]
+    hook_argv = list(hook.argv or [])
+    hook_root = _flag(hook_argv, "--saipen-root")
+    declared_host = _flag(hook_argv, "--host")
+    if declared_host != policy.host:
+        return refuse(
+            REASON_HOOK_HOST_MISMATCH,
+            f"the hook declares host {declared_host!r}, the request names {policy.host!r}",
+            hook_pid=hook.pid,
+        )
+    # Below the hook only the engine it started may sit.
+    for fact in facts[:hook_index]:
+        script = _script(getattr(fact, "argv", None))
+        allowed = {
+            norm_path(f"{hook_root}/{entry}") for entry in policy.engine_entries if hook_root
+        }
+        if script is None or norm_path(script) not in allowed:
+            return refuse(
+                REASON_HOOK_NOT_FOUND,
+                "the connecting process was started by the hook but is not its engine",
+                hook_pid=hook.pid,
+            )
+
+    # 2. Above the hook: an interpreter re-exec of the same command, then shells
+    #    that were each started to run exactly this hook command.
+    cursor = hook_index + 1
+    reexec = 0
+    while (
+        cursor < len(facts)
+        and reexec < _MAX_REEXEC
+        and facts[cursor].argv
+        and _same_argv(list(facts[cursor].argv), hook_argv)
+        and not _name_matches(facts[cursor].image, policy.shells)
+    ):
+        cursor += 1
+        reexec += 1
+    shells = 0
+    while cursor < len(facts) and _name_matches(facts[cursor].image, policy.shells):
+        shell = facts[cursor]
+        if not any(
+            _same_argv(tokens, hook_argv) for tokens in _shell_payloads(list(shell.argv or []))
+        ):
+            return refuse(
+                REASON_HOOK_CHAIN_UNRECOGNIZED,
+                f"shell {shell.pid} above the hook was not started to run exactly the hook "
+                "command, so this is not the host's own hook invocation",
+                hook_pid=hook.pid,
+                hook_root=hook_root,
+            )
+        shells += 1
+        cursor += 1
+        if shells > policy.max_shells:
+            return refuse(
+                REASON_HOOK_CHAIN_UNRECOGNIZED,
+                "too many shells between the hook and the host application",
+                hook_pid=hook.pid,
+                hook_root=hook_root,
+            )
+
+    # 3. The host application itself, directly above.
+    if cursor >= len(facts) or not _name_matches(facts[cursor].image, policy.host_images):
+        above = facts[cursor].name if cursor < len(facts) else None
+        if not any(_name_matches(item.image, policy.host_images) for item in facts):
+            return refuse(
+                REASON_NOT_HOST_DESCENDANT,
+                "the hook was not started by a registered host application",
+                hook_pid=hook.pid,
+                hook_root=hook_root,
+            )
+        return refuse(
+            REASON_HOOK_CHAIN_UNRECOGNIZED,
+            f"the hook was started through {above!r}, not directly by the host application",
+            hook_pid=hook.pid,
+            hook_root=hook_root,
+        )
+    host = facts[cursor]
+    signer = None
+    if policy.host_signers:
+        try:
+            signer = signer_of(str(host.image)) if signer_of and host.image else None
+        except Exception:
+            signer = None
+        if signer not in policy.host_signers:
+            return refuse(
+                REASON_HOST_IMAGE_UNVERIFIED,
+                f"host image {host.name!r} is not signed by a registered publisher "
+                f"(found {signer!r})",
+                host_pid=host.pid,
+                host_image=host.image,
+                hook_pid=hook.pid,
+                hook_root=hook_root,
+            )
+
+    # 4. The hook's own bytes are the shipped ones.
+    script = _script(hook_argv) or ""
+    try:
+        current = artifact_current(script) if artifact_current else True
+    except Exception:
+        current = False
+    if not current:
+        return refuse(
+            REASON_HOOK_ARTIFACT_MISMATCH,
+            "the installed hook is not the shipped artifact of this SAIPEN generation",
+            host_pid=host.pid,
+            host_image=host.image,
+            hook_pid=hook.pid,
+            hook_root=hook_root,
+        )
+    return Proof(
+        ok=True,
+        detail="the request came from the host application's own hook invocation",
+        host_pid=host.pid,
+        host_image=host.image,
+        host_signer=signer,
+        hook_pid=hook.pid,
+        hook_root=hook_root,
+        shells=shells,
+        chain=view,
+    )
+
+
+__all__ = [
+    "DEFAULT_ENGINE_ENTRIES",
+    "DEFAULT_SHELLS",
+    "REASON_HOOK_ARTIFACT_MISMATCH",
+    "REASON_HOOK_CHAIN_UNRECOGNIZED",
+    "REASON_HOOK_HOST_MISMATCH",
+    "REASON_HOOK_NOT_FOUND",
+    "REASON_HOST_IMAGE_UNVERIFIED",
+    "REASON_IDENTITY_UNAVAILABLE",
+    "REASON_NOT_HOST_DESCENDANT",
+    "REASON_PARENT_REUSED",
+    "IdentityPolicy",
+    "Proof",
+    "norm_path",
+    "prove_hook_invocation",
+]
diff --git a/tools/saipen_engine/host_authority_process.py b/tools/saipen_engine/host_authority_process.py
new file mode 100644
index 00000000..45760377
--- /dev/null
+++ b/tools/saipen_engine/host_authority_process.py
@@ -0,0 +1,340 @@
+"""OS-derived process identity: who is on the other end of the authority socket.
+
+The host-authority broker authenticates a client by asking the OPERATING SYSTEM
+who that client is -- its image path and its parent chain -- and by trusting
+nothing the client says about itself. That distinction is the whole point of
+this module. A request may carry a project, a session, a host name and a claimed
+adapter identity, and every one of those fields is a string the caller chose;
+process identity is not, because the caller cannot set it.
+
+This module supplies identity only. It proves nothing by itself, grants nothing,
+and authenticates nobody: the broker decides which image names count as the host
+application, and a hostile same-user Python process that sits under a shell
+rather than under the host application is exactly what the parent chain is read
+to detect. A same-user process which really is a descendant of the host
+application is the only client the broker can trust, and even that trust is
+bounded by what the operator's machine can observe.
+
+Every function here is bounded and read-only. Nothing spawns, kills, signals or
+writes; an unreadable process is reported as unknown rather than guessed at, and
+an unknown client is a client the broker refuses. Failures never raise: a
+diagnostic that crashes is worse than one that says "unavailable".
+"""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import sys
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Sequence
+
+#: Buffer bound for one image path. Windows' own maximum is far below this.
+IMAGE_MAX = 32768
+
+#: Windows access right: enough to read the image name, nothing more.
+_PROCESS_QUERY_LIMITED_INFORMATION = 0x1000
+_TH32CS_SNAPPROCESS = 0x2
+_INVALID_HANDLE_VALUE = -1
+
+
+@dataclass(frozen=True)
+class ProcessFact:
+    """One observed process. `image` and `name` are None when unreadable."""
+
+    pid: int
+    ppid: int | None
+    image: str | None
+    name: str | None
+
+
+def _normalize_image(raw: str) -> str:
+    return raw.replace("\\", "/").strip().lower()
+
+
+def _basename(image: str | None) -> str | None:
+    if not image:
+        return None
+    tail = image.rsplit("/", 1)[-1]
+    return tail or None
+
+
+def _strip_exe(name: str) -> str:
+    return name[:-4] if name.endswith(".exe") else name
+
+
+# ---------------------------------------------------------------- Windows
+
+
+def _windows_api():
+    """The two kernel32 calls this module needs, or None off Windows."""
+    if sys.platform != "win32":
+        return None
+    try:
+        import ctypes
+        from ctypes import wintypes
+    except Exception:  # pragma: no cover - a platform without ctypes
+        return None
+    try:
+        kernel32 = ctypes.WinDLL("kernel32", use_last_error=True)
+    except (AttributeError, OSError):
+        return None
+
+    class _PROCESSENTRY32W(ctypes.Structure):
+        _fields_ = [
+            ("dwSize", wintypes.DWORD),
+            ("cntUsage", wintypes.DWORD),
+            ("th32ProcessID", wintypes.DWORD),
+            ("th32DefaultHeapID", ctypes.c_void_p),
+            ("th32ModuleID", wintypes.DWORD),
+            ("cntThreads", wintypes.DWORD),
+            ("th32ParentProcessID", wintypes.DWORD),
+            ("pcPriClassBase", ctypes.c_long),
+            ("dwFlags", wintypes.DWORD),
+            ("szExeFile", wintypes.WCHAR * 260),
+        ]
+
+    try:
+        kernel32.OpenProcess.argtypes = [wintypes.DWORD, wintypes.BOOL, wintypes.DWORD]
+        kernel32.OpenProcess.restype = wintypes.HANDLE
+        kernel32.CloseHandle.argtypes = [wintypes.HANDLE]
+        kernel32.CloseHandle.restype = wintypes.BOOL
+        kernel32.QueryFullProcessImageNameW.argtypes = [
+            wintypes.HANDLE,
+            wintypes.DWORD,
+            wintypes.LPWSTR,
+            ctypes.POINTER(wintypes.DWORD),
+        ]
+        kernel32.QueryFullProcessImageNameW.restype = wintypes.BOOL
+        kernel32.CreateToolhelp32Snapshot.argtypes = [wintypes.DWORD, wintypes.DWORD]
+        kernel32.CreateToolhelp32Snapshot.restype = wintypes.HANDLE
+        kernel32.Process32FirstW.argtypes = [wintypes.HANDLE, ctypes.POINTER(_PROCESSENTRY32W)]
+        kernel32.Process32FirstW.restype = wintypes.BOOL
+        kernel32.Process32NextW.argtypes = [wintypes.HANDLE, ctypes.POINTER(_PROCESSENTRY32W)]
+        kernel32.Process32NextW.restype = wintypes.BOOL
+    except (AttributeError, TypeError):
+        return None
+    return ctypes, kernel32, _PROCESSENTRY32W
+
+
+_WINDOWS = _windows_api()
+
+
+def _windows_image(pid: int) -> str | None:
+    if _WINDOWS is None:
+        return None
+    ctypes, kernel32, _entry = _WINDOWS
+    handle = None
+    try:
+        handle = kernel32.OpenProcess(_PROCESS_QUERY_LIMITED_INFORMATION, False, pid)
+        if not handle:
+            return None
+        buffer = ctypes.create_unicode_buffer(IMAGE_MAX)
+        size = ctypes.c_ulong(IMAGE_MAX)
+        if not kernel32.QueryFullProcessImageNameW(handle, 0, buffer, ctypes.byref(size)):
+            return None
+        text = buffer.value
+        return _normalize_image(text) if text else None
+    except (OSError, ValueError, OverflowError, ctypes.ArgumentError):
+        return None
+    finally:
+        if handle:
+            with contextlib.suppress(OSError, ValueError, ctypes.ArgumentError):
+                kernel32.CloseHandle(handle)
+
+
+def _windows_parent(pid: int) -> int | None:
+    if _WINDOWS is None:
+        return None
+    ctypes, kernel32, entry_type = _WINDOWS
+    for _attempt in range(2):
+        handle = None
+        try:
+            handle = kernel32.CreateToolhelp32Snapshot(_TH32CS_SNAPPROCESS, 0)
+            if not handle or handle == _INVALID_HANDLE_VALUE:
+                continue
+            entry = entry_type()
+            entry.dwSize = ctypes.sizeof(entry_type)
+            found = False
+            if not kernel32.Process32FirstW(handle, ctypes.byref(entry)):
+                return None
+            while True:
+                if entry.th32ProcessID == pid:
+                    found = True
+                    break
+                if not kernel32.Process32NextW(handle, ctypes.byref(entry)):
+                    break
+            return int(entry.th32ParentProcessID) if found else None
+        except (OSError, ValueError, OverflowError, ctypes.ArgumentError):
+            return None
+        finally:
+            if handle and handle != _INVALID_HANDLE_VALUE:
+                with contextlib.suppress(OSError, ValueError, ctypes.ArgumentError):
+                    kernel32.CloseHandle(handle)
+    return None
+
+
+# ---------------------------------------------------------------- POSIX
+
+
+def _proc_available() -> bool:
+    try:
+        return os.path.isdir("/proc") and os.path.exists("/proc/self/stat")
+    except OSError:
+        return False
+
+
+def _posix_image(pid: int) -> str | None:
+    try:
+        target = os.readlink(f"/proc/{pid}/exe")
+    except OSError:
+        return None
+    if not target:
+        return None
+    # A deleted binary reads as "... (deleted)"; the identity is still the path.
+    return _normalize_image(target)
+
+
+def _posix_parent(pid: int) -> int | None:
+    try:
+        raw = Path(f"/proc/{pid}/stat").read_bytes()[:4096]
+    except OSError:
+        return None
+    try:
+        text = raw.decode("utf-8", errors="replace")
+    except (UnicodeDecodeError, ValueError):
+        return None
+    # `comm` may contain spaces and parentheses, so the fields start after the
+    # LAST ')' of the line.
+    pivot = text.rfind(")")
+    if pivot < 0:
+        return None
+    fields = text[pivot + 1 :].split()
+    if len(fields) < 2:
+        return None
+    try:
+        return int(fields[1])
+    except ValueError:
+        return None
+
+
+# ---------------------------------------------------------------- public
+
+
+def platform_supported() -> bool:
+    """Can this platform report process identity at all? Never raises."""
+    try:
+        if sys.platform == "win32":
+            return _WINDOWS is not None
+        return _proc_available()
+    except Exception:
+        return False
+
+
+def process_fact(pid: int) -> ProcessFact | None:
+    """One observed process, or None when it cannot be observed."""
+    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:
+        return None
+    try:
+        if sys.platform == "win32":
+            if _WINDOWS is None:
+                return None
+            image = _windows_image(pid)
+            parent = _windows_parent(pid)
+        else:
+            image = _posix_image(pid)
+            parent = _posix_parent(pid)
+            if pid == os.getpid():
+                parent = os.getppid() if parent is None else parent
+    except Exception:
+        return None
+    if image is None and parent is None:
+        return None
+    return ProcessFact(pid=pid, ppid=parent, image=image, name=_basename(image))
+
+
+def ancestry(pid: int, limit: int = 16) -> list[ProcessFact]:
+    """Self, then parent, then grandparent... bounded, cycle-safe, never raising."""
+    chain: list[ProcessFact] = []
+    seen: set[int] = set()
+    current: int | None = pid
+    try:
+        bound = int(limit)
+    except (TypeError, ValueError):
+        bound = 16
+    if bound < 1:
+        return chain
+    while current and current > 0 and current not in seen and len(chain) < bound:
+        seen.add(current)
+        fact = process_fact(current)
+        if fact is None:
+            break
+        chain.append(fact)
+        current = fact.ppid
+        if current in (0, 1):
+            break
+    return chain
+
+
+def _matches(name: str | None, image: str | None, wanted: str) -> bool:
+    target = wanted.replace("\\", "/").strip().lower()
+    if not target:
+        return False
+    if "/" in target:
+        return image is not None and image == target
+    if name is None:
+        return False
+    return name == target or _strip_exe(name) == _strip_exe(target)
+
+
+def host_ancestor(
+    pid: int, host_images: Sequence[str], limit: int = 16
+) -> ProcessFact | None:
+    """The nearest ancestor (or the process itself) that is a host application.
+
+    `host_images` are image names supplied as configuration by the broker's
+    policy -- `claude.exe` and `claude` match each other. An empty or unusable
+    list matches nothing, which leaves the client unauthenticated.
+    """
+    try:
+        wanted = [str(item) for item in host_images if str(item).strip()]
+    except TypeError:
+        return None
+    if not wanted:
+        return None
+    for fact in ancestry(pid, limit):
+        for candidate in wanted:
+            if _matches(fact.name, fact.image, candidate):
+                return fact
+    return None
+
+
+def describe(pid: int, limit: int = 16) -> dict:
+    """A JSON-safe identity report for diagnostics. Never raises."""
+    supported = platform_supported()
+    chain: list[dict] = []
+    detail: str | None = None
+    try:
+        for fact in ancestry(pid, limit):
+            chain.append(
+                {"pid": fact.pid, "ppid": fact.ppid, "image": fact.image, "name": fact.name}
+            )
+    except Exception as exc:  # pragma: no cover - defensive only
+        detail = f"identity read failed: {type(exc).__name__}"
+    if supported and not chain and detail is None:
+        detail = "the OS reported no identity for this process"
+    if not supported:
+        detail = "process identity is unavailable on this platform"
+    return {"supported": supported, "pid": pid, "chain": chain, "detail": detail}
+
+
+__all__ = [
+    "IMAGE_MAX",
+    "ProcessFact",
+    "ancestry",
+    "describe",
+    "host_ancestor",
+    "platform_supported",
+    "process_fact",
+]
diff --git a/tools/saipen_engine/host_authority_transport.py b/tools/saipen_engine/host_authority_transport.py
new file mode 100644
index 00000000..55347b06
--- /dev/null
+++ b/tools/saipen_engine/host_authority_transport.py
@@ -0,0 +1,490 @@
+"""Local authenticated-adjacent IPC for the SAIPEN host-authority broker.
+
+This module moves bytes. It authenticates nothing, decides nothing and stores
+nothing: a Windows named pipe is bound on Windows and a Unix domain socket on
+POSIX, one JSON request frame in and one JSON response frame out per connection.
+Every trust decision belongs to the broker that passes the handler in, which
+reads the peer's OS identity (`Peer.pid`) itself and refuses a caller it cannot
+place. Keeping the transport this empty is the point: if a caller could prove
+itself by anything it SENDS, the same-user client this boundary exists to refuse
+would be able to send it too.
+
+Framing is one 4-byte big-endian length prefix followed by that many bytes of
+UTF-8 JSON, in both directions, on both platforms. A frame larger than
+`MAX_FRAME` or of zero length is refused rather than allocated.
+
+`serve` is called with a `threading.Event`; it answers connections until the
+event is set and then returns within about a second, because a lifecycle owner
+has to be able to shut a broker down without killing it.
+"""
+
+from __future__ import annotations
+
+import ctypes
+import errno
+import json
+import os
+import socket
+import struct
+import tempfile
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Callable
+
+__all__ = [
+    "MAX_FRAME",
+    "Peer",
+    "TransportError",
+    "available",
+    "endpoint",
+    "peer_supported",
+    "request",
+    "serve",
+]
+
+MAX_FRAME = 1024 * 1024
+
+_HEADER = struct.Struct(">I")
+_POLL_SECONDS = 0.01
+_ACCEPT_POLL_SECONDS = 0.05
+_FRAME_TIMEOUT_SECONDS = 5.0
+_ACCEPT_TIMEOUT_SECONDS = 0.25
+IS_WINDOWS = os.name == "nt"
+
+if IS_WINDOWS:  # pragma: no cover - platform branch, exercised on Windows only
+    from ctypes import wintypes
+
+    _GENERIC_READ = 0x80000000
+    _GENERIC_WRITE = 0x40000000
+    _OPEN_EXISTING = 3
+    _PIPE_ACCESS_DUPLEX = 0x00000003
+    _PIPE_TYPE_BYTE = 0x00000000
+    _PIPE_READMODE_BYTE = 0x00000000
+    _PIPE_WAIT = 0x00000000
+    _INVALID_HANDLE_VALUE = ctypes.c_void_p(-1).value
+    _ERROR_FILE_NOT_FOUND = 2
+    _ERROR_PIPE_BUSY = 231
+    _ERROR_PIPE_CONNECTED = 535
+    _BUFFER_BYTES = 65536
+    _MAX_INSTANCES = 255
+
+    _KERNEL32 = ctypes.WinDLL("kernel32", use_last_error=True)
+
+    _KERNEL32.CreateNamedPipeW.argtypes = (
+        wintypes.LPCWSTR,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.LPVOID,
+    )
+    _KERNEL32.CreateNamedPipeW.restype = wintypes.HANDLE
+    _KERNEL32.ConnectNamedPipe.argtypes = (wintypes.HANDLE, wintypes.LPVOID)
+    _KERNEL32.ConnectNamedPipe.restype = wintypes.BOOL
+    _KERNEL32.DisconnectNamedPipe.argtypes = (wintypes.HANDLE,)
+    _KERNEL32.DisconnectNamedPipe.restype = wintypes.BOOL
+    _KERNEL32.FlushFileBuffers.argtypes = (wintypes.HANDLE,)
+    _KERNEL32.FlushFileBuffers.restype = wintypes.BOOL
+    _KERNEL32.CloseHandle.argtypes = (wintypes.HANDLE,)
+    _KERNEL32.CloseHandle.restype = wintypes.BOOL
+    _KERNEL32.ReadFile.argtypes = (
+        wintypes.HANDLE,
+        wintypes.LPVOID,
+        wintypes.DWORD,
+        wintypes.LPDWORD,
+        wintypes.LPVOID,
+    )
+    _KERNEL32.ReadFile.restype = wintypes.BOOL
+    _KERNEL32.WriteFile.argtypes = (
+        wintypes.HANDLE,
+        wintypes.LPVOID,
+        wintypes.DWORD,
+        wintypes.LPDWORD,
+        wintypes.LPVOID,
+    )
+    _KERNEL32.WriteFile.restype = wintypes.BOOL
+    _KERNEL32.PeekNamedPipe.argtypes = (
+        wintypes.HANDLE,
+        wintypes.LPVOID,
+        wintypes.DWORD,
+        wintypes.LPDWORD,
+        wintypes.LPDWORD,
+        wintypes.LPDWORD,
+    )
+    _KERNEL32.PeekNamedPipe.restype = wintypes.BOOL
+    _KERNEL32.CreateFileW.argtypes = (
+        wintypes.LPCWSTR,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.LPVOID,
+        wintypes.DWORD,
+        wintypes.DWORD,
+        wintypes.HANDLE,
+    )
+    _KERNEL32.CreateFileW.restype = wintypes.HANDLE
+
+    _GET_PIPE_PID = getattr(_KERNEL32, "GetNamedPipeClientProcessId", None)
+    if _GET_PIPE_PID is not None:
+        _GET_PIPE_PID.argtypes = (wintypes.HANDLE, ctypes.POINTER(wintypes.ULONG))
+        _GET_PIPE_PID.restype = wintypes.BOOL
+
+
+class TransportError(RuntimeError):
+    """A connect or framing failure, classified by `.kind` for the caller."""
+
+    def __init__(self, kind: str, detail: str = "") -> None:
+        super().__init__(f"{kind}: {detail}" if detail else kind)
+        self.kind = kind
+        self.detail = detail
+
+
+@dataclass(frozen=True)
+class Peer:
+    """Who is on the other end, as far as the operating system will say."""
+
+    kind: str
+    pid: int | None
+
+
+def endpoint(scope: str) -> str:
+    """The endpoint name for a pre-sanitized scope token.
+
+    The caller owns the token; it is never re-derived or escaped here, so two
+    callers that pass the same token always meet on the same endpoint.
+    """
+    if IS_WINDOWS:
+        return "\\\\.\\pipe\\saipen-authority-" + scope
+    return str(Path(tempfile.gettempdir()) / ("saipen-authority-" + scope + ".sock"))
+
+
+def available() -> bool:
+    """True when this platform can both bind and connect a local endpoint."""
+    if IS_WINDOWS:
+        return True
+    return hasattr(socket, "AF_UNIX")
+
+
+def peer_supported() -> bool:
+    """True when the platform genuinely supplies an OS-derived client pid."""
+    if IS_WINDOWS:
+        return _GET_PIPE_PID is not None
+    return hasattr(socket, "SO_PEERCRED")
+
+
+# --------------------------------------------------------------- framing
+
+
+def _frame_size(header: bytes) -> int:
+    size = _HEADER.unpack(header)[0]
+    if size == 0 or size > MAX_FRAME:
+        raise TransportError("frame", f"declared length {size}")
+    return size
+
+
+def _pack(payload: dict) -> bytes:
+    body = json.dumps(payload, ensure_ascii=False, sort_keys=True).encode("utf-8")
+    if not body or len(body) > MAX_FRAME:
+        raise TransportError("frame", f"response size {len(body)}")
+    return _HEADER.pack(len(body)) + body
+
+
+def _unpack(body: bytes) -> dict:
+    try:
+        payload = json.loads(body.decode("utf-8"))
+    except (ValueError, UnicodeDecodeError) as exc:
+        raise TransportError("frame", f"unreadable JSON: {exc}") from exc
+    if not isinstance(payload, dict):
+        raise TransportError("frame", "frame is not a JSON object")
+    return payload
+
+
+def _dispatch(handler: Callable[[dict, Peer], dict], payload: dict, peer: Peer) -> dict:
+    """The handler never raises out of here; a fault becomes a refusal."""
+    if not isinstance(payload, dict):
+        return {"ok": False, "code": "BAD_REQUEST"}
+    try:
+        result = handler(payload, peer)
+    except Exception:  # a handler fault must not end the service loop
+        return {"ok": False, "code": "HANDLER_ERROR"}
+    if not isinstance(result, dict):
+        return {"ok": False, "code": "HANDLER_ERROR"}
+    return result
+
+
+if IS_WINDOWS:  # pragma: no cover - platform branch, exercised on Windows only
+
+    def _win_create(name: str):
+        return _KERNEL32.CreateNamedPipeW(
+            name,
+            _PIPE_ACCESS_DUPLEX,
+            _PIPE_TYPE_BYTE | _PIPE_READMODE_BYTE | _PIPE_WAIT,
+            _MAX_INSTANCES,
+            _BUFFER_BYTES,
+            _BUFFER_BYTES,
+            0,
+            None,
+        )
+
+    def _win_connect(handle) -> bool:
+        if _KERNEL32.ConnectNamedPipe(handle, None):
+            return True
+        return ctypes.get_last_error() == _ERROR_PIPE_CONNECTED
+
+    def _win_close(handle) -> None:
+        try:
+            _KERNEL32.CloseHandle(handle)
+        except OSError:
+            pass
+
+    def _win_peer(handle) -> Peer:
+        if _GET_PIPE_PID is None:
+            return Peer("named-pipe", None)
+        pid = wintypes.ULONG(0)
+        if _GET_PIPE_PID(handle, ctypes.byref(pid)):
+            return Peer("named-pipe", int(pid.value))
+        return Peer("named-pipe", None)
+
+    def _win_read(handle, count: int, deadline: float) -> bytes:
+        buffer = ctypes.create_string_buffer(count)
+        got = 0
+        while got < count:
+            if time.monotonic() > deadline:
+                raise TransportError("timeout", "peer did not finish its frame")
+            available_bytes = wintypes.DWORD(0)
+            if not _KERNEL32.PeekNamedPipe(
+                handle, None, 0, None, ctypes.byref(available_bytes), None
+            ):
+                raise TransportError("io", "peer closed the pipe")
+            if available_bytes.value == 0:
+                time.sleep(_POLL_SECONDS)
+                continue
+            chunk = min(count - got, available_bytes.value)
+            read = wintypes.DWORD(0)
+            if not _KERNEL32.ReadFile(
+                handle, ctypes.byref(buffer, got), chunk, ctypes.byref(read), None
+            ):
+                raise TransportError("io", "read failed")
+            got += read.value
+        return buffer.raw[:count]
+
+    def _win_write(handle, blob: bytes) -> bool:
+        written = wintypes.DWORD(0)
+        body = ctypes.create_string_buffer(blob, len(blob))
+        if not _KERNEL32.WriteFile(handle, body, len(blob), ctypes.byref(written), None):
+            return False
+        return written.value == len(blob)
+
+    def _win_release(name: str) -> None:
+        """One self-connect, so a blocked ConnectNamedPipe can be abandoned."""
+        handle = _KERNEL32.CreateFileW(
+            name, _GENERIC_READ | _GENERIC_WRITE, 0, None, _OPEN_EXISTING, 0, None
+        )
+        if handle != _INVALID_HANDLE_VALUE:
+            _win_close(handle)
+
+    def _win_serve(name: str, handler, stop, max_requests: int | None) -> None:
+        served = 0
+        while not stop.is_set() and (max_requests is None or served < max_requests):
+            handle = _win_create(name)
+            if handle == _INVALID_HANDLE_VALUE:
+                raise TransportError(
+                    "bind", f"CreateNamedPipeW failed ({ctypes.get_last_error()})"
+                )
+            try:
+                accepted = {"ok": False}
+                connected = threading.Event()
+
+                def accept(handle=handle, accepted=accepted, connected=connected) -> None:
+                    accepted["ok"] = _win_connect(handle)
+                    connected.set()
+
+                threading.Thread(target=accept, daemon=True).start()
+                while not connected.wait(_ACCEPT_POLL_SECONDS):
+                    if stop.is_set():
+                        _win_release(name)
+                        connected.wait(1.0)
+                        return
+                if not accepted["ok"] or stop.is_set():
+                    return
+                peer = _win_peer(handle)
+                deadline = time.monotonic() + _FRAME_TIMEOUT_SECONDS
+                response = None
+                try:
+                    size = _frame_size(_win_read(handle, _HEADER.size, deadline))
+                    payload = _unpack(_win_read(handle, size, deadline))
+                except TransportError:
+                    response = {"ok": False, "code": "BAD_REQUEST"}
+                if response is None:
+                    response = _dispatch(handler, payload, peer)
+                try:
+                    if _win_write(handle, _pack(response)):
+                        _KERNEL32.FlushFileBuffers(handle)
+                        served += 1
+                except TransportError:
+                    pass
+            finally:
+                _KERNEL32.DisconnectNamedPipe(handle)
+                _win_close(handle)
+
+    def _win_request(name: str, payload: dict, timeout: float) -> dict:
+        handle = _KERNEL32.CreateFileW(
+            name, _GENERIC_READ | _GENERIC_WRITE, 0, None, _OPEN_EXISTING, 0, None
+        )
+        if handle == _INVALID_HANDLE_VALUE:
+            error = ctypes.get_last_error()
+            if error in (_ERROR_FILE_NOT_FOUND, _ERROR_PIPE_BUSY):
+                raise TransportError("absent", f"no endpoint ({error})")
+            raise TransportError("absent", f"CreateFileW failed ({error})")
+        try:
+            if not _win_write(handle, _pack(payload)):
+                raise TransportError("io", "request was not written")
+            _KERNEL32.FlushFileBuffers(handle)
+            deadline = time.monotonic() + timeout
+            size = _frame_size(_win_read(handle, _HEADER.size, deadline))
+            return _unpack(_win_read(handle, size, deadline))
+        finally:
+            _win_close(handle)
+
+
+# --------------------------------------------------------------- POSIX
+
+
+def _posix_peer(connection: socket.socket) -> Peer:
+    if not hasattr(socket, "SO_PEERCRED"):
+        return Peer("unix-socket", None)
+    try:
+        raw = connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
+        return Peer("unix-socket", int(struct.unpack("3i", raw)[0]))
+    except OSError:
+        return Peer("unix-socket", None)
+
+
+def _recv_exact(connection: socket.socket, count: int) -> bytes:
+    chunks = bytearray()
+    while len(chunks) < count:
+        try:
+            chunk = connection.recv(count - len(chunks))
+        except socket.timeout as exc:
+            raise TransportError("timeout", "peer did not finish its frame") from exc
+        except OSError as exc:
+            raise TransportError("io", "peer closed the endpoint") from exc
+        if not chunk:
+            raise TransportError("io", "peer closed the endpoint")
+        chunks.extend(chunk)
+    return bytes(chunks)
+
+
+def _safe_send(connection: socket.socket, payload: dict) -> bool:
+    try:
+        connection.sendall(_pack(payload))
+        return True
+    except (OSError, TransportError):
+        return False
+
+
+def _posix_connection(connection: socket.socket, handler, peer: Peer) -> bool:
+    try:
+        connection.settimeout(_FRAME_TIMEOUT_SECONDS)
+        size = _frame_size(_recv_exact(connection, _HEADER.size))
+        payload = _unpack(_recv_exact(connection, size))
+    except TransportError:
+        return _safe_send(connection, {"ok": False, "code": "BAD_REQUEST"})
+    return _safe_send(connection, _dispatch(handler, payload, peer))
+
+
+def _posix_serve(name: str, handler, stop, max_requests: int | None) -> None:
+    path = name
+    try:
+        os.unlink(path)
+    except OSError as exc:
+        if exc.errno != errno.ENOENT:
+            raise TransportError("bind", f"stale endpoint not removable: {exc}") from exc
+    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    served = 0
+    try:
+        try:
+            server.bind(path)
+        except OSError as exc:
+            raise TransportError("bind", str(exc)) from exc
+        os.chmod(path, 0o600)
+        server.listen(64)
+        server.settimeout(_ACCEPT_TIMEOUT_SECONDS)
+        while not stop.is_set() and (max_requests is None or served < max_requests):
+            try:
+                connection, _ = server.accept()
+            except socket.timeout:
+                continue
+            except OSError:
+                if stop.is_set():
+                    break
+                continue
+            try:
+                if _posix_connection(connection, handler, _posix_peer(connection)):
+                    served += 1
+            finally:
+                connection.close()
+    finally:
+        server.close()
+        try:
+            os.unlink(path)
+        except OSError:
+            pass
+
+
+def _posix_request(name: str, payload: dict, timeout: float) -> dict:
+    connection = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    connection.settimeout(timeout)
+    try:
+        try:
+            connection.connect(name)
+        except (FileNotFoundError, ConnectionRefusedError) as exc:
+            raise TransportError("absent", str(exc)) from exc
+        except socket.timeout as exc:
+            raise TransportError("timeout", "connect timed out") from exc
+        except OSError as exc:
+            raise TransportError("absent", str(exc)) from exc
+        try:
+            connection.sendall(_pack(payload))
+        except (OSError, TransportError) as exc:
+            raise TransportError("io", str(exc)) from exc
+        size = _frame_size(_recv_exact(connection, _HEADER.size))
+        return _unpack(_recv_exact(connection, size))
+    finally:
+        connection.close()
+
+
+# --------------------------------------------------------------- surface
+
+
+def serve(
+    name: str,
+    handler: Callable[[dict, Peer], dict],
+    *,
+    stop: threading.Event,
+    max_requests: int | None = None,
+) -> None:
+    """Answer request frames on `name` until `stop` is set.
+
+    One connection carries exactly one request and exactly one response; a
+    malformed frame is answered with `BAD_REQUEST` and the loop continues, so no
+    client can take the service down by misbehaving.
+    """
+    if not available():
+        raise TransportError("unsupported", "this platform cannot serve a local endpoint")
+    if IS_WINDOWS:
+        _win_serve(name, handler, stop, max_requests)
+    else:
+        _posix_serve(name, handler, stop, max_requests)
+
+
+def request(name: str, payload: dict, *, timeout: float = 5.0) -> dict:
+    """Send one request frame to `name` and return the one response frame."""
+    if not available():
+        raise TransportError("unsupported", "this platform cannot connect a local endpoint")
+    if IS_WINDOWS:
+        return _win_request(name, payload, timeout)
+    return _posix_request(name, payload, timeout)
diff --git a/tools/saipen_engine/host_integration.py b/tools/saipen_engine/host_integration.py
new file mode 100644
index 00000000..de1e2a69
--- /dev/null
+++ b/tools/saipen_engine/host_integration.py
@@ -0,0 +1,976 @@
+"""HOST-INTEGRATION-01: one state model, one doctor and one repair for hosts.
+
+Defect class: host integration was a scatter of booleans and error strings, and
+they disagreed in front of the operator. The injector printed "provenance
+verified" and the launcher answered `CANONICAL_RUNTIME_SOURCE_UNPROVEN` a minute
+later; a hook being present was read as the host being healthy; a marker being
+present was read as admission being mechanical; the one host with a
+prompt-blocking hook had no supported way back when that hook blocked. Each
+surface was locally right, and nobody could say what state a host was in.
+
+This module says it, from one place:
+
+* `capability_contract` -- what each registered host CAN do, read from the
+  adapter registry and from nowhere else: its install surfaces, what it can
+  intercept, where its host authority comes from, whether admission can be
+  mechanical there, how it is launched and how it recovers. A cell the registry
+  does not declare is reported as undeclared, never inferred from a file.
+* `observe` / `derive_state` -- what each host IS right now, as one of nine
+  states with the facts that produced it. Installed, fresh, healthy and
+  verified are four separate facts and are never folded into each other.
+* `doctor` -- the read-only view. It writes nothing and starts nothing.
+* `repair` -- the one operator entry point. It reinstalls stale or broken host
+  integrations through the canonical installer, restarts an authority service
+  left over from another generation, and reports what still needs a person. It
+  never touches a project.
+* `mode` -- show or set the admission policy.
+
+States (the first that applies):
+
+    UNINSTALLED           SAIPEN is not installed for this host
+    INSTALLING            an installation is staged and not yet activated
+    BROKEN                an installed surface cannot run or cannot be read
+    STALE_RUNTIME         installed bytes are not the canonical generation
+    RECOVERING            the last prompt recovered the authority service
+    AUTHORITY_UNAVAILABLE installed and current, the last prompt found no
+                          provable host authority
+    DEGRADED_UNVERIFIED   the last prompt proceeded UNVERIFIED for another reason
+    INSTALLED_UNVERIFIED  installed and current; no health evidence yet, or the
+                          host exposes no channel that could give any
+    HEALTHY_VERIFIED      installed, current, and the last prompt was ADMITTED
+                          by the separated authority
+
+`HEALTHY_VERIFIED` is only ever derived from a recorded ADMITTED prompt that is
+newer than the installed hook. A host without an evidence channel can be
+installed and current forever and is still reported `INSTALLED_UNVERIFIED`:
+that is the truth about what SAIPEN can see there, not a fault to repair.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+from . import host_taxonomy as taxonomy
+
+STATE_UNINSTALLED = "UNINSTALLED"
+STATE_INSTALLING = "INSTALLING"
+STATE_INSTALLED_UNVERIFIED = "INSTALLED_UNVERIFIED"
+STATE_HEALTHY_VERIFIED = "HEALTHY_VERIFIED"
+STATE_RECOVERING = "RECOVERING"
+STATE_DEGRADED_UNVERIFIED = "DEGRADED_UNVERIFIED"
+STATE_STALE_RUNTIME = "STALE_RUNTIME"
+STATE_AUTHORITY_UNAVAILABLE = "AUTHORITY_UNAVAILABLE"
+STATE_BROKEN = "BROKEN"
+STATES = (
+    STATE_UNINSTALLED,
+    STATE_INSTALLING,
+    STATE_INSTALLED_UNVERIFIED,
+    STATE_HEALTHY_VERIFIED,
+    STATE_RECOVERING,
+    STATE_DEGRADED_UNVERIFIED,
+    STATE_STALE_RUNTIME,
+    STATE_AUTHORITY_UNAVAILABLE,
+    STATE_BROKEN,
+)
+#: States `repair` acts on. Everything else is either fine or not SAIPEN's to fix.
+REPAIRABLE = (STATE_BROKEN, STATE_STALE_RUNTIME, STATE_INSTALLING)
+
+#: What the registry may declare for how a host recovers and degrades.
+RECOVERY_AUTHORITY = "AUTHORITY_RESTART_THEN_DEGRADE"
+RECOVERY_PRELAUNCH = "PRELAUNCH_RESYNC"
+RECOVERY_NONE = "NONE"
+DEGRADED_DEFAULT = "DEGRADED_ALLOWED_DEFAULT"
+DEGRADED_NOT_APPLICABLE = "NOT_APPLICABLE"
+LAUNCH_NATIVE = "NATIVE"
+LAUNCH_NATIVE_OR_LAUNCHER = "NATIVE_OR_OPTIONAL_LAUNCHER"
+
+UNDECLARED = "UNDECLARED"
+#: A health record older than this is history, not the host's current state.
+HEALTH_FRESH_SECONDS = 7 * 24 * 3600
+#: Registry cells every first-class host must declare (no unexplained cell).
+CONTRACT_FIELDS = (
+    "install_surfaces",
+    "tool_interception",
+    "prompt_interception",
+    "response_interception",
+    "host_authority_source",
+    "separated_authority",
+    "mechanical_admission",
+    "launch",
+    "auto_recovery",
+    "degraded_mode",
+)
+
+
+def source_root() -> Path:
+    """The SAIPEN home this module runs from (a clone or an installed runtime)."""
+    return Path(__file__).resolve().parents[2]
+
+
+def load_registry(root: Path | None = None) -> dict:
+    path = (root or source_root()) / "extensions" / "adapters" / "registry.json"
+    return json.loads(path.read_text(encoding="utf-8-sig"))
+
+
+def _expand(surface: object) -> Path | None:
+    """A registry surface as a path on this machine, or None when it names an
+    unset host variable (that host is simply not configured here)."""
+    text = str(surface or "").strip()
+    if not text:
+        return None
+    expanded = os.path.expandvars(os.path.expanduser(text))
+    if expanded.startswith("$"):
+        return None
+    return Path(expanded)
+
+
+def capability_contract(adapter: dict) -> dict:
+    """What this host can do, as the adapter registry declares it.
+
+    Pure projection: every value is a registry field or a fixed function of
+    one. A capability the registry does not state is `UNDECLARED` -- reporting
+    a stronger capability than the registry claims is exactly the defect this
+    contract exists to prevent, and guessing a weaker one hides a real claim.
+    """
+    install = adapter.get("install") if isinstance(adapter.get("install"), dict) else {}
+    launch_executable = adapter.get("launch_executable")
+    launch = {
+        "routine": adapter.get("routine_launch") or UNDECLARED,
+        "mode": LAUNCH_NATIVE_OR_LAUNCHER if launch_executable else LAUNCH_NATIVE,
+        "launcher_command": adapter.get("launch_command"),
+        "executable": launch_executable,
+    }
+    return {
+        "id": adapter.get("id"),
+        "name": adapter.get("name"),
+        "install_surfaces": {
+            key: install.get(key) for key in ("home", "skill", "instruction", "hook", "bespoke")
+            if install.get(key)
+        },
+        "tool_interception": adapter.get("declared_strength") or UNDECLARED,
+        "prompt_interception": adapter.get("pre_output_interception") or UNDECLARED,
+        "response_interception": adapter.get("stop_output_interception") or UNDECLARED,
+        "response_enforcement": adapter.get("response_enforcement") or UNDECLARED,
+        "admission_enforcement": adapter.get("admission_enforcement") or UNDECLARED,
+        "host_authority_source": adapter.get("admission_authority") or "NONE",
+        "separated_authority": bool(adapter.get("admission_authority")),
+        "mechanical_admission": adapter.get("admission_enforcement") == "MECHANICAL",
+        "prompt_blocking": adapter.get("admission_required") is True,
+        "launch": launch,
+        "auto_recovery": adapter.get("auto_recovery") or UNDECLARED,
+        "degraded_mode": adapter.get("degraded_mode") or UNDECLARED,
+    }
+
+
+def contract_gaps(contract: dict) -> list[str]:
+    """Cells of one host's contract that the registry leaves undeclared."""
+    gaps = [key for key in CONTRACT_FIELDS if contract.get(key) in (None, UNDECLARED)]
+    if contract["launch"]["routine"] == UNDECLARED and "launch" not in gaps:
+        gaps.append("launch")
+    return gaps
+
+
+def capability_matrix(root: Path | None = None) -> dict:
+    """host id -> capability contract, for every registered adapter."""
+    registry = load_registry(root)
+    return {
+        str(adapter.get("id")): capability_contract(adapter)
+        for adapter in registry.get("adapters", [])
+        if adapter.get("id")
+    }
+
+
+# --------------------------------------------------------------- observation
+
+
+def health_path(host: str, home: Path | None = None) -> Path:
+    base = Path(home) if home is not None else Path.home()
+    return base / ".saipen" / "health" / f"{host}.json"
+
+
+def read_health(host: str, home: Path | None = None) -> dict | None:
+    """The last outcome the host's own hook recorded, or None. Diagnostics
+    only: nothing decides admission from this file."""
+    try:
+        payload = json.loads(health_path(host, home).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    return payload if isinstance(payload, dict) else None
+
+
+def _mtime(path: Path | None) -> float | None:
+    try:
+        return path.stat().st_mtime if path is not None else None
+    except OSError:
+        return None
+
+
+def _hook_facts(adapter: dict, runtime_root: Path | None, home: Path) -> dict:
+    """The installed blocking hook: present, current, and what it delegates to."""
+    declared = adapter.get("hook_install_surface") or (adapter.get("install") or {}).get("hook")
+    surface = _expand(declared)
+    facts: dict = {
+        "declared": bool(adapter.get("hook_artifact")),
+        "path": str(surface) if surface else None,
+        "installed": bool(surface and surface.is_file()),
+        "status": "absent",
+        "delegated_root": None,
+        "delegated_current": None,
+        "problems": [],
+        "installed_at": _mtime(surface),
+    }
+    if not facts["declared"] or surface is None:
+        facts["status"] = "not-applicable"
+        return facts
+    if not facts["installed"]:
+        return facts
+    checker = runtime_root if runtime_root is not None else source_root()
+    try:
+        if adapter.get("hook_installer"):
+            tools = str(checker / "tools")
+            if tools not in sys.path:
+                sys.path.insert(0, tools)
+            from install_host_guard import install
+
+            result = install(str(adapter["id"]), home, checker, check=True)
+            facts["status"] = "current" if result.get("current") else "stale"
+            facts["delegated_root"] = result.get("saipen_root")
+            facts["delegated_current"] = bool(result.get("root_current"))
+            facts["problems"] = list(result.get("problems") or [])
+            if result.get("style_hook_conflicts"):
+                facts["style_hook_conflicts"] = result["style_hook_conflicts"]
+        else:
+            from .runtime_bootstrap import hook_problems
+
+            facts["problems"] = hook_problems(adapter, checker)
+            facts["status"] = "current" if not facts["problems"] else "stale"
+    except Exception as exc:
+        facts["status"] = "unknown"
+        facts["problems"] = [f"hook-unobservable:{type(exc).__name__}"]
+    return facts
+
+
+def _runtime_facts(
+    adapter: dict,
+    canonical: Path | None,
+    expected: str | None,
+    sharing: tuple[str, ...] = (),
+) -> dict:
+    """The installed runtime copy: present, provable, and current with its source.
+
+    `sharing` names every adapter that declares the SAME runtime directory. One
+    directory carries one installer record, so a record written for a sibling
+    adapter describes this adapter's runtime just as truly.
+    """
+    from .runtime_bootstrap import (
+        PROVENANCE_FILENAME,
+        launcher_problems,
+        marker_problems,
+        read_provenance,
+        surface_diff,
+        surface_fingerprint,
+    )
+
+    install = adapter.get("install") if isinstance(adapter.get("install"), dict) else {}
+    skill = _expand(install.get("skill"))
+    facts: dict = {
+        "declared": bool(install.get("skill")),
+        "path": str(skill) if skill else None,
+        "installed": bool(skill and skill.is_dir()),
+        "generation": None,
+        "expected_generation": expected,
+        "current": None,
+        "diff": [],
+        "launcher_problems": [],
+        "provenance_problems": [],
+        "source": None,
+        "staging": [],
+    }
+    if skill is None or not facts["installed"]:
+        if skill is not None:
+            facts["staging"] = _staging_leftovers(skill)
+        return facts
+    facts["staging"] = _staging_leftovers(skill)
+    facts["generation"] = surface_fingerprint(skill)
+    marker = read_provenance(skill)
+    facts["source"] = marker.get("canonical_source_root") if isinstance(marker, dict) else None
+    facts["marker"] = str(skill / PROVENANCE_FILENAME) if marker is not None else None
+    if canonical is not None:
+        problems = marker_problems(marker, str(adapter.get("id")), canonical, expected)
+        recorded = str((marker or {}).get("adapter_id") or "")
+        if "adapter_id" in problems and recorded in sharing:
+            problems = [item for item in problems if item != "adapter_id"]
+        facts["provenance_problems"] = problems
+        facts["diff"] = surface_diff(canonical, skill, limit=6)
+    facts["launcher_problems"] = launcher_problems(skill)
+    facts["current"] = bool(
+        facts["generation"] is not None
+        and expected is not None
+        and facts["generation"] == expected
+        and not facts["diff"]
+    )
+    return facts
+
+
+def _staging_leftovers(skill: Path) -> list[str]:
+    """Stage or backup directories an interrupted install left beside a home."""
+    try:
+        parent, leaf = skill.parent, skill.name
+        return sorted(
+            item.name
+            for item in parent.iterdir()
+            if item.name.startswith(f".{leaf}.saipen-")
+        )
+    except OSError:
+        return []
+
+
+def authority_facts(home: Path | None = None) -> dict:
+    """The authority service and the admission policy, read without starting
+    anything. `running` False is the ordinary idle state: the service is
+    started by the first prompt that needs it."""
+    from . import host_authority_broker as broker
+    from . import host_authority_client as client
+
+    policy = client.policy(home)
+    live = client.health()
+    facts = {
+        "running": bool(live),
+        "pid": (live or {}).get("pid"),
+        "instance": (live or {}).get("instance"),
+        "generation": (live or {}).get("generation"),
+        "expected_generation": broker.service_generation(),
+        "saipen_root": (live or {}).get("saipen_root"),
+        "endpoint": broker.endpoint_name(),
+        "log": str(broker.log_path()),
+        "identity_supported": _identity_supported(),
+        "mode": policy["mode"],
+        "mode_label": taxonomy.MODE_LABELS[policy["mode"]],
+        "mode_source": policy["source"],
+        "mode_path": policy["path"],
+    }
+    facts["generation_current"] = (
+        None if not live else facts["generation"] == facts["expected_generation"]
+    )
+    if not live:
+        try:
+            status = client._exchange({"op": "ping"}, runtime=None, timeout=client.PING_TIMEOUT)
+            facts["unanswered"] = status[1]
+        except Exception:
+            facts["unanswered"] = None
+    return facts
+
+
+def _identity_supported() -> bool:
+    from . import host_authority_process as proc
+
+    return proc.platform_supported()
+
+
+def observe(adapter: dict, *, home: Path | None = None, canonical: Path | None = None,
+            expected: str | None = None, authority: dict | None = None,
+            sharing: tuple[str, ...] = ()) -> dict:
+    """Every observable fact about one host, with nothing inferred."""
+    base = Path(home) if home is not None else Path.home()
+    contract = capability_contract(adapter)
+    install = adapter.get("install") if isinstance(adapter.get("install"), dict) else {}
+    host_home = _expand(install.get("home"))
+    runtime = _runtime_facts(adapter, canonical, expected, sharing)
+    runtime_root = Path(runtime["path"]) if runtime["installed"] and runtime["path"] else None
+    hook = _hook_facts(adapter, runtime_root, base)
+    instruction = "not-applicable"
+    if install.get("instruction"):
+        target = _expand(install.get("instruction"))
+        if target is None or not target.is_file():
+            instruction = "absent"
+        elif runtime_root is not None:
+            try:
+                tools = str(source_root() / "tools")
+                if tools not in sys.path:
+                    sys.path.insert(0, tools)
+                from autoinject import instruction_status
+
+                instruction = instruction_status(adapter, runtime_root)
+            except Exception:
+                instruction = "unknown"
+        else:
+            instruction = "unknown"
+    health = read_health(str(adapter.get("id")), home)
+    return {
+        "id": adapter.get("id"),
+        "name": adapter.get("name"),
+        "contract": contract,
+        "installable": bool(install),
+        #: A bespoke installer step with no declared runtime directory leaves
+        #: nothing this view can inspect; that is said, never guessed around.
+        "observable": bool(install.get("skill") or adapter.get("hook_artifact")),
+        "host_present": bool(host_home and host_home.is_dir()),
+        "host_home": str(host_home) if host_home else None,
+        "runtime": runtime,
+        "hook": hook,
+        "instruction": instruction,
+        "health": health,
+        "authority": authority if contract["separated_authority"] else None,
+    }
+
+
+def _health_is_current(facts: dict) -> bool:
+    """Is the recorded outcome evidence about THIS installation?"""
+    health = facts.get("health") or {}
+    at = health.get("at")
+    if not isinstance(at, (int, float)):
+        return False
+    if time.time() - at > HEALTH_FRESH_SECONDS:
+        return False
+    installed_at = facts["hook"].get("installed_at")
+    return installed_at is None or at >= installed_at - 1
+
+
+def derive_state(facts: dict) -> tuple[str, list[str], str | None]:
+    """(state, reasons, next action) for one host's observed facts.
+
+    The order is the order of the module docstring: the first state that
+    applies wins, and every state names what was seen, never what was assumed.
+    """
+    runtime, hook = facts["runtime"], facts["hook"]
+    contract = facts["contract"]
+    reasons: list[str] = []
+    if not facts["installable"]:
+        return STATE_UNINSTALLED, ["this host has no installable surface in the registry"], None
+    if not facts["host_present"]:
+        return STATE_UNINSTALLED, ["the host application is not set up on this machine"], None
+    if runtime["staging"] and not runtime["installed"]:
+        return (
+            STATE_INSTALLING,
+            ["an installation was staged and never activated: " + ", ".join(runtime["staging"])],
+            taxonomy.REPAIR,
+        )
+    if not facts.get("observable", True):
+        return (
+            STATE_INSTALLED_UNVERIFIED,
+            [
+                "this host is set up by a bespoke installer step with no declared runtime "
+                "directory; nothing here can be inspected, so nothing is claimed"
+            ],
+            None,
+        )
+    installed_any = runtime["installed"] or hook["installed"]
+    if not installed_any:
+        return STATE_UNINSTALLED, ["SAIPEN is not installed for this host"], taxonomy.REPAIR
+    # ---- BROKEN: something installed cannot run or cannot be read
+    if runtime["declared"] and not runtime["installed"]:
+        reasons.append("the hook is installed but the runtime it needs is missing")
+    elif runtime["installed"] and runtime["generation"] is None:
+        reasons.append("the installed runtime cannot prove any generation (files missing)")
+    if hook["status"] == "unknown":
+        reasons.append("the installed hook cannot be inspected")
+    if hook["declared"] and runtime["installed"] and not hook["installed"]:
+        reasons.append("the runtime is installed but its host hook is missing")
+    if any(str(item).startswith("hook-interpreter-missing") for item in hook["problems"]):
+        reasons.append("the hook names an interpreter that no longer exists")
+    if runtime["launcher_problems"]:
+        reasons.append("installed launcher: " + ", ".join(runtime["launcher_problems"]))
+    if reasons:
+        return STATE_BROKEN, reasons, taxonomy.REPAIR
+    # ---- STALE_RUNTIME: installed bytes are not the canonical generation
+    if runtime["installed"] and runtime["current"] is False:
+        names = ", ".join(runtime["diff"][:3]) or "generation differs"
+        reasons.append(f"installed runtime is not the source generation ({names})")
+    if runtime["provenance_problems"]:
+        reasons.append("installer record: " + ", ".join(runtime["provenance_problems"]))
+    if hook["declared"] and hook["status"] == "stale":
+        reasons.append(
+            "host hook is not the installed generation"
+            + (": " + ", ".join(str(item) for item in hook["problems"]) if hook["problems"] else "")
+        )
+    if facts["instruction"] in ("stale", "absent"):
+        reasons.append(f"instruction block is {facts['instruction']}")
+    if runtime["staging"]:
+        reasons.append("an interrupted installation left: " + ", ".join(runtime["staging"]))
+    authority = facts.get("authority") or {}
+    if authority.get("running") and authority.get("generation_current") is False:
+        reasons.append("the running authority service is an older generation")
+    if reasons:
+        return STATE_STALE_RUNTIME, reasons, taxonomy.REPAIR
+    # ---- installed and current: what does the host's own evidence say?
+    if not contract["mechanical_admission"]:
+        return (
+            STATE_INSTALLED_UNVERIFIED,
+            [
+                "installed and current; this host exposes no channel through which "
+                "SAIPEN could verify a session, so nothing more can be claimed"
+            ],
+            None,
+        )
+    if authority and not authority.get("identity_supported"):
+        return (
+            STATE_AUTHORITY_UNAVAILABLE,
+            ["this platform does not report process identity; admission cannot be mechanical"],
+            None,
+        )
+    health = facts.get("health") or {}
+    if not _health_is_current(facts):
+        return (
+            STATE_INSTALLED_UNVERIFIED,
+            ["installed and current; no prompt has been observed through this installation yet"],
+            None,
+        )
+    outcome = str(health.get("state") or "")
+    code = str(health.get("code") or "")
+    if outcome == "ADMITTED":
+        return STATE_HEALTHY_VERIFIED, ["the last prompt was ADMITTED by the host authority"], None
+    if outcome in ("BLOCKED", "REFUSED"):
+        entry = taxonomy.get(code) if taxonomy.known(code) else None
+        return (
+            STATE_BROKEN,
+            [f"the last prompt was blocked ({code or 'unclassified'})"],
+            entry.operator_action if entry else taxonomy.REPAIR,
+        )
+    entry = taxonomy.get(code) if taxonomy.known(code) else None
+    action = entry.operator_action if entry and entry.operator_action != "none" else taxonomy.DOCTOR
+    summary = entry.summary if entry else "the last prompt proceeded unverified"
+    if entry is not None and entry.family == taxonomy.FAMILY_AUTHORITY:
+        if authority.get("running") and code in ("AUTHORITY_UNREACHABLE", "AUTHORITY_FAULT"):
+            return (
+                STATE_RECOVERING,
+                [f"{summary} ({code}); the authority service is answering again"],
+                None,
+            )
+        return STATE_AUTHORITY_UNAVAILABLE, [f"{summary} ({code})"], action
+    return STATE_DEGRADED_UNVERIFIED, [f"{summary} ({code or 'unclassified'})"], action
+
+
+def effective_admission(facts: dict, state: str) -> str:
+    """The admission strength this host has RIGHT NOW, never the declared one."""
+    contract = facts["contract"]
+    if state in (STATE_UNINSTALLED, STATE_INSTALLING):
+        return "NONE"
+    if not contract["mechanical_admission"]:
+        return str(contract["admission_enforcement"])
+    if state == STATE_HEALTHY_VERIFIED:
+        return "MECHANICAL"
+    mode = ((facts.get("authority") or {}).get("mode")) or taxonomy.DEFAULT_MODE
+    if state == STATE_INSTALLED_UNVERIFIED:
+        return "MECHANICAL_UNOBSERVED"
+    return "DEGRADED_UNVERIFIED" if mode == taxonomy.MODE_DEGRADED else "BLOCKING_STRICT"
+
+
+def effective_response(facts: dict, state: str) -> str:
+    contract = facts["contract"]
+    declared = str(contract["response_enforcement"])
+    if state in (STATE_UNINSTALLED, STATE_INSTALLING):
+        return "NONE"
+    if declared == "MECHANICAL" and (
+        facts["hook"]["status"] != "current" or state == STATE_BROKEN
+    ):
+        # A hook that is not current, or whose runtime cannot run, enforces
+        # nothing however the host is declared.
+        return "INACTIVE"
+    return declared
+
+
+def _source_facts() -> dict:
+    """This runtime's own standing: is it a canonical source, an installed
+    runtime of one host, or neither -- and can its source be proven?"""
+    from .runtime_bootstrap import (
+        CanonicalSourceUnproven,
+        canonical_source_root,
+        read_provenance,
+        surface_fingerprint,
+    )
+
+    here = source_root()
+    marker = read_provenance(here)
+    facts: dict = {
+        "home": str(here),
+        "kind": "installed-runtime" if marker is not None else "source-checkout",
+        "adapter": (marker or {}).get("adapter_id") if isinstance(marker, dict) else None,
+        "canonical": None,
+        "generation": None,
+        "proven": False,
+        "detail": None,
+        "version": None,
+    }
+    try:
+        facts["version"] = (here / "VERSION").read_text(encoding="utf-8-sig").strip()
+    except OSError:
+        facts["version"] = None
+    try:
+        canonical = canonical_source_root(here)
+    except CanonicalSourceUnproven as exc:
+        facts["detail"] = str(exc)
+        return facts
+    facts["canonical"] = str(canonical)
+    facts["generation"] = surface_fingerprint(canonical)
+    facts["proven"] = facts["generation"] is not None
+    if not facts["proven"]:
+        facts["detail"] = "the canonical source cannot prove its shipped surface"
+    return facts
+
+
+def doctor(*, home: Path | None = None, only: str | None = None) -> dict:
+    """The read-only state of every registered host. Writes and starts nothing.
+
+    `ok` is False only when an installed host is BROKEN or the source this
+    runtime depends on cannot be proven: stale, degraded and unverified hosts
+    are working hosts with an action, not a failed doctor.
+    """
+    from .runtime_surface import identity_session
+
+    with identity_session():
+        source = _source_facts()
+        canonical = Path(source["canonical"]) if source["canonical"] else None
+        authority = authority_facts(home)
+        registry = load_registry(canonical or source_root())
+        by_runtime: dict[str, list[str]] = {}
+        for adapter in registry.get("adapters", []):
+            plan = adapter.get("install") if isinstance(adapter.get("install"), dict) else {}
+            target = _expand(plan.get("skill"))
+            if target is not None and adapter.get("id"):
+                key = os.path.normcase(str(target))
+                by_runtime.setdefault(key, []).append(str(adapter["id"]))
+        hosts: list[dict] = []
+        for adapter in registry.get("adapters", []):
+            host_id = str(adapter.get("id") or "")
+            if not host_id or (only and host_id != only):
+                continue
+            plan = adapter.get("install") if isinstance(adapter.get("install"), dict) else {}
+            target = _expand(plan.get("skill"))
+            sharing = tuple(by_runtime.get(os.path.normcase(str(target)), ())) if target else ()
+            facts = observe(
+                adapter,
+                home=home,
+                canonical=canonical,
+                expected=source["generation"],
+                authority=authority,
+                sharing=sharing,
+            )
+            state, reasons, action = derive_state(facts)
+            hosts.append(
+                {
+                    "id": host_id,
+                    "name": facts["name"],
+                    "state": state,
+                    "reasons": reasons,
+                    "action": action,
+                    "installed": facts["runtime"]["installed"] or facts["hook"]["installed"],
+                    "host_present": facts["host_present"],
+                    "runtime": (
+                        "absent"
+                        if not facts["runtime"]["installed"]
+                        else "current" if facts["runtime"]["current"] else "stale"
+                    ),
+                    "hook": facts["hook"]["status"],
+                    "instruction": facts["instruction"],
+                    "admission": effective_admission(facts, state),
+                    "response_enforcement": effective_response(facts, state),
+                    "last_health": facts["health"],
+                    "recoverable": state in REPAIRABLE
+                    or state in (STATE_AUTHORITY_UNAVAILABLE, STATE_DEGRADED_UNVERIFIED),
+                    "contract": facts["contract"],
+                    "contract_gaps": contract_gaps(facts["contract"]),
+                    "facts": {
+                        "runtime": facts["runtime"],
+                        "hook": facts["hook"],
+                        "host_home": facts["host_home"],
+                    },
+                }
+            )
+    broken = [item["id"] for item in hosts if item["state"] == STATE_BROKEN]
+    actionable = [item["id"] for item in hosts if item["action"]]
+    problems: list[dict] = []
+    if not source["proven"]:
+        problems.append(
+            taxonomy.problem(
+                "source", "CANONICAL_RUNTIME_SOURCE_UNPROVEN", str(source["detail"] or "")
+            )
+        )
+    if authority["mode_source"] == "invalid":
+        problems.append(
+            taxonomy.problem(
+                "policy",
+                "POLICY_INVALID",
+                f"{authority['mode_path']} is unreadable or names no recognized mode",
+            )
+        )
+    return {
+        "ok": not broken and source["proven"],
+        "code": "HOST_DOCTOR",
+        "source": source,
+        "policy": {
+            "mode": authority["mode"],
+            "label": authority["mode_label"],
+            "source": authority["mode_source"],
+            "path": authority["mode_path"],
+        },
+        "authority": authority,
+        "hosts": hosts,
+        "broken": broken,
+        "needs_action": actionable,
+        "problems": problems,
+        "next_action": (
+            taxonomy.REPAIR
+            if any(item["state"] in REPAIRABLE and item["host_present"] for item in hosts)
+            else next((item["action"] for item in hosts if item["action"]), None)
+        ),
+    }
+
+
+# -------------------------------------------------------------------- repair
+
+
+def _stop_authority() -> dict:
+    from . import host_authority_client as client
+
+    report = client.retire_service()
+    return {"stopped": bool(report.get("retired")), "detail": str(report.get("detail") or "")}
+
+
+def _start_authority(runtime_root: Path) -> dict:
+    """Start the authority service FROM the installed runtime a hook delegates
+    to, so the service and the hook it serves are one generation."""
+    entry = Path(runtime_root) / "tools" / "authority_service.py"
+    if not entry.is_file():
+        return {"ok": False, "detail": f"service entry missing: {entry}"}
+    try:
+        proc = subprocess.run(
+            [sys.executable, str(entry), "start", "--force", "--saipen-root", str(runtime_root),
+             "--json"],
+            capture_output=True,
+            timeout=30,
+            creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0) if os.name == "nt" else 0,
+        )
+        payload = json.loads((proc.stdout or b"{}").decode("utf-8", errors="replace") or "{}")
+    except (OSError, ValueError, subprocess.SubprocessError) as exc:
+        return {"ok": False, "detail": f"{type(exc).__name__}: {exc}"}
+    return payload if isinstance(payload, dict) else {"ok": False, "detail": "unreadable answer"}
+
+
+def repair(*, home: Path | None = None, only: str | None = None) -> dict:
+    """Bring installed hosts back to the canonical generation. One entry point.
+
+    For every installed host that is BROKEN, STALE_RUNTIME or half-installed it
+    runs the ONE canonical installer, host-scoped; the installer stages,
+    self-tests and only then activates a hook, so a repair that fails leaves
+    the previous generation in place. An authority service left over from
+    another generation is retired and the installed one is started. Hosts that
+    are not installed are left alone, and no project is read or written.
+    """
+    from .runtime_bootstrap import CanonicalSourceUnproven, _invoke_installer, canonical_source_root
+
+    before = doctor(home=home, only=only)
+    steps: list[dict] = []
+    try:
+        canonical = canonical_source_root(source_root())
+    except CanonicalSourceUnproven as exc:
+        canonical = None
+        steps.append(
+            {"step": "source", "ok": False, "code": "CANONICAL_RUNTIME_SOURCE_UNPROVEN",
+             "detail": str(exc)}
+        )
+    restart_authority = False
+    for item in before["hosts"]:
+        if item["state"] not in REPAIRABLE or not item["host_present"]:
+            continue
+        if canonical is None:
+            steps.append({"step": f"install:{item['id']}", "ok": False,
+                          "code": "CANONICAL_RUNTIME_SOURCE_UNPROVEN",
+                          "detail": "no proven source to install from"})
+            continue
+        proc = _invoke_installer(canonical, item["id"])
+        rc = proc.returncode if proc is not None else None
+        tail = "\n".join(((proc.stdout or "") if proc is not None else "").splitlines()[-6:])
+        steps.append(
+            {
+                "step": f"install:{item['id']}",
+                "ok": rc == 0,
+                "code": "INSTALLED" if rc == 0 else "BOOTSTRAP_INSTALL_FAILED",
+                "installer_rc": rc,
+                "detail": tail[-600:],
+            }
+        )
+        if item["contract"]["separated_authority"]:
+            restart_authority = True
+    authority = before["authority"]
+    if authority.get("running") and authority.get("generation_current") is False:
+        restart_authority = True
+    mechanical = [
+        item for item in before["hosts"]
+        if item["contract"]["separated_authority"] and item["host_present"]
+    ]
+    if restart_authority and authority.get("running"):
+        steps.append({"step": "authority:stop", "ok": True, **_stop_authority()})
+    after = doctor(home=home, only=only)
+    for item in after["hosts"]:
+        if not item["contract"]["separated_authority"] or item["state"] in (
+            STATE_UNINSTALLED, STATE_BROKEN, STATE_INSTALLING
+        ):
+            continue
+        if after["authority"].get("running"):
+            break
+        root = item["facts"]["hook"].get("delegated_root") or item["facts"]["runtime"].get("path")
+        if not root:
+            continue
+        started = _start_authority(Path(root))
+        steps.append(
+            {
+                "step": "authority:start",
+                "ok": bool(started.get("ok")),
+                "code": "AUTHORITY_STARTED" if started.get("ok") else "AUTHORITY_UNREACHABLE",
+                "detail": str(started.get("detail") or started.get("state") or ""),
+            }
+        )
+        after = doctor(home=home, only=only)
+        break
+    remaining = [
+        {"id": item["id"], "state": item["state"], "action": item["action"],
+         "reasons": item["reasons"]}
+        for item in after["hosts"]
+        if item["state"] in REPAIRABLE and item["host_present"]
+    ]
+    failed = [step for step in steps if not step.get("ok")]
+    return {
+        **after,
+        "ok": not remaining and not failed and after["ok"],
+        "code": "HOST_REPAIRED" if not remaining and not failed else "REPAIR_INCOMPLETE",
+        "steps": steps,
+        "remaining": remaining,
+        "mechanical_hosts": [item["id"] for item in mechanical],
+    }
+
+
+def mode(value: str | None, *, home: Path | None = None) -> dict:
+    """Show the admission policy, or set it: `strict`, `degraded` (alias
+    `degraded_allowed`), or `default` to remove the operator's choice."""
+    from . import host_authority_client as client
+
+    if value is None:
+        policy = client.policy(home)
+        return {
+            "ok": True,
+            "code": "HOST_MODE",
+            "mode": policy["mode"],
+            "label": taxonomy.MODE_LABELS[policy["mode"]],
+            "source": policy["source"],
+            "path": policy["path"],
+            "default": taxonomy.DEFAULT_MODE,
+        }
+    if str(value).strip().lower() == "default":
+        return client.clear_authority_mode(home)
+    return client.set_authority_mode(value, home)
+
+
+# -------------------------------------------------------------------- render
+
+
+def _cell(text: object, width: int) -> str:
+    value = str(text if text not in (None, "") else "-")
+    return value[: width - 1].ljust(width)
+
+
+def render(report: dict) -> str:
+    """The compact view a person reads. One line per host; the next action is
+    printed only where there is one."""
+    source = report.get("source") or {}
+    policy = report.get("policy") or {}
+    authority = report.get("authority") or {}
+    lines = []
+    standing = "proven" if source.get("proven") else "UNPROVEN"
+    lines.append(
+        f"SAIPEN source  {standing}  {source.get('kind')}  {source.get('version') or '?'}  "
+        f"{source.get('canonical') or source.get('home')}"
+    )
+    lines.append(
+        f"policy         {policy.get('label')} ({policy.get('source')})"
+    )
+    if authority.get("running"):
+        freshness = (
+            "current generation"
+            if authority.get("generation_current")
+            else "ANOTHER GENERATION (restart: saipen host repair)"
+        )
+        pid = authority.get("pid") or "?"
+        lines.append(f"authority      running pid {pid}  {freshness}")
+    else:
+        lines.append("authority      idle (started by the first prompt that needs it)")
+    lines.append("")
+    lines.append(
+        _cell("host", 18) + _cell("state", 23) + _cell("runtime", 9) + _cell("hook", 15)
+        + _cell("admission", 22) + "next action"
+    )
+    for item in report.get("hosts") or []:
+        if not item.get("host_present") and not item.get("installed"):
+            continue
+        lines.append(
+            _cell(item["id"], 18)
+            + _cell(item["state"], 23)
+            + _cell(item["runtime"], 9)
+            + _cell(item["hook"], 15)
+            + _cell(item["admission"], 22)
+            + str(item.get("action") or "-")
+        )
+        if item.get("action") or item["state"] == STATE_BROKEN:
+            for reason in item.get("reasons") or []:
+                lines.append("    " + str(reason)[:150])
+    absent = [
+        item["id"] for item in report.get("hosts") or []
+        if not item.get("host_present") and not item.get("installed")
+    ]
+    if absent:
+        lines.append("")
+        lines.append("not on this machine: " + ", ".join(absent))
+    for step in report.get("steps") or []:
+        mark = "ok" if step.get("ok") else "FAILED"
+        lines.append(f"repair {step.get('step')}: {mark} {step.get('code') or ''}".rstrip())
+    for item in report.get("problems") or []:
+        lines.append(f"problem [{item.get('code')}] {str(item.get('reason') or '')[:160]}")
+    lines.append("")
+    if report.get("code") in ("HOST_REPAIRED", "REPAIR_INCOMPLETE"):
+        lines.append(
+            "repair complete: every installed host is on the canonical generation"
+            if report.get("ok")
+            else "repair incomplete: " + ", ".join(
+                f"{item['id']} {item['state']}" for item in report.get("remaining") or []
+            )
+        )
+    elif report.get("next_action"):
+        lines.append(f"next: {report['next_action']}")
+    else:
+        lines.append("nothing to do")
+    return "\n".join(lines)
+
+
+__all__ = [
+    "CONTRACT_FIELDS",
+    "REPAIRABLE",
+    "STATES",
+    "STATE_AUTHORITY_UNAVAILABLE",
+    "STATE_BROKEN",
+    "STATE_DEGRADED_UNVERIFIED",
+    "STATE_HEALTHY_VERIFIED",
+    "STATE_INSTALLED_UNVERIFIED",
+    "STATE_INSTALLING",
+    "STATE_RECOVERING",
+    "STATE_STALE_RUNTIME",
+    "STATE_UNINSTALLED",
+    "authority_facts",
+    "capability_contract",
+    "capability_matrix",
+    "contract_gaps",
+    "derive_state",
+    "doctor",
+    "effective_admission",
+    "effective_response",
+    "health_path",
+    "mode",
+    "observe",
+    "read_health",
+    "render",
+    "repair",
+    "source_root",
+]

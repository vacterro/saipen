+                .get("goal_authority_transition", {})
+                .get("authorization_sha256")
+                == hashlib.sha256(text.encode("utf-8")).hexdigest()
+            ):
+                return Result(
+                    True,
+                    "GOAL_AUTHORITY_ALREADY_SET",
+                    op_id=old["op_id"],

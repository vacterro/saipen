+def _trip_checkpoint(
+    root: Path,
+    docs: dict,
+    new_log: str,
+    state: dict,
+    *,
+    waves: int,
+    tickets: int,
+    event: int,
+    agent: str,
+    now: str,
+    utc: str,
+    op_id: str,
+) -> tuple[str, dict] | None:
+    """Clear a tripped goal budget in ONE operation, or say a human must decide.
+
+    T-1864 (SRC-296). Reaching a cap counts WORK, never authority: the grant
+    that authorized the first ticket authorizes the twentieth. Writing
+    `WAIT: safety valve ...` there turned a mechanical checkpoint into an
+    operator obligation, and the engine then cleared the very same counters by
+    itself one command later -- so the human was asked to type a command whose
+    only effect was to let the engine do what it already knew how to do.
+
+    The budget itself is NOT removed. It still fires, and the marker below
+    still records that it fired; only the question "who has to be awake for
+    it" changes. `goal_authority.trip_checkpoint` owns that answer and returns
+    None exactly when the budget is the run's ONLY authority -- no persisting
+    grant, no protocol home -- because auto-renewing a bounded grant would
+    fabricate authority the operator never gave.
+
+    Returns (new_log, owned_updates), or None when the caller must write the
+    WAIT. `next_action` is deliberately left alone: the transition that
+    tripped the budget is mid-flight, and its own destination is the correct
+    route (`PHASE REVIEW T-###`), which is strictly better than a generic
+    continue.
+    """
+    from . import goal_authority
+
+    prospective = {**state, "goal_waves": waves, "goal_tickets": tickets}
+    decision = goal_authority.trip_checkpoint(root, prospective)
+    if decision is None:
+        return None
+    marker_event, marker_line = _producer_event(
+        docs,
+        event,
+        "DEC",
+        f"goal checkpoint -- goal_waves {waves}->0, goal_tickets {tickets}->0; "
+        f"authority_source {decision['source']}; "
+        f"budget reached, continuing under the same grant",
+        ticket=None,
+        agent=agent,
+        now=now,
+        op_id=op_id,
+    )
+    return (
+        new_log.rstrip("\n") + "\n" + marker_line + "\n",
+        {
+            "goal_waves": 0,
+            "goal_tickets": 0,
+            "last_event": marker_event,
+            "updated": utc,
+        },
+    )
+
+

          "category": "Language",
          "text": "Default user-facing explanations to Russian unless the current request specifies another language.",
          "id": "ce2c6a40c5bb",
          "source": "global"
        },
        {
          "category": "Language",
          "text": "Use English for source code, identifiers, filenames, API names, schema keys, protocol tokens, and code comments unless the project explicitly requires another language.",
          "id": "f0706c4fb135",
          "source": "global"
        },
        {
          "category": "Language",
          "text": "Estonian may be used when explicitly requested or when producing Estonia-specific user-facing material.",
          "id": "bedaea94084c",
          "source": "global"
        },
        {
          "category": "Language",
          "text": "Japanese may be used when explicitly requested.",
          "id": "2ee99b283a3b",
          "source": "global"
        },
        {
          "category": "Language",
          "text": "Preserve exact technical terminology when translating it is likely to create ambiguity.",
          "id": "188448ab0d9d",
          "source": "global"
        },
        {
          "category": "Language",
          "text": "Do not translate literal commands, identifiers, paths, configuration keys, error tokens, or protocol state names unless a localized form is explicitly defined.",
          "id": "7648e8a8ff23",
          "source": "global"
        },
        {
          "category": "Language",
          "text": "When translation is requested, preserve meaning and operational precision rather than translating mechanically word-for-word.",
          "id": "6ba3d7329aeb",
          "source": "global"
        },
        {
          "category": "Localization",
          "text": "Treat localization as product behavior, not simple string substitution.",
          "id": "a4641c0db75b",
          "source": "global"
        },
        {
          "category": "Localization",
          "text": "Preserve placeholders, variables, formatting tokens, command names, paths, and machine-readable identifiers exactly unless the format explicitly requires localization.",
          "id": "82324dd5e42c",
          "source": "global"
        },
        {
          "category": "Localization",
          "text": "Prefer natural target-language phrasing over awkward literal translation.",
          "id": "99c469b70599",
          "source": "global"
        },
        {
          "category": "Localization",
          "text": "Preserve the technical meaning, severity, and actionability of warnings and error messages across languages.",
          "id": "93178165499d",
          "source": "global"
        },
        {
          "category": "Localization",
          "text": "Do not invent localized terminology for protocol tokens that are intentionally canonical.",
          "id": "d68a91df16f9",
          "source": "global"
        },
        {
          "category": "Localization",
          "text": "Keep multilingual documentation structurally aligned enough that important commands and behavioral contracts do not silently disappear from one language.",
          "id": "c9b8b2c8a764",
          "source": "global"
        },
        {
          "category": "Localization",
          "text": "When localized documentation diverges from the canonical implementation, correct the divergence rather than preserving it for consistency with old text.",
          "id": "6e31ad9edf47",
          "source": "global"
        }
      ]
    }

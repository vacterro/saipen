{
  "clauses": {
    "SRC-183:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u0417\u0430\u043e\u0434\u043d\u043e, \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u044c \u043f\u043e\u0436\u0430\u043b\u0443\u0439\u0441\u0442\u0430 \u0442\u043e\u0433\u0434\u0430, \u0433\u0434\u0435 \u044d\u0442\u043e \u0438\u043c\u0435\u0435\u0442 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 \u0440\u0430\u0441\u043a\u0438\u0434\u0430\u0439 \u0442\u043e\u0433\u0434\u0430 \u043a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u0433\u043e\u0442\u043e\u0432\u043e \u044d\u0442\u043e\u0442 \u043c\u0435\u0445\u0430\u043d\u0438\u0437\u043c \u0438 \u0435\u0441\u043b\u0438 \u043e\u043d\u043e \u044d\u0442\u043e\u0433\u043e \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0442\u043e\u0433\u0434\u0430 \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u043f\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0443 SAITULS; AUDAPACK \u0438 \u0432\u0435\u0437\u0434\u0435 \u0432 \u043e\u0431\u0449\u0435\u043c \u0433\u0434\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u044d\u0442\u043e\u0442 \u0437\u0430\u043f\u0443\u0441\u043a \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u043e\u0431\u043b\u0435\u043c \u0447\u0442\u043e\u0431\u044b \u0430\u0433\u0435\u043d\u0442\u044b \u043f\u043e\u0434\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043b\u0438 \u0441\u043e \u0441\u0432\u043e\u0435\u0439 \u0441\u0442\u043e\u0440\u043e\u043d\u044b. \u041a \u043f\u0440\u0438\u043c\u0435\u0440\u0443 SAITULS \u0442\u0430\u043c \u0437\u0430\u043f\u0443\u0441\u043a \u0438\u0437 \u043a\u043e\u043d\u0442\u0435\u043a\u0442\u0441\u043d\u043e\u0433\u043e \u043c\u0435\u043d\u044e \u0438 \u0441\u0430\u043c\u043e\u0433\u043e saituls, \u0430 \u0432 AUDAPACK \u0442\u0430\u043c \u0437\u0430\u043f\u0443\u0441\u043a \u0442\u043e\u0436\u0435 \u0435\u0441\u0442\u044c \u0441\u0432\u043e\u0439, \u044d\u0442\u043e \u0442\u0430\u043a \u043d\u0430\u0432\u0441\u043a\u0438\u043a\u0434\u043a\u0443 \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u0432 \u043e\u0431\u0449\u0435\u043c \u043f\u043e\u0442\u043e\u043c (\u0435\u0441\u043b\u0438 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043a\u043e\u043d\u0435\u0447\u043d\u043e)"
    }

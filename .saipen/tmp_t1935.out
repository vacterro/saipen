############ tools/test_t1935_zaicode_hook_ownership.py
"""T-1935: the ZAICODE guard hook needs an owner that DEPLOYS and SEES it.

MEASURED 26.10.26 while closing T-1934. ZAICODE was the only adapter that ships
a `hook_artifact` while declaring neither `install.hook` nor `hook_installer`.
Two consequences, both reproduced in a throwaway home with `USERPROFILE`, `HOME`
and `ZAICODE_HOME` redirected:

  * `bootstrap/inject.ps1` and `bootstrap/inject.sh` run their hook step only
    under `install.hook`, so the canonical injector deployed ZAICODE's skill and
    instruction block and silently skipped its guard hook. The T-1933 repair
    reached the live surface only because it was installed by hand -- which is
    exactly how the 20-ticket safety valve kept tripping after a green ticket;
  * `runtime_bootstrap.hook_problems` returns `[]` when `install.hook` is
    absent, so `saipen runtime --prelaunch` and `saipen host doctor` -- the two
    observers wired to the prelaunch gate -- called a drifted ZAICODE hook
    current. The same drifted bytes answered `[]` for the shipped entry and
    `["hook-stale"]` once `install.hook` was added.

The repair is a registry declaration, not a deployment-topology change: ZAICODE
already executes `~/.zcode/hooks/saipen-guard.py` (its `cli/config.json` names
it), so `hook_install_surface` always described that file. These tests pin the
declaration, the split between the isolated home and the profile hook surface,
and both observers.

Every fixture is a temp directory. Nothing here reads or writes the operator's
real `~/.zcode`.
"""

from __future__ import annotations

import json
import os
import shutil
import sys
import tempfile
import unittest
from pathlib import Path
from unittest import mock

TOOLS = Path(__file__).resolve().parent
REPO = TOOLS.parent
if str(TOOLS) not in sys.path:
    sys.path.insert(0, str(TOOLS))

import install_host_guard as G  # noqa: E402
from saipen_engine import runtime_bootstrap as RB  # noqa: E402
from test_hermetic_env import isolate_host_session  # noqa: E402

REGISTRY = REPO / "extensions" / "adapters" / "registry.json"
#: The host-side variables that select a ZAICODE profile. All three have to be
#: redirected: `install.hook` expands `~`, the skill expands `$ZAICODE_HOME`,
#: and an inherited CLAUDE_CONFIG_DIR would move the claude adapter's surfaces.
ZAICODE_CARRIERS = ("USERPROFILE", "HOME", "ZAICODE_HOME", "CLAUDE_CONFIG_DIR")


def setUpModule() -> None:
    isolate_host_session()


def _adapter() -> dict:
    registry = json.loads(REGISTRY.read_text(encoding="utf-8-sig"))
    return next(entry for entry in registry["adapters"] if entry["id"] == "zaicode")


class Redirected:
    """A throwaway operator profile plus a throwaway isolated ZAICODE home."""

    def __init__(self) -> None:
        self.base = Path(tempfile.mkdtemp(prefix="t1935-zaicode-"))
        self.profile = self.base / "profile"
        self.profile.mkdir()
        self.zaicode_home = self.base / "zhome"
        (self.zaicode_home / ".zcode").mkdir(parents=True)
        self._saved: dict[str, str | None] = {}

    def __enter__(self) -> "Redirected":
        for name in ZAICODE_CARRIERS:
            self._saved[name] = os.environ.get(name)
        os.environ["USERPROFILE"] = os.environ["HOME"] = str(self.profile)
        os.environ["ZAICODE_HOME"] = str(self.zaicode_home)
        os.environ.pop("CLAUDE_CONFIG_DIR", None)
        return self

    def __exit__(self, *exc_info) -> None:
        for name, value in self._saved.items():
            if value is None:
                os.environ.pop(name, None)
            else:
                os.environ[name] = value
        shutil.rmtree(self.base, ignore_errors=True)

    @property
    def hook(self) -> Path:
        return self.profile / ".zcode" / "hooks" / "saipen-guard.py"


class DeclarationTests(unittest.TestCase):
    def test_the_adapter_declares_a_deployer_and_a_hook_freshness_surface(self):
        adapter = _adapter()
        # Before T-1935 both of these were absent, which is what made the hook
        # undeployable and unobservable at once.
        self.assertEqual(adapter["hook_installer"], "tools/install_host_guard.py")
        self.assertTrue((REPO / adapter["hook_installer"]).is_file())
        self.assertIn("hook", adapter["freshness_surfaces"])
        self.assertIn("hook", adapter["install"])
        # The declared surface and the executable surface are the same file.
        self.assertEqual(adapter["install"]["hook"], adapter["hook_install_surface"])

    def test_the_skill_and_instruction_surfaces_stay_in_the_isolated_home(self):
        adapter = _adapter()
        for key in ("home", "skill", "instruction"):
            with self.subTest(key=key):
                self.assertTrue(
                    adapter["install"][key].startswith("$ZAICODE_HOME/"),
                    adapter["install"][key],
                )


class DeployTests(unittest.TestCase):
    def test_the_canonical_installer_puts_the_shipped_hook_on_the_profile(self):
        with Redirected() as world:
            result = G.install("zaicode", world.profile, REPO)
            self.assertTrue(result["current"], result)
            self.assertEqual(result["problems"], [], result)
            self.assertEqual(
                world.hook.read_bytes(),
                (REPO / _adapter()["hook_artifact"]).read_bytes(),
                "the installed hook must be the shipped bytes",
            )

    def test_the_injector_shell_hook_step_reaches_zaicode(self):
        """The registry row is what the injector's loop reads.

        The full injector is exercised by `test_t1504_zaicode_adapter`; what
        this pins is the exact predicate that skipped ZAICODE before the
        repair, read from the shipped registry rather than a fixture copy.
        """
        install = _adapter().get("install") or {}
        self.assertIn("hook", install, "inject.ps1/inject.sh gate on install.hook")
        self.assertTrue(install["hook"], install["hook"])


class ObserverTests(unitt
############ tools/test_t1933_zaicode_goal_seal.py
"""T-1933/SRC-339: the ZAICODE hook must seal the intent the operator declared.

MEASURED defect. `extensions/adapters/zaicode/saipen-guard.py` hardcoded
`action = "continue"` for every prompt. `operator_origin` reserves goal
authority for `action in {"goal", "authorize-goal"}` only, so a ZAICODE
operator could never hold `continuation_authority: operator_persistent`:
`operations.authorize_goal_continuation` refused with "a fresh externally
witnessed operator authorization is required", and the bounded budget tripped
its 20-ticket safety valve into `hard_wait` demanding another manual cc.

The second half is the same constraint T-1859 measured from the other side: the
broker accepts a proof only BELOW the worker that registered it, and the agent's
shell is that worker's SIBLING. A hook that sealed `goal` but left the entry to
the model would mint a proof nothing in the session can verify.

These cases run the REAL hook file in a real subprocess against a recording stub
engine, so they pin which action the hook names and which command it then
spends. The stub stands in for the CLIENT, never the broker: what this suite
decides is the hook's own decision, not the broker's. No claim is made that a
live ZAICODE host delivered these events (that stays UNVERIFIED: no receipt).
"""

from __future__ import annotations

import json
import subprocess
import sys
import tempfile
import textwrap
import unittest
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
REPO = TOOLS.parent
HOOK = REPO / "extensions" / "adapters" / "zaicode" / "saipen-guard.py"

BOOTSTRAP = (
    "import os,runpy,sys;a=sys.argv[1];sys.argv=sys.argv[1:];"
    "os.path.isfile(a) and runpy.run_path(a,run_name=__name__)"
)

#: A stand-in engine that records the action the hook asked to seal and the
#: argv of any engine the hook then started.
STUB_CLIENT = textwrap.dedent(
    '''
    import json, os

    RECORD = os.path.join(os.path.dirname(__file__), "record.json")


    def _append(row):
        rows = []
        if os.path.isfile(RECORD):
            with open(RECORD, encoding="utf-8") as handle:
                rows = json.load(handle)
        rows.append(row)
        with open(RECORD, "w", encoding="utf-8") as handle:
            json.dump(rows, handle)


    def issue_operator_origin(**kwargs):
        _append({"op": "issue", "action": kwargs.get("action"),
                 "request_text": kwargs.get("request_text"),
                 "event_id": kwargs.get("event_id"),
                 "session": kwargs.get("session"), "host": kwargs.get("host")})
        proof = {"schema": 1, "kind": "operator-origin",
                 "host": kwargs.get("host") or "zaicode", "nonce": "n1",
                 "action": kwargs.get("action") or "continue",
                 "request_digest": "d" * 64, "host_pid": os.getppid()}
        return {"ok": True, "code": None, "proof": proof, "reused": False}


    def register_operator_worker(proof, worker, *, home=None, **kwargs):
        _append({"op": "register", "worker": worker, "own_pid": os.getpid()})
        return {"ok": True, "worker": worker}
    '''
)

#: Records the argv of any command the hook runs below itself.
ENGINE_STUB = textwrap.dedent(
    '''
    import json, os, sys

    RECORD = os.path.join(os.path.dirname(os.path.dirname(__file__)), "engine.json")
    with open(RECORD, "w", encoding="utf-8") as handle:
        json.dump({"argv": sys.argv[1:], "own_pid": os.getpid(),
                   "parent_pid": os.getppid()}, handle)
    print(json.dumps({"ok": True, "code": "GOAL_SET", "ticket": "T-2",
                      "phase": "SCOUT", "next_action": "PHASE SCOUT T-2",
                      "goal_waves": 1, "goal_tickets": 0}, indent=2))
    '''
)

#: An engine that refuses, so the hook must report its exact code rather than
#: claim success from the seal alone.
ENGINE_STUB_REFUSED = textwrap.dedent(
    '''
    import json, sys
    print(json.dumps({"ok": False, "code": "VALIDATION_FAILED",
                      "detail": "refused for the control"}, indent=2))
    '''
)


def build_root(engine: str = ENGINE_STUB) -> tuple[tempfile.TemporaryDirectory, Path]:
    """A throwaway project whose stub engine records what the hook does."""
    holder = tempfile.TemporaryDirectory(prefix="t1933-")
    root = Path(holder.name)
    (root / ".saipen").mkdir(parents=True, exist_ok=True)
    (root / ".saipen" / "STATE.md").write_text(
        "---\nphase: SCOUT\nagent: fixture\ntask: T-1\n"
        "next_action: PHASE SCOUT T-1\nblocker: none\ntransition_from: PLAN\n"
        "saipen_version: 8\nmode: full\nupdated: 2026-10-26T00:00:00Z\n"
        "goal_waves: 0\ngoal_tickets: 0\n"
        "continuation_authority: operator_required\nauthority_until: budget\n"
        "safety_valve_mode: hard_wait\nexecution_intent: goal\n"
        "goal_ingress: goal-1\nauthority_source: E-1\n---\n",
        encoding="utf-8",
    )
    tools = root / "tools"
    engine_pkg = tools / "saipen_engine"
    engine_pkg.mkdir(parents=True)
    (engine_pkg / "__init__.py").write_text("", encoding="utf-8")
    (engine_pkg / "host_authority_client.py").write_text(STUB_CLIENT, encoding="utf-8")
    (engine_pkg / "pending_ingress.py").write_text(
        "import hashlib\n\n\ndef ingress_digest(text):\n"
        "    return hashlib.sha256(text.encode('utf-8')).hexdigest()\n",
        encoding="utf-8",
    )
    (engine_pkg / "operator_task.py").write_text(
        textwrap.dedent(
            '''
            def admit_host_ingress(ingress, root, *, event_session=None):
                return {"ok": True, "ingress_id": "ing-stub",
                        "destination_op": "continue", "sealed": True}
            '''
        ),
        encoding="utf-8",
    )
    # The real registry reader is what the hook consults for the goal route, so
    # the fixture ships the real table shape instead of a private word list.
    (engine_pkg / "commands.py").write_text(
        textwrap.dedent(
            '''
            TAB

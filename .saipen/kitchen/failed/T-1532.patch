+def _valve_resume_action(root: Path, state: dict, board: dict) -> str:
+    """What owns continuation once the valve is cleared -- never a WAIT.
+
+    T-1293: a fixed `saipen continue` is neither the routed audit action nor a
+    continuation naming a DOING ticket, so with an ACTIVE audit layer the
+    sanctioned `cc` left a state tools/validate.py rejects
+    (SOURCE-AUDIT-INBOX-01). Same precedence the validator accepts: the live
+    ticket by name, then the audit route, then the plain resume.
+    """
+    task, phase = state.get("task"), state.get("phase")
+    ticket = board.get("tickets", {}).get(task or "")
+    if ticket is not None and ticket.get("section") == "## DOING" and phase and phase != "DONE":
+        return f"PHASE {phase} {task}"
+    try:
+        from .audit_inbox import projection as audit_projection
+        from .audit_route import audit_route_owns
+
+        routed = audit_projection(root)
+        if audit_route_owns(routed, tickets=board.get("tickets"), agent=state.get("agent")):
+            action = str(routed["action"])
+            if not action.startswith("WAIT"):
+                return action
+    except (OSError, ValueError, KeyError):
+        # An unreadable inbox is reported by the validator, which then checks
+        # no route either; the plain resume is what it accepts.
+        pass
+    return "saipen continue"
+

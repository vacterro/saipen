+#: The declared route a continuation directive asks for. A `/goal` objective
+#: whose whole text is a declared CONTINUE-family row names the CONVERGE
+#: CONTRACT (CONVERGE.md: `cc` takes the project "to a state where nothing
+#: known is left undone"), which is a persisted `execution_intent`, not new
+#: Work. The row->target pairs are the registry's own CONVERGE.md targets, and
+#: the route strings are the exact canonical commands those rows resolve to.
+_CONTINUE_ROW_TARGETS = {
+    "cc": ("saipen continue", "done"),
+    "ccc": ("saipen continue", "ship"),
+    "sc": ("saipen crew", "crew"),
+}
+
+
+def _converge_directive(objective: str) -> str | None:
+    """The converge target a `/goal` objective is really asking for, or None.
+
+    `gg "cc all"` is the operator naming the convergence contract, not
+    describing new Work. Planning it minted a ticket whose text AND whose
+    verify clause were the same sentence ("cc all is complete and ...") --
+    the GOAL_ECHO class (T-1306, T-1195, T-1172, T-1155): no evidence can
+    ever satisfy it, and the pivot DEMOTED the live DOING ticket to make
+    room. Here the objective is a closed-vocabulary continuation request, so
+    it binds the declared converge intent instead.
+
+    Fail-closed by construction: the objective must be EXACTLY one declared
+    continue row, optionally plus the bare `all` qualifier. Anything else --
+    a clause, a second word, an undeclared row -- returns None and plans
+    normally.
+    """
+    from .commands import load_shortcut_table, normalize_shortcut_token
+
+    words = objective.split()
+    if not words:
+        return None
+    lead = normalize_shortcut_token(words[0])
+    declared_route, target = _CONTINUE_ROW_TARGETS.get(lead, (None, None))
+    if declared_route is None:
+        return None
+    # The row must still be declared in the live registry with the route
+    # this mapping names; a renamed or dropped row is not a directive.
+    if load_shortcut_table().get(lead) != declared_route:
+        return None
+    if len(words) == 1:
+        return target
+    if len(words) == 2 and normalize_shortcut_token(words[1]) == "all":
+        return target
+    return None
+
+

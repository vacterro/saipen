+def force_stop_reason_goal_blocked(text: str) -> str:
+    """T-1302: stamp `stop_reason: GOAL_BLOCKED` onto STATE whatever the live
+    state holds. A sub_line would go dead the moment the field is absent (it
+    is new), so this inserts the line before the closing frontmatter `---`
+    and replaces it when already present."""
+    if re.search(r"^stop_reason:\s*GOAL_BLOCKED$", text, re.MULTILINE):
+        return text
+    if re.search(r"^stop_reason:", text, re.MULTILINE):
+        return re.sub(r"^stop_reason:.*$", "stop_reason: GOAL_BLOCKED", text, flags=re.MULTILINE)
+    return text.replace("\n---", "\nstop_reason: GOAL_BLOCKED\n---", 1)
+
+
+def strip_verify_add_inherited_closure(text: str) -> str:
+    """T-1302: turn the first DONE ticket into an evidence-less
+    INHERITED_VERIFIED closeout -- drop its | verify: evidence and stamp the
+    verification-only closure mode that requires it."""
+    lines = text.splitlines()
+    section = ""
+    for index, line in enumerate(lines):
+        if line.startswith("## "):
+            section = line
+            continue
+        if section == "## DONE" and line.startswith("- [x] T-") and " | verify:" in line:
+            stripped = re.sub(r" \| verify:[^|]*", "", line)
+            lines[index] = stripped + " | closure_mode: inherited_verified"
+            return "\n".join(lines) + "\n"
+    return text
+

@@ -2389,6 +2389,69 @@
         f"THAT ticket's line in `## BLOCKED` with its owner named, and Core "
         f"keeps working the rest"
     )
+# Orchestration repair (T-1302): `stop_reason: GOAL_BLOCKED` is the new-format
+# evidence of a deliberate global stop. It is FALSE when any ticket is still
+# workable -- the FastPrompter failure was exactly a "blocked" that still had
+# independent work (a fresh user request) available. `phase: BLOCKED` is the
+# legacy evidence path checked above; this fires on the persisted stop_reason
+# even where a stale phase label survived the transition.
+_stop_reason = str(state.get("stop_reason") or "").strip().upper()
+if _stop_reason == "GOAL_BLOCKED":
+    _goal_blocked_workable = [
+        tid
+        for tid, t in tickets.items()
+        if ticket_is_workable(t, tickets, agent=state.get("agent"))
+    ]
+    if _goal_blocked_workable:
+        fail(
+            f"STATE.md stop_reason: GOAL_BLOCKED while {len(_goal_blocked_workable)} "
+            f"workable ## TODO ticket(s) exist (topmost "
+            f"{min(_goal_blocked_workable)}) -- a goal block is a claim that "
+            f"NO safe work remains, and a workable ticket makes it false. "
+            f"Block the ticket, not the goal (orchestration repair, T-1302)"
+        )
+
+# Orchestration repair (T-1302) closure provenance: INHERITED_VERIFIED means
+# "the implementation already existed and THIS agent verified it" -- the one
+# closure mode that must show verification evidence on the ticket itself, since
+# it deliberately contributes no patch. The generic DONE rule above already
+# requires | verify: for every DONE ticket; this names the mode so the failure
+# explains itself when a verification-only closeout loses its evidence.
+_inherited_no_evidence = [
+    tid
+    for tid, t in tickets.items()
+    if t["section"] == "## DONE"
+    and str(t["fields"].get("closure_mode") or "").strip().lower()
+    in ("inherited_verified",)
+    and not str(t["fields"].get("verify") or "").strip()
+]
+if _inherited_no_evidence:
+    fail(
+        "BOARD.md INHERITED_VERIFIED closure(s) carry no | verify: evidence: "
+        + ", ".join(_inherited_no_evidence)
+        + " -- a verification-only closeout without verification evidence is "
+        "a closure with nothing behind it (orchestration repair, T-1302)"
+    )
+
+# COHORT_DANGLING: a cohort id referenced by exactly one DONE ticket has no
+# member to ship with -- either the cohort was never joined or the members were
+# closed without the cohort field. Warn (not fail): a single-member cohort may
+# be a legitimate pre-publish record, and legacy boards cannot have cohorts.
+_cohort_members: dict[str, list[str]] = {}
+for tid, t in tickets.items():
+    _cohort = str(t["fields"].get("closure_cohort") or "").strip()
+    if t["section"] == "## DONE" and _cohort:
+        _cohort_members.setdefault(_cohort, []).append(tid)
+for _cohort, _members in sorted(_cohort_members.items()):
+    if len(_members) == 1:
+        warn(
+            "cohort-dangling",
+            f"BOARD.md closure_cohort {_cohort} has a single member "
+            f"({_members[0]}) -- no other ticket ships with it; either the "
+            f"cohort was never joined or members closed without the cohort "
+            f"field (COHORT_DANGLING, orchestration repair T-1302)",
+        )
+

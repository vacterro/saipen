+    if command == "cohort":
+        # Orchestration repair (T-1302 FINDING 4): `saipen cohort ship C-###`
+        # is the ONE public cohort publication operation. It freezes the
+        # union of the members' attributable paths, publishes through the
+        # EXISTING exact release-integrity machinery (no second engine), and
+        # flips the durable registry record to shipped with the release
+        # identity. No member may isolate a personal diff; publication
+        # belongs to the cohort authority.
+        if len(args) < 2 or args[1] not in ("ship", "status"):
+            _emit(
+                {
+                    "ok": False,
+                    "code": "VALIDATION_FAILED",
+                    "detail": "cohort accepts `ship <C-###>` | `status <C-###>`",
+                },
+                as_json,
+            )
+            return 2
+        if len(args) != 3:
+            _emit(

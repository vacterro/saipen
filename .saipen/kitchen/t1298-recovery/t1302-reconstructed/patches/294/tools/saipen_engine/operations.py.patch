+def _plan_cohort_closure(
+    root: Path,
+    agent: str,
+    now: str,
+    utc: str,
+    cohort_id: str,
+    digest_text: str | None = None,
+    prefix_run: str | None = None,
+    release_op_id: str = "",
+    version: str = "",
+    tag: str = "",
+    commit: str = "",
+) -> OperationPlan | Result:
+    """PLAN the cohort publication closure (FINDING 4, T-1302).
+
+    A cohort ship has NO ## DOING ticket: the member tickets are already
+    DONE with closure_mode=cohort, and publication belongs to the cohort
+    authority, not to any per-ticket diff. This plan writes the RUN +
+    completion LOG events, the digest, the STATE last_event/updated/agent
+    (phase stays DONE / task none), and flips the durable cohort registry
+    record to shipped with the exact release identity (op_id, version, tag,
+    commit) and the frozen batch scope -- all in ONE journaled transaction.
+    """
+    op_id = "cohort-closure-" + uuid4_hex()
+    docs, state, board, log_tail = _read(root)
+    if board["errors"]:
+        return _refuse(
+            "VALIDATION_FAILED", "BOARD parse error(s): " + "; ".join(board["errors"][:3])
+        )
+    if state.get("phase") != "DONE" or state.get("task") not in (None, "", "none"):
+        return _refuse(
+            "ILLEGAL_PHASE",
+            f"cohort publication closure requires local Core phase DONE / "
+            f"task none; live {state.get('phase')}/{state.get('task')}",
+        )
+    try:
+        registry = read_cohort_registry(root)
+        ready = cohort_ready_error(root, board, registry, cohort_id)
+    except (OSError, ValueError) as exc:
+        return _refuse("VALIDATION_FAILED", f"cohort registry is unreadable: {exc}")
+    if ready is not None:
+        return _refuse("VALIDATION_FAILED", ready)
+    cohort = registry["cohorts"][cohort_id]
+    scope = {}
+    for member_id, record in sorted((cohort.get("members") or {}).items()):
+        for rel, expected in sorted((record.get("paths") or {}).items()):
+            scope[rel] = expected
+    if prefix_run:
+        run_event, run_line = build_event(
+            log_tail, "RUN", prefix_run, ticket=None, agent=agent, now=now, op_id=op_id
+        )
+        event, line = build_event(
+            run_event,
+            "DEC",
+            f"cohort {cohort_id} published -- batch closure",
+            ticket=None,
+            agent=agent,
+            now=now,
+            op_id=op_id,
+        )
+        new_log = docs["log"].text_norm.rstrip("\n") + "\n" + run_line + "\n" + line + "\n"
+    else:
+        event, line = _event_line(
+            docs, log_tail, "DEC", None, agent, f"cohort {cohort_id} published", now, op_id
+        )
+        new_log = docs["log"].text_norm.rstrip("\n") + "\n" + line + "\n"
+    owned = {
+        "last_event": event,
+        "updated": utc,
+        "agent": agent,
+    }
+    new_state = patch_state(docs["state"].text_norm, owned)
+    from .router import route_next
+
+    new_board = docs["board"].text_norm
+    routed = route_next(new_state, new_board, current_agent=agent)
+    if routed.get("ok") and routed.get("action") != "saipen continue":
+        new_state = patch_state(new_state, {"next_action": routed["action"]})
+    errors = validate_texts(
+        new_state, new_board, new_log, current_agent=agent, sealed_events=docs["_history"]
+    )
+    if errors:
+        return _refuse(
+            "VALIDATION_FAILED",
+            "proposed cohort closure state fails fast validation: " + "; ".join(errors[:5]),
+        )
+    cohort["publication_status"] = "shipped"
+    cohort["release_op_id"] = release_op_id
+    cohort["version"] = version
+    cohort["tag"] = tag
+    cohort["commit"] = commit
+    cohort["scope"] = dict(sorted(scope.items()))
+    reg_doc = _cohort_registry_doc(root)
+    new_reg = reg_doc.encode(json.dumps(registry, indent=2, ensure_ascii=False) + "\n")
+    reg_path = root / COHORT_REGISTRY_PATH
+    targets = [
+        _target(docs["log"], ".saipen/LOG.md", "log", new_log),
+        _target(docs["state"], ".saipen/STATE.md", "state", new_state),
+        TargetPlan(
+            COHORT_REGISTRY_PATH,
+            "report",
+            new_reg,
+            reg_doc.raw_hash if reg_path.is_file() else "",
+            hash_bytes(new_reg),
+        ),
+    ]
+    if digest_text is not None:
+        digest_doc = codec.read_document(root / ".saipen" / "kitchen" / "digest.md")
+        targets.append(
+            TargetPlan(
+                ".saipen/kitchen/digest.md",
+                "report",
+                digest_doc.encode(digest_text),
+                digest_doc.raw_hash,
+                hash_bytes(digest_doc.encode(digest_text)),
+            )
+        )
+    expected = {
+        "ok": True,
+        "code": "COHORT_SHIPPED",
+        "event_id": f"E-{event}",
+        "cohort": cohort_id,
+        "release_op_id": release_op_id,
+        "phase": "DONE",
+        "task": "none",
+        "next_action": routed.get("action"),
+    }
+    return build_plan(
+        "release_cohort_closure",
+        agent,
+        _identity(root),
+        {"operation": "release_cohort_closure", "cohort": cohort_id},
+        _docs_preconditions(docs, "state", "board", "log"),
+        targets,
+        expected,
+        op_id=op_id,
+    )
+
+

+COHORT_REGISTRY_PATH = ".saipen/kitchen/cohort_registry.json"
+
+
+def read_cohort_registry(root: Path | str) -> dict:
+    """Read the durable cohort authority. A missing file is an empty
+    registry; malformed bytes refuse with ValueError."""
+    path = Path(root) / COHORT_REGISTRY_PATH
+    if not path.is_file():
+        return {"schema_version": 1, "cohorts": {}}
+    text = path.read_text(encoding="utf-8")
+    if not text.strip():
+        return {"schema_version": 1, "cohorts": {}}
+    try:
+        data = json.loads(text)
+    except json.JSONDecodeError as exc:
+        raise ValueError(f"{COHORT_REGISTRY_PATH} is not canonical JSON: {exc}") from exc
+    if not isinstance(data, dict) or not isinstance(data.get("cohorts"), dict):
+        raise ValueError(f"{COHORT_REGISTRY_PATH} must be an object with a cohorts map")
+    return data
+
+
+def cohort_ready_error(
+    root: Path | str,
+    board: dict,
+    registry: dict,
+    cohort_id: str,
+) -> str | None:
+    """Mechanical cohort-READY predicate (FINDING 4, T-1302).
+
+    A cohort is ready to publish only when every declared member is DONE on
+    the BOARD with matching closure provenance (closure_mode=cohort,
+    closure_cohort=this id) and has a durable registry membership record
+    carrying exact path -> content-hash bindings. Membership records are
+    written only by the finish gate, which itself requires the member's
+    verification evidence, so the registry IS the publication authority.
+    Returns None when ready, else the refusal detail.
+    """
+    registry = registry or read_cohort_registry(root)
+    cohort = (registry.get("cohorts") or {}).get(cohort_id)
+    if cohort is None:
+        return f"cohort {cohort_id} has no durable registry record; no member " \
+            "has joined through `ticket done --closure-mode cohort`"
+    if cohort.get("publication_status") == "shipped":
+        return f"cohort {cohort_id} is already published (release " \
+            f"{cohort.get('release_op_id', '') or 'unknown'})"
+    members = cohort.get("members") or {}
+    if not members:
+        return f"cohort {cohort_id} has zero members"
+    tickets = board.get("tickets") or {}
+    for member_id, record in sorted(members.items()):
+        ticket = tickets.get(member_id)
+        if ticket is None or ticket.get("section") != "## DONE" or ticket.get("checkbox") != "[x]":
+            return f"cohort member {member_id} is not DONE on BOARD"
+        fields = ticket.get("fields") or {}
+        if fields.get("closure_mode") != "cohort":
+            return f"cohort member {member_id} did not close with closure_mode=cohort"
+        if fields.get("closure_cohort") != cohort_id:
+            return f"cohort member {member_id} names a different cohort " \
+                f"({fields.get('closure_cohort')!r})"
+        paths = record.get("paths") if isinstance(record, dict) else None
+        if not paths:
+            return f"cohort member {member_id} has no attributable paths in the registry"
+        root_res = Path(root).resolve()
+        for rel, expected in sorted(paths.items()):
+            fp = (root_res / rel).resolve()
+            if root_res not in fp.parents or not fp.is_file():
+                return f"cohort member {member_id} path {rel!r} is missing " \
+                    f"from the worktree"
+            if hash_bytes(fp.read_bytes()) != expected:
+                return f"cohort member {member_id} path {rel!r} changed since " \
+                    f"its member review (live bytes differ from the registry)"
+    return None
+
+
+def _implementation_source_error(root: Path, source: str, board: dict) -> str | None:
+    """Resolve the closed implementation-authority grammar against durable
+    evidence (FINDING 3). Returns a refusal detail or None when resolvable."""
+    if re.fullmatch(r"T-\d+", source):
+        tickets = board.get("tickets") or {}
+        if source in tickets:
+            return None
+        return f"implementation_source {source!r} does not exist on BOARD"
+    if re.fullmatch(r"SRC-\d+", source):
+        index_path = root / ".saipen" / "intake" / "index.json"
+        try:
+            index = json.loads(index_path.read_text(encoding="utf-8"))
+        except OSError:
+            return f"implementation_source {source!r} cannot be resolved: " \
+                f"intake index is missing ({index_path})"
+        except json.JSONDecodeError:
+            return f"implementation_source {source!r} cannot be resolved: " \
+                f"intake index is malformed"
+        if isinstance(index, dict) and (
+            source in (index.get("active") or {}) or source in (index.get("tombstones") or {})
+        ):
+            return None
+        return f"implementation_source {source!r} has no intake receipt " \
+            f"(active or tombstoned)"
+    if source.startswith("release:"):
+        token = source[len("release:"):]
+        receipt_path = root / ".saipen" / "kitchen" / "release_receipt.json"
+        try:
+            receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
+        except OSError:
+            return f"implementation_source {source!r} cannot be resolved: " \
+                f"no release receipt exists ({receipt_path})"
+        except json.JSONDecodeError:
+            return f"implementation_source {source!r} cannot be resolved: " \
+                f"release receipt is malformed"
+        if isinstance(receipt, dict) and token in (
+            receipt.get("op_id", ""),
+            receipt.get("version", ""),
+            receipt.get("tag", ""),
+        ):
+            return None
+        return f"implementation_source {source!r} does not match any " \
+            f"committed release receipt identity"
+    return f"implementation_source {source!r} is outside the closed " \
+        f"authority grammar (T-### | SRC-### | release:<id>)"
+
+
+def _cohort_registry_doc(root: Path):
+    """The cohort registry as a codec Document (missing == empty doc)."""
+    return codec.read_document(root / COHORT_REGISTRY_PATH)
+
+
+def _cohort_registry_parse(text: str) -> dict:
+    if not text.strip():
+        return {"schema_version": 1, "cohorts": {}}
+    data = json.loads(text)
+    if not isinstance(data, dict) or not isinstance(data.get("cohorts"), dict):
+        raise ValueError("cohort registry root must be an object with a cohorts map")
+    return data
+

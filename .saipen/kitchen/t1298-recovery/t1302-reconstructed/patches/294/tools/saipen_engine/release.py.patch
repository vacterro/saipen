+def _owned_entries(root: Path, paths, tree: str | None = None) -> dict:
+    """Read exact Git entries; missing owned paths are explicit deletions.
+
+    Neither route reads mutable worktree bytes or creates a tree object.
+    """
+    paths = sorted(set(paths))
+    if not paths:
+        return {}
+    args = ("ls-tree", "-r", "-z", tree) if tree is not None else ("ls-files", "-s", "-z")
+    result = _git(root, *args, "--", *paths, literal=True)
+    if not result.ok:
+        raise ValueError("cannot read owned Git entries: " + result.stderr)
+    entries = {path: {"deleted": True} for path in paths}
+    seen = set()
+    for item in result.stdout.split("\0"):
+        if not item:
+            continue
+        header, separator, path = item.partition("\t")
+        fields = header.split()
+        if not separator or len(fields) != 3 or path not in entries or path in seen:
+            raise ValueError("noncanonical owned Git entry")
+        mode, kind, blob = fields if tree is not None else (fields[0], fields[2], fields[1])
+        if kind not in (("blob", "commit") if tree is not None else ("0",)):
+            raise ValueError(f"unmerged or unsupported owned Git entry: {path}")
+        if mode not in ("100644", "100755", "120000", "160000") or not re.fullmatch(
+            r"[0-9a-f]{40}|[0-9a-f]{64}", blob
+        ):
+            raise ValueError(f"invalid owned Git identity: {path}")
+        entries[path] = {"mode": mode, "blob": blob}
+        seen.add(path)
+    return entries
+
+
+def _verify_owned_entries(root: Path, paths, manifest, tree: str | None = None) -> dict:
+    stage = "TREE_MISMATCH" if tree is not None else "INDEX_DRIFT"
+    if not isinstance(manifest, dict) or set(manifest) != set(paths):
+        return {"ok": False, "stage": stage,
+                "detail": "owned index manifest missing or scope differs"}
+    try:
+        actual = _owned_entries(root, paths, tree)
+    except ValueError as exc:
+        return {"ok": False, "stage": stage, "detail": str(exc)}
+    if actual != manifest:
+        changed = sorted(p for p in actual if actual[p] != manifest[p])
+        return {"ok": False, "stage": stage,
+                "detail": "owned Git identity changed: " + ", ".join(changed)}
+    return {"ok": True}
+

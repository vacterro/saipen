+def add_inherited_closure_no_source(text: str) -> str:
+    """T-1302 FINDING 3: stamp the first ## DONE ticket as an
+    INHERITED_VERIFIED closeout WITHOUT naming the durable implementation
+    authority. The verify evidence stays (so the earlier evidence check does
+    not shadow this site); only the mandatory source is missing."""
+    lines = text.splitlines()
+    section = ""
+    for index, line in enumerate(lines):
+        if line.startswith("## "):
+            section = line
+            continue
+        if section == "## DONE" and line.startswith("- [x] T-") and " | verify:" in line:
+            if "closure_mode:" in line:
+                continue
+            lines[index] = line + " | closure_mode: inherited_verified"
+            return "\n".join(lines) + "\n"
+    return text
+
+
+def add_inherited_closure_bad_source(text: str) -> str:
+    """T-1302 FINDING 3: INHERITED_VERIFIED closeout whose implementation
+    source is free prose instead of the closed authority grammar. Verify stays,
+    so only the malformed-authority site can fire."""
+    lines = text.splitlines()
+    section = ""
+    for index, line in enumerate(lines):
+        if line.startswith("## "):
+            section = line
+            continue
+        if section == "## DONE" and line.startswith("- [x] T-") and " | verify:" in line:
+            if "closure_mode:" in line:
+                continue
+            lines[index] = (
+                line
+                + " | closure_mode: inherited_verified"
+                + " | implementation_source: shared main.py blob"
+            )
+            return "\n".join(lines) + "\n"
+    return text
+
+

+# Orchestration repair (T-1302 FINDING 3): INHERITED_VERIFIED must name the
+# durable implementation authority. "The implementation already existed" is
+# an unsupported assertion without one; closing without a source would leave
+# implementation bytes with nobody responsible for publication.
+_inherited_no_source = [
+    tid
+    for tid, t in tickets.items()
+    if t["section"] == "## DONE"
+    and str(t["fields"].get("closure_mode") or "").strip().lower()
+    == "inherited_verified"
+    and not str(t["fields"].get("implementation_source") or "").strip()
+]
+if _inherited_no_source:
+    fail(
+        "BOARD.md INHERITED_VERIFIED closure(s) carry no implementation_source: "
+        + ", ".join(_inherited_no_source)
+        + " -- a verification-only closeout MUST name the durable authority "
+        "of the already-existing implementation "
+        "(--implementation-source T-### | SRC-### | release:<id>); without it "
+        "nobody is mechanically responsible for publication "
+        "(orchestration repair, T-1302)"
+    )
+
+# Same finding, malformed authority: the closed grammar is
+# T-### | SRC-### | release:<op_id|version|tag>. Arbitrary prose cannot be
+# resolved by the engine, so it must not be recorded as provenance.
+_inherited_bad_source = [
+    (tid, str(t["fields"].get("implementation_source") or ""))
+    for tid, t in tickets.items()
+    if t["section"] == "## DONE"
+    and str(t["fields"].get("closure_mode") or "").strip().lower()
+    == "inherited_verified"
+    and re.fullmatch(
+        r"(T-\d+|SRC-\d+|release:[0-9A-Za-z_.-]+)",
+        str(t["fields"].get("implementation_source") or "").strip(),
+    )
+    is None
+]
+if _inherited_bad_source:
+    fail(
+        "BOARD.md INHERITED_VERIFIED closure(s) carry a malformed "
+        "implementation_source: "
+        + ", ".join(f"{tid}={source!r}" for tid, source in _inherited_bad_source)
+        + " -- the closed authority grammar is T-### | SRC-### | "
+        "release:<op_id|version|tag>; arbitrary prose is not resolvable "
+        "provenance (orchestration repair, T-1302)"
+    )
+
+# Orchestration repair (T-1302 FINDING 4): COHORT closure is metadata only
+# until the durable registry binds the member. A DONE ticket claiming
+# closure_mode=cohort with NO registry record for it is a cohort string
+# pretending to be publication authority -- the overlapping-main.py problem
+# renamed, not solved.
+_cohort_registry: dict[str, set[str]] = {}
+try:
+    _registry_text = Path(".saipen/kitchen/cohort_registry.json").read_text(
+        encoding="utf-8"
+    )
+    if _registry_text.strip():
+        _registry_data = json.loads(_registry_text)
+        if isinstance(_registry_data, dict) and isinstance(
+            _registry_data.get("cohorts"), dict
+        ):
+            for _cid, _cohort in _registry_data["cohorts"].items():
+                _members = (
+                    set((_cohort.get("members") or {}).keys())
+                    if isinstance(_cohort, dict)
+                    else set()
+                )
+                _cohort_registry[_cid] = _members
+except (OSError, ValueError):
+    _cohort_registry = {}
+_cohort_unbound = [
+    tid
+    for tid, t in tickets.items()
+    if t["section"] == "## DONE"
+    and str(t["fields"].get("closure_mode") or "").strip().lower() == "cohort"
+    and tid
+    not in _cohort_registry.get(
+        str(t["fields"].get("closure_cohort") or "").strip(), set()
+    )
+]
+if _cohort_unbound:
+    fail(
+        "BOARD.md COHORT closure(s) have no durable registry membership: "
+        + ", ".join(_cohort_unbound)
+        + " -- `.saipen/kitchen/cohort_registry.json` must bind every cohort "
+        "member (ticket id + attributed paths) before the closure is real; "
+        "a cohort string on BOARD is metadata, not publication authority "
+        "(orchestration repair, T-1302)"
+    )
+

    "SRC-296:R001": {
      "actionable": true,
      "class": "requirement",
      "text": "\u0414\u0435\u043b\u043e \u0432 \u0442\u043e\u043c \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0440\u0435\u0448\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0432\u043e\u043f\u0440\u043e\u0441 \u0442\u0430\u043a \u0447\u0442\u043e\u0431\u044b \u044e\u0437\u0435\u0440 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0432\u044b\u043d\u0443\u0436\u0434\u0435\u043d \u0431\u044b\u043b \u0447\u0442\u043e \u0442\u043e \u0442\u0430\u043c \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0432\u0440\u0443\u0447\u043d\u0443\u044e \u0434\u0430\u0432\u0430\u0442\u044c - \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u043e SAIPEN. SAIPEN \u044d\u0442\u043e \u043f\u043e\u043b\u043d\u0430\u044f \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u043e\u0441\u0442\u044c \u0438 \u0442\u0430\u043a\u0438\u0435 \u043a\u043e\u0441\u0442\u044b\u043b\u0438 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0442, \u0442\u0443\u0442 \u043d\u0443\u0436\u0435\u043d \u043f\u043e\u0434\u0445\u043e\u0434 \u0442\u0430\u043a\u043e\u0439 \u0447\u0442\u043e \u0438\u043b\u0438 \u0442\u044b \u0447\u0438\u043d\u0438\u0448\u044c \u044d\u0442\u043e \u0441\u0440\u0430\u0437\u0443 \u043a\u0430\u043a \u0431\u044b \u0434\u0430\u0432\u0430\u044f \u0442\u0443 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0438\u043b\u0438 \u0430\u0433\u0435\u043d\u0442 \u044d\u0442\u043e \u0447\u0438\u043d\u0438\u0442 \u0441\u0430\u043c, \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u043e \u0438\u043b\u0438 SAIPEN \u0443\u043c\u0435\u0435\u0442 \u044d\u0442\u043e \u0441\u0430\u043c \u0447\u0438\u043d\u0438\u0442\u044c\u0441\u044f."
    }
